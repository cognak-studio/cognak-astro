    .adm .field{ margin:1.6rem 0 0; }
    .adm .q{ display:block; margin-bottom:.75rem; }
    .adm .q-title{ display:block; font-size:var(--fs-15); font-weight:500; line-height:1.3; color:var(--ink); }
    .adm .txt{ width:100%; box-sizing:border-box; margin:0; background:var(--field);
      border:1px solid var(--line-strong); border-radius:8px; color:var(--ink);
      -webkit-text-fill-color:var(--ink); caret-color:var(--accent-text);
      font-family:inherit; font-size:var(--fs-16); line-height:1.5; padding:13px 16px; outline:none;
      transition:border-color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard); }
    .adm .txt:focus{ border-color:var(--accent-text); background:var(--field-focus); }
    /* WebKit autofill repaints the field pale; force it back to the page's own field. */
    .adm .txt:-webkit-autofill, .adm .txt:-webkit-autofill:hover,
    .adm .txt:-webkit-autofill:focus, .adm .txt:-webkit-autofill:active{
      -webkit-text-fill-color:var(--ink) !important; caret-color:var(--accent-text);
      -webkit-box-shadow:0 0 0 1000px var(--panel-hi) inset !important; box-shadow:0 0 0 1000px var(--panel-hi) inset !important;
      transition:background-color 9999s ease-out 0s; }

    .adm .note{ margin:.9rem 0 0; font-size:var(--fs-13); line-height:1.45; color:var(--ink-soft); }
    .adm .note:empty{ margin:0; }
    .adm .note.is-error{ color:var(--err); }
    .adm .idle-note{ max-width:440px; text-align:center; font-family:'Diatype Mono', monospace;
      font-size:var(--fs-12); line-height:1.75; color:var(--accent-text); margin:1.1rem 0 0; }
    .adm .idle-note:empty{ margin:0; }

    .adm .actions{ display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:center; margin-top:1.6rem; }
    .adm .btn{ font-family:inherit; font-size:var(--fs-15); font-weight:500; cursor:pointer;
      display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
      border-radius:999px; padding:12px 22px; background:none; color:var(--ink);
      border:1px solid var(--line-strong);
      transition:background var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard),
        border-color var(--dur-s) var(--ease-standard), box-shadow var(--dur-sm) var(--ease-standard); }
    .adm .btn:hover:not(:disabled){ border-color:var(--ink); }
    /* White on --purple-vivid is 5.62:1. Hover deepens rather than lightens
       (lighter purples drop white text under 4.5) and glows, like /send's CTA. */
    .adm .btn.btn-primary{ background:var(--purple-vivid); border-color:var(--purple-vivid); color:#fff; }
    .adm .btn.btn-primary:hover:not(:disabled){ background:var(--purple-deep); border-color:var(--purple-deep);
      box-shadow:0 0 26px rgba(139,31,255,.5); }
    .adm .btn.btn-ghost{ padding:11px 18px; font-size:var(--fs-14); }
    .adm .btn:active:not(:disabled){ transform:scale(.98); }
    .adm .btn:disabled{ opacity:.55; cursor:not-allowed; }
    .adm .btn .btn-icon{ display:inline-flex; }
    .adm .btn .btn-icon svg{ display:block; }
    .adm .actions .btn{ min-width:0; }
    @media (max-width:600px){ .adm #gate .actions .btn{ width:100%; } }

    .adm a:focus-visible, .adm button:focus-visible, .adm input:focus-visible{
      outline:2px solid var(--accent-text) !important; outline-offset:3px; }

    /* ---------------------------------------------------------- dashboard --- */
    .adm .dash-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:1.1rem; }
    .adm .status{ display:inline-flex; align-items:center; gap:.6rem; font-family:'Diatype Mono', monospace;
      font-size:var(--fs-11); letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); }
    .adm .status-dot{ width:7px; height:7px; border-radius:50%; background:var(--purple);
      box-shadow:0 0 10px rgba(159,80,255,.8); }

    /* One column, centred under the headline (Pierce, 9/28: "stack the admin cards"). */
    .adm #dash{ max-width:600px; }
    .adm .tools{ display:grid; grid-template-columns:1fr; gap:12px; margin:0; padding:0; list-style:none; }
    .adm .tcard{ position:relative; display:flex; flex-direction:column; min-height:0; box-sizing:border-box;
      text-decoration:none; color:var(--ink); background:var(--panel); border:1px solid var(--line);
      border-radius:12px; padding:24px 24px 22px;
      transition:border-color var(--dur-sm) var(--ease-standard), box-shadow var(--dur-sm) var(--ease-standard), background var(--dur-sm) var(--ease-standard); }
    @media (max-width:900px){ .adm .tcard{ min-height:0; padding:22px 20px 20px; } }
    .adm .tcard .idx, .adm .tcard .ttag{ line-height:1; font-family:'Diatype Mono', monospace; font-size:var(--fs-10);
      letter-spacing:.14em; color:var(--ink-soft); transition:color var(--dur-s) var(--ease-standard); }
    .adm .tcard .ttag{ position:absolute; top:24px; right:24px; text-transform:uppercase; }
    @media (max-width:900px){ .adm .tcard .ttag{ top:22px; right:20px; } }
    .adm .tcard h2{ font-size:1.5rem; font-weight:500; letter-spacing:-.01em; line-height:1.2;
      margin:1.4rem 0 .45rem; color:var(--ink); transition:color var(--dur-s) var(--ease-standard); }
    .adm .tcard p{ font-size:var(--fs-14); line-height:1.5; color:var(--ink-soft); margin:0; padding-right:1.6rem;
      max-width:40ch; transition:color var(--dur-s) var(--ease-standard); }
    .adm .tcard .arrow{ position:absolute; bottom:20px; right:22px; color:var(--ink-soft);
      transition:transform var(--dur-sm) var(--ease-standard), color var(--dur-sm) var(--ease-standard); }
    @media (hover:hover){
      .adm .tcard:hover{ background:var(--panel-hi); border-color:rgba(159,80,255,.45);
        box-shadow:0 22px 34px -18px rgba(139,31,255,.55); }
      .adm .tcard:hover h2, .adm .tcard:hover .arrow, .adm .tcard:hover .ttag{ color:var(--accent-text); }
      .adm .tcard:hover .arrow{ transform:translateX(4px); }
    }
    .adm .tcard:active{ transform:scale(.995); }

    .adm .dash-foot{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
      margin-top:1.6rem; }
    .adm .dash-foot .hint{ font-size:var(--fs-13); line-height:1.45; color:var(--ink-soft); margin:0; max-width:52ch; }
    .adm .dash-foot .hint a{ color:var(--accent-text); text-decoration:underline; text-underline-offset:3px;
      text-decoration-color:rgba(199,155,255,.4); }
    .adm .dash-foot .btn{ margin-left:auto; }
    /* Passkeys, moved here from /send (Pierce, 9/28): sign-in lives on /admin, so its keys do too. */
    .adm .pk{ margin-top:1.6rem; padding:22px 24px; background:var(--panel); border:1px solid var(--line); border-radius:12px; }
    .adm .pk-title{ font-family:'Diatype Mono', monospace; font-size:var(--fs-11); letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); margin:0 0 .4rem; }
    .adm .pk-sub{ font-size:var(--fs-13); line-height:1.5; color:var(--ink-soft); margin:0 0 1rem; }
    .adm .pk-list{ list-style:none; margin:0; padding:0; }
    .adm .pk-list li{ display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 0; border-top:1px solid var(--line); }
    .adm .pk-list .pk-name{ font-size:var(--fs-15); color:var(--ink); }
    .adm .pk-list .pk-meta{ display:block; font-size:var(--fs-12); color:var(--ink-soft); margin-top:2px; }
    .adm .pk .actions{ justify-content:flex-start; margin-top:1rem; }
    .adm .note.is-ok{ color:var(--accent-text); }
    .adm .bounce-note{ margin:0 0 1.2rem; font-size:var(--fs-14); line-height:1.5; color:var(--err); max-width:60ch; }
    .adm .bounce-note:empty{ display:none; }

