              <g clip-path="url(#adm-icon-clip-1)">
                <path fill-rule="nonzero" fill="currentColor" d="M 41.5625 22.730469 C 34.507812 26.585938 28.847656 31.1875 23.125 36.367188 C 21.96875 37.414062 20.78125 38.265625 19.710938 39.441406 C 17.992188 41.328125 15.050781 41.574219 13.285156 39.605469 C 11.398438 37.503906 10.519531 33.753906 12.78125 31.4375 C 30.253906 13.554688 51.378906 3.167969 76.503906 0.734375 C 93.230469 -0.886719 109.851562 2.089844 125.296875 8.535156 C 127.410156 9.417969 128.664062 11.296875 129.097656 13.160156 C 129.5 14.886719 128.976562 17.582031 127.269531 18.671875 C 126.300781 19.289062 124.160156 19.222656 123.070312 18.804688 C 108.472656 13.199219 93.546875 10.1875 77.863281 11.679688 C 65.089844 12.890625 52.988281 16.492188 41.5625 22.730469 "/>
              </g>
              <path fill-rule="nonzero" fill="currentColor" d="M 52.007812 219.777344 C 49.136719 218.179688 48.578125 212.785156 51.332031 210.867188 C 53.402344 209.421875 56.320312 210.023438 58.71875 209.757812 C 73.695312 208.113281 84.53125 200.898438 90.886719 187.296875 C 96.550781 175.179688 97.484375 162.207031 94.484375 149.34375 C 93.941406 147.015625 95.84375 144.695312 97.386719 144.175781 C 99.523438 143.449219 101.945312 144.738281 102.730469 147.214844 C 104.984375 154.320312 105.433594 161.839844 104.957031 169.417969 C 104.128906 182.554688 99.878906 195.027344 91.484375 205.214844 L 85.503906 211.199219 C 78.8125 216.679688 70.5 219.867188 61.863281 220.492188 C 58.542969 220.734375 55.335938 221.628906 52.007812 219.777344 "/>
            </svg>
            <span class="signin-icon-shimmer" aria-hidden="true"></span>
          </span>
        <div class="group-title">Sign in</div>
        <p class="signin-sub" id="signin-sub">Use Touch ID, Face ID, or your device passkey to continue.</p>
      </div>
      <div class="field" id="pw-field" hidden>
        {/* Hidden username so password managers save + autofill reliably. */}
        <input type="text" name="username" value="cognak-admin" autocomplete="username"
               readonly hidden aria-hidden="true" tabindex="-1" />
        <label class="q" for="pw-input"><span class="q-title">Admin password</span></label>
        <input class="txt" id="pw-input" name="password" type="password" autocomplete="current-password" />
      </div>
      <p class="note" id="pw-note" role="status" aria-live="polite"></p>
      <div class="actions">
        <button type="button" class="btn btn-primary" id="passkey-signin">
          <span class="btn-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12.5 2 2 4-4.5"/><path d="M12 3 5 6v5.5c0 4.6 3 7.7 7 9 4-1.3 7-4.4 7-9V6l-7-3Z"/></svg>
          </span>
          Sign in with passkey
        </button>
        <button type="button" class="btn btn-primary" id="pw-submit" hidden>Sign in</button>
        <button type="button" class="btn btn-ghost" id="use-password" hidden>Use password instead</button>
      </div>
    </div>
    <p class="idle-note" id="idle-note" role="status" aria-live="polite"></p>

    <!-- ------------------------------------------------------ dashboard --- -->
    <div id="dash" class="rise" hidden>
      <p class="bounce-note" id="bounce-note" role="status" aria-live="polite"></p>
      <div class="dash-head">
        <span class="status"><span class="status-dot" aria-hidden="true"></span>Signed in</span>
      </div>
      <ul class="tools">
        {TOOLS.map((t, i) => (
          <li>
            <a class="tcard" href={t.href}>
              <span class="idx">0{i + 1}</span>
              <span class="ttag">{t.tag}</span>
              <h2>{t.title}</h2>
              <p>{t.desc}</p>
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <section class="pk" aria-labelledby="pk-title">
        <h2 class="pk-title" id="pk-title">Passkeys</h2>
        <p class="pk-sub">Each browser or device you sign in from. Add one here to sign in from a new browser; saving it to iCloud Keychain makes it work in Safari and on your iPhone too.</p>
        <p class="note" id="pk-note" role="status" aria-live="polite"></p>
        <ul class="pk-list" id="pk-list"></ul>
        <p class="note" id="pk-empty" hidden>No passkeys yet. The password is the only way in.</p>
        <div class="actions"><button type="button" class="btn btn-primary" id="pk-add">Add this device</button></div>
      </section>
      <div class="dash-foot">
        <button type="button" class="btn btn-ghost" id="signout-btn">Sign out</button>
      </div>
    </div>

  </section></main>

  <script>
    const $ = (id) => document.getElementById(id);
    const REDUCE = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const safeNext: (raw: string | null) => string | null = (window as any).cognakSafeNext || (() => null);

    /* "Probably signed in" hint for first paint only (see the inline script
       above and /send). Never used to decide access — the server does that. */
    const HINT = 'cognak-admin-hint';
    function setHint(on) {
      try { if (on) localStorage.setItem(HINT, '1'); else localStorage.removeItem(HINT); } catch (e) {}
    }

    /* Never hangs: a stalled request gives up after 10s and the page shows the sign-in card. */
    async function api(path, opts) {
      const ac = new AbortController(); const t = setTimeout(() => ac.abort(), 10000);
      try {
        const res = await fetch(path, {
          method: (opts && opts.method) || 'GET',
          headers: { 'Content-Type': 'application/json' },
          body: opts && opts.body ? JSON.stringify(opts.body) : undefined,
          credentials: 'same-origin',
          signal: ac.signal,
        });
        let json = null;
        try { json = await res.json(); } catch (e) { /* no body */ }
        return { ok: res.ok, status: res.status, data: json };
      } catch (e) {
        return { ok: false, status: 0, data: null };
      } finally { clearTimeout(t); }
    }

    const params = new URLSearchParams(location.search);
    let next = safeNext(params.get('next'));
    const gate = $('gate');
    const dash = $('dash');

    function ready() { document.documentElement.classList.remove('admin-pending'); }

    function reveal(el) {
      el.classList.remove('in', 'out');
      el.hidden = false;
      if (REDUCE()) { el.classList.add('in'); return; }
      requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('in')));
    }
    function swap(outEl, inEl) {
      outEl.classList.add('out');
      setTimeout(() => {
        outEl.hidden = true;
        outEl.classList.remove('in', 'out');
        reveal(inEl);
        syncScroll();
      }, REDUCE() ? 0 : 260);
    }
    /* Lenis caches the document height; the gate <-> dashboard swap changes it. */
    function syncScroll() {
      requestAnimationFrame(() => {
        try { if (window._lenis && window._lenis.resize) window._lenis.resize(); } catch (e) {}
        window.dispatchEvent(new Event('resize'));
      });
    }

    /* Loop breaker. /admin -> next -> (next says 401) -> /admin?next=... can
       only happen if the two disagree about the session, which they shouldn't
       (same cookie, same requireAdmin). If it ever does, the second arrival
       within 15s stops and shows the dashboard with a note instead of
       bouncing forever. /send clears the marker once it's signed in. */
    const BOUNCE = 'cognak-admin-bounce';
    function bouncedRecently(target) {
      try {
        const b = JSON.parse(sessionStorage.getItem(BOUNCE) || 'null');
        return !!(b && b.to === target && Date.now() - b.t < 15000);
      } catch (e) { return false; }
    }
    function go(target) {
      try { sessionStorage.setItem(BOUNCE, JSON.stringify({ to: target, t: Date.now() })); } catch (e) {}
      location.replace(target);
    }

    /* ------------------------------------------------------------ auth --- */
    let _webauthn = null;
    function webauthn() {
      if (!_webauthn) {
        _webauthn = import('https://esm.sh/@simplewebauthn/browser@13').catch(() => {
          _webauthn = null;
          throw new Error('Passkey support could not load. Check your connection.');
        });
      }
      return _webauthn;
    }

    /* Ask the server which methods it will accept. Secure default on any
       failure: passkey only, never the password box. */
    async function initGate() {
      const r = await api('/api/admin-login');
      const modes = (r.ok && r.data) || { hasPasskeys: true, passwordAllowed: false };
      const supported = typeof window.PublicKeyCredential !== 'undefined';
      const usePasskey = modes.hasPasskeys && supported;
      $('passkey-signin').hidden = !usePasskey;
      $('pw-field').hidden = usePasskey || !modes.passwordAllowed;
      $('pw-submit').hidden = usePasskey || !modes.passwordAllowed;
      $('use-password').hidden = !(usePasskey && modes.passwordAllowed);
      $('signin-sub').textContent = usePasskey || !modes.passwordAllowed
        ? 'Use Touch ID, Face ID, or your device passkey to continue.'
        : 'Enter the admin password to continue.';
      const note = $('pw-note');
      note.textContent = '';
      note.className = 'note';
      if (modes.hasPasskeys && !supported) {
        note.textContent = 'This browser cannot use passkeys. Open this page in Safari or Chrome.';
        note.className = 'note is-error';
      }
    }

    /* ---- passkeys (moved from /send, 9/28): same endpoints, same wording ---- */
    async function renderPasskeys() {
      const r = await api('/api/admin-passkey?action=list');
      if (!r.ok) return;
      const keys = (r.data && r.data.passkeys) || [];
      const list = $('pk-list'); list.innerHTML = '';
      $('pk-empty').hidden = keys.length > 0;
      if (r.data && r.data.fallbackEnabled && keys.length) {
        $('pk-note').textContent = 'ADMIN_PASSWORD_FALLBACK is on, so the password still works. Turn it off in Vercel to make passkeys the only way in.';
        $('pk-note').className = 'note is-error';
      }
      keys.forEach((k) => {
        const li = document.createElement('li');
        li.innerHTML = '<div><span class="pk-name"></span><span class="pk-meta"></span></div><button type="button" class="btn btn-ghost">Remove</button>';
        li.querySelector('.pk-name').textContent = k.label;
        const added = k.createdAt ? new Date(k.createdAt).toLocaleDateString() : '';
        li.querySelector('.pk-meta').textContent = 'added ' + added + ' · ' + (k.lastUsedAt ? 'last used ' + new Date(k.lastUsedAt).toLocaleDateString() : 'never used') + (k.backedUp ? ' · synced' : ' · this device only');
        const del = li.querySelector('button');
        del.setAttribute('aria-label', 'Remove passkey ' + k.label);
        del.addEventListener('click', async () => {
          const msg = keys.length === 1 ? 'Remove the last passkey? The password becomes the only way in again.' : 'Remove "' + k.label + '"? That device will no longer be able to sign in.';
          if (!confirm(msg)) return;
          del.disabled = true;
          await api('/api/admin-passkey?action=delete', { method: 'POST', body: { id: k.id } });
          await renderPasskeys();
        });
        list.appendChild(li);
      });
      $('pk-add').textContent = keys.length ? 'Add another device' : 'Add this device';
    }
    $('pk-add').addEventListener('click', async () => {
      const note = $('pk-note'); const btn = $('pk-add');
      note.textContent = ''; note.className = 'note';
      if (typeof window.PublicKeyCredential === 'undefined') { note.textContent = 'This browser does not support passkeys.'; note.className = 'note is-error'; return; }
      const label = prompt('Name this device (e.g. "MacBook Pro", "iPhone")', 'This device');
      if (label === null) return;
      btn.disabled = true;
      try {
        const optRes = await api('/api/admin-passkey?action=register-options');
        if (!optRes.ok) throw new Error((optRes.data && optRes.data.error) || 'Could not start adding this device.');
        const { startRegistration } = await webauthn();
        const response = await startRegistration({ optionsJSON: optRes.data });
        const verify = await api('/api/admin-passkey?action=register-verify', { method: 'POST', body: { response, label } });
        if (!verify.ok) throw new Error((verify.data && verify.data.error) || 'Could not add this device.');
        note.textContent = 'Added.'; note.className = 'note is-ok';
        await renderPasskeys();
      } catch (err) {
        const msg = err && err.name === 'NotAllowedError' ? '' : (err && err.message) || 'Could not add this device.';
        note.textContent = msg; note.className = msg ? 'note is-error' : 'note';
      } finally { btn.disabled = false; }
    });

    function showDash(instant) {
      renderPasskeys();
      $('idle-note').textContent = '';
      if (instant || gate.hidden) reveal(dash);
      else swap(gate, dash);
    }

    async function onSignedIn() {
      setHint(true);
      $('pw-input').value = '';
      if (next) { go(next); return; }
      showDash(false);
    }

    async function boot() {
      const r = await api('/api/admin-passkey?action=list');
      // Signed in only on a real JSON { ok: true } — a 200 from anything else
      // (a proxy page, a dev server serving the handler's source) is not a session.
      if (r.ok && r.data && r.data.ok === true) {
        setHint(true);
        if (next && !bouncedRecently(next)) { go(next); return; }
        if (next) {
          $('bounce-note').textContent =
            'You are signed in, but ' + next + ' did not accept the session. Try opening it again, or sign out and back in.';
          next = null;
        }
        ready();
        showDash(true);
        return;
      }
      setHint(false);
      await initGate();
      ready();
      if (params.get('reason') === 'idle') $('idle-note').textContent = 'Signed out after 1 week of inactivity.';
      reveal(gate);
    }

    $('pw-submit').addEventListener('click', async () => {
      const note = $('pw-note');
      const btn = $('pw-submit');
      note.textContent = '';
      note.className = 'note';
      btn.disabled = true;
      const r = await api('/api/admin-login', { method: 'POST', body: { password: $('pw-input').value } });
      btn.disabled = false;
      if (!r.ok) {
        note.textContent = (r.data && r.data.error) || 'Could not sign in.';
        note.className = 'note is-error';
        return;
      }
      await onSignedIn();
    });
    $('pw-input').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('pw-submit').click(); });

    $('use-password').addEventListener('click', () => {
      $('pw-field').hidden = false;
      $('pw-submit').hidden = false;
      $('use-password').hidden = true;
      $('pw-input').focus();
    });

    $('passkey-signin').addEventListener('click', async () => {
      const note = $('pw-note');
      const btn = $('passkey-signin');
      note.textContent = '';
      note.className = 'note';
      btn.disabled = true;
      try {
        const optRes = await api('/api/admin-passkey?action=auth-options');
        if (!optRes.ok) throw new Error((optRes.data && optRes.data.error) || 'Could not start sign-in.');
        const { startAuthentication } = await webauthn();
        const response = await startAuthentication({ optionsJSON: optRes.data });
        const verify = await api('/api/admin-passkey?action=auth-verify', { method: 'POST', body: { response } });
        if (!verify.ok) throw new Error((verify.data && verify.data.error) || 'Sign-in failed.');
        await onSignedIn();
      } catch (err) {
        // A cancelled Touch ID prompt throws too — reset quietly.
        const msg = err && err.name === 'NotAllowedError' ? '' : (err && err.message) || 'Sign-in failed.';
        note.textContent = msg;
        note.className = msg ? 'note is-error' : 'note';
      } finally {
        btn.disabled = false;
      }
    });

    $('signout-btn').addEventListener('click', async () => {
      const btn = $('signout-btn');
      btn.disabled = true;
      await api('/api/admin-logout', { method: 'POST' });
      setHint(false);
      $('bounce-note').textContent = '';
      // Re-ask which methods are on offer before the card shows again.
      await initGate();
      btn.disabled = false;
      swap(dash, gate);
    });

    requestAnimationFrame(() => {
      $('adm-headline').classList.add('in');
      setTimeout(() => $('adm-lede').classList.add('in'), REDUCE() ? 0 : 90);
    });
    boot();
  </script>
</BaseLayout>
