              </g>
              <path fill-rule="nonzero" fill="currentColor" d="M 144.855469 153.902344 L 142.386719 140.195312 C 139.515625 128.6875 134.015625 118.15625 125.292969 110.175781 C 118.613281 104.058594 111.019531 99.773438 102.121094 98.007812 C 87.742188 95.148438 73.355469 100.433594 64.242188 111.835938 C 52.917969 126 50.894531 142.027344 54.507812 159.515625 C 54.992188 161.863281 53.15625 164.167969 51.59375 164.550781 C 45.425781 166.070312 44.910156 156.429688 44.152344 148.941406 C 42.628906 133.828125 46.832031 118.519531 55.511719 106.109375 C 65.964844 91.160156 83.503906 83.601562 101.683594 86.957031 C 112.207031 88.894531 121.40625 93.894531 129.496094 100.992188 C 138.925781 109.269531 145.328125 120.058594 149.078125 132.113281 C 153.417969 146.050781 155.464844 160.28125 154.585938 174.863281 C 153.503906 192.777344 149.179688 209.925781 140.871094 225.703125 C 140.09375 227.183594 138.933594 227.777344 137.640625 227.949219 C 135.980469 228.164062 134.910156 227.367188 133.695312 225.890625 C 132.3125 224.203125 131.730469 221.132812 132.96875 218.8125 C 141.367188 203.035156 145.230469 185.707031 145.640625 167.855469 C 145.746094 163.164062 145.753906 158.882812 144.855469 153.902344 "/>
