---
/**
 * /admin — the studio's one front door. Sign in here (passkey first, the
 * password only when the server says it's allowed), then either land on the
 * small dashboard below or get sent straight on to ?next=.
 *
 * Replaces the sign-in gate that used to sit at the top of /send: /send now
 * bounces signed-out visitors here with ?next=/send, and the SiTime admin does
 * the same with ?next=/workflows/sitime/admin. Same endpoints and the same
 * cognak_admin session cookie as before (api/admin-login.js,
 * api/admin-passkey.js, api/admin-logout.js) — nothing server-side changed.
 *
 * "Am I signed in?" = GET /api/admin-passkey?action=list. It's the cheapest
 * admin-gated endpoint (it only reads the passkey list, which the handler
 * loads on every request anyway) and it 401s through the same requireAdmin()
 * as /api/deliver-list, the check /send uses — so the two pages can never
 * disagree about the session.
 *
 * Unlisted: noindex meta (BaseLayout), X-Robots-Tag header (vercel.json),
 * dropped from the sitemap (astro.config.mjs). Type "admin" anywhere on the
 * site to get here (public/js/cognak-global.js).
 *
 * Palette is the HOMEPAGE's: --ink-deep ground, --ink-deep-alt panels, and the
 * purple "worth noticing" settles into (#9F50FF, --cognak-purple-text on home).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

/* BaseLayout's `page` union doesn't list 'admin' yet, and its built-in inner
   nav only renders for the pages it names — so this page passes 'admin'
   through (for body[data-page="admin"], window.COGNAK_PAGE) and renders the
   same nav markup itself below, with its own .admin-nav colourway. */
const PAGE = 'admin' as any;

const TOOLS = [
  {
    href: '/send',
    tag: 'Clients',
    title: 'Send',
    desc: 'Deliver files to clients with a cognak.com link.',
  },
  {
    href: '/workflows/sitime/admin',
    tag: 'SiTime',
    title: 'Image review',
    desc: 'Choose and approve images for the new site, slot by slot.',
  },
  {
    href: '/workflows',
    tag: 'Index',
    title: 'Workflows',
    desc: 'Every custom client workflow, in one place.',
  },
];
---
<BaseLayout
  page={PAGE}
  title="Admin – COGNAK"
  description="Studio sign-in."
  ogUrl="https://cognak.com/admin/"
  noindex={true}
  pageBg="#17151A"
>
  {/* Styles go FIRST, ahead of the nav markup, so the bar paints in its own
      colourway from the first frame instead of flashing the base pale
      .inner-page-nav background (the flash schedule.astro hit, see custom.css). */}
  <style is:inline>
    html, body { background-color:#17151A !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh;
      transition:opacity var(--dur-l, .4s) var(--ease-standard); }
    /* Held back only when we already expect to redirect (valid ?next= and a
       signed-in hint), so a signed-in bounce to /send never paints this page.
       A 4s failsafe in the inline script below lifts it regardless. */
    html.admin-pending #cognak-main { opacity:0; pointer-events:none; }

    /* One soft pool of the homepage purple, top right — the hero's glow
       without its WebGL. Fixed and clipped, so it can't cause sideways scroll. */
    .adm-glow{ position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
    .adm-glow::before{ content:''; position:absolute; width:min(900px,120vw); height:min(900px,120vw);
      right:max(-420px,-40vw); top:12vh; border-radius:50%;
      background:radial-gradient(closest-side, rgba(139,31,255,.16), rgba(139,31,255,.05) 55%, rgba(139,31,255,0));
      transform:translate3d(var(--gx,0px), var(--gy,0px), 0); will-change:transform; }

    /* Homepage palette. Contrast, measured on --panel (#1C1A21):
       ink 15.05, ink-soft 7.07, accent-text 7.84, purple (#9F50FF, headline
       only — large text) 4.16 on panel / 4.37 on ground, CTA label white on
       #8B1FFF 5.62, err 9.0+. Everything body-sized clears AA. */
    .adm{
      --ground:#17151A; --panel:#1C1A21; --panel-hi:#221F28;
      --ink:#F2EEF7; --ink-soft:#A9A3B8; --line:rgba(242,238,247,.08); --line-strong:rgba(242,238,247,.22);
      --purple:#9F50FF; --purple-vivid:#8B1FFF; --purple-deep:#7A12EC; --accent-text:#C79BFF;
      --field:rgba(0,0,0,.24); --field-focus:rgba(0,0,0,.36);
      --ok:#AAFF00; --err:#FFA79A;
      max-width:1040px; margin:0 auto; padding:190px 6vw 22vh;
      color:var(--ink); font-family:'Diatype Variable', sans-serif;
    }
    @media (max-width:720px){ .adm{ padding-top:120px; padding-bottom:14vh; } }
    @media (max-width:600px){ .adm{ padding-left:24px; padding-right:24px; } }   /* the logo's left edge */
    .adm [hidden]{ display:none !important; }
    /* screen.css leftover hides every <label> sitewide; opt back in. */
    .adm label.q{ display:block !important; }

    .adm .headline{ font-size:clamp(20px,5.5vw,62px); font-weight:500; line-height:1.1;
      letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .adm .headline em{ font-style:normal; font-weight:500; color:var(--purple); }
    .adm .lede{ font-size:var(--fs-17); text-wrap:pretty; line-height:1.65; color:var(--ink-soft);
      max-width:48ch; margin:0 0 3.4rem; }
    @media (max-width:720px){ .adm .headline{ font-size:clamp(24px,7vw,42px); } .adm .lede{ margin-bottom:2.4rem; } }

    .adm .mono, .adm .group-title{ font-family:'Diatype Mono', monospace; }
    .adm .group-title{ font-size:var(--fs-11); letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); }

    /* ---- entrance: headline block rises on load, panels rise when shown -- */
    .adm .rise{ opacity:0; transform:translateY(8px);
      transition:opacity var(--dur-2xl, .7s) var(--ease-standard), transform var(--dur-2xl, .7s) var(--ease-standard); }
    .adm .rise.in{ opacity:1; transform:none; }
    .adm .rise.out{ opacity:0; transform:translateY(-8px);
      transition:opacity var(--dur-sm, .26s) var(--ease-standard), transform var(--dur-sm, .26s) var(--ease-standard); }
    @media (prefers-reduced-motion:reduce){ .adm .rise, .adm .rise.out{ opacity:1; transform:none; transition:none; } }

    /* ------------------------------------------------------------ sign in --- */
    .adm .acard{ max-width:440px; background:var(--panel); border:1px solid var(--line);
      border-radius:12px; padding:36px 34px 32px; box-shadow:0 2px 24px rgba(0,0,0,.28); }
    @media (max-width:600px){ .adm .acard{ max-width:none; padding:28px 20px 24px; } }
    /* The site's usual layout (Pierce, 9/28): headline flush left, the lede offset 40px under it
       like /workflows (flush on phones), and the card and dashboard on the same left edge. Static
       CSS, so nothing shifts after load. */
    .adm .lede{ max-width:52ch; text-wrap:pretty; margin-left:40px; }
    @media (max-width:760px){ .adm .lede{ margin-left:0; } }

    .adm .signin-head{ display:flex; flex-direction:column; align-items:center; text-align:center; margin-bottom:1.2rem; }
    .adm .signin-icon{ margin-bottom:1.1rem; }
    .adm .signin-head .group-title{ margin-bottom:1.15rem; }
    .adm .signin-sub{ font-size:var(--fs-15); line-height:1.5; color:var(--ink-soft); max-width:34ch; margin:0; }

    /* Pierce's passkey mark + ring, lifted from /send's gate and re-toned from
       its blue to the homepage purple; the masked shimmer rides on the mark itself. */
    .adm .signin-icon{ position:relative; display:inline-flex; align-items:center; justify-content:center;
      width:84px; height:84px; border-radius:999px; color:var(--accent-text);
      background:rgba(159,80,255,.12); border:1px solid rgba(159,80,255,.34); box-shadow:0 0 36px rgba(139,31,255,.22); }
    .adm .signin-icon::before{ content:''; position:absolute; inset:-1.5px; border-radius:inherit; padding:1.5px;
      background:linear-gradient(340deg,
        rgba(159,80,255,0) 0%, rgba(159,80,255,0) 30%,
        rgba(159,80,255,.18) 38%, rgba(199,155,255,.55) 44%, rgba(242,238,247,1) 50%, rgba(199,155,255,.55) 56%,
        rgba(159,80,255,.18) 62%, rgba(159,80,255,0) 70%, rgba(159,80,255,0) 100%);
      background-size:320% 320%; background-repeat:no-repeat;
      -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite:xor; mask-composite:exclude;
      animation:adm-sweep 3.4s cubic-bezier(.45,.05,.3,1) infinite; }
    /* One feathered band of light on a 340deg line (Pierce, 9/28, replacing the spinning
       conic arc): it enters from the 340deg side, crosses to the opposite side, then rests.
       Ring and mark share the timing, so both catch the light at once. */
    @keyframes adm-sweep{ 0%{ background-position:100% 100%; } 62%, 100%{ background-position:0% 0%; } }
    .adm .signin-icon-shimmer{ position:absolute; inset:0; margin:auto; width:30px; height:40.3px;
      pointer-events:none; mix-blend-mode:screen;
