  <script is:inline>
    /* ?next= validation. Runs before first paint so the page can stay
       invisible when it's about to bounce straight on. Also exposed as
       window.cognakSafeNext for the module script below.

       Only a same-origin, root-relative path is ever followed:
         - must start with exactly one "/" ("//evil.com" is protocol-relative)
         - no backslash anywhere ("/\evil.com" is read as "//evil.com")
         - no control characters (the URL parser strips tab/newline, which
           can turn "/\t/evil.com" into "//evil.com")
         - no "." / ".." segments ("/..//evil.com" normalises to "//evil.com"),
           and the normalised result is re-checked for a leading "//" anyway
         - after resolving against this origin, the origin must still match
         - never /admin itself (would just loop back here) */
    (function () {
      function safeNext(raw) {
        if (typeof raw !== 'string' || !raw || raw.length > 512) return null;
        if (raw.charAt(0) !== '/') return null;
        if (raw.charAt(1) === '/' || raw.charAt(1) === '\\') return null;
        if (/[\\\u0000-\u001F\u007F]/.test(raw)) return null;
        if (/(^|\/)\.{1,2}(\/|$)/.test(raw.split(/[?#]/)[0])) return null;
        var u;
        try { u = new URL(raw, location.origin); } catch (e) { return null; }
        if (u.origin !== location.origin) return null;
        if (/^\/admin\/?$/.test(u.pathname)) return null;
        var out = u.pathname + u.search + u.hash;
        if (out.charAt(0) !== '/' || out.charAt(1) === '/' || out.charAt(1) === '\\') return null;
        return out;
      }
      window.cognakSafeNext = safeNext;
      try {
        var next = safeNext(new URLSearchParams(location.search).get('next'));
        if (next && localStorage.getItem('cognak-admin-hint') === '1') {
          var root = document.documentElement;
          root.classList.add('admin-pending');
          setTimeout(function () { root.classList.remove('admin-pending'); }, 4000);
        }
      } catch (e) {}
    })();
  </script>

  <div class="adm-glow" aria-hidden="true"></div>
  <script is:inline>
    /* The glow leans a little toward the pointer and eases there (Pierce, 9/28: "shift slightly,
       like /studio or /schedule", which use UnicornStudio scenes). Up to ~40px, lerped; still for
       reduced motion and for touch, and idle once it has settled. */
    (function () {
      var g = document.querySelector('.adm-glow'); if (!g) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      var MAX = 40, tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      function step() {
        x += (tx - x) * 0.06; y += (ty - y) * 0.06;
        g.style.setProperty('--gx', x.toFixed(2) + 'px'); g.style.setProperty('--gy', y.toFixed(2) + 'px');
        raf = Math.abs(tx - x) > 0.05 || Math.abs(ty - y) > 0.05 ? requestAnimationFrame(step) : 0;
      }
      document.addEventListener('pointermove', function (e) {
        tx = (e.clientX / innerWidth - 0.5) * 2 * MAX; ty = (e.clientY / innerHeight - 0.5) * 2 * MAX;
        if (!raf) raf = requestAnimationFrame(step);
      }, { passive: true });
      document.addEventListener('mouseleave', function () { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(step); });
    })();
  </script>

