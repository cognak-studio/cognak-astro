    function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

    function groupsFor(key){ return [LEAD].concat(DISCIPLINES[key].groups,[tailFor(key)]); }

    function fmt(n){ return Number(n).toLocaleString('en-US'); }
    function fieldHTML(f){
      var reqDot='';
      var title=f.t?'<span class="q-title">'+reqDot+esc(f.t)+'</span>':'';
      var sub=f.q?'<span class="q-sub">'+esc(f.q)+'</span>':'';
      var hintId='h_'+f.id;
      var hint=f.hint?'<span class="hint" id="'+hintId+'">'+esc(f.hint)+'</span>':'';
      var describedBy=f.hint?' aria-describedby="'+hintId+'"':'';
      var inner='';
      /* Choice groups get real fieldset/legend semantics so screen readers
         announce the question with each option; single inputs keep label[for]. */
      var useFieldset = f.type==='single'||f.type==='multi'||f.type==='colors'||f.type==='files';
      if(f.type==='text'||f.type==='email'||f.type==='url'){
        var t=f.type==='text'?'text':f.type;
        inner='<input type="'+t+'" id="f_'+f.id+'" data-id="'+f.id+'" placeholder="'+esc(f.ph||'')+'"'+describedBy+'>';
      }else if(f.type==='textarea'){
        inner='<textarea id="f_'+f.id+'" data-id="'+f.id+'" placeholder="'+esc(f.ph||'')+'"'+describedBy+'></textarea>';
      }else if(f.type==='single'){
        inner='<div class="pills" data-id="'+f.id+'">'+f.options.map(function(o){
          return '<label class="pill"><input type="radio" name="'+f.id+'" value="'+esc(o)+'">'+esc(o)+'</label>';
        }).join('')+'</div>';
      }else if(f.type==='multi'){
        inner='<div class="chips" data-id="'+f.id+'">'+f.options.map(function(o){
          return '<label class="chip"><input type="checkbox" value="'+esc(o)+'">'+esc(o)+'</label>';
        }).join('')+'</div>';
      }else if(f.type==='urls'){
        /* One URL to start, "+ Add another link" appends more — same dialect
           as the uploader's paste-a-link row. First input stays classless so it
           reads like a normal field input; appended ones take .uplink spacing. */
        inner='<div class="urlmulti" data-id="'+f.id+'">'+
            '<div class="uplinks" data-role="links">'+
              '<input type="url" id="f_'+f.id+'" data-id="'+f.id+'" data-role="link" placeholder="'+esc(f.ph||'https://')+'"'+describedBy+'>'+
            '</div>'+
            '<button type="button" class="uplink-add" data-role="addlink">+ Add another link</button>'+
          '</div>';
      }else if(f.type==='colors'){
        inner=colorsHTML();
      }else if(f.type==='files'){
        inner=filesHTML(f);
      }else if(f.type==='range'){
        var pfx=f.prefix||'';var atmax=f.def>=f.max?'+':'';
        inner='<div class="rangewrap" data-id="'+f.id+'" data-prefix="'+pfx+'" data-max="'+f.max+'">'+
          '<div class="rangeval mono"><span class="rv">'+pfx+fmt(f.def)+atmax+'</span></div>'+
          '<input type="range" id="f_'+f.id+'" min="'+f.min+'" max="'+f.max+'" step="'+f.step+'" value="'+f.def+'"'+
            ' aria-valuetext="'+pfx+fmt(f.def)+atmax+'">'+
          '<div class="rangeends mono"><span>'+pfx+fmt(f.min)+'</span><span>'+pfx+fmt(f.max)+'+</span></div>'+
          bplusHTML(f)+
        '</div>';
      }
      var labelInner=title+sub;
      var labelHTML='';
      if(labelInner && useFieldset){
        /* legend + fieldset wrap the options; visually identical to label.q */
        inner='<fieldset class="qset"'+describedBy+'><legend class="q qset-legend">'+labelInner+'</legend>'+hint+inner+'</fieldset>';
        hint='';
      }else if(labelInner){
        labelHTML='<label class="q" for="f_'+f.id+'">'+labelInner+'</label>';
      }
      /* Optional boxes don't count toward completion %: those flagged opt, the
         "if any" URL fields, and the free-form "Anything else". */
      var isOpt = f.opt || f.type==='url' || f.type==='urls' || f.id==='anything';
      return '<div class="field" data-field="'+f.id+'"'+(f.req?' data-req="1"':'')+(isOpt?' data-opt="1"':'')+
        ' data-type="'+f.type+'">'+labelHTML+hint+inner+'</div>';
    }

    /* Budget follow-up: when the slider parks at max, ask how far north. */
    function bplusHTML(f){
      if(!f.max||f.id!=='budget') return '';
      var M=f.max,pfx=f.prefix||'';
      var opts=[pfx+fmt(M)+'–'+fmt(M*2), pfx+fmt(M*2)+'–'+fmt(M*4), pfx+fmt(M*4)+'+','Prefer to discuss'];
      return '<div class="bplus" data-role="bplus" hidden>'+
        '<span class="bplus-q">North of '+pfx+fmt(M)+' — roughly how far?</span>'+
        '<div class="bplus-chips">'+opts.map(function(o){
          return '<button type="button" class="pill bplus-opt" data-val="'+esc(o)+'">'+esc(o)+'</button>';
        }).join('')+'</div></div>';
    }

    /* Existing-materials: direct-to-Blob uploads plus paste-a-link fields
       (one to start, "+ Add another link" up to UP_MAX_LINKS). */
    var UP_MAX_FILES=5, UP_MAX_BYTES=25*1024*1024, UP_MAX_LINKS=10;
    function filesHTML(f){
      return '<div class="uploader" data-id="'+f.id+'">'+
        '<button type="button" class="updrop" data-role="drop">DROP FILES OR CLICK &mdash; PDF, ZIP, IMG &middot; 25MB &middot; '+UP_MAX_FILES+' MAX</button>'+
