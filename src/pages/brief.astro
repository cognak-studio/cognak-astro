    @keyframes btnShimmer{ to{ transform:translateX(100%); } }
    .brief .btn.is-sent{ background:var(--orange); border-color:var(--orange); box-shadow:0 0 26px rgba(var(--orange-rgb),.5); }
    .brief .btn.is-failed{ animation:btnShake var(--dur-l) var(--ease-standard) both; background:var(--err); border-color:var(--err); }
    @keyframes btnShake{ 0%,100%{transform:translateX(0)} 15%{transform:translateX(-6px)}
