       then the ghost button. The sparks are HELD until the headline has landed
       (JS adds .sparks-go) — glitter that starts before there's anything to
       celebrate reads as decoration; glitter that arrives on the word "Got it"
       reads as a reaction. */
    #sent .sent-eyebrow, #sent .lede, #sent .btn-ghost, #sent .sw{
      opacity:0; transform:translateY(9px); }
    #sent.sent-in .sent-eyebrow, #sent.sent-in .lede, #sent.sent-in .btn-ghost, #sent.sent-in .sw{
      opacity:1; transform:none;
      transition:opacity var(--dur-xl) var(--ease-standard) var(--d,0s), transform var(--dur-xl) var(--ease-out-expo) var(--d,0s); }
    #sent .sw{ display:inline-block; will-change:transform; }
    /* sparks are inert until armed */
    #sent .spark{ animation-play-state:paused; opacity:0; }
    #sent .sent-eyebrow.sparks-go .spark{ animation-play-state:running; }
    @media (prefers-reduced-motion:reduce){
      #sent .sent-eyebrow, #sent .lede, #sent .btn-ghost, #sent .sw{ opacity:1; transform:none; transition:none; }
      /* The earlier reduced-motion rule parks the sparks at opacity .85 with no
         animation. `#sent .spark` above out-specifies it (id beats class), so
         without restating the opacity here they'd stay invisible — the sent
         screen would lose its glitter entirely for reduced-motion users. */
      #sent .spark{ animation-play-state:running; opacity:.85; }
    }

