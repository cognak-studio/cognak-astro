    function selectDiscipline(key){
      state.discipline=key;state.colors=[];state.editing=-1;
      /* desktop top-bar test — see PROGTOP_FOR / .brief.progtop */
      var sec=document.querySelector('.brief');
      if(sec) sec.classList.toggle('progtop', PROGTOP_FOR==='*'||key===PROGTOP_FOR);
      state.files=[];state.budgetPlus=null;
      lastPct=0; // so the 100% swell can fire again on a second brief
      var d=DISCIPLINES[key];
      var groups=groupsFor(key);
      state.groupData=groups;
      var form=document.getElementById('briefForm');
      form.innerHTML=groups.map(function(g){
        var desc=g.desc?'<p class="group-desc">'+esc(g.desc)+'</p>':'';
        return '<div class="group"><div class="group-title">'+esc(g.title)+'</div>'+desc+
          g.fields.map(fieldHTML).join('')+'</div>';
      }).join('');
      document.getElementById('form-headline').textContent=d.headline;
      /* Reset the Sent screen so a second brief in the same session replays its
         entrance instead of appearing already-arrived. */
      var sentEl=document.getElementById('sent');
      sentEl.style.display='none';
      sentEl.classList.remove('sent-in');
      var eb=sentEl.querySelector('.sent-eyebrow');
      if(eb) eb.classList.remove('sparks-go');
      wireForm();
      showForm();
    }

    function reduceMotion(){ return window.matchMedia('(prefers-reduced-motion: reduce)').matches; }
    function afterFormShown(){ window.scrollTo(0,0); refreshScroll(); positionRail(); clampRail(); positionBarM(); updateProgress(); }

    /* Crossfade the picker out, then rise the questionnaire's header + groups in,
       staggered top-to-bottom. Instant for prefers-reduced-motion. */
    function showForm(){
      var pick=document.getElementById('step-pick');
      var wrap=document.getElementById('formwrap');
      /* Push a history entry so the browser Back button returns to the picker
         instead of leaving /brief. */
      try{ history.pushState({briefStep:'form'}, ''); }catch(e){}
      document.body.classList.add('brief-form-open');
      if(reduceMotion()){
        pick.style.display='none'; wrap.style.display='block'; afterFormShown(); return;
      }
      pick.classList.add('step-hide');
      setTimeout(function(){
        pick.style.display='none'; pick.classList.remove('step-hide');
        wrap.style.display='block';
        var items=wrap.querySelectorAll('.backlink, .form-headline, .stepmeta, .group');
        items.forEach(function(el,i){
          el.style.opacity='0'; el.style.transform='translateY(10px)';
          var dl=(i*0.06).toFixed(2)+'s';
          el.style.transition='opacity var(--dur-xl) var(--ease-standard) '+dl+', transform var(--dur-xl) var(--ease-standard) '+dl;
        });
        afterFormShown();
        requestAnimationFrame(function(){ requestAnimationFrame(function(){
          items.forEach(function(el){ el.style.opacity='1'; el.style.transform='none'; });
        }); });
        setTimeout(function(){ items.forEach(function(el){ el.style.transition=''; el.style.transform=''; el.style.opacity=''; }); }, 1100);
      }, 260);
    }

    /* The form is injected after load, so Lenis' cached scroll limit is stale
       and the page won't scroll. Re-measure it (and nudge a resize) once the
       new content is laid out. */
    function refreshScroll(){
      window.scrollTo(0,0);
      requestAnimationFrame(function(){
        try{ if(window._lenis){ if(window._lenis.resize) window._lenis.resize();
          if(window._lenis.scrollTo) window._lenis.scrollTo(0,{immediate:true,force:true}); } }catch(e){}
        window.dispatchEvent(new Event('resize'));
        window.scrollTo(0,0);
      });
    }

    function clearInvalid(fld){
      if(!fld) return;
      fld.classList.remove('invalid');
      fld.querySelectorAll('[aria-invalid]').forEach(function(el){ el.removeAttribute('aria-invalid'); });
    }

    function wireForm(){
      var form=document.getElementById('briefForm');
      form.querySelectorAll('.pills').forEach(function(box){
        box.querySelectorAll('.pill').forEach(function(pill){
          pill.addEventListener('click',function(){
            box.querySelectorAll('.pill').forEach(function(p){p.classList.remove('on');});
            pill.classList.add('on');pill.querySelector('input').checked=true;
            clearInvalid(pill.closest('.field'));updateProgress();
          });
        });
      });
      form.querySelectorAll('.chip').forEach(function(chip){
        chip.addEventListener('click',function(e){
          e.preventDefault();
          var inp=chip.querySelector('input');inp.checked=!inp.checked;
          chip.classList.toggle('on',inp.checked);
          clearInvalid(chip.closest('.field'));updateProgress();
        });
      });
      var cp=form.querySelector('.colorpick');
      if(cp){ initColors(cp); }
      form.querySelectorAll('input,textarea').forEach(function(el){
        el.addEventListener('input',function(){
          var fld=el.closest('.field');
          if(fld){ clearInvalid(fld); if(el.type==='range') fld.setAttribute('data-touched','1'); }
          updateProgress();
        });
      });
      form.querySelectorAll('input[type=range]').forEach(function(r){
        setRangeFill(r);
        r.addEventListener('input',function(){
          var wrap=r.closest('.rangewrap');if(!wrap)return;var rv=wrap.querySelector('.rv');
          var pfx=wrap.getAttribute('data-prefix')||'';var mx=+wrap.getAttribute('data-max');var v=+r.value;
          rv.textContent=pfx+fmt(v)+(v>=mx?'+':'');
          r.setAttribute('aria-valuetext',rv.textContent);
          setRangeFill(r);
          /* at the ceiling? ask how far north */
          var bp=wrap.querySelector('[data-role="bplus"]');
          if(bp){
            var atMax=v>=mx;
            if(bp.hidden===atMax){ bp.hidden=!atMax; }
            if(!atMax && state.budgetPlus){
              state.budgetPlus=null;
              bp.querySelectorAll('.bplus-opt').forEach(function(b){b.classList.remove('on');});
            }
          }
        });
      });
      form.querySelectorAll('.bplus-opt').forEach(function(b){
        b.addEventListener('click',function(){
          var on=!b.classList.contains('on');
          b.closest('.bplus-chips').querySelectorAll('.bplus-opt').forEach(function(x){x.classList.remove('on');});
          if(on){ b.classList.add('on'); state.budgetPlus=b.getAttribute('data-val'); }
          else state.budgetPlus=null;
          updateProgress();
        });
      });
      var up=form.querySelector('.uploader');
      if(up){ initUploader(up); }
      form.querySelectorAll('.urlmulti').forEach(function(um){ initUrlMulti(um); });
    }

    /* ---- multi-URL fields (Design link): "+ Add another link", capped like
       the uploader's paste-a-link row. Dynamically added inputs miss wireForm's
       generic listener, so clearInvalid/updateProgress are wired here. ---- */
    function initUrlMulti(um){
      var linksBox=um.querySelector('[data-role="links"]');
      var addLink=um.querySelector('[data-role="addlink"]');
      if(!addLink||!linksBox) return;
      addLink.addEventListener('click',function(){
        if(linksBox.querySelectorAll('[data-role="link"]').length>=UP_MAX_LINKS) return;
        var inp=document.createElement('input');
        inp.type='url';inp.className='uplink';inp.setAttribute('data-role','link');
        inp.placeholder='…another link';
        inp.setAttribute('aria-label','Additional design link');
        inp.addEventListener('input',function(){
          var fld=inp.closest('.field');if(fld)clearInvalid(fld);updateProgress();
        });
        linksBox.appendChild(inp);
        inp.focus();
        addLink.hidden = linksBox.querySelectorAll('[data-role="link"]').length>=UP_MAX_LINKS;
      });
    }

    /* ---- existing-materials uploader (Vercel Blob client uploads) ---- */
    function humanSize(b){ return b>=1048576?(b/1048576).toFixed(1)+' MB':Math.max(1,Math.round(b/1024))+' KB'; }
    /* A stalled upload must never spin forever. If any leg (client import, the
       /api/upload token handshake, or the PUT to Blob) hasn't settled by this
       cap, we reject with a readable reason so the row flips to FAILED and the
       paste-a-link fallback is right there. */
    var UP_TIMEOUT_MS=60000;
    var _blobClient=null;                 // cache the on-demand client import
    function blobClient(){
      if(!_blobClient){
        _blobClient=import('https://esm.sh/@vercel/blob@1/client').catch(function(e){
          _blobClient=null;               // let the next attempt retry the import
          throw new Error('Uploader could not load. Check your connection and retry.');
        });
      }
      return _blobClient;
    }
    function withTimeout(promise,ms,label){
      return new Promise(function(resolve,reject){
        var to=setTimeout(function(){ reject(new Error(label||'Timed out')); }, ms);
        promise.then(function(v){ clearTimeout(to); resolve(v); },
                     function(e){ clearTimeout(to); reject(e); });
      });
    }
    function blobUpload(file, onProgress){
      /* official client, loaded on demand so the page pays nothing until used */
      return blobClient().then(function(m){
        return withTimeout(
          m.upload('briefs/'+file.name, file, {
            access:'public', handleUploadUrl:'/api/upload',
            onUploadProgress:function(p){ try{ if(onProgress) onProgress(p&&typeof p.percentage==='number'?p.percentage:0); }catch(e){} }
          }),
          UP_TIMEOUT_MS, 'Upload timed out. Paste a link instead.'
        );
      });
    }
    function initUploader(up){
      var drop=up.querySelector('[data-role="drop"]');
      var input=up.querySelector('[data-role="fileinput"]');
      var list=up.querySelector('[data-role="list"]');
      /* "+ Add another link": append a fresh link input (up to UP_MAX_LINKS).
         Dynamically added inputs miss wireForm's generic listener, so wire the
         clearInvalid/updateProgress behavior here. */
      var linksBox=up.querySelector('[data-role="links"]');
      var addLink=up.querySelector('[data-role="addlink"]');
      if(addLink&&linksBox){
        addLink.addEventListener('click',function(){
          if(linksBox.querySelectorAll('[data-role="link"]').length>=UP_MAX_LINKS) return;
          var inp=document.createElement('input');
          inp.type='url';inp.className='uplink';inp.setAttribute('data-role','link');
          inp.placeholder='…another link';
          inp.setAttribute('aria-label','Additional link to existing materials');
          inp.addEventListener('input',function(){
            var fld=inp.closest('.field');if(fld)clearInvalid(fld);updateProgress();
          });
          linksBox.appendChild(inp);
          inp.focus();
          addLink.hidden = linksBox.querySelectorAll('[data-role="link"]').length>=UP_MAX_LINKS;
        });
      }
      function render(){
        list.innerHTML='';
        state.files.forEach(function(f,i){
          var li=document.createElement('li');
          li.className='upfile'+(f.status==='error'?' err':'')+(f.status==='done'?' done':'');
          li.innerHTML='<span class="uf-fill" aria-hidden="true"></span>'+
            '<span class="ufname"></span><span class="ufmeta mono"></span>'+
            '<button type="button" class="ufx" aria-label="Remove file">&times;</button>';
          li.querySelector('.ufname').textContent=f.name;
          li.querySelector('.ufx').addEventListener('click',function(){ state.files.splice(i,1); render(); });
          f._el=li;
          list.appendChild(li);
          paintRow(f);
        });
        drop.hidden = state.files.length>=UP_MAX_FILES;
      }
      /* Update one row's orange fill + label without a full re-render, so the
         bar animates smoothly on each progress tick. Text flips to dark ink as
         the fill reaches each side (keeps AA on the orange). */
      function paintRow(f){
        var li=f._el; if(!li) return;
        var pct=f.status==='done'?100:(f.status==='error'?0:(typeof f.pct==='number'?f.pct:0));
        var fill=li.querySelector('.uf-fill'); if(fill) fill.style.width=pct+'%';
        li.classList.toggle('done', f.status==='done');
        li.classList.toggle('name-lit', f.status==='done'||pct>=22);
        li.classList.toggle('meta-lit', f.status==='done'||pct>=90);
        var meta=li.querySelector('.ufmeta');
        if(meta){
          meta.textContent = f.status==='uploading' ? (pct>0?Math.round(pct)+'%':'UPLOADING…')
            : (f.status==='error' ? (f.reason||'FAILED — REMOVE & RETRY') : humanSize(f.size));
        }
      }
      function addFiles(files){
        Array.prototype.slice.call(files).forEach(function(file){
          if(state.files.length>=UP_MAX_FILES) return;
          if(file.size>UP_MAX_BYTES){
            state.files.push({name:file.name,size:file.size,url:null,status:'error',reason:'OVER 25MB'});
            render(); return;
          }
          var entry={name:file.name,size:file.size,url:null,status:'uploading',pct:0};
          state.files.push(entry); render();
          blobUpload(file,function(pct){ entry.pct=pct; paintRow(entry); }).then(function(blob){
            entry.url=blob.url; entry.status='done'; entry.pct=100; render();
          }).catch(function(err){
            entry.status='error'; entry.pct=0;
            var msg=(err&&err.message)?String(err.message):'Upload failed';
            entry.reason=msg.slice(0,64);
            console.error('[brief upload] '+file.name, err);
            render();
          });
        });
        input.value='';
      }
      drop.addEventListener('click',function(){ input.click(); });
      input.addEventListener('change',function(){ addFiles(input.files); });
      ['dragenter','dragover'].forEach(function(ev){
        drop.addEventListener(ev,function(e){ e.preventDefault(); drop.classList.add('drag'); });
      });
      ['dragleave','drop'].forEach(function(ev){
        drop.addEventListener(ev,function(e){ e.preventDefault(); drop.classList.remove('drag'); });
      });
      drop.addEventListener('drop',function(e){
        if(e.dataTransfer&&e.dataTransfer.files) addFiles(e.dataTransfer.files);
      });
    }

    /* Accumulate pattern: state.colors holds only real hex values; a transient
       null is pushed while the editor is open for a brand-new swatch and pruned
       on close if never picked. No empty numbered boxes are ever rendered. */
    function initColors(cp){
      buildSlots(cp);
      cp.querySelector('[data-role="add"]').addEventListener('click',function(){
        if(state.colors.filter(Boolean).length>=5)return;
        state.colors.push(null);
        openEditor(cp,state.colors.length-1);
      });
    }
    function buildSlots(cp){
      var wrap=cp.querySelector('[data-role="slots"]');
      wrap.innerHTML='';
      state.colors.forEach(function(c,i){
        if(!c) return;                       // pending (never-picked) entry renders nothing
        var slot=document.createElement('div');
        slot.className='cslot filled'+(state.editing===i?' editing':'');
        slot.setAttribute('data-slot',i);slot.setAttribute('tabindex','0');
        slot.setAttribute('role','button');slot.setAttribute('aria-label','Edit color '+c);
        slot.innerHTML='<span class="cslot-face" style="background:'+c+'"></span>'+
          '<span class="cslot-hex mono">'+c+'</span>'+
          '<button type="button" class="cslot-clear" aria-label="Remove color '+c+'">&times;</button>';
        slot.addEventListener('click',function(e){
          if(e.target.classList.contains('cslot-clear'))return;
          openEditor(cp,i);
        });
        slot.addEventListener('keydown',function(e){
          if(e.key==='Enter'||e.key===' '){e.preventDefault();openEditor(cp,i);}
        });
        slot.querySelector('.cslot-clear').addEventListener('click',function(e){
          e.preventDefault();e.stopPropagation();
          state.colors.splice(i,1);buildSlots(cp);updateProgress();
        });
        wrap.appendChild(slot);
      });
      var add=cp.querySelector('[data-role="add"]');
      if(add) add.hidden = state.colors.filter(Boolean).length>=5;
    }
    function openEditor(cp,i){
      state.editing=i;
      var has=state.colors[i];              // color already chosen for this slot, if any
      var val=has||DEFAULT_HEX;             // seed value for the OS picker only
      var modal=document.getElementById('ceModal');
      var ed=modal.querySelector('[data-role="edit"]');
      ed.innerHTML='<div class="ce-inner">'+
        '<span class="ce-label mono">Color 0'+(i+1)+'</span>'+
        '<span class="ce-swatch" title="Click to open the color picker">'+
          '<span class="ce-fill" style="background:'+(has||'transparent')+'"></span>'+
          '<input type="color" class="ce-native" value="'+val+'">'+
          '<span class="ce-badge" aria-hidden="true">'+PENCIL_SVG+'</span>'+
        '</span>'+
        '<span class="ce-hint mono">Click to pick</span>'+
        '<span class="ce-hashwrap"># <input type="text" class="ce-hex" maxlength="6" spellcheck="false" value="'+(has?has.replace('#','').toUpperCase():'')+'"></span>'+
        '<button type="button" class="ce-done">Done</button></div>';
      modal.hidden=false; modal.setAttribute('aria-hidden','false');
      /* focus management: remember the opener, move focus in, trap Tab */
      state.lastFocus=document.activeElement;
      try{ if(window._lenis && window._lenis.stop) window._lenis.stop(); }catch(e){}
      var native=ed.querySelector('.ce-native');
      var hex=ed.querySelector('.ce-hex');
      setTimeout(function(){ if(hex) hex.focus(); },0);
      modal.addEventListener('keydown',function trap(e){
        if(modal.hidden){ modal.removeEventListener('keydown',trap); return; }
        if(e.key!=='Tab') return;
        var focusables=modal.querySelectorAll('input,button');
        if(!focusables.length) return;
        var f=focusables[0],l=focusables[focusables.length-1];
        if(e.shiftKey&&document.activeElement===f){ e.preventDefault(); l.focus(); }
        else if(!e.shiftKey&&document.activeElement===l){ e.preventDefault(); f.focus(); }
      });
      var fill=ed.querySelector('.ce-fill');
      native.addEventListener('input',function(){
        var v=native.value.toUpperCase();state.colors[i]=v;hex.value=v.replace('#','');fill.style.background=v;
        buildSlots(cp);updateProgress();
      });
      hex.addEventListener('input',function(){
        var raw=hex.value.replace(/[^0-9a-fA-F]/g,'').toUpperCase();
        if(raw!==hex.value)hex.value=raw;
        var norm=null;
        if(raw.length===6)norm='#'+raw;
        else if(raw.length===3)norm='#'+raw[0]+raw[0]+raw[1]+raw[1]+raw[2]+raw[2];
        if(norm){state.colors[i]=norm;native.value=norm;fill.style.background=norm;buildSlots(cp);updateProgress();}
      });
      ed.querySelector('.ce-done').addEventListener('click',function(){closeEditor(cp);});
      buildSlots(cp);
    }
    function closeEditor(cp){
      state.editing=-1;
      state.colors=state.colors.filter(Boolean);   // drop a swatch opened but never picked
      var modal=document.getElementById('ceModal');
      if(modal){ modal.hidden=true; modal.setAttribute('aria-hidden','true'); var ed=modal.querySelector('[data-role="edit"]'); if(ed) ed.innerHTML=''; }
      try{ if(window._lenis && window._lenis.start) window._lenis.start(); }catch(e){}
      if(state.lastFocus&&state.lastFocus.focus){ try{ state.lastFocus.focus(); }catch(e){} state.lastFocus=null; }
      if(cp) buildSlots(cp);
    }

    function setRangeFill(r){
      var min=+r.min, max=+r.max, v=+r.value;
      var pct=max>min?((v-min)/(max-min))*100:0;
      r.style.background='linear-gradient(90deg, var(--orange) 0%, var(--orange) '+pct+'%, var(--track) '+pct+'%, var(--track) 100%)';
    }

    /* Sit the rail just left of the text column, responsive to its margin/padding. */
    function positionRail(){
      var rail=document.getElementById('progRail'); var brief=document.querySelector('.brief');
      if(!rail||!brief) return;
      var cs=getComputedStyle(brief);
      var left=brief.getBoundingClientRect().left + parseFloat(cs.paddingLeft||'0');
      /* center the rail in the gutter between the viewport edge and the text
         column's left edge (rail is 2px wide, so -1 to true-center). */
      rail.style.left=Math.max(6, (left/2) - 1) + 'px';
    }

    /* Keep the fixed rail within the form's vertical bounds so it can never sit
       past the bottom of the form (below the Send button) when scrolled. It stays
       viewport-centered until the form's top/bottom would clip it, then clamps. */
    function clampRail(){
      var rail=document.getElementById('progRail');
      var wrap=document.getElementById('formwrap');
      if(!rail||!wrap||wrap.style.display==='none') return;
      var r=wrap.getBoundingClientRect();
      var vh=window.innerHeight||document.documentElement.clientHeight;
      var railH=rail.offsetHeight||0;
      var top=(vh-railH)/2;
      var minTop=r.top+8, maxTop=r.bottom-railH-8;
      top=(maxTop<=minTop) ? (r.top+(r.height-railH)/2) : Math.min(Math.max(top,minTop),maxTop);
      rail.style.top=Math.round(top)+'px';
      rail.style.transform='none';
    }

    /* Float the mobile bar a little below the fixed nav, whatever height the
       nav lands at on this viewport. */
    function positionBarM(){
      var bar=document.getElementById('progBarM');
      if(!bar) return;
      var nav=document.querySelector('.home-bottom-bar.inner-page-nav');
      if(nav) bar.style.top=(Math.round(nav.getBoundingClientRect().height)+14)+'px';
      /* Desktop top-bar test: pull the bar in to the form column. .brief is
         offset by margin-left:clamp(48px,10vw,180px) and padded 6vw at
         >=960px, so the stylesheet's 6vw gutters would leave it floating wide
         of the questions it's measuring. Measured rather than duplicated in
         CSS so the two can't drift. Cleared below 960 (and off-test) so the
         stylesheet takes back over. */
      var sec=document.querySelector('.brief');
      var vw=document.documentElement.clientWidth;
      if(sec && sec.classList.contains('progtop') && vw>=960){
        var r=sec.getBoundingClientRect(), cs=getComputedStyle(sec);
        var padL=parseFloat(cs.paddingLeft)||0, padR=parseFloat(cs.paddingRight)||0;
        bar.style.left=Math.round(r.left+padL)+'px';
        bar.style.right=Math.round(vw-(r.right-padR))+'px';
      }else{
        bar.style.left=''; bar.style.right='';
      }
    }

    function updateProgress(){
      var form=document.getElementById('briefForm');if(!form)return;
      /* Every field except the optional ones (data-opt) counts toward completion.
         The budget range ships with a default, so it only counts once the visitor
         has actually moved it (data-touched). */
      var fields=form.querySelectorAll('.field:not([data-opt="1"])');var filled=0;
      fields.forEach(function(fld){
        var done=(fld.getAttribute('data-type')==='range')?(fld.getAttribute('data-touched')==='1'):!!fieldValue(fld);
        if(done)filled++;
      });
      var pct=fields.length?Math.round(filled/fields.length*100):0;
      /* Shared fill treatment: cream at the start, the growing end shifting
         cream -> orange as the brief nears complete; the completed segment
         glows, brighter as it fills. */
      var t=pct/100;
      var r=Math.round(237+(239-237)*t), g=Math.round(224+(145-224)*t), b=Math.round(200+(70-200)*t);
      var end='rgb('+r+','+g+','+b+')';
      var glow='0 0 8px 1px rgba(var(--orange-rgb),'+(0.25+0.5*t).toFixed(2)+')';
      var fill=document.getElementById('progFill');
      if(fill){
        /* Desktop rail: a filled line down from the top. */
        fill.style.height='max(6px,'+pct+'%)';
        fill.style.background='linear-gradient(180deg, var(--rail-cream) 0%, '+end+' 100%)';
        fill.style.boxShadow=glow;
      }
      var fillM=document.getElementById('progFillM');
      if(fillM){
        /* Mobile bar: the same fill sweeping left -> right. */
        fillM.style.width='max(6px,'+pct+'%)';
        fillM.style.background='linear-gradient(90deg, var(--rail-cream) 0%, '+end+' 100%)';
        fillM.style.boxShadow=glow;
      }

      /* ---- the 100% moment ----
         Reaching complete used to be silent: the fill just stopped growing.
         Now the rail swells once and the bottom end-cap tints orange, so the
         thing that has been tracking you all the way down finally answers.
         Fired on the TRANSITION to 100 only (lastPct guard) — updateProgress
         runs on every keystroke, and a glow that re-swells each time you touch
         an already-complete form is noise, not a reward. */
      var wasComplete=lastPct>=100, isComplete=pct>=100;
      [document.getElementById('progRail'), document.getElementById('progBarM')].forEach(function(el){
        if(!el) return;
        el.classList.toggle('is-complete', isComplete);
        if(isComplete && !wasComplete){
          el.classList.remove('just-complete');
          void el.offsetWidth;            // restart the animation
          el.classList.add('just-complete');
        }
        if(!isComplete) el.classList.remove('just-complete');
      });
      lastPct=pct;

      updateStepMeta(pct);
      renderRailNotes(form);
    }
    var lastPct=0;

    /* ---- .stepmeta ----
       Styled in custom CSS and already named in showForm()'s entrance stagger,
       but nothing ever rendered it. It reads "02 / BRANDING — ~4 MIN LEFT",
       which is the point: the picker promises a duration per discipline and the
       rail tracks completion, but nothing connected the two. The minutes here
       are that promise counted DOWN against real progress, so the rail stops
       being an abstract percentage. At 100% it stops estimating and says so. */
    function updateStepMeta(pct){
      var el=document.getElementById('stepMeta');
      if(!el||!state.discipline) return;
      var idx=0, mins=0;
      PICKER_META.forEach(function(m,i){
        if(m[0]===state.discipline){ idx=i+1; mins=parseInt(m[2],10)||0; }
      });
      var label=(DISCIPLINES[state.discipline]||{}).label||state.discipline;
      var head='0'+idx+' / '+String(label).toUpperCase();
      if(pct>=100){ el.textContent=head+' — READY TO SEND'; return; }
      var left=Math.max(1, Math.ceil(mins*(1-pct/100)));
      el.textContent=head+' — ~'+left+' MIN LEFT';
    }

    /* ---- rail receipt: a section name materializes beside the rail when
       every counted field in that section is complete ---- */
    var RAIL_SHORT={'Your details':'DETAILS','The brand':'BRAND','Feel & direction':'FEEL',
      'Versions':'VERSIONS','Timeline & budget':'CLOSE','The product':'PRODUCT','Format & specs':'FORMATS',
      'Practical':'PRACTICAL','The site':'SITE','Scope & content':'SCOPE','Look & feel':'FEEL',
      'Build':'BUILD','The build':'BUILD','Functionality':'FUNCTION'};
    function shortTitle(t){ return RAIL_SHORT[t]||String(t).split(' ')[0].toUpperCase(); }
    function renderRailNotes(form){
      var rail=document.getElementById('progRail');
      var track=document.querySelector('#progBarM .progbar-m-track');
      if(!rail&&!track)return;
      var gd=state.groupData||[];
      /* Build once per discipline, then only the .on toggles run per keystroke.
         `pos` is the CSS property the notes are laid out on: `top` down the
         rail, `left` across the bar — same midpoint-of-section math either way.
         The bar's copies are always built; CSS keeps them hidden unless the
         page is in the desktop top-bar test. */
      [[rail,'rail-note','top'],[track,'bar-note','left']].forEach(function(cfg){
        var host=cfg[0], cls=cfg[1], pos=cfg[2];
        if(!host||host.getAttribute('data-notes-for')===state.discipline) return;
        host.querySelectorAll('.'+cls).forEach(function(n){n.remove();});
        gd.forEach(function(g,i){
          var n=document.createElement('span');
          n.className=cls;
          n.style[pos]=(((i+0.5)/gd.length)*100)+'%';
          n.textContent=shortTitle(g.title)+' ✓';
          host.appendChild(n);
        });
        host.setAttribute('data-notes-for',state.discipline||'');
      });
      var notes=rail?rail.querySelectorAll('.rail-note'):[];
      var bnotes=track?track.querySelectorAll('.bar-note'):[];
      form.querySelectorAll('.group').forEach(function(gEl,i){
        var req=gEl.querySelectorAll('.field:not([data-opt="1"])');
        var done=req.length>0;
        req.forEach(function(fld){
          var ok=(fld.getAttribute('data-type')==='range')?(fld.getAttribute('data-touched')==='1'):!!fieldValue(fld);
          if(!ok)done=false;
        });
        if(notes[i])notes[i].classList.toggle('on',done);
        if(bnotes[i])bnotes[i].classList.toggle('on',done);
      });
    }

    function fieldValue(fld){
      var type=fld.getAttribute('data-type');
      if(type==='colors'){var v=state.colors.filter(Boolean);return v.length?v.join(', '):'';}
      if(type==='files'){
        var parts=state.files.filter(function(f){return f.status==='done'&&f.url;})
          .map(function(f){return f.name+': '+f.url;});
        fld.querySelectorAll('[data-role="link"]').forEach(function(link){
          if(link.value.trim())parts.push('Link: '+link.value.trim());
        });
        return parts.join('\n  ');
      }
      if(type==='urls'){
        var uv=[];fld.querySelectorAll('[data-role="link"]').forEach(function(l){var s=l.value.trim();if(s)uv.push(s);});
        return uv.join('\n  ');
      }
      if(type==='range'){var wrap=fld.querySelector('.rangewrap');var r=fld.querySelector('input[type=range]');if(!r||!wrap)return '';var pfx=wrap.getAttribute('data-prefix')||'';var mx=+wrap.getAttribute('data-max');var v=+r.value;var out=pfx+fmt(v)+(v>=mx?'+':'');if(v>=mx&&state.budgetPlus)out+=' ('+state.budgetPlus+')';return out;}
      if(type==='single'){var c=fld.querySelector('input:checked');return c?c.value:'';}
      if(type==='multi'){var v=[];fld.querySelectorAll('input:checked').forEach(function(i){v.push(i.value);});return v.join(', ');}
      var el=fld.querySelector('input,textarea');return el?el.value.trim():'';
    }

    function buildBrief(){
      var d=DISCIPLINES[state.discipline];
      var form=document.getElementById('briefForm');
      var groups=form.querySelectorAll('.group');
      var groupData=groupsFor(state.discipline);
      var lines=[];
      lines.push('COGNAK PROJECT BRIEF');
      lines.push('Discipline: '+d.label);
      lines.push('');
      groups.forEach(function(gEl,gi){
        var g=groupData[gi];var section=[];
        g.fields.forEach(function(f){
          var fld=gEl.querySelector('[data-field="'+f.id+'"]');
          var val=fld?fieldValue(fld):'';
          if(val){section.push((f.t||f.q||f.elabel||f.id)+'\n  '+val);}
        });
        if(section.length){
          lines.push('-- '+g.title.toUpperCase()+' --');
          lines.push(section.join('\n\n'));
          lines.push('');
        }
      });
      return lines.join('\n');
    }

    function validate(){
      var form=document.getElementById('briefForm');var ok=true;var first=null;
      form.querySelectorAll('.field[data-req="1"]').forEach(function(fld){
        if(!fieldValue(fld)){
          ok=false;fld.classList.add('invalid');
          fld.querySelectorAll('input,textarea').forEach(function(el){ el.setAttribute('aria-invalid','true'); });
          if(!first)first=fld;
        }
      });
      if(first)first.scrollIntoView({behavior:'smooth',block:'center'});
      return ok;
    }

    document.getElementById('sendBtn').addEventListener('click',function(){
      var errEl=document.getElementById('formErr');
      if(state.files.some(function(f){return f.status==='uploading';})){
        errEl.textContent='Your files are still uploading. One moment.';errEl.style.display='block';return;
      }
      if(!validate()){errEl.textContent='Please fill in the required fields.';errEl.style.display='block';return;}
      errEl.style.display='none';
      var d=DISCIPLINES[state.discipline];
      var who=firstFilled(['brand_name','product_name','company','your_name'])||'New';
      var email=firstFilled(['your_email'])||'';
      var body=buildBrief();
      var files=state.files.filter(function(f){return f.status==='done'&&f.url;})
        .map(function(f){return {name:f.name,url:f.url,size:f.size};});
      /* ---- submit state machine ----
         arrow slides away -> shimmer while in flight -> a "Submitted ✓" beat that
         lands BEFORE the screen changes -> shake + red on failure. The beat
         matters: without it the button and the whole screen change in the same
         frame, so the click never gets acknowledged on its own terms. */
      var btn=document.getElementById('sendBtn');
      var labelEl=btn.querySelector('.btn-label');
      var label=labelEl?labelEl.textContent:btn.textContent;
      btn.disabled=true;
      btn.classList.remove('is-failed','is-sent');
      btn.classList.add('is-sending');
      if(labelEl) labelEl.textContent='Submitting…';
      fetch('/api/brief',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({discipline:d.label,who:who,email:email,text:body,files:files})})
        .then(function(r){if(!r.ok)throw new Error('send failed');return r.json();})
        .then(function(){
          btn.classList.remove('is-sending');
          btn.classList.add('is-sent');
          if(labelEl) labelEl.textContent='Submitted ✓';
          /* ---- conversion tracking ----
             This fires once, right here, only after /api/brief has confirmed
             the email actually sent — not on the "Start a project" click that
             lands someone on this page (BaseLayout.astro logs that separately
             as the non-conversion event click_start_project) and not on form
             interaction. Before 2026-07 "Start a project" was a mailto: link,
             so BaseLayout's sitewide handler counted every click as a
             conversion (AW-876403750/KaY9CKLGmLwcEKa486ED, the account's
             "Contacts" goal). Once the button became a link to /brief that
             stopped firing anything — the click no longer matched the mailto
             check, and nothing on this page replaced it. Reusing the same
             conversion action here is deliberate (same "Contacts" goal,
             same lead intent) and it's actually a tighter signal than the
             old mailto click ever was: that only proved someone opened a
             compose window, this proves the brief was delivered. */
          if(typeof gtag==='function'){
            gtag('event','brief_submitted',{'event_category':'Contact','event_label':d.label});
            gtag('event','conversion',{'send_to':'AW-876403750/KaY9CKLGmLwcEKa486ED'});
          }
          var beat=reduceMotion()?0:300;
          setTimeout(function(){
            showSent();
            /* Reset the button underneath, so a Back to the form (or "Start
               another brief") never finds it stuck in the sent state. */
            btn.classList.remove('is-sent');
            btn.disabled=false;
            if(labelEl) labelEl.textContent=label;
          }, beat);
        })
        .catch(function(){
          errEl.textContent='Something went wrong sending your brief. Please try again, or email us directly at pierce@cognak.com.';
          errEl.style.display='block';
          btn.classList.remove('is-sending');
          btn.classList.add('is-failed');
          btn.disabled=false;
          if(labelEl) labelEl.textContent=label;
          setTimeout(function(){ btn.classList.remove('is-failed'); }, 900);
        });
    });
    function firstFilled(ids){
      var form=document.getElementById('briefForm');
      for(var i=0;i<ids.length;i++){var fld=form.querySelector('[data-field="'+ids[i]+'"]');
        if(fld){var v=fieldValue(fld);if(v)return v;}}
      return '';
    }
    /* Wrap each word of an element in <span class="sw"> so the headline can be
       staggered word by word. Walks child nodes rather than touching innerHTML,
       so the <em>Got it</em> accent survives — its words get wrapped in place,
       inside the em, and keep the orange. */
    /* Named distinctly from cognak-global.js's own splitWords (that one is
       IIFE-scoped and uses .stagger-word; this one is page-scope and uses .sw). */
    function splitSentWords(el){
      if(el.getAttribute('data-split')==='1') return;
      (function walk(node){
        Array.prototype.slice.call(node.childNodes).forEach(function(n){
          if(n.nodeType===3){
            var parts=n.nodeValue.split(/(\s+)/);
            if(!parts.length) return;
            var frag=document.createDocumentFragment();
            parts.forEach(function(p){
              if(!p) return;
              if(/^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); return; }
              var s=document.createElement('span');
              s.className='sw'; s.textContent=p;
              frag.appendChild(s);
            });
            node.replaceChild(frag,n);
          } else if(n.nodeType===1 && !n.classList.contains('sw') && !n.classList.contains('sparkles')){
            walk(n);
          }
        });
      })(el);
      el.setAttribute('data-split','1');
    }

    /* ---- the Sent screen ----
       Was `display:none` -> `display:block`, i.e. the one step in the funnel with
       no transition, at the exact moment the visitor most deserves one. Now the
       form crossfades out first (reusing .step-hide, same 260ms as every other
       step change on this page), then Sent rises in parts: eyebrow, headline
       word by word, lede, ghost button. Sparks are armed only once the headline
       has landed. */
    function showSent(){
      var wrap=document.getElementById('formwrap');
      var sent=document.getElementById('sent');
      var eyebrow=sent.querySelector('.sent-eyebrow');
      var head=sent.querySelector('.headline');

      if(reduceMotion()){
        wrap.style.display='none';
        sent.style.display='block'; sent.classList.add('sent-in');
        if(eyebrow) eyebrow.classList.add('sparks-go');
        window.scrollTo(0,0);refreshScroll();
        return;
      }

      if(head) splitSentWords(head);
      sent.classList.remove('sent-in');
      wrap.classList.add('step-hide');

      setTimeout(function(){
        wrap.style.display='none'; wrap.classList.remove('step-hide');
        sent.style.display='block';
        window.scrollTo(0,0); refreshScroll();

        /* Build the running order, then hand each element its own delay via a
           --d custom property (the CSS transition reads it). Words carry the
           bulk of the stagger; the lede and button follow the last word. */
        var words=head?Array.prototype.slice.call(head.querySelectorAll('.sw')):[];
        var t=0, STEP=0.055;
        if(eyebrow){ eyebrow.style.setProperty('--d','0s'); t=0.16; }
        words.forEach(function(w){ w.style.setProperty('--d',t.toFixed(3)+'s'); t+=STEP; });
        var headDone=t;
        var lede=sent.querySelector('.lede');
        var ghost=sent.querySelector('.btn-ghost');
        if(lede)  lede.style.setProperty('--d',(headDone+0.06).toFixed(3)+'s');
        if(ghost) ghost.style.setProperty('--d',(headDone+0.18).toFixed(3)+'s');

        requestAnimationFrame(function(){ requestAnimationFrame(function(){
          sent.classList.add('sent-in');
        }); });

        /* Arm the glitter only after the last headline word has settled. */
        if(eyebrow){
          setTimeout(function(){ eyebrow.classList.add('sparks-go'); }, (headDone+0.52)*1000);
        }
      }, 260);
    }
    /* Return to the project picker (from the form OR the sent screen), matching
       the forward crossfade. Called by browser Back via the popstate handler. */
    function goToPicker(){
      var wrap=document.getElementById('formwrap');
      var sent=document.getElementById('sent');
      var pick=document.getElementById('step-pick');
      var cur=(sent&&sent.style.display!=='none')?sent:wrap;
      document.body.classList.remove('brief-form-open');
      if(reduceMotion()){
        if(wrap) wrap.style.display='none'; if(sent) sent.style.display='none';
        pick.style.display='block'; window.scrollTo(0,0); refreshScroll(); return;
      }
      if(cur) cur.classList.add('step-hide');
      setTimeout(function(){
        if(wrap) wrap.style.display='none'; if(sent) sent.style.display='none';
        if(cur) cur.classList.remove('step-hide');
        pick.style.display='block'; pick.style.opacity='0'; pick.style.transform='translateY(8px)';
        window.scrollTo(0,0); refreshScroll();
        requestAnimationFrame(function(){ requestAnimationFrame(function(){
          pick.style.transition='opacity var(--dur-l) var(--ease-standard), transform var(--dur-l) var(--ease-standard)';
          pick.style.opacity='1'; pick.style.transform='none';
        }); });
        setTimeout(function(){ pick.style.transition=''; pick.style.transform=''; pick.style.opacity=''; }, 700);
      }, 260);
    }
    /* The on-page "back" link and "start another" just step history back one entry;
       the popstate handler does the actual swap, so the browser Back button and
       the on-page controls stay in sync and both land on the picker. */
    document.getElementById('backBtn').addEventListener('click',function(){ history.back(); });
    document.getElementById('restartBtn').addEventListener('click',function(){ history.back(); });
    window.addEventListener('popstate',function(){
      var wrap=document.getElementById('formwrap');
      var sent=document.getElementById('sent');
      var onStep=(wrap&&wrap.style.display!=='none')||(sent&&sent.style.display!=='none');
      if(onStep) goToPicker();
    });

    (function(){
      var modal=document.getElementById('ceModal');
      if(!modal) return;
      modal.querySelector('[data-role="backdrop"]').addEventListener('click',function(){ var cp=document.querySelector('.colorpick'); if(cp) closeEditor(cp); });
      document.addEventListener('keydown',function(e){ if(e.key==='Escape' && !modal.hidden){ var cp=document.querySelector('.colorpick'); if(cp) closeEditor(cp); } });
      window.addEventListener('resize',function(){ positionRail(); clampRail(); positionBarM(); });
      window.addEventListener('scroll',clampRail,{passive:true});
    })();

    (function(){
      var els=document.querySelectorAll('.rise');
      els.forEach(function(el,i){setTimeout(function(){el.classList.add('in');},120+i*90);});
    })();
  </script>

  <script is:inline>
    /* Fade the WebGL background in once UnicornStudio mounts its canvas
       (with a timed fallback), matching the site's hero fade. */
    (function(){
      var el=document.querySelector('.brief-webgl');
      if(!el) return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      function ready(){ el.classList.add('webgl-ready'); }
      if('MutationObserver' in window){
        var mo=new MutationObserver(function(){ if(el.querySelector('canvas')){ ready(); mo.disconnect(); } });
        mo.observe(el,{childList:true,subtree:true});
        setTimeout(function(){ ready(); mo.disconnect(); }, 4000);
      } else {
        setTimeout(ready, 1200);
      }
    })();
  </script>
</BaseLayout>
