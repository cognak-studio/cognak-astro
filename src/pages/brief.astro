---
/**
 * /brief — hidden, unlinked client discovery questionnaire.
 * Not in nav, footer, or sitemap; noindex. Pierce sends the URL per project.
 * Delivery: JS assembles a plaintext brief and POSTs it to /api/brief (a Vercel
 * serverless function that emails it via Resend, reply-to = the client's email).
 * Palette: adjusted olive-brown, dark ink — verified WCAG AA (see :root).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="brief"
  title="Start a Project – COGNAK"
  description="Tell us about your project. The idea, the audience, the way it should feel. We'll have the shape of it before we ever get on a call."
  ogUrl="https://cognak.com/brief/"
  pageBg="#140E07"
>
  <div class="brief-webgl" data-us-project="MYx6GEJ4hZQRnWnBgCQ9" aria-hidden="true"></div>
  <div class="brief-veil" aria-hidden="true"></div>

  <main id="cognak-main"><section class="brief">

    <div id="step-pick">
      <h1 class="headline">Good work starts with a good <em>brief</em>. Let's write yours.</h1>
      <p class="lede">The idea, the audience, the way it should feel. Give us the essentials and we'll have the sum of it before we ever get on a call.</p>
      <div class="picker rise" id="picker"></div>
    </div>

    <div id="formwrap">
      <div class="prograil" id="progRail" aria-hidden="true"><span class="prograil-cap prograil-cap--top">0%</span><i id="progFill"></i><span class="prograil-cap prograil-cap--bot">100%</span></div>
      <div class="progbar-m" id="progBarM" aria-hidden="true"><span class="progbar-m-cap">0%</span><span class="progbar-m-track"><i id="progFillM"></i></span><span class="progbar-m-cap">100%</span></div>
      <button class="backlink" id="backBtn" type="button">&larr; Change project type</button>
      <h2 class="headline form-headline" id="form-headline"></h2>
      <form id="briefForm" novalidate></form>
      <div class="actions">
        <button class="btn" id="sendBtn" type="button">Send brief &rarr;</button>
      </div>
      <div class="formerr" id="formErr" role="alert">Please fill in the required fields.</div>
    </div>

    <div id="sent">
      <p class="eyebrow sent-eyebrow">Sent<span class="sparkles" aria-hidden="true"><i class="spark s1"></i><i class="spark s2"></i><i class="spark s3"></i><i class="spark s4"></i><i class="spark s5"></i><i class="spark s6"></i><i class="spark s7"></i><i class="spark s8"></i><i class="spark s9"></i></span></p>
      <h2 class="headline">Thank you. <em>Got it</em>.</h2>
      <p class="lede">Your brief just landed with us. We'll read it properly and get back to you within a day or two.</p>
      <button class="btn btn-ghost" id="restartBtn" type="button">Start another brief</button>
    </div>

    <div class="ce-modal" id="ceModal" hidden aria-hidden="true">
      <div class="ce-backdrop" data-role="backdrop"></div>
      <div class="ce-dialog" role="dialog" aria-modal="true" aria-label="Choose a color">
        <div class="ce-body" data-role="edit"></div>
      </div>
    </div>

  </section></main>

  <style is:inline>
    html, body { background-color:#140E07 !important; }
    /* Keep the main column at least a full viewport tall so the footer stays
       pinned to the bottom on the short "Sent" screen (otherwise the page is
       shorter than the viewport and the bg shows below the footer).
       overflow-anchor:none stops WebKit/Arc/Dia from scroll-anchoring to the
       footer and jumping to the bottom when the picker swaps to the tall form. */
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; overflow-anchor:none; }

    /* WebGL background (UnicornStudio) — fixed behind the content, fades in when
       the canvas mounts. Mirrors the home/studio setup; skipped on reduced-motion. */
    .brief-webgl{ position:fixed; inset:0; width:100vw; height:100vh; z-index:0; pointer-events:none;
      opacity:0; transition:opacity 1.6s ease; }
    .brief-webgl.webgl-ready{ opacity:1; }
    @media (prefers-reduced-motion:reduce){ .brief-webgl{ display:none; } }

    /* ============================================================
       COGNAK Project Brief — dark espresso palette.
       Light text built off the nav-tan #9C8768, laddered up in the
       same hue to clear WCAG AA on the dark bg (verified):
       ink/bg 6.89:1, ink-soft/bg 5.53:1, nav-text/nav 4.75:1,
       dark-ink/tan-button 9.3:1.  (--cream = dark text ON tan controls)
       ============================================================ */
    .brief {
      --bg:#140E07; --nav:#372914; --navtext:#A89372;
      --field:rgba(12,8,3,0.55); --field-focus:rgba(12,8,3,0.72); --card:rgba(12,8,3,0.4);
      --ink:#CFBB9B; --ink-soft:#C9B694; --accent:#DECBAF;
      --cream:#2A2010; --btn:#D6C3A4; --sel:#D6C3A4;
      --line:rgba(207,187,155,0.20); --line-strong:rgba(207,187,155,0.40);
      --placeholder:#9C8763; --err:#FF9E90;
      /* Fixed 190px (not vh-based) so the headline text lands at 274px under
         the 84px nav clearance — the shared header position across
         projects/studio/privacy/colophon/brief. */
      max-width:1040px; margin:0 auto; padding:190px 6vw 22vh;
      color:var(--ink); font-family:'Diatype Variable', sans-serif;
    }
    /* Mobile: 100px under the 54px nav clearance = headline text at 154px,
       matching the other inner pages. The form step's backlink starts at the
       same spot. */
    @media (max-width:720px){ .brief{ padding-top:100px; } }
    @media (min-width:960px){ .brief{ margin-left:clamp(48px,10vw,180px); margin-right:auto; } }
    .brief .mono{ font-family:'Diatype Mono', monospace; }

    /* screen.css hides every <label> globally (Ninja Forms leftover:
       label{display:none!important}). Restore the labels this form relies on. */
    .brief label.q{ display:block !important; }
    .brief label.pill, .brief label.chip{ display:inline-flex !important; align-items:center; }

    /* nav themed to the olive colorway (shared inner-page nav) */
    /* Opaque warm espresso-black bar with a strong blur, matching the other
       dark page navs (home/studio use rgba(23,21,26,.75)); deep + blurred so it
       obscures the WebGL background underneath and keeps the nav text legible. */
    .home-bottom-bar.inner-page-nav.brief-nav{ background:rgba(12,8,3,0.6) !important;
      backdrop-filter:blur(12px) !important; -webkit-backdrop-filter:blur(12px) !important; }
    .brief-nav .home-bottom-email,
    .brief-nav .home-bottom-location,
    .brief-nav .inner-nav-links a,
    .brief-nav .pulse-dot{ color:#A89372 !important; }
    .brief-nav .home-bottom-email,
    .brief-nav .inner-nav-links a{ transition:color .2s ease; }
    @media (hover:hover){
      .brief-nav .home-bottom-email:hover,
      .brief-nav .inner-nav-links a:hover{ color:#DECBAF !important; }
    }

    .brief .eyebrow{ font-family:'Diatype Mono', monospace; font-size:.72rem; line-height:1.3;
      letter-spacing:.28em; text-transform:uppercase; color:var(--ink-soft); margin:0 0 2.2rem; }
    .brief .headline{ font-size:clamp(20px,5.5vw,62px); font-weight:500; line-height:1.1;
      letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .brief .form-headline{ font-size:clamp(2rem,5vw,3.2rem); margin-bottom:1.3rem; }
    .brief .headline em{ font-style:normal; font-weight:500; color:#EF9146; }
    .brief .lede{ font-size:1.05rem; line-height:1.65; color:var(--ink-soft); max-width:52ch; margin:0 0 3.4rem; }
    /* Nudge the intro copy above the picker slightly right of the headline. */
    #step-pick .lede{ margin-left:40px; }
    .brief .sent-mail{ color:var(--accent); text-decoration:underline; text-underline-offset:3px; }
    /* Match the projects/studio headline scale on mobile — they drop to
       clamp(24px,7vw,42px) at ≤720px; brief had no override so it read smaller. */
    @media (max-width:720px){
      .brief .headline{ font-size:clamp(24px,7vw,42px); }
      .brief .form-headline{ font-size:clamp(24px,7vw,42px); }
    }

    .brief .stepmeta{ font-family:'Diatype Mono', monospace; font-size:.7rem; letter-spacing:.18em;
      text-transform:uppercase; color:var(--ink-soft); margin:0 0 2.4rem; display:flex; align-items:center; gap:.8rem; }
    /* Left-edge completion rail — fixed so it stays visible while scrolling.
       Fills bottom-to-top and shifts from tan toward orange as the brief
       nears complete (height + color set in JS). */
    .brief .prograil{ position:fixed; left:24px; top:50%; transform:translateY(-50%); width:2px; height:44vh; max-height:380px;
      background:rgba(207,187,155,0.16); z-index:6; }
    /* Filled line from the top: cream at the top, orange at the growing end,
       glowing along the completed segment (color + glow set in JS). */
    .brief .prograil i{ position:absolute; left:0; right:0; top:0; height:0; border-radius:2px;
      background:linear-gradient(180deg, #EDE0C8 0%, #EF9146 100%);
      box-shadow:0 0 8px 1px rgba(239,145,70,.5);
      transition:height .5s ease, background .5s ease, box-shadow .5s ease; }
    /* Tiny mono end-caps: 0% at the top, 100% at the bottom of the rail. */
    .brief .prograil-cap{ position:absolute; left:50%; transform:translateX(-50%);
      font-family:'Diatype Mono', monospace; font-size:.52rem; letter-spacing:.06em;
      color:var(--ink-soft); pointer-events:none; white-space:nowrap; }
    .brief .prograil-cap--top{ top:-15px; }
    .brief .prograil-cap--bot{ bottom:-15px; }
    /* Completion rail lives in the left margin, which only exists >=960px.
       Below that the reading column goes full-width, so hide the rail on
       mobile/tablet until it's reimagined for small screens. */
    @media (max-width:959px){ .brief .prograil{ display:none; } }

    /* Mobile counterpart of the completion rail: a slim horizontal strip
       floating a little below the fixed nav (offset measured in JS — see
       positionBarM), locked there while the page scrolls. Frosted like the
       brief nav (espresso tint + blur) so any form content that passes
       beneath it blurs out while the bar stays readable. No % caps or
       section notes here. */
    .brief .progbar-m{ display:none; }
    @media (max-width:959px){
      .brief .progbar-m{ display:flex; align-items:center; gap:10px; position:fixed; top:100px;
        left:6vw; right:6vw; z-index:6;
        padding:11px 14px 13px; border-radius:999px; background:rgba(12,8,3,0.6);
        -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px);
        /* own compositor layer so the backdrop-filter actually paints over the
           WebGL background — same fix the site navs use */
        will-change:transform; }
      /* Tiny mono end-caps: 0% at the left, 100% at the right of the track,
         matching the desktop rail's caps. */
      .brief .progbar-m-cap{ font-family:'Diatype Mono', monospace; font-size:.52rem;
        letter-spacing:.06em; line-height:1; color:var(--ink-soft);
        pointer-events:none; white-space:nowrap; }
      .brief .progbar-m-track{ display:block; position:relative; flex:1; height:2px; border-radius:2px;
        background:rgba(207,187,155,0.16); }
      /* Filled line from the left: cream at the start, orange at the growing
         end, glowing along the completed segment (width + color set in JS). */
      .brief .progbar-m i{ position:absolute; left:0; top:0; bottom:0; width:0; border-radius:2px;
        background:linear-gradient(90deg, #EDE0C8 0%, #EF9146 100%);
        box-shadow:0 0 8px 1px rgba(239,145,70,.5);
        transition:width .5s ease, background .5s ease, box-shadow .5s ease; }
    }

    /* ---- project picker: no outline, squared 2px, subtle tile shadow ---- */
    /* stacked, strokeless frosted panels; hover turns all text orange (no raise) */
    .brief .picker{ display:grid; grid-template-columns:1fr; gap:14px; margin-top:.4rem; }
    .brief .pcard{ position:relative; text-align:left; cursor:pointer; background:var(--card);
      border:none; border-radius:6px; padding:22px 22px 20px; color:var(--ink);
      -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px);
      box-shadow:0 2px 10px rgba(0,0,0,.18);
      transition:background .25s ease;
      font-family:inherit; }
    .brief .pcard:hover{ background:var(--field-focus); }
    .brief .pcard:hover .idx, .brief .pcard:hover h3, .brief .pcard:hover p, .brief .pcard:hover .arrow{ color:#EF9146; }
    .brief .pcard:active{ transform:scale(.995); }
    .brief .pcard .idx{ font-family:'Diatype Mono', monospace; font-size:.7rem; color:var(--ink-soft); letter-spacing:.14em; transition:color .2s ease; }
    .brief .pcard h3{ font-size:1.5rem; font-weight:500; letter-spacing:-.01em; margin:.7rem 0 .35rem; transition:color .2s ease; }
    .brief .pcard p{ font-size:.9rem; line-height:1.45; color:var(--ink-soft); transition:color .2s ease; }
    .brief .pcard .arrow{ position:absolute; bottom:20px; right:22px; color:var(--ink-soft); transition:transform .25s ease,color .25s ease; }
    .brief .pcard:hover .arrow{ transform:translateX(4px); }

    #formwrap{ display:none; }
    /* flex (not inline-flex) + fit-content: block-level so no inline strut
       nudges it below the shared header position, still shrink-wrapped. */
    .brief .backlink{ position:relative; display:flex; width:fit-content; align-items:center; gap:.5rem; background:none; border:none;
      color:#EF9146; font-family:'Diatype Mono', monospace; font-size:.72rem; line-height:1.3; letter-spacing:.16em;
      text-transform:uppercase; cursor:pointer; padding:0; margin:0 0 2.2rem; transition:color .2s ease; }
    .brief .backlink::before{ content:""; position:absolute; inset:-12px -10px; }
    .brief .backlink:hover{ color:#F5A65E; }

    .brief .group{ border-top:1px solid var(--line); padding-top:2.2rem; margin-top:2.6rem; }
    .brief .group:first-of-type{ border-top:none; padding-top:0; margin-top:.6rem; }
    .brief .group-title{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.2em;
      text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.9rem; }

    .brief .field{ margin-bottom:2rem; }
    .brief .field:last-child{ margin-bottom:0; }
    /* Title + sub give each box a clear name and a scannable hierarchy */
    .brief .q{ display:block; margin-bottom:.85rem; }
    .brief .q-title{ display:block; font-size:1.08rem; font-weight:500; line-height:1.3; color:var(--ink); }
    .brief .q-sub{ display:block; font-size:.88rem; font-weight:450; line-height:1.4; color:var(--ink-soft); margin-top:.2rem; }
    /* required fields are validated on submit — no visual dot */
    .brief .hint{ display:block; font-size:.8rem; font-weight:450; color:var(--ink-soft); margin:-.35rem 0 .85rem; font-style:italic; }
    .brief .group-desc{ font-size:.95rem; line-height:1.5; color:var(--ink-soft); margin:-1.1rem 0 1.7rem; }
    .brief .rangewrap{ padding-top:.2rem; }
    .brief .rangeval{ font-size:1.15rem; font-weight:500; color:var(--ink); margin-bottom:.7rem; }
    /* Track is lightened and thicker; JS paints an orange fill up to the value
       so the slider reads clearly against the dark WebGL background. */
    .brief input[type=range]{ -webkit-appearance:none; appearance:none; width:100%; height:8px; border-radius:999px; background:rgba(207,187,155,0.22); outline:none; cursor:pointer; }
    .brief input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; width:24px; height:24px; border-radius:50%; background:var(--btn); border:2px solid #EF9146; box-shadow:0 2px 10px rgba(0,0,0,.5); cursor:pointer; }
    .brief input[type=range]::-moz-range-thumb{ width:24px; height:24px; border-radius:50%; background:var(--btn); border:2px solid #EF9146; box-shadow:0 2px 10px rgba(0,0,0,.5); cursor:pointer; }
    .brief .rangeends{ display:flex; justify-content:space-between; font-size:.72rem; color:var(--ink-soft); margin-top:.55rem; }

    .brief input[type=text], .brief input[type=email], .brief input[type=url], .brief textarea{
      width:100%; background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:1rem; line-height:1.5; padding:14px 16px;
      -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
      transition:border-color .2s ease,background .2s ease,box-shadow .2s ease; outline:none; }
    .brief input::placeholder, .brief textarea::placeholder{ color:var(--placeholder); }
    .brief input:focus, .brief textarea:focus{ border-color:#EF9146; background:var(--field-focus); }
    /* Recolor the site's global :focus-visible outline (custom.css sets it to
       purple #9F50FF !important) to the brief's orange, page-wide. */
    .brief a:focus-visible, .brief button:focus-visible, .brief input:focus-visible,
    .brief textarea:focus-visible, .brief select:focus-visible, .brief [tabindex]:focus-visible{
      outline-color:#EF9146 !important; }
    .brief textarea{ min-height:92px; resize:vertical; }
    .brief .field.invalid input, .brief .field.invalid textarea{ border-color:var(--err); }

    .brief .pills{ display:flex; flex-wrap:wrap; gap:10px; }
    .brief .pill{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
      border-radius:999px; padding:10px 18px; font-size:.92rem; color:var(--ink); background:var(--field);
      transition:transform .14s cubic-bezier(.2,.7,.3,1),border-color .2s ease,color .2s ease,background .2s ease; }
    .brief .pill:hover{ border-color:var(--ink); }
    .brief .pill:active{ transform:scale(.96); }
    .brief .pill input{ position:absolute; opacity:0; pointer-events:none; }
    .brief .pill.on{ border-color:var(--ink); color:var(--cream); background:var(--sel); font-weight:500; }

    .brief .chips{ display:flex; flex-wrap:wrap; gap:10px; }
    .brief .chip{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
      border-radius:999px; padding:9px 15px 9px 34px; font-size:.9rem; color:var(--ink); background:var(--field);
      transition:transform .14s cubic-bezier(.2,.7,.3,1),border-color .2s ease,background .2s ease; }
    .brief .chip:hover{ border-color:var(--ink); }
    .brief .chip:active{ transform:scale(.96); }
    .brief .chip input{ position:absolute; opacity:0; pointer-events:none; }
    .brief .chip::before{ content:""; position:absolute; left:13px; top:50%; transform:translateY(-50%);
      width:12px; height:12px; border-radius:4px; border:1px solid var(--ink-soft); transition:all .18s ease; }
    .brief .chip.on{ border-color:var(--ink); background:var(--field-focus); }
    .brief .chip.on::before{ background:var(--sel); border-color:var(--sel); }
    .brief .chip.on::after{ content:""; position:absolute; left:16px; top:calc(50% - 4px); width:6px; height:3px;
      border-left:1.5px solid var(--cream); border-bottom:1.5px solid var(--cream); transform:rotate(-45deg); }

    /* ---- color picker: accumulate pattern — filled swatches grow next to a
       single "+ Add color" tile; no empty numbered boxes. Up to 5. ---- */
    .brief .colorpick{ display:flex; flex-wrap:wrap; gap:12px; align-items:stretch; }
    .brief .color3{ display:contents; }
    .brief .cslot{ width:96px; height:78px; border-radius:12px; border:1px solid transparent;
      position:relative; overflow:hidden; cursor:pointer; display:flex; align-items:flex-end; padding:10px 12px;
      transition:transform .16s cubic-bezier(.2,.7,.3,1),border-color .2s ease,box-shadow .2s ease; }
    .brief .cslot:hover{ box-shadow:0 0 0 2px var(--accent); }
    .brief .cslot:active{ transform:scale(.98); }
    .brief .cslot.editing{ box-shadow:0 0 0 2px var(--accent); }
    .brief .cslot-face{ position:absolute; inset:0; z-index:0; background:transparent; transition:background .2s ease; }
    .brief .cslot-hex{ position:relative; z-index:1; pointer-events:none; font-size:.72rem; letter-spacing:.04em;
      color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.55); }
    .brief .cslot-clear{ position:absolute; top:5px; right:8px; z-index:2; background:none; border:none;
      color:#fff; font-size:1.05rem; line-height:1; cursor:pointer; opacity:.92; text-shadow:0 1px 2px rgba(0,0,0,.5);
      transition:opacity .2s ease,transform .2s ease; }
    .brief .cslot-clear:hover{ transform:scale(1.15); }

    .brief .coloradd{ width:96px; height:78px; background:none; border:1px dashed var(--line-strong); color:var(--ink-soft);
      border-radius:12px; padding:8px; display:flex; align-items:center; justify-content:center; text-align:center;
      font-family:'Diatype Mono', monospace; font-size:.68rem; letter-spacing:.06em; line-height:1.35;
      cursor:pointer; transition:border-color .2s ease,color .2s ease; }
    .brief .coloradd:hover{ border-color:var(--ink); color:var(--ink); }
    .brief .coloradd[hidden]{ display:none; }
    /* ---- color editor: a single frosted card that opens under the slots.
       The card is the only container, so the hex sits bare inside it (no
       box-within-a-box). ---- */
    .brief .coloredit[hidden]{ display:none; }
    .brief .coloredit{ margin-top:14px; background:rgba(12,8,3,0.55); border:1px solid var(--line-strong);
      border-radius:12px; padding:18px 20px; -webkit-backdrop-filter:blur(16px); backdrop-filter:blur(16px);
      box-shadow:0 10px 34px rgba(0,0,0,.30); }
    .brief .ce-inner{ display:flex; align-items:center; gap:24px; flex-wrap:wrap;
      animation:ceIn .26s cubic-bezier(.2,.7,.3,1) both; }
    @keyframes ceIn{ from{ opacity:0; transform:translateY(-6px); } to{ opacity:1; transform:none; } }
    @media (prefers-reduced-motion:reduce){ .brief .ce-inner{ animation:none; } }
    .brief .ce-label{ flex:1 1 100%; font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.18em;
      text-transform:uppercase; color:var(--ink-soft); margin-bottom:2px; }
    /* swatch = one filled circle; the color input is a transparent overlay that
       opens the OS picker. Pencil badge + hint show it is clickable. */
    .brief .ce-swatch{ position:relative; width:52px; height:52px; border-radius:50%; cursor:pointer; flex:0 0 auto;
      box-shadow:0 0 0 1px var(--line-strong); transition:transform .16s ease, box-shadow .2s ease; }
    .brief .ce-swatch:hover{ transform:scale(1.06); box-shadow:0 0 0 2px var(--accent); }
    .brief .ce-fill{ position:absolute; inset:0; border-radius:50%; }
    .brief .ce-native{ position:absolute; inset:0; width:100%; height:100%; opacity:0; border:none; padding:0; margin:0; cursor:pointer; }
    .brief .ce-badge{ position:absolute; right:-3px; bottom:-3px; width:21px; height:21px; border-radius:50%;
      background:var(--btn); color:#2A2010; display:flex; align-items:center; justify-content:center;
      border:2px solid var(--bg); pointer-events:none; }
    .brief .ce-hint{ font-size:.74rem; color:var(--ink-soft); }
    /* hex sits bare inside the card — a thin underline is the only affordance,
       so there's no container-within-a-container around it. */
    .brief .ce-hashwrap{ display:inline-flex; align-items:center; gap:6px; color:var(--ink);
      font-family:'Diatype Mono', monospace; border-bottom:1px solid var(--line-strong);
      padding:6px 2px; transition:border-color .2s ease; }
    .brief .ce-hashwrap:focus-within{ border-color:#EF9146; }
    .brief .ce-hashwrap .ce-hex{ width:7ch; background:none; border:none; outline:none; box-shadow:none; color:var(--ink);
