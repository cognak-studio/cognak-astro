---
/**
 * /brief — hidden, unlinked client discovery questionnaire.
 * Not in nav, footer, or sitemap; noindex. Pierce sends the URL per project.
 * Delivery: mailto (no backend) — JS assembles a plaintext brief and hands it
 * to the client's mail app; "Copy answers" fallback covers long-body clients.
 * Palette: adjusted olive-brown, dark ink — verified WCAG AA (see :root).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="brief"
  title="Project Brief – COGNAK"
  description="Start a project with COGNAK."
  ogUrl="https://cognak.com/brief/"
  noindex={true}
  pageBg="#140E07"
>
  <div class="brief-webgl" data-us-project="MYx6GEJ4hZQRnWnBgCQ9" aria-hidden="true"></div>

  <main id="cognak-main"><section class="brief">

    <div id="step-pick">
      <p class="eyebrow rise">Project Brief</p>
      <h1 class="headline rise">Let's start something <em>good</em>.</h1>
      <p class="lede rise">A few focused questions so we understand exactly what you need before we talk. Pick what you're here for. It takes about three minutes.</p>
      <div class="picker rise" id="picker"></div>
    </div>

    <div id="formwrap">
      <button class="backlink" id="backBtn" type="button">&larr; Change project type</button>
      <h2 class="headline form-headline" id="form-headline"></h2>
      <div class="stepmeta"><span id="disc-label" class="mono"></span><span class="bar"><i id="progbar"></i></span></div>
      <form id="briefForm" novalidate></form>
      <div class="actions">
        <button class="btn" id="sendBtn" type="button">Send brief &rarr;</button>
        <button class="btn btn-ghost" id="copyBtn" type="button">Copy answers instead</button>
        <span class="copied" id="copiedMsg">Copied &#10003;</span>
      </div>
      <div class="formerr" id="formErr">Please fill in the required fields (marked with a dot).</div>
    </div>

    <div id="sent">
      <p class="eyebrow">Sent</p>
      <h2 class="headline">Thank you &mdash; <em>got it</em>.</h2>
      <p class="lede">Your brief is on its way to us. We'll review it and get back to you within a day or two. If your email app didn't open, use &ldquo;Copy answers&rdquo; and send it to <a href="mailto:pierce@cognak.com" class="sent-mail">pierce@cognak.com</a>.</p>
      <button class="btn btn-ghost" id="restartBtn" type="button">Start another brief</button>
    </div>

  </section></main>

  <style is:inline>
    html, body { background-color:#140E07 !important; }
    #cognak-main { position:relative; z-index:1; }

    /* WebGL background (UnicornStudio) — fixed behind the content, fades in when
       the canvas mounts. Mirrors the home/studio setup; skipped on reduced-motion. */
    .brief-webgl{ position:fixed; inset:0; width:100vw; height:100vh; z-index:0; pointer-events:none;
      opacity:0; transition:opacity 1.6s ease; }
    .brief-webgl.webgl-ready{ opacity:1; }
    @media (prefers-reduced-motion:reduce){ .brief-webgl{ display:none; } }

    /* ============================================================
       COGNAK Project Brief — dark espresso palette.
       Light text built off the nav-tan #9C8768, laddered up in the
       same hue to clear WCAG AA on the dark bg (verified):
       ink/bg 6.89:1, ink-soft/bg 5.53:1, nav-text/nav 4.75:1,
       dark-ink/tan-button 9.3:1.  (--cream = dark text ON tan controls)
       ============================================================ */
    .brief {
      --bg:#140E07; --nav:#372914; --navtext:#A89372;
      --field:rgba(12,8,3,0.55); --field-focus:rgba(12,8,3,0.72); --card:rgba(12,8,3,0.5);
      --ink:#CFBB9B; --ink-soft:#BCA787; --accent:#DECBAF;
      --cream:#2A2010; --btn:#D6C3A4; --sel:#D6C3A4;
      --line:rgba(207,187,155,0.20); --line-strong:rgba(207,187,155,0.40);
      --placeholder:#8F7B5B; --err:#FF9E90;
      max-width:760px; margin:0 auto; padding:calc(8vh + 80px) 6vw 22vh;
      color:var(--ink); font-family:'Diatype Variable', sans-serif;
    }
    @media (min-width:960px){ .brief{ margin-left:clamp(48px,10vw,180px); margin-right:auto; } }
    .brief .mono{ font-family:'Diatype Mono', monospace; }

    /* screen.css hides every <label> globally (Ninja Forms leftover:
       label{display:none!important}). Restore the labels this form relies on. */
    .brief label.q{ display:block !important; }
    .brief label.pill, .brief label.chip{ display:inline-flex !important; align-items:center; }

    /* nav themed to the olive colorway (shared inner-page nav) */
    /* Opaque warm espresso-black bar with a strong blur, matching the other
       dark page navs (home/studio use rgba(23,21,26,.75)); deep + blurred so it
       obscures the WebGL background underneath and keeps the nav text legible. */
    .home-bottom-bar.inner-page-nav.brief-nav{ background:rgba(12,8,3,0.6) !important;
      backdrop-filter:blur(12px) !important; -webkit-backdrop-filter:blur(12px) !important; }
    .brief-nav .home-bottom-email,
    .brief-nav .home-bottom-location,
    .brief-nav .inner-nav-links a,
    .brief-nav .pulse-dot{ color:#A89372 !important; }
    .brief-nav .home-bottom-email,
    .brief-nav .inner-nav-links a{ transition:color .2s ease; }
    @media (hover:hover){
      .brief-nav .home-bottom-email:hover,
      .brief-nav .inner-nav-links a:hover{ color:#DECBAF !important; }
    }

    .brief .eyebrow{ font-family:'Diatype Mono', monospace; font-size:.72rem; line-height:1.3;
      letter-spacing:.28em; text-transform:uppercase; color:var(--ink-soft); margin:0 0 2.2rem; }
    .brief .headline{ font-size:clamp(2.4rem,6.5vw,4.2rem); font-weight:500; line-height:1.02;
      letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .brief .form-headline{ font-size:clamp(2rem,5vw,3.2rem); margin-bottom:1.3rem; }
    .brief .headline em{ font-style:italic; font-weight:500; color:var(--accent); }
    .brief .lede{ font-size:1.05rem; line-height:1.65; color:var(--ink-soft); max-width:52ch; margin:0 0 3.4rem; }
    .brief .sent-mail{ color:var(--accent); text-decoration:underline; text-underline-offset:3px; }

    .brief .stepmeta{ font-family:'Diatype Mono', monospace; font-size:.7rem; letter-spacing:.18em;
      text-transform:uppercase; color:var(--ink-soft); margin:0 0 2.4rem; display:flex; align-items:center; gap:.8rem; }
    .brief .stepmeta .bar{ flex:1; height:2px; background:var(--line); position:relative; overflow:hidden; border-radius:2px; }
    .brief .stepmeta .bar i{ position:absolute; inset:0; background:var(--accent); width:0; transition:width .5s ease; }

    /* ---- project picker: no outline, squared 2px, subtle tile shadow ---- */
    .brief .picker{ display:grid; grid-template-columns:repeat(2,1fr); grid-auto-rows:1fr; gap:14px; margin-top:.4rem; }
    @media (max-width:620px){ .brief .picker{ grid-template-columns:1fr; } }
    .brief .pcard{ position:relative; text-align:left; cursor:pointer; background:var(--card);
      border:1px solid var(--line-strong); border-radius:6px; padding:22px 22px 20px; color:var(--ink);
      -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
      box-shadow:0 2px 10px rgba(0,0,0,.20);
      transition:transform .18s cubic-bezier(.2,.7,.3,1),background .25s ease,box-shadow .25s ease;
      font-family:inherit; }
    .brief .pcard:hover{ background:var(--field-focus); border-color:var(--ink); transform:translateY(-3px); box-shadow:0 12px 30px rgba(0,0,0,.32); }
    .brief .pcard:active{ transform:translateY(-1px) scale(.99); }
    .brief .pcard .idx{ font-family:'Diatype Mono', monospace; font-size:.7rem; color:var(--ink-soft); letter-spacing:.14em; }
    .brief .pcard h3{ font-size:1.5rem; font-weight:500; letter-spacing:-.01em; margin:.7rem 0 .35rem; }
    .brief .pcard p{ font-size:.9rem; line-height:1.45; color:var(--ink-soft); }
    .brief .pcard .arrow{ position:absolute; top:22px; right:22px; color:var(--ink-soft); transition:transform .25s ease,color .25s ease; }
    .brief .pcard:hover .arrow{ transform:translateX(4px); color:var(--accent); }

    #formwrap{ display:none; }
    .brief .backlink{ position:relative; display:inline-flex; align-items:center; gap:.5rem; background:none; border:none;
      color:#EF9146; font-family:'Diatype Mono', monospace; font-size:.72rem; line-height:1.3; letter-spacing:.16em;
      text-transform:uppercase; cursor:pointer; padding:0; margin:0 0 2.2rem; transition:color .2s ease; }
    .brief .backlink::before{ content:""; position:absolute; inset:-12px -10px; }
    .brief .backlink:hover{ color:#F5A65E; }

    .brief .group{ border-top:1px solid var(--line); padding-top:2.2rem; margin-top:2.6rem; }
    .brief .group:first-of-type{ border-top:none; padding-top:0; margin-top:.6rem; }
    .brief .group-title{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.2em;
      text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.9rem; }

    .brief .field{ margin-bottom:2rem; }
    .brief .field:last-child{ margin-bottom:0; }
    /* Title + sub give each box a clear name and a scannable hierarchy */
    .brief .q{ display:block; margin-bottom:.85rem; }
    .brief .q-title{ display:block; font-size:1.08rem; font-weight:500; line-height:1.3; color:var(--ink); }
    .brief .q-sub{ display:block; font-size:.88rem; font-weight:400; line-height:1.4; color:var(--ink-soft); margin-top:.2rem; }
    /* required fields are validated on submit — no visual dot */
    .brief .hint{ display:block; font-size:.8rem; color:var(--ink-soft); margin:-.35rem 0 .85rem; font-style:italic; }
    .brief .group-desc{ font-size:.95rem; line-height:1.5; color:var(--ink-soft); margin:-1.1rem 0 1.7rem; }
    .brief .rangewrap{ padding-top:.2rem; }
    .brief .rangeval{ font-size:1.15rem; font-weight:500; color:var(--ink); margin-bottom:.7rem; }
    .brief input[type=range]{ -webkit-appearance:none; appearance:none; width:100%; height:6px; border-radius:999px; background:var(--field-focus); outline:none; cursor:pointer; }
    .brief input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; width:22px; height:22px; border-radius:50%; background:var(--btn); border:1px solid var(--ink); cursor:pointer; }
    .brief input[type=range]::-moz-range-thumb{ width:22px; height:22px; border-radius:50%; background:var(--btn); border:1px solid var(--ink); cursor:pointer; }
    .brief .rangeends{ display:flex; justify-content:space-between; font-size:.72rem; color:var(--ink-soft); margin-top:.55rem; }

    .brief input[type=text], .brief input[type=email], .brief input[type=url], .brief textarea{
      width:100%; background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:1rem; line-height:1.5; padding:14px 16px;
      -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
      transition:border-color .2s ease,background .2s ease,box-shadow .2s ease; outline:none; }
    .brief input::placeholder, .brief textarea::placeholder{ color:var(--placeholder); }
    .brief input:focus, .brief textarea:focus{ border-color:var(--accent); background:var(--field-focus); box-shadow:0 0 0 3px rgba(222,203,175,.20); }
    .brief textarea{ min-height:92px; resize:vertical; }
    .brief .field.invalid input, .brief .field.invalid textarea{ border-color:var(--err); }

    .brief .pills{ display:flex; flex-wrap:wrap; gap:10px; }
    .brief .pill{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
      border-radius:999px; padding:10px 18px; font-size:.92rem; color:var(--ink); background:var(--field);
      transition:transform .14s cubic-bezier(.2,.7,.3,1),border-color .2s ease,color .2s ease,background .2s ease; }
    .brief .pill:hover{ border-color:var(--ink); }
    .brief .pill:active{ transform:scale(.96); }
    .brief .pill input{ position:absolute; opacity:0; pointer-events:none; }
    .brief .pill.on{ border-color:var(--ink); color:var(--cream); background:var(--sel); font-weight:500; }

    .brief .chips{ display:flex; flex-wrap:wrap; gap:10px; }
    .brief .chip{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
      border-radius:999px; padding:9px 15px 9px 34px; font-size:.9rem; color:var(--ink); background:var(--field);
      transition:transform .14s cubic-bezier(.2,.7,.3,1),border-color .2s ease,background .2s ease; }
    .brief .chip:hover{ border-color:var(--ink); }
    .brief .chip:active{ transform:scale(.96); }
    .brief .chip input{ position:absolute; opacity:0; pointer-events:none; }
    .brief .chip::before{ content:""; position:absolute; left:13px; top:50%; transform:translateY(-50%);
      width:12px; height:12px; border-radius:4px; border:1px solid var(--ink-soft); transition:all .18s ease; }
    .brief .chip.on{ border-color:var(--ink); background:var(--field-focus); }
    .brief .chip.on::before{ background:var(--sel); border-color:var(--sel); }
    .brief .chip.on::after{ content:""; position:absolute; left:16px; top:calc(50% - 4px); width:6px; height:3px;
      border-left:1.5px solid var(--cream); border-bottom:1.5px solid var(--cream); transform:rotate(-45deg); }

    /* ---- color picker: numbered rectangles -> hex editor, up to 5 ---- */
    .brief .color3{ display:flex; flex-wrap:wrap; gap:12px; }
    .brief .cslot{ flex:1 1 0; min-width:84px; height:78px; border-radius:12px; border:1px dashed var(--line-strong);
      position:relative; overflow:hidden; cursor:pointer; display:flex; align-items:flex-end; padding:10px 12px;
      transition:transform .16s cubic-bezier(.2,.7,.3,1),border-color .2s ease,box-shadow .2s ease; }
    .brief .cslot:hover{ border-color:var(--ink); }
    .brief .cslot:active{ transform:scale(.98); }
    .brief .cslot.editing{ box-shadow:0 0 0 2px var(--accent); border-color:transparent; }
    .brief .cslot-face{ position:absolute; inset:0; z-index:0; background:transparent; transition:background .2s ease; }
    .brief .cslot-hex{ position:relative; z-index:1; pointer-events:none; font-size:.72rem; letter-spacing:.04em; color:var(--ink-soft); }
    .brief .cslot.filled{ border-style:solid; border-color:transparent; }
    .brief .cslot.filled .cslot-hex{ color:#fff; text-shadow:0 1px 3px rgba(0,0,0,.55); }
    .brief .cslot-clear{ position:absolute; top:5px; right:8px; z-index:2; background:none; border:none;
      color:var(--ink-soft); font-size:1.05rem; line-height:1; cursor:pointer; opacity:0; transition:opacity .2s ease; }
    .brief .cslot.filled .cslot-clear{ color:#fff; opacity:.92; text-shadow:0 1px 2px rgba(0,0,0,.5); }
    .brief .cslot.removable .cslot-clear{ opacity:.7; }

    .brief .coloradd{ margin-top:12px; background:none; border:1px dashed var(--line-strong); color:var(--ink-soft);
      border-radius:8px; padding:9px 14px; font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.08em;
      cursor:pointer; transition:border-color .2s ease,color .2s ease; }
    .brief .coloradd:hover{ border-color:var(--ink); color:var(--ink); }
    .brief .coloradd[hidden]{ display:none; }
    .brief .coloredit[hidden]{ display:none; }
    .brief .coloredit{ margin-top:16px; }
    .brief .ce-inner{ display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
    .brief .ce-label{ font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); }
    /* swatch = one filled circle; the color input is a transparent overlay that
       opens the OS picker. Pencil badge + hint show it is clickable. */
    .brief .ce-swatch{ position:relative; width:54px; height:54px; border-radius:50%; cursor:pointer; flex:0 0 auto;
      box-shadow:0 0 0 1px var(--line-strong); transition:transform .16s ease, box-shadow .2s ease; }
    .brief .ce-swatch:hover{ transform:scale(1.06); box-shadow:0 0 0 2px var(--accent); }
    .brief .ce-fill{ position:absolute; inset:0; border-radius:50%; }
    .brief .ce-native{ position:absolute; inset:0; width:100%; height:100%; opacity:0; border:none; padding:0; margin:0; cursor:pointer; }
    .brief .ce-badge{ position:absolute; right:-3px; bottom:-3px; width:21px; height:21px; border-radius:50%;
      background:var(--btn); color:#2A2010; display:flex; align-items:center; justify-content:center;
      border:2px solid var(--bg); pointer-events:none; }
    .brief .ce-hint{ font-size:.74rem; color:var(--ink-soft); }
    .brief .ce-hashwrap{ display:inline-flex; align-items:center; gap:6px; background:var(--field-focus);
      -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
      border:1px solid var(--line-strong); border-radius:10px; padding:12px 14px; font-family:'Diatype Mono', monospace; color:var(--ink); }
    .brief .ce-hashwrap .ce-hex{ width:7ch; background:none; border:none; outline:none; box-shadow:none; color:var(--ink);
      font-family:inherit; font-size:.95rem; letter-spacing:.1em; text-transform:uppercase; padding:0; }
    .brief .ce-hashwrap .ce-hex:focus{ background:none; border:none; box-shadow:none; }
    .brief .ce-done{ margin-left:auto; background:var(--btn); color:var(--cream); border:1px solid var(--ink);
      border-radius:999px; padding:9px 20px; font-size:.85rem; cursor:pointer; font-family:inherit; }
    .brief .ce-done:active{ transform:scale(.97); }

    .brief .actions{ border-top:1px solid var(--line); margin-top:3rem; padding-top:2.4rem;
      display:flex; flex-wrap:wrap; gap:16px; align-items:center; }
    .brief .btn{ font-family:inherit; font-size:1rem; cursor:pointer; border-radius:999px; padding:15px 30px;
      border:1px solid var(--ink); background:var(--btn); color:var(--cream); font-weight:500;
      transition:transform .16s cubic-bezier(.2,.7,.3,1),box-shadow .25s ease,background .2s ease; }
    .brief .btn:hover{ box-shadow:0 8px 30px rgba(0,0,0,.35); transform:translateY(-2px); background:#E4D3AE; }
    .brief .btn:active{ transform:translateY(0) scale(.98); }
    .brief .btn-ghost{ background:none; color:var(--ink); border:1px solid var(--ink); }
    .brief .btn-ghost:hover{ background:rgba(222,203,175,.10); box-shadow:none; }
    .brief .formerr{ color:var(--err); font-size:.88rem; margin-top:1rem; display:none; }
    .brief .copied{ color:var(--accent); font-size:.82rem; font-family:'Diatype Mono', monospace;
      letter-spacing:.08em; opacity:0; transition:opacity .3s ease; font-weight:500; }
    .brief .copied.show{ opacity:1; }

    #sent{ display:none; text-align:left; }
    #sent .headline{ margin-bottom:1.2rem; }
    #sent .lede{ margin-bottom:2rem; }

    .brief .rise{ opacity:0; transform:translateY(8px); transition:opacity .6s ease,transform .6s ease; }
    .brief .rise.in{ opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce){ .brief .rise{ opacity:1; transform:none; transition:none; } }
  </style>

  <script is:inline>
    if (history.scrollRestoration) { history.scrollRestoration = 'manual'; }
    window.scrollTo(0, 0);

    var DELIVER_TO = 'pierce@cognak.com';

    /* Lead capture shown at the top of every discipline's questionnaire */
    var LEAD = {title:'Your details',fields:[
      {id:'your_name',type:'text',t:'Name',q:'',req:true,ph:'First and last'},
      {id:'your_email',type:'email',t:'Email',q:'',req:true,ph:'you@company.com'}
    ]};
    /* Logistics closer shown at the bottom of every questionnaire */
    var TAIL = {title:'Timeline & budget',fields:[
      {id:'timeline',type:'single',t:'Timeline',q:'When do you want this done?',options:['ASAP / urgent','1–3 months','3–6 months','Flexible / exploratory']},
      {id:'budget',type:'range',t:'Budget',q:'Drag to set your rough budget.',min:0,max:10000,step:250,def:5000,prefix:'$'},
      {id:'anything',type:'textarea',t:'Anything else',q:'Anything else we should know?'}
    ]};

    var DISCIPLINES = {
      branding:{
        label:'Branding',
        headline:'Tell us about the brand.',
        groups:[
          {title:'The brand',fields:[
            {id:'brand_name',type:'text',t:'Brand name',q:"What's the name we're designing around?",req:true,ph:'e.g. COGNAK'},
            {id:'alt_names',type:'text',t:'Alternate names, abbreviations to consider',q:'',ph:'Optional'},
            {id:'stage',type:'single',t:'Starting point',q:'Where are you starting from?',options:['Brand-new, from scratch','Rebrand of an established business','Refresh of the current look']}
          ]},
          {title:'Feel & direction',fields:[
            {id:'personality',type:'multi',t:'Personality',q:'Pick the words that should describe the brand.',hint:'Choose a handful.',options:['Bold','Refined','Playful','Minimal','Premium','Approachable','Technical','Warm','Trustworthy','Expressive','Editorial','Timeless','Modern','Handmade']},
            {id:'colors',type:'colors',t:'Colors',q:'Please choose up to 5 colors.'},
            {id:'colors_comments',type:'textarea',t:'Any additional thoughts or comments on color',q:'',ph:'Optional'}
          ]},
          {title:'Versions',desc:"Let us know how many concepts you'd like to see.",fields:[
            {id:'versions',type:'single',elabel:'Number of concepts',options:['1','2','3']}
          ]}
        ]
      },
      packaging:{
        label:'Packaging',
        headline:'Tell us about the product.',
        groups:[
          {title:'The product',fields:[
            {id:'product_name',type:'text',t:'Product & brand',q:"What's the product we're packaging?",req:true,ph:'e.g. Alchemy Peppers — Hot Sauce'},
            {id:'category',type:'text',t:'Category',q:'What category is it?',ph:'Food, beverage, beauty, supplement…'},
            {id:'what',type:'textarea',t:'What it is',q:'What is it, and what makes it different?',req:true},
            {id:'audience',type:'textarea',t:'Audience',q:"Who's it for?"}
          ]},
          {title:'Format & specs',fields:[
            {id:'formats',type:'multi',t:'Formats',q:'What formats are we designing?',options:['Box / carton','Bottle','Can','Jar','Pouch / bag','Label','Tube','Blister / clamshell','Shipper / mailer','Set / kit']},
            {id:'sku_count',type:'text',t:'SKUs / variants',q:'How many?',ph:'e.g. 3 flavors'},
            {id:'dimensions',type:'textarea',t:'Specs & dielines',q:'Known dimensions, materials, or dielines? (paste specs, or leave blank)'},
            {id:'sustainability',type:'single',t:'Sustainability',q:'Any requirements?',options:['Not a priority','Nice to have','Required / core to the brand']}
          ]},
          {title:'Practical',fields:[
            {id:'brand_exists',type:'single',t:'Existing brand',q:'Is there a brand to work within?',options:['Yes, established brand','Partial','No — needs branding too']},
            {id:'regulatory',type:'textarea',t:'Regulatory',q:'Nutrition panels, compliance, barcodes, etc.'},
            {id:'shelf',type:'textarea',t:'Where it sells',q:'Where will it sell, and what does it sit next to on shelf?'},
            {id:'references',type:'textarea',t:'References',q:'Packaging you admire (competitor or otherwise).'},
            {id:'printer',type:'single',t:'Printer / vendor',q:'Production lined up?',options:['Lined up already','Need a recommendation','Not sure yet']},
            {id:'deliverables',type:'multi',t:'Deliverables',q:'What do you need?',options:['Print-ready dielines','3D renders','Flat mockups','Photography direction','Multiple SKUs','Structural design']}
          ]}
        ]
      },
      web:{
        label:'Web Design',
        headline:'Tell us about the site.',
        groups:[
          {title:'The site',fields:[
            {id:'company',type:'text',t:'Company / brand',q:'What should we call you?',req:true},
            {id:'current_url',type:'url',t:'Current site',q:'If you have one.',ph:'https://'},
            {id:'goal',type:'single',t:'Main goal',q:"What's the site's main job?",options:['Generate leads / inquiries','Sell products (e-commerce)','Showcase work / portfolio','Inform / educate','Raise funding / credibility']},
            {id:'what',type:'textarea',t:'What & who',q:"What does the business do, and who's it for?",req:true}
          ]},
          {title:'Scope & content',fields:[
            {id:'pages',type:'multi',t:'Pages',q:'Which sections do you need?',options:['Home','About','Services','Work / Portfolio','Products / Shop','Pricing','Blog / Journal','Case studies','Contact','Careers','FAQ']},
            {id:'functionality',type:'multi',t:'Functionality',q:'Anything special?',options:['CMS / blog','E-commerce','Booking / scheduling','Membership / login','Forms','Multilingual','Animation / interactivity','Integrations','Search']},
            {id:'content_ready',type:'single',t:'Content',q:'Is your content ready?',options:['Copy & images ready','Some of it','Need help creating it']}
          ]},
          {title:'Look & feel',fields:[
            {id:'personality',type:'multi',t:'Feel',q:'How should it feel?',options:['Bold','Minimal','Editorial','Playful','Premium','Corporate','Warm','Technical','Immersive','Clean','Expressive']},
            {id:'references',type:'textarea',t:'Sites you love',q:'2–3 sites you love — and why.'},
            {id:'brand_ready',type:'single',t:'Brand assets',q:'Logo, colors, fonts?',options:['Yes, ready to use','Partial','Need branding too']}
          ]},
          {title:'Build',fields:[
            {id:'platform',type:'single',t:'Platform',q:'Any preference?',options:['No preference — recommend one','Custom build','Webflow','WordPress','Shopify','Framer']},
            {id:'deliverables',type:'multi',t:'Scope',q:'What do you want from us?',options:['Design only','Design + build','Copywriting','Photography','SEO setup','Ongoing maintenance']}
          ]}
        ]
      },
      development:{
        label:'Development',
        headline:"Tell us what we're building.",
        groups:[
          {title:'The build',fields:[
            {id:'company',type:'text',t:'Company / project',q:'What should we call it?',req:true},
            {id:'what_kind',type:'single',t:"What we're building",q:'Pick the closest.',options:['Marketing / brochure site','Web app','E-commerce store','Internal tool / dashboard','API / integration','Not sure yet']},
            {id:'what',type:'textarea',t:'What it does',q:'Describe what it needs to do.',req:true},
            {id:'design_status',type:'single',t:'Design status',q:'Is there a design?',options:['Figma design ready','Rough wireframes','Nothing yet — need design too']},
            {id:'figma_url',type:'url',t:'Design link',q:'Figma or files, if any.',ph:'https://'}
          ]},
          {title:'Functionality',fields:[
            {id:'features',type:'multi',t:'Core features',q:'What does it need?',options:['User accounts / auth','Payments','CMS','Dashboard / admin','Search','Notifications','File uploads','Real-time / live data','AI / LLM features','Maps / location']},
            {id:'integrations',type:'textarea',t:'Integrations',q:'Third-party APIs? (Stripe, HubSpot, etc.)'},
            {id:'existing_code',type:'single',t:'Codebase',q:'Starting from?',options:['Greenfield / brand new','Existing code to extend','Migration / rebuild']}
          ]},
          {title:'Practical',fields:[
            {id:'stack',type:'text',t:'Tech stack',q:'Preferences or constraints?',ph:'Optional'},
            {id:'hosting',type:'text',t:'Hosting',q:'Infra preferences, if any.',ph:'Optional'},
            {id:'requirements',type:'multi',t:'Priorities',q:'What matters most?',options:['Performance','SEO','Accessibility','Scalability','Security / compliance','Analytics']},
            {id:'maintenance',type:'single',t:'Support',q:'After launch?',options:['Yes, ongoing','Handoff to our team','Not sure']}
          ]}
        ]
      }
    };

    var PICKER_META=[
      ['branding','Identity, logo, art direction & guidelines'],
      ['packaging','Structure, dielines, print-ready & renders'],
      ['web','Sites, landing pages, UX & interaction'],
      ['development','Web apps, e-commerce, tools & builds']
    ];

    var state={discipline:null,colors:[null,null,null],editing:-1};
    var DEFAULT_HEX='#8A7556';
    var PENCIL_SVG='<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>';

    (function(){
      var p=document.getElementById('picker');
      PICKER_META.forEach(function(m,i){
        var key=m[0],desc=m[1],d=DISCIPLINES[key];
        var b=document.createElement('button');
        b.type='button';b.className='pcard';b.setAttribute('data-key',key);
        b.innerHTML='<span class="idx mono">0'+(i+1)+'</span><span class="arrow">&rarr;</span>'+
          '<h3>'+d.label+'</h3><p>'+desc+'</p>';
        b.addEventListener('click',function(){selectDiscipline(key);});
        p.appendChild(b);
      });
    })();

    function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

    function groupsFor(key){ return [LEAD].concat(DISCIPLINES[key].groups,[TAIL]); }

    function fmt(n){ return Number(n).toLocaleString('en-US'); }
    function fieldHTML(f){
      var reqDot='';
      var title=f.t?'<span class="q-title">'+reqDot+esc(f.t)+'</span>':'';
      var sub=f.q?'<span class="q-sub">'+esc(f.q)+'</span>':'';
      var hint=f.hint?'<span class="hint">'+esc(f.hint)+'</span>':'';
      var inner='';
      if(f.type==='text'||f.type==='email'||f.type==='url'){
        var t=f.type==='text'?'text':f.type;
        inner='<input type="'+t+'" id="f_'+f.id+'" data-id="'+f.id+'" placeholder="'+esc(f.ph||'')+'">';
      }else if(f.type==='textarea'){
        inner='<textarea id="f_'+f.id+'" data-id="'+f.id+'" placeholder="'+esc(f.ph||'')+'"></textarea>';
      }else if(f.type==='single'){
        inner='<div class="pills" data-id="'+f.id+'">'+f.options.map(function(o){
          return '<label class="pill"><input type="radio" name="'+f.id+'" value="'+esc(o)+'">'+esc(o)+'</label>';
        }).join('')+'</div>';
      }else if(f.type==='multi'){
        inner='<div class="chips" data-id="'+f.id+'">'+f.options.map(function(o){
          return '<label class="chip"><input type="checkbox" value="'+esc(o)+'">'+esc(o)+'</label>';
        }).join('')+'</div>';
      }else if(f.type==='colors'){
        inner=colorsHTML();
      }else if(f.type==='range'){
        var pfx=f.prefix||'';var atmax=f.def>=f.max?'+':'';
        inner='<div class="rangewrap" data-id="'+f.id+'" data-prefix="'+pfx+'" data-max="'+f.max+'">'+
          '<div class="rangeval mono"><span class="rv">'+pfx+fmt(f.def)+atmax+'</span></div>'+
          '<input type="range" id="f_'+f.id+'" min="'+f.min+'" max="'+f.max+'" step="'+f.step+'" value="'+f.def+'">'+
          '<div class="rangeends mono"><span>'+pfx+fmt(f.min)+'</span><span>'+pfx+fmt(f.max)+'+</span></div>'+
        '</div>';
      }
      var labelInner=title+sub;
      var labelHTML=labelInner?('<label class="q" for="f_'+f.id+'">'+labelInner+'</label>'):'';
      return '<div class="field" data-field="'+f.id+'"'+(f.req?' data-req="1"':'')+
        ' data-type="'+f.type+'">'+labelHTML+hint+inner+'</div>';
    }

    function colorsHTML(){
      return '<div class="colorpick" data-id="colors">'+
        '<div class="color3" data-role="slots"></div>'+
        '<button type="button" class="coloradd" data-role="add">+ Add color</button>'+
        '<div class="coloredit" data-role="edit" hidden></div></div>';
    }

    function selectDiscipline(key){
      state.discipline=key;state.colors=[null,null,null];state.editing=-1;
      var d=DISCIPLINES[key];
      var groups=groupsFor(key);
      var form=document.getElementById('briefForm');
      form.innerHTML=groups.map(function(g){
        var desc=g.desc?'<p class="group-desc">'+esc(g.desc)+'</p>':'';
        return '<div class="group"><div class="group-title">'+esc(g.title)+'</div>'+desc+
          g.fields.map(fieldHTML).join('')+'</div>';
      }).join('');
      document.getElementById('form-headline').textContent=d.headline;
      document.getElementById('disc-label').textContent=d.label;
      document.getElementById('step-pick').style.display='none';
      document.getElementById('formwrap').style.display='block';
      document.getElementById('sent').style.display='none';
      wireForm();
      window.scrollTo(0,0);
      refreshScroll();
      updateProgress();
    }

    /* The form is injected after load, so Lenis' cached scroll limit is stale
       and the page won't scroll. Re-measure it (and nudge a resize) once the
       new content is laid out. */
    function refreshScroll(){
      requestAnimationFrame(function(){
        try{ if(window._lenis && window._lenis.resize) window._lenis.resize(); }catch(e){}
        window.dispatchEvent(new Event('resize'));
      });
    }

    function wireForm(){
      var form=document.getElementById('briefForm');
      form.querySelectorAll('.pills').forEach(function(box){
        box.querySelectorAll('.pill').forEach(function(pill){
          pill.addEventListener('click',function(){
            box.querySelectorAll('.pill').forEach(function(p){p.classList.remove('on');});
            pill.classList.add('on');pill.querySelector('input').checked=true;updateProgress();
          });
        });
      });
      form.querySelectorAll('.chip').forEach(function(chip){
        chip.addEventListener('click',function(e){
          e.preventDefault();
          var inp=chip.querySelector('input');inp.checked=!inp.checked;
          chip.classList.toggle('on',inp.checked);updateProgress();
        });
      });
      var cp=form.querySelector('.colorpick');
      if(cp){ initColors(cp); }
      form.querySelectorAll('input,textarea').forEach(function(el){
        el.addEventListener('input',function(){
          var fld=el.closest('.field');if(fld)fld.classList.remove('invalid');updateProgress();
        });
      });
      form.querySelectorAll('input[type=range]').forEach(function(r){
        r.addEventListener('input',function(){
          var wrap=r.closest('.rangewrap');if(!wrap)return;var rv=wrap.querySelector('.rv');
          var pfx=wrap.getAttribute('data-prefix')||'';var mx=+wrap.getAttribute('data-max');var v=+r.value;
          rv.textContent=pfx+fmt(v)+(v>=mx?'+':'');
        });
      });
    }

    function initColors(cp){
      buildSlots(cp);
      cp.querySelector('[data-role="add"]').addEventListener('click',function(){
        if(state.colors.length>=5)return;
        state.colors.push(null);
        buildSlots(cp);
        openEditor(cp,state.colors.length-1);
      });
    }
    function buildSlots(cp){
      var wrap=cp.querySelector('[data-role="slots"]');
      wrap.innerHTML='';
      state.colors.forEach(function(c,i){
        var slot=document.createElement('div');
        slot.className='cslot'+(c?' filled':'')+(!c&&i>=3?' removable':'')+(state.editing===i?' editing':'');
        slot.setAttribute('data-slot',i);slot.setAttribute('tabindex','0');
        var label=c?c:('0'+(i+1));
        slot.innerHTML='<span class="cslot-face" style="background:'+(c||'transparent')+'"></span>'+
          '<span class="cslot-hex mono">'+label+'</span>'+
          '<button type="button" class="cslot-clear" aria-label="Clear or remove color">&times;</button>';
        slot.addEventListener('click',function(e){
          if(e.target.classList.contains('cslot-clear'))return;
          openEditor(cp,i);
        });
        slot.addEventListener('keydown',function(e){
          if(e.key==='Enter'||e.key===' '){e.preventDefault();openEditor(cp,i);}
        });
        slot.querySelector('.cslot-clear').addEventListener('click',function(e){
          e.preventDefault();e.stopPropagation();
          if(state.colors[i]){ state.colors[i]=null; buildSlots(cp); updateProgress(); }
          else if(i>=3){ state.colors.splice(i,1); closeEditor(cp); updateProgress(); }
        });
        wrap.appendChild(slot);
      });
      var add=cp.querySelector('[data-role="add"]');
      if(add) add.hidden = state.colors.length>=5;
    }
    function openEditor(cp,i){
      state.editing=i;
      var val=state.colors[i]||DEFAULT_HEX;
      var ed=cp.querySelector('[data-role="edit"]');
      ed.innerHTML='<div class="ce-inner">'+
        '<span class="ce-label mono">Color 0'+(i+1)+'</span>'+
        '<span class="ce-swatch" title="Click to open the color picker">'+
          '<span class="ce-fill" style="background:'+val+'"></span>'+
          '<input type="color" class="ce-native" value="'+val+'">'+
          '<span class="ce-badge" aria-hidden="true">'+PENCIL_SVG+'</span>'+
        '</span>'+
        '<span class="ce-hint mono">Click to pick</span>'+
        '<span class="ce-hashwrap"># <input type="text" class="ce-hex" maxlength="6" spellcheck="false" value="'+val.replace('#','').toUpperCase()+'"></span>'+
        '<button type="button" class="ce-done">Done</button></div>';
      ed.hidden=false;
      var native=ed.querySelector('.ce-native');
      var hex=ed.querySelector('.ce-hex');
      var fill=ed.querySelector('.ce-fill');
      native.addEventListener('input',function(){
        var v=native.value.toUpperCase();state.colors[i]=v;hex.value=v.replace('#','');fill.style.background=v;
        buildSlots(cp);updateProgress();
      });
      hex.addEventListener('input',function(){
        var raw=hex.value.replace(/[^0-9a-fA-F]/g,'').toUpperCase();
        if(raw!==hex.value)hex.value=raw;
        var norm=null;
        if(raw.length===6)norm='#'+raw;
        else if(raw.length===3)norm='#'+raw[0]+raw[0]+raw[1]+raw[1]+raw[2]+raw[2];
        if(norm){state.colors[i]=norm;native.value=norm;fill.style.background=norm;buildSlots(cp);updateProgress();}
      });
      ed.querySelector('.ce-done').addEventListener('click',function(){closeEditor(cp);});
      buildSlots(cp);
      hex.focus();
    }
    function closeEditor(cp){
      state.editing=-1;
      var ed=cp.querySelector('[data-role="edit"]');
      if(ed){ ed.hidden=true; ed.innerHTML=''; }
      buildSlots(cp);
    }

    function updateProgress(){
      var form=document.getElementById('briefForm');if(!form)return;
      var fields=form.querySelectorAll('.field');var filled=0;
      fields.forEach(function(fld){if(fieldValue(fld))filled++;});
      var pct=fields.length?Math.round(filled/fields.length*100):0;
      document.getElementById('progbar').style.width=pct+'%';
    }

    function fieldValue(fld){
      var type=fld.getAttribute('data-type');
      if(type==='colors'){var v=state.colors.filter(Boolean);return v.length?v.join(', '):'';}
      if(type==='range'){var wrap=fld.querySelector('.rangewrap');var r=fld.querySelector('input[type=range]');if(!r||!wrap)return '';var pfx=wrap.getAttribute('data-prefix')||'';var mx=+wrap.getAttribute('data-max');var v=+r.value;return pfx+fmt(v)+(v>=mx?'+':'');}
      if(type==='single'){var c=fld.querySelector('input:checked');return c?c.value:'';}
      if(type==='multi'){var v=[];fld.querySelectorAll('input:checked').forEach(function(i){v.push(i.value);});return v.join(', ');}
      var el=fld.querySelector('input,textarea');return el?el.value.trim():'';
    }

    function buildBrief(){
      var d=DISCIPLINES[state.discipline];
      var form=document.getElementById('briefForm');
      var groups=form.querySelectorAll('.group');
      var groupData=groupsFor(state.discipline);
      var lines=[];
      lines.push('COGNAK — PROJECT BRIEF');
      lines.push('Discipline: '+d.label);
      lines.push('');
      groups.forEach(function(gEl,gi){
        var g=groupData[gi];var section=[];
        g.fields.forEach(function(f){
          var fld=gEl.querySelector('[data-field="'+f.id+'"]');
          var val=fld?fieldValue(fld):'';
          if(val){section.push((f.t||f.q||f.elabel||f.id)+'\n  '+val);}
        });
        if(section.length){
          lines.push('-- '+g.title.toUpperCase()+' --');
          lines.push(section.join('\n\n'));
          lines.push('');
        }
      });
      return lines.join('\n');
    }

    function validate(){
      var form=document.getElementById('briefForm');var ok=true;var first=null;
      form.querySelectorAll('.field[data-req="1"]').forEach(function(fld){
        if(!fieldValue(fld)){ok=false;fld.classList.add('invalid');if(!first)first=fld;}
      });
      if(first)first.scrollIntoView({behavior:'smooth',block:'center'});
      return ok;
    }

    document.getElementById('sendBtn').addEventListener('click',function(){
      if(!validate()){document.getElementById('formErr').style.display='block';return;}
      document.getElementById('formErr').style.display='none';
      var d=DISCIPLINES[state.discipline];
      var who=firstFilled(['brand_name','product_name','company','your_name'])||'New';
      var subject='New '+d.label+' brief — '+who;
      var body=buildBrief();
      var href='mailto:'+DELIVER_TO+'?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);
      window.location.href=href;
      setTimeout(showSent,600);
    });
    document.getElementById('copyBtn').addEventListener('click',function(){
      var body=buildBrief();var msg=document.getElementById('copiedMsg');
      function done(){msg.classList.add('show');setTimeout(function(){msg.classList.remove('show');},2200);}
      if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(body).then(done,done);}
      else{var ta=document.createElement('textarea');ta.value=body;document.body.appendChild(ta);ta.select();
        try{document.execCommand('copy');}catch(e){}document.body.removeChild(ta);done();}
    });
    function firstFilled(ids){
      var form=document.getElementById('briefForm');
      for(var i=0;i<ids.length;i++){var fld=form.querySelector('[data-field="'+ids[i]+'"]');
        if(fld){var v=fieldValue(fld);if(v)return v;}}
      return '';
    }
    function showSent(){
      document.getElementById('formwrap').style.display='none';
      document.getElementById('sent').style.display='block';
      window.scrollTo(0,0);refreshScroll();
    }
    document.getElementById('backBtn').addEventListener('click',function(){
      document.getElementById('formwrap').style.display='none';
      document.getElementById('step-pick').style.display='block';
      window.scrollTo(0,0);refreshScroll();
    });
    document.getElementById('restartBtn').addEventListener('click',function(){
      document.getElementById('sent').style.display='none';
      document.getElementById('step-pick').style.display='block';
      window.scrollTo(0,0);refreshScroll();
    });

    (function(){
      var els=document.querySelectorAll('.rise');
      els.forEach(function(el,i){setTimeout(function(){el.classList.add('in');},120+i*90);});
    })();
  </script>

  <script is:inline>
    /* Fade the WebGL background in once UnicornStudio mounts its canvas
       (with a timed fallback), matching the site's hero fade. */
    (function(){
      var el=document.querySelector('.brief-webgl');
      if(!el) return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      function ready(){ el.classList.add('webgl-ready'); }
      if('MutationObserver' in window){
        var mo=new MutationObserver(function(){ if(el.querySelector('canvas')){ ready(); mo.disconnect(); } });
        mo.observe(el,{childList:true,subtree:true});
        setTimeout(function(){ ready(); mo.disconnect(); }, 4000);
      } else {
        setTimeout(ready, 1200);
      }
    })();
  </script>
</BaseLayout>
