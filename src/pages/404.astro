---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="404"
  title="Page not found – COGNAK"
  description="The page you were looking for doesn't exist."
  noindex={true}
  pageBg="#6F6F6F"
>
  <style is:inline>
    /* Lost pulse-dot canvas: fixed full-viewport like the projects matrix glow,
       but layered UNDER the content so the dot never wanders across the copy. */
    #fourofour-dot-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }
    .fourofour-template { position: relative; z-index: 1; }
  </style>
  <canvas id="fourofour-dot-canvas" aria-hidden="true"></canvas>
  <main id="cognak-main">
    <section class="fourofour-template">
      <h1 class="fourofour-headline">You've caught us in a <span class="fourofour-accent">404 error.</span><br>This page doesn't exist <span class="fourofour-frown" aria-hidden="true"><span class="ff-eyes">:</span><span class="ff-mouth">(</span></span></h1>
      <p class="fourofour-body">You accidentally followed a dead link, mistyped something, or we moved it without telling anyone. Either way, we're glad you're here.</p>
      <div class="fourofour-buttons">
        <a href="/projects" class="fourofour-btn">View projects</a>
        <a href="/studio" class="fourofour-btn">Discover the studio</a>
      </div>
    </section>
  </main>

  <script is:inline>
    /* CTA entrance. Deliberately its OWN script, above the canvas one and with
       no early return of any kind: the CTAs are hidden by `html.js
       .fourofour-btn{opacity:0}` in custom.css, so whatever reveals them must
       run unconditionally. Putting this inside the canvas IIFE below would
       strand them invisible for every reduced-motion visitor, since that block
       returns before doing anything. */
    (function () {
      var btns = document.querySelectorAll('.fourofour-btn');
      if (!btns.length) return;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      btns.forEach(function (b, i) {
        // After the body copy's own stagger, then 90ms apart.
        setTimeout(function () { b.classList.add('is-in'); }, reduced ? 0 : 620 + i * 90);
      });
    })();
  </script>

  <script is:inline>
    // ── Lost pulse-dot: a lone avail-dot-green dot wanders the page looking
    //    for the missing page, leaving a fading trail. Pauses now and then
    //    and shows a small "?" while it thinks.
    (function () {
      var canvas = document.getElementById('fourofour-dot-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      /* Reduced motion used to `return` here, which left the page as flat gray
         with no subject at all — the dot IS the page's idea, and losing all of
         it is a worse outcome than losing the movement. Now it draws a single
         static dot instead: same character, no animation. */
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var GREEN = '170,255,0'; // #AAFF00 — same green as the availability dot
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var W, H;

      function resize() {
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      window.addEventListener('resize', resize);
      resize();

      var dot = { x: W * 0.72, y: H * 0.6, vx: 0, vy: 0, tx: 0, ty: 0, trail: [], pause: 0, scare: 0 };

      /* The dot is looking for the missing page — so now and then it drifts
         over one of the two ways out. Roughly one waypoint in three targets a
         CTA's rect instead of open space, which over a few cycles reads as the
         lost thing quietly showing you the exits. No new UI, no pointing: it
         just spends time where the links are.

         Rects are read at pick() time rather than cached, so this stays correct
         after a resize or scroll without any invalidation bookkeeping — it runs
         a handful of times a minute, not per frame. getBoundingClientRect is in
         viewport coordinates, which is what the fixed canvas draws in. */
      var EXIT_BIAS = 0.34;
      function exitTarget() {
        var els = document.querySelectorAll('.fourofour-btn');
        if (!els.length) return null;
        var r = els[Math.floor(Math.random() * els.length)].getBoundingClientRect();
        if (r.width < 1 || r.bottom < 0 || r.top > H) return null;
        // Anywhere along the link, biased just below its baseline so the dot
        // passes under the words rather than sitting on top of them.
        return {
          x: r.left + Math.random() * r.width,
          y: r.top + r.height * (0.65 + Math.random() * 0.5)
        };
      }
      function pick() {
        if (Math.random() < EXIT_BIAS) {
          var e = exitTarget();
          if (e) {
            dot.tx = Math.max(14, Math.min(W - 14, e.x));
            dot.ty = Math.max(14, Math.min(H - 14, e.y));
            return;
          }
        }
        dot.tx = 40 + Math.random() * (W - 80);
        dot.ty = 40 + Math.random() * (H - 80);
      }
      pick();

      // The dot is lost and skittish — get the cursor close and it darts away.
      var mouse = { x: -9999, y: -9999 };
      document.addEventListener('mousemove', function (e) {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      }, { passive: true });

      function frame() {
        ctx.clearRect(0, 0, W, H);

        // Flee the cursor: burst of velocity away from it, pause interrupted.
        var mx = dot.x - mouse.x;
        var my = dot.y - mouse.y;
        var md = Math.sqrt(mx * mx + my * my);
        if (md < 130 && md > 0) {
          var f = ((130 - md) / 130) * 1.6;
          dot.vx += (mx / md) * f;
          dot.vy += (my / md) * f;
          dot.pause = 0;
          if (dot.scare === 0) pick(); // change its mind about where it was going
          dot.scare = 40; // suppress the calm waypoint easing while spooked
        }
        if (dot.scare > 0) dot.scare--;
        dot.vx *= 0.92;
        dot.vy *= 0.92;
        dot.x += dot.vx;
        dot.y += dot.vy;
        // Keep it on screen when it darts toward an edge.
        if (dot.x < 14) { dot.x = 14; dot.vx = Math.abs(dot.vx); }
        if (dot.x > W - 14) { dot.x = W - 14; dot.vx = -Math.abs(dot.vx); }
        if (dot.y < 14) { dot.y = 14; dot.vy = Math.abs(dot.vy); }
        if (dot.y > H - 14) { dot.y = H - 14; dot.vy = -Math.abs(dot.vy); }

        if (dot.pause > 0) {
          dot.pause--;
        } else if (dot.scare === 0) {
          var dx = dot.tx - dot.x;
          var dy = dot.ty - dot.y;
          if (Math.sqrt(dx * dx + dy * dy) < 6) {
            dot.pause = 60 + Math.random() * 160; // stop and look around
            pick();
          } else {
            dot.x += dx * 0.012;
            dot.y += dy * 0.012;
          }
        }

        dot.trail.push({ x: dot.x, y: dot.y, a: 0.5 });
        if (dot.trail.length > 90) dot.trail.shift();
        for (var i = 0; i < dot.trail.length; i++) {
          var t = dot.trail[i];
          t.a *= 0.985;
          ctx.beginPath();
          ctx.arc(t.x, t.y, 1.4, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(' + GREEN + ',' + (t.a * (i / dot.trail.length)).toFixed(3) + ')';
          ctx.fill();
        }

        ctx.beginPath();
        ctx.arc(dot.x, dot.y, 3.2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgb(' + GREEN + ')';
        ctx.fill();
        // Blip ring, matching the sitewide .avail-dot::after dot-blip keyframes:
        // ring emerges from the dot, expands to ~2.8x, fades 0.8 -> 0, 2.5s ease-out.
        var p = (performance.now() % 2500) / 2500;
        var eased = 1 - Math.pow(1 - p, 3); // ease-out
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, 3.2 + eased * 8, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(' + GREEN + ',' + (0.8 * (1 - p)).toFixed(3) + ')';
        ctx.lineWidth = 1;
        ctx.stroke();

        if (dot.pause > 30) {
          ctx.font = '12px "Diatype Mono", ui-monospace, monospace';
          ctx.fillStyle = 'rgba(255,255,255,0.55)';
          ctx.fillText('?', dot.x + 11, dot.y - 11);
        }

        if (!reduced) requestAnimationFrame(frame);
      }

      if (reduced) {
        /* One still frame: the dot parked near a CTA with its ring, no trail,
           no loop. Redrawn on resize so it doesn't end up off-screen. */
        function still() {
          ctx.clearRect(0, 0, W, H);
          var e = exitTarget();
          var x = e ? e.x : W * 0.72;
          var y = e ? e.y : H * 0.6;
          ctx.beginPath();
          ctx.arc(x, y, 3.2, 0, Math.PI * 2);
          ctx.fillStyle = 'rgb(' + GREEN + ')';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(x, y, 9, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(' + GREEN + ',0.34)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        window.addEventListener('resize', function () { resize(); still(); });
        // After layout settles, so exitTarget() measures the real CTA position.
        window.addEventListener('load', still);
        still();
      } else {
        requestAnimationFrame(frame);
      }
    })();
  </script>
</BaseLayout>
