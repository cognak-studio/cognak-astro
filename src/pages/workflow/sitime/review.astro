      if (state.orig && state.orig.id !== s.id) state.orig = null;
      const oi = state.orig ? Math.min(state.orig.k, origs.length - 1) : -1;
      const og = oi >= 0 ? origs[oi] : null;
      $('orig').hidden = !origs.length;
      $('orig').classList.toggle('on', !!og);
      $('orig').textContent = og ? 'Back to comp' : 'Show original';
      $('st-hero').classList.toggle('orig', !!og);
      $('st-hero').classList.toggle('clean', state.clean);
      $('st-hero').classList.toggle('card', s.display === 'card');
      const mk = !og && (s.display === 'burst' || s.display === 'arm') ? s.display : '';
      $('st-hero').classList.toggle('masked', !!mk);
      $('st-hero').classList.toggle('m-burst', mk === 'burst');
      $('st-hero').classList.toggle('m-arm', mk === 'arm');
      $('clean').classList.toggle('on', state.clean);
      $('clean').setAttribute('aria-pressed', String(state.clean));
      $('clean').textContent = state.clean ? 'Show text' : 'Hide text';
      $('clean').hidden = !!og;
      /* B&W / Color swap (Pierce, 9/24). On a review link it only changes the
         view (bwView, not saved). In Preview it sets the pick's treatment and
         saves it back to the admin, same as the framing controls. */
      const bwKey = s.id + ':' + which;
      const bwOn = pick ? (bwKey in state.bwView ? state.bwView[bwKey] : !!pick.bw) : false;
      $('bwbtn').hidden = !!og || !(pick && pick.url);
      $('bwbtn').textContent = bwOn ? 'Show color' : 'Show B&W';
      $('bwbtn').classList.toggle('on', bwOn);
      $('pills').classList.toggle('off', !!og);
      $('ctxbtn').hidden = !s.context;
      if (og) document.querySelectorAll('#which button').forEach((btn) => btn.classList.remove('on'));
      const heroUrl = og ? og.url : ((pick && pick.url) || '');
      $('hero-img').src = heroUrl; $('hero-img').hidden = !heroUrl; $('noimg').hidden = !!heroUrl;
      /* COGNAK's treatment on the pick (B&W, flipped); never on the current-site original. */
      $('hero-img').style.filter = !og && bwOn ? 'grayscale(1)' : '';
      applyFrame(s, og ? null : pick);
      const canFrame = LP && !og && !!(pick && pick.url);
