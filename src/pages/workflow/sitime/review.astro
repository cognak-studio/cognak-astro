---
/**
 * /workflow/sitime/review — the SiTime image review page.
 * Reached as cognak.com/workflow/sitime/<batch-token> via a vercel.json
 * rewrite; also readable as /workflow/sitime/review?b=<token> under astro dev.
 *
 * One shared link per batch, no login: SiTime (Judy, Greg, Dela) decide as a
 * group and one person clicks, or COGNAK clicks on a call. Each screen shows
 * one image where it will sit on the new site (a fixed hero mock: nav, the
 * same three lines of copy every time, a red button), with approve / deny /
 * hold above it and an optional note. Deny the main and the backup appears
 * in the same spot. Decisions post to /api/sitime-decide.js as append-only
 * events; the admin side reads them back.
 *
 * Design: the cognak.com utility-page pattern (fixed nav, accent-first-word
 * headline, lede, one white card with mono labels) in the light version
 * Pierce chose 2026-09-14 — white nav, off-white ground, Diatype, the /tools
 * purple, decision buttons outlined at rest and coloured on hover/selected.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  page="workflow"
  title="Review images for sitime.com — COGNAK"
  description="Image review for the new sitime.com."
  ogUrl="https://cognak.com/workflow/sitime/"
  noindex={true}
  pageBg="#F4F4F2"
>

  <main id="cognak-main"><section class="review">

    <h1 class="headline"><em>Review</em> the images.</h1>

    <div class="card rise" id="loading"><div class="group"><div class="group-title">Loading</div><p class="hint">One moment.</p></div></div>

    <div class="card rise" id="gate" hidden><div class="group"><div class="group-title">Passcode</div>
      <label class="q" for="pass"><span class="q-title">Enter the review passcode.</span></label>
      <div class="passrow"><input class="txt" id="pass" type="password" autocomplete="off" autocapitalize="off" /><button type="button" class="btn" id="pass-go">Continue</button></div>
      <p class="hint is-error" id="pass-err" hidden></p>
    </div></div>

    <div class="card rise" id="invalid" hidden><div class="group"><div class="group-title">This link</div><p class="hint" id="invalid-note">This link isn't complete. Open it again from the Batches tab.</p></div></div>

    <div class="card rise" id="card" hidden>
      <div class="group">
        <div class="group-title"><span id="batch-label">Batch</span><span class="bar"><i id="bar"></i></span></div>
        <div class="field">
          <span class="q-title" id="slot-title">Slot</span>
          <span class="q-sub q-where" id="slot-where" hidden></span>
          <span class="q-sub" id="slot-sub"></span>
          <div class="pills" id="pills" role="group" aria-label="Decision">
            <button type="button" class="pill" data-v="approve">Approve</button>
            <button type="button" class="pill" data-v="deny">Deny</button>
            <button type="button" class="pill" data-v="hold">Hold</button>
          </div>
          <div class="note" id="note" hidden>
            <textarea id="note-text" placeholder="Optional. What's wrong with it, or what to look for instead."></textarea>
            <div class="actions">
              <button type="button" class="btn" id="submit">Submit and continue <span aria-hidden="true">→</span></button>
              <button type="button" class="skip" id="skip">Skip for now</button>
              <span class="saving" id="saving" hidden>Saving…</span>
            </div>
            <p class="hint is-error" id="err" hidden></p>
          </div>
          <div class="statusslot"><p class="handoff" id="handoff" hidden></p><p class="decided" id="decided" hidden></p></div>
        </div>

        <div class="stage-wrap">
          <div class="stage-head"><span class="label-line"><span class="count" id="progress">0 of 0</span><span class="which" id="which" role="group" aria-label="Image"><button type="button" data-w="main">Main</button><button type="button" data-w="backup">Backup</button></span><button type="button" class="origbtn" id="orig" hidden>Show original</button><button type="button" class="origbtn" id="clean" aria-pressed="false">Hide text</button><button type="button" class="origbtn" id="bwbtn" hidden>Color</button><button type="button" class="origbtn" id="ctxbtn" hidden>Context</button></span><div class="arrows"><button type="button" id="prev" aria-label="Previous">←</button><button type="button" id="next" aria-label="Next">→</button></div></div>
          <div class="stage" id="stage"><div class="st-inner">
            <div class="st-nav">
              <img class="mark" src="/media/sitime/logo.svg" alt="SiTime" />
              <div class="links"><span>Products</span><span>Applications</span><span>Tools &amp; Resources</span><span>Support</span><span>Company</span></div>
              <div class="right"><span>Search</span><span>Sign in</span><span class="cta">Sample &amp; Buy</span></div>
            </div>
            <svg class="maskdefs" width="0" height="0" aria-hidden="true" style="position:absolute"><clipPath id="mask-burst" clipPathUnits="objectBoundingBox" transform="scale(0.000975609756,0.000975609756)"><path d="M980.163 676.347L715.21 568.762V607.109C706.764 710.586 813.978 778.987 888.092 835.443C896.005 841.454 907.343 840.313 913.431 832.476C944.857 791.922 970.804 747.107 990.208 699.782C993.936 690.575 989.294 680.076 980.087 676.347H980.163Z"/><path d="M715.211 417.799V456.147L980.164 348.561C989.371 344.833 994.012 334.257 990.284 325.126C970.88 277.801 944.933 232.986 913.507 192.433C907.419 184.596 896.082 183.454 888.168 189.465C813.902 246.073 706.917 314.17 715.287 417.799H715.211Z"/><path d="M607.159 309.757C710.568 318.202 779.051 210.997 835.511 136.813C841.523 128.9 840.305 117.564 832.544 111.477C791.987 80.0533 747.168 54.1079 699.839 34.706C690.632 30.9017 680.131 35.619 676.327 44.8254L568.732 309.757H607.159Z"/><path d="M564.928 309.765L604.344 25.66C605.714 15.8449 598.865 6.48633 589.05 5.19287C537.916 -1.73096 487.086 -1.73096 435.876 5.19287C426.06 6.56242 419.212 15.8449 420.581 25.66L459.997 309.765H564.928Z"/><path d="M417.766 309.759H456.117L348.598 44.8274C344.87 35.621 334.293 30.9797 325.086 34.7079C277.757 54.186 232.938 80.0552 192.381 111.479C184.544 117.566 183.402 128.902 189.414 136.815C246.026 211.075 314.129 317.976 417.766 309.683V309.759Z"/><path d="M44.8381 348.645L309.791 456.231V417.883C318.237 314.406 211.023 246.005 136.91 189.549C128.996 183.538 117.658 184.68 111.571 192.517C80.1449 233.07 54.1974 277.885 34.7939 325.211C31.0654 334.417 35.707 344.917 44.9142 348.645H44.8381Z"/><path d="M309.714 460.031L25.6621 420.618C15.8462 419.249 6.48686 426.096 5.19329 435.911C-1.7311 487.041 -1.7311 537.943 5.19329 589.073C6.56295 598.888 15.8462 605.735 25.6621 604.366L309.79 564.953V460.031H309.714Z"/><path d="M309.715 607.179V568.832L44.762 676.418C35.5548 680.146 30.9132 690.722 34.6417 699.928C54.0452 747.254 79.9926 792.068 111.419 832.622C117.506 840.459 128.844 841.6 136.757 835.589C211.023 778.981 317.933 710.885 309.639 607.255L309.715 607.179Z"/><path d="M417.766 715.221C314.281 706.776 245.874 813.981 189.413 888.165C183.402 896.078 184.62 907.414 192.457 913.501C233.014 944.925 277.832 970.87 325.162 990.272C334.369 994.076 344.87 989.359 348.674 980.153L456.269 715.221H417.766Z"/><path d="M459.997 715.235L420.581 999.34C419.212 1009.16 426.06 1018.51 435.876 1019.81C487.01 1026.73 537.916 1026.73 589.05 1019.81C598.865 1018.44 605.714 1009.16 604.344 999.34L564.928 715.235H459.997Z"/><path d="M568.809 715.223L676.404 980.154C680.132 989.36 690.709 994.002 699.916 990.273C747.245 970.871 791.988 944.926 832.621 913.503C840.458 907.416 841.6 896.079 835.589 888.166C778.976 813.906 710.873 706.929 607.236 715.223H568.809Z"/><path d="M1019.81 435.911C1018.44 426.096 1009.15 419.249 999.338 420.618L715.21 460.031V564.953L999.338 604.366C1009.15 605.735 1018.51 598.888 1019.81 589.073C1026.73 537.943 1026.73 487.041 1019.81 435.911Z"/></clipPath><clipPath id="mask-arm" clipPathUnits="objectBoundingBox" transform="scale(0.00114285714,0.00117096019)"><path d="M1.22263 732.317V853.28L838.921 513.912C868.031 502.152 882.706 468.791 870.917 439.99C809.57 290.707 727.532 149.343 628.173 21.4204C608.927 -3.30014 573.08 -6.90027 548.06 12.0602C313.254 190.624 -25.0004 405.429 1.46332 732.317H1.22263Z"/></clipPath></svg><div class="st-hero" id="st-hero"><div class="imgbox" id="imgbox"><img id="hero-img" src="" alt="" hidden /></div><div class="noimg" id="noimg">No image assigned to this slot yet</div><div class="scrim"></div>
              <div class="ccopy" aria-hidden="true"><span class="eyebrow"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>Event</span><h3 id="mock-card-h">How a Tier-1 OEM eliminated quartz failures in ADAS.</h3><p id="mock-card-p">Replacing 14 quartz parts with one MEMS platform across the radar stack.</p><span class="carrow">→</span></div>
              <div class="copy"><h2 id="mock-h1">Built for where others fail.</h2><p id="mock-p">From space to factory floors, SiTime timing holds when conditions don’t.</p><span class="btn-s" id="mock-cta">Learn more</span></div>
            </div>
          </div></div>
          <p class="pdesc" id="pdesc"></p>
          <div class="stage-foot"><span id="source"></span><span class="foot-r"><span id="source-note">Comp shown, licensed after approval</span><span class="ocyc" id="ocyc" hidden><button type="button" id="oprev" aria-label="Previous original">‹</button><span id="ocount"></span><button type="button" id="onext" aria-label="Next original">›</button></span></span></div>
          <div class="framebar" id="framebar" hidden><span>Drag the image to reframe</span><label>Zoom <input type="range" id="fzoom" min="1" max="2.5" step="0.01" value="1" /></label><span id="fval"></span><button type="button" class="origbtn" id="freset">Reset</button></div>
        </div>
      </div>
    </div>

    <div class="card rise summary" id="summary" hidden>
      <div class="group">
        <div class="group-title"><span id="sum-label">Batch</span><span class="sep">·</span><span>Complete</span><span class="bar"><i style="width:100%"></i></span></div>
        <span class="q-title">That's the batch. Thank you.</span>
        <span class="q-sub">COGNAK has the decisions. Replacements for anything denied come in the next batch; held images stay parked until you say otherwise.</span>
        <div class="counts"><div><b id="c-ok">0</b><span>approved</span></div><div><b id="c-deny">0</b><span>denied</span></div><div><b id="c-hold">0</b><span>held</span></div></div>
        <div id="sum-rows"></div>
        <div class="actions" style="margin-top:1.6rem"><button type="button" class="btn ghost" id="review-again">Look through them again</button></div>
      </div>
    </div>

    {/* Back to the batch list (Pierce, 2026-09-22) — same mono uppercase
       arrow link as /brief's "Change project type", under the card on the
       left, lined up with the card's own labels. */}
    {/* Only for someone signed in to the tool; on the shared link it led to the sign-in gate. */}
    <a class="backlink" id="backlink" href="/workflow/sitime/admin" hidden>&larr; Back to all batches</a>

    {/* Context (Pierce, 9/25): the whole page with this slot flashed in place. */}
    <div class="ctx" id="ctx" hidden role="dialog" aria-modal="true" aria-label="Where this image goes">
      <div class="ctx-bar">
        <div class="ctx-t"><b id="ctx-title"></b><span id="ctx-src"></span></div>
        <div class="ctx-r"><button type="button" class="origbtn" id="ctx-put" aria-pressed="true">Show this image in place</button><button type="button" class="origbtn" id="ctx-close">Close</button></div>
      </div>
      <div class="ctx-scroll" id="ctx-scroll"><div class="ctx-page" id="ctx-page"><img id="ctx-img" alt=""><div class="ctx-box" id="ctx-box"><img id="ctx-pick" alt=""></div></div></div>
    </div>

  </section></main>

  <style is:inline>
    /* The sitewide focus ring is brand purple (custom.css), built for the dark
       pages. This one is light, so the ring uses its own ink instead. */
    .review a:focus-visible, .review button:focus-visible, .review input:focus-visible,
    .review textarea:focus-visible, .review [tabindex]:focus-visible{ outline-color:#575049 !important; }
    @font-face{ font-family:'Onest'; src:url(/theme/assets/fonts/onest/Onest-300.ttf) format('truetype'); font-weight:300; font-style:normal; font-display:swap; }
    @font-face{ font-family:'Onest'; src:url(/theme/assets/fonts/onest/Onest-400.ttf) format('truetype'); font-weight:400; font-style:normal; font-display:swap; }
    @font-face{ font-family:'Onest'; src:url(/theme/assets/fonts/onest/Onest-500.ttf) format('truetype'); font-weight:500; font-style:normal; font-display:swap; }
    @font-face{ font-family:'Onest'; src:url(/theme/assets/fonts/onest/Onest-600.ttf) format('truetype'); font-weight:600; font-style:normal; font-display:swap; }
    html, body { background-color:#F4F4F2 !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }
    .review label, .review legend { display:block !important; }
    /* [hidden] loses to ANY author rule setting display on the same element
       (UA origin < author origin, regardless of specificity) -- .noimg sets
       display:flex to lay out its text, which silently cancelled every
       el.hidden = true/false toggle in render() and left it painted over
       the actual hero image even once one loaded. Same bug class as
       /send's passkey buttons (see hidden-attribute-css-bug memory);
       same fix: force it back to a hard override for this page. */
    .review [hidden]{ display:none !important; }

    /* ?preview=local: shown inside the admin's Preview modal. Just the stage,
       no site chrome, no decision controls. */
    html.lp .home-bottom-bar, html.lp .main-footer, html.lp #cognak-cookie, html.lp #cognak-scrollbar{ display:none !important; }
    html.lp, html.lp body{ background:#F4F4F2 !important; }
    html.lp .review{ max-width:none; padding:8px 10px 24px; }
    html.lp .review .headline, html.lp .review .lede, html.lp .review .backlink{ display:none !important; }
    html.lp .review #pills, html.lp .review #note, html.lp .review .statusslot{ display:none !important; }
    /* Reframing (Pierce, 9/24): preview only. Drag pans (object-position),
       the slider zooms around the same point; saved on the pick. */
    .review .framebar{ display:flex; align-items:center; gap:16px; margin-top:14px; font-family:'Diatype Mono', monospace; font-size:var(--fs-11); letter-spacing:.12em; text-transform:uppercase; color:var(--ink-soft); flex-wrap:wrap; }
    .review .framebar label{ display:inline-flex; align-items:center; gap:10px; }
    .review .framebar input[type=range]{ width:200px; accent-color:var(--head); }
    .review .framebar .origbtn{ margin-left:0; }
    html.lp .review .st-hero.canframe{ cursor:grab; touch-action:none; user-select:none; }
    html.lp .review .st-hero.canframe.dragging{ cursor:grabbing; }

    .review{ --bg:#F4F4F2; --card:#FFFFFF; --field:#FAFAF9; --ink:#1A1A1A; --ink-soft:#6B6B6B;
      --accent:#9B948A; --accent-rgb:155,148,138; --head:#575049; --deep:#1C1A17;
      --line:#E6E6E3; --line-strong:#CFCFCB; --ok:#5A9E00; --err:#E5231B;
      max-width:1040px; margin:0 auto; padding:190px 6vw 18vh; color:var(--ink); font-family:'Diatype Variable', sans-serif; }
    .review .headline{ font-size:clamp(24px,5.5vw,58px); font-weight:500; line-height:1.1; letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .review .headline em{ font-style:normal; font-weight:500; color:var(--head); }
    .review .lede{ font-size:var(--fs-17); text-wrap:pretty; line-height:1.65; color:var(--ink-soft); max-width:52ch; margin:0 0 3.4rem 40px; }
    .review .card{ background:var(--card); border-radius:12px; padding:34px 34px 30px; box-shadow:0 1px 2px rgba(0,0,0,.04),0 12px 40px rgba(0,0,0,.07); border:1px solid #ECECE9; position:relative; }
    .review .card + .card{ margin-top:22px; }
    .review .backlink{ position:relative; display:flex; width:fit-content; align-items:center; gap:.5rem;
      margin:1.8rem 0 0 34px; color:var(--ink-soft); font-family:'Diatype Mono', monospace; font-size:var(--fs-11);
      line-height:1.3; letter-spacing:.16em; text-transform:uppercase; text-decoration:none;
      transition:color var(--dur-s) var(--ease-standard); }
    .review .backlink::before{ content:""; position:absolute; inset:-12px -10px; }
    @media (hover:hover){ .review .backlink:hover{ color:var(--ink); } }
    .review .group{ border-top:1px solid var(--line); padding-top:2.2rem; margin-top:2.6rem; }
    .review .group:first-child{ border-top:none; padding-top:0; margin-top:0; }
    .review .group-title{ font-family:'Diatype Mono', monospace; font-size:var(--fs-11); letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.9rem; display:flex; align-items:center; gap:14px; }
    .review .group-title .bar{ flex:1; height:2px; background:var(--line); border-radius:2px; overflow:hidden; max-width:260px; margin-left:auto; }
    .review .group-title .bar i{ display:block; height:100%; width:6px; background:var(--accent); transition:width .3s var(--ease-standard); }
    .review .q-title{ display:block; font-size:var(--fs-17); font-weight:500; line-height:1.3; color:var(--ink); }
    .review .q-sub{ display:block; font-size:var(--fs-14); line-height:1.4; color:var(--ink-soft); margin-top:.2rem; max-width:60ch; }
    .review .hint{ font-size:var(--fs-15); color:var(--ink-soft); margin:0; }
    .review .hint.is-error{ color:var(--err); margin-top:10px; }
    .review .passrow{ display:flex; gap:12px; margin-top:12px; max-width:480px; }
    .review .txt{ flex:1; font:inherit; font-size:var(--fs-16); color:var(--ink); background:var(--field); border:1px solid var(--line-strong); border-radius:999px; padding:12px 18px; outline:none; }
    .review .txt:focus{ border-color:var(--accent); }
    .review .field{ margin-bottom:2rem; }
    .review .pills{ display:flex; gap:10px; flex-wrap:wrap; margin-top:1.1rem; }
    .review .pill{ font:inherit; display:inline-flex; align-items:center; border:1px solid var(--line-strong); border-radius:999px; padding:12px 24px; font-size:var(--fs-15); font-weight:500; color:var(--ink); background:none; cursor:pointer;
      transition:background var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard), border-color var(--dur-s) var(--ease-standard), box-shadow var(--dur-s) var(--ease-standard); }
    .review .pill[data-v=approve]{ --fill:#AAFF00; --stroke:#D9FF66; --on-ink:#152400; --glow:170,255,0; }
    .review .pill[data-v=hold]{ --fill:#FF7A00; --stroke:#FFB24D; --on-ink:#2A1200; --glow:255,122,0; }
    .review .pill[data-v=deny]{ --fill:#FF1E1E; --stroke:#FF7070; --on-ink:#fff; --glow:255,30,30; }
    @media (hover:hover){ .review .pill:hover{ background:var(--fill); color:var(--on-ink); border-color:var(--stroke); box-shadow:0 0 24px rgba(var(--glow),.38); } }
    .review .pill.on{ background:var(--fill); color:var(--on-ink); border-color:var(--stroke); box-shadow:0 0 24px rgba(var(--glow),.38); }
    .review .note{ margin-top:14px; }
    .review .note textarea{ width:100%; height:84px; resize:vertical; font:inherit; font-size:var(--fs-15); color:var(--ink); background:var(--field); border:1px solid var(--line-strong); border-radius:8px; padding:12px 14px; outline:none; }
    .review .note textarea:focus{ border-color:var(--accent); }
    .review .note textarea::placeholder{ color:#9A9A96; }
    .review .actions{ display:flex; align-items:center; gap:18px; margin-top:14px; flex-wrap:wrap; }
    .review .btn{ font:inherit; font-size:var(--fs-16); font-weight:500; display:inline-flex; align-items:center; gap:.6rem; border-radius:999px; padding:14px 28px; background:var(--accent); color:var(--deep); border:1px solid var(--accent); cursor:pointer; transition:filter var(--dur-s) var(--ease-standard); }
    .review .btn:hover:not(:disabled){ filter:brightness(1.06); }
    .review .btn:disabled{ opacity:.4; cursor:not-allowed; }
    .review .btn.ghost{ background:none; color:var(--ink); border-color:var(--line-strong); }
    .review .skip{ font:inherit; background:none; border:0; padding:0; color:var(--ink-soft); font-size:var(--fs-14); text-decoration:underline; text-underline-offset:3px; cursor:pointer; }
    .review .saving{ font-size:var(--fs-14); color:var(--ink-soft); }
    .review .decided{ margin:0; font-size:var(--fs-14); color:var(--ink-soft); }
    /* Fixed-height header (Pierce, 9/23): flipping Main / Backup / Show original
       changes the subtitle length, the "Decided" line and the denied-main
       banner, and each of those used to push the image down or pull it up.
       The subtitle reserves two lines and the banner + decided line share one
       reserved slot under the pills, so the stage stays put. Only opening the
       deny/hold note box still moves it, deliberately. */
    .review #slot-sub{ min-height:calc(2 * 1.4em); }
    /* Where the image sits on the page (seed `where`) and what the image is
       (pick.desc), 9/24. The description line keeps its height when empty so
       the source line under it doesn't move between slots. */
    .review .q-where{ color:var(--ink); margin-top:.35rem; min-height:calc(2 * 1.4em); }
    .review .pdesc{ margin:12px 0 0; font-size:var(--fs-14); line-height:1.45; color:var(--ink); min-height:1.45em; max-width:80ch; }
    .review .statusslot{ min-height:46px; margin-top:14px; display:flex; flex-direction:column; justify-content:flex-start; }
    .review .statusslot .handoff{ margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .review .statusslot .decided{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .review .statusslot .handoff:not([hidden]) + .decided{ display:none !important; }
    .review .decided b{ font-weight:500; color:var(--ink); }
    .review .handoff{ margin:12px 0 0; padding:10px 14px; border-radius:8px; background:#FDF2F2; border:1px solid #F3D2D2; color:#8A2A2A; font-size:var(--fs-14); line-height:1.5; }
    .review .handoff b{ font-weight:600; }

    .review .stage-wrap{ margin-top:.4rem; }
    /* The toolbar wraps as a whole row (arrows drop under the buttons on a
       phone); the pills themselves never break mid-label. Before this, "SHOW
