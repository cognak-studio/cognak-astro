       Card: headline and text; the Event label and icon stay fixed. A blank
       field keeps the default in the markup. */
    function applyMock(m) {
      [['mock-h1', 'h1'], ['mock-p', 'p'], ['mock-cta', 'cta'], ['mock-card-h', 'cardH'], ['mock-card-p', 'cardP']].forEach(([id, k]) => { if (m[k]) $(id).textContent = m[k]; });
    }
    function getToken() {
      const m = location.pathname.match(/\/workflow\/sitime\/([a-z0-9]{8,16})\/?$/);
      if (m) return m[1];
      const q = new URLSearchParams(location.search).get('b');
      return q && /^[a-z0-9]{8,16}$/.test(q) ? q : '';
    }

    async function api(path, body) {
      const res = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}), credentials: 'same-origin' });
      let json = null; try { json = await res.json(); } catch (e) {}
      return { ok: res.ok, status: res.status, data: json };
    }

    function fit() {
      const st = $('stage'); if (!st) return;
      st.style.setProperty('--scale', (st.clientWidth / 1584).toFixed(4));
    }
    window.addEventListener('resize', fit);

    const LP = new URLSearchParams(location.search).get('preview') === 'local';
    if (LP) document.documentElement.classList.add('lp');
    const token = getToken();
    const state = { batch: null, slots: [], decisions: {}, i: 0, pending: null, view: {}, orig: null, clean: false, bwView: {} };
    try { state.clean = localStorage.getItem('sitime-review-clean') === '1'; } catch (e) {}
    let pass = '';
    try { pass = sessionStorage.getItem('sitime-pass-' + token) || ''; } catch (e) {}

    /* One rule for a slot's outcome, shared verbatim by admin.astro,
       review.astro and sitimeStore.mjs. Either image can be decided at any
       time (the reviewer can flip to the backup before denying the main):
         - any approve wins; if both are approved, the newest one
         - otherwise any hold wins, newest first
         - denied only once every image is denied (main, and backup if any)
         - otherwise pending, on the main unless the main is denied */
    function resolveOutcome(m, b, hasBackup) {
      const at = (e) => Number(e && e.at) || 0;
      const evs = [m && { w: 'main', e: m }, hasBackup && b && { w: 'backup', e: b }].filter(Boolean);
      const top = (d) => evs.filter((x) => x.e.decision === d).sort((x, y) => at(y.e) - at(x.e))[0];
      const ap = top('approve'); if (ap) return { outcome: 'approved', which: ap.w, ev: ap.e };
      const ho = top('hold'); if (ho) return { outcome: 'held', which: ho.w, ev: ho.e };
      const mDen = !!(m && m.decision === 'deny');
      const bDen = !hasBackup || !!(b && b.decision === 'deny');
      const de = top('deny');
      if (mDen && bDen) return { outcome: 'denied', which: de.w, ev: de.e };
      return { outcome: 'pending', which: mDen ? 'backup' : 'main', ev: de ? de.e : null };
    }
    function outcome(slot) {
      const d = state.decisions[slot.id] || {};
      return resolveOutcome(d.main, d.backup, !!slot.backup);
    }
    /* Which image is on the stage. The reviewer can flip Main/Backup at any
       time; otherwise it follows the outcome (a denied main hands over to the
       backup in the same spot). */
    function viewed(s) {
      const v = state.view[s.id] || outcome(s).which || 'main';
      return v === 'backup' && !(s.backup && s.backup.url) ? 'main' : v;
    }

    function firstPending(from) {
      const n = state.slots.length;
      for (let k = 0; k < n; k++) { const j = (from + k) % n; if (outcome(state.slots[j]).outcome === 'pending') return j; }
      return -1;
    }

    /* Merge the server's decisions with what this browser already knows --
       never replace. Two ways a straight assignment lost the decision that
       had just been submitted, and in both the reviewer was thrown back to
       the main image instead of forward to its backup:
         - (historical) draft-batch preview links had no server-side
           decisions, so a resync wiped the local event. Drafts are gone
           (9/16), but the merge stays for the case below.
         - on a live batch the Blob listing can lag the write by a moment,
           so an immediate resync can come back without the newest event.
       Newest event per (slot, which) wins, same rule the server uses. */
    async function resync() {
      const r = await api('/api/sitime-batch', { token, pass });
      if (!(r.ok && r.data && r.data.ok)) return;
      state.slots = r.data.slots;
      const server = r.data.decisions || {};
      const local = state.decisions || {};
      const merged = {};
      const ids = new Set(Object.keys(server).concat(Object.keys(local)));
      ids.forEach((id) => {
        const out = {};
        ['main', 'backup'].forEach((w) => {
          const a = (local[id] || {})[w], b = (server[id] || {})[w];
          const keep = !b ? a : !a ? b : ((a.at || 0) > (b.at || 0) ? a : b);
          if (keep) out[w] = keep;
        });
        merged[id] = out;
      });
      state.decisions = merged;
    }

    function render() {
      const s = state.slots[state.i]; if (!s) return;
      const which = viewed(s);
      const pick = which === 'backup' ? s.backup : s.main;
      const d = state.decisions[s.id] || {};
      const done = state.slots.filter((x) => outcome(x).outcome !== 'pending').length;

      $('batch-label').textContent = LP ? 'Preview' : 'Batch ' + String(state.batch.num || '').padStart(2, '0') + (state.batch.name ? ' · ' + state.batch.name : '');
      $('progress').textContent = (state.i + 1) + ' of ' + state.slots.length;
      /* max(6px, …) is the /brief rail's rule: at zero decided the fill is still
         a visible nub, so an untouched batch reads as "at the start" rather than
         as an empty rule with nothing in it. */
      $('bar').style.width = 'max(6px, ' + Math.round((done / state.slots.length) * 100) + '%)';
      $('slot-title').textContent = s.page + ' · ' + s.name;
