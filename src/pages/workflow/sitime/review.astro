        $('source-note').textContent = 'Not up for review';
        $('ocyc').hidden = origs.length < 2;
        $('ocount').textContent = (oi + 1) + ' of ' + origs.length;
        $('oprev').disabled = oi === 0; $('onext').disabled = oi >= origs.length - 1;
      } else {
        $('ocyc').hidden = true;
        $('source').innerHTML = pick ? (pick.ref + (pick.link ? ' · <a href="' + pick.link + '" target="_blank" rel="noopener">View source ↗</a>' : '')) : '';
        const LICN = { envato: 'Envato Elements comp · SiTime licenses it on its own Envato account', adobe: 'Comp shown, licensed after approval', sitime: 'From SiTime’s licensed library', own: 'SiTime’s own image', generated: 'AI-generated', other: '' };
        $('source-note').textContent = pick ? (pick.lic ? (LICN[pick.lic] || '') : pick.source === 'stock' ? LICN.adobe : pick.source === 'library' ? LICN.sitime : '') : '';
      }

      // decision controls
      document.querySelectorAll('#pills .pill').forEach((p) => { p.classList.remove('on'); p.setAttribute('aria-pressed', 'false'); });
      $('note').hidden = true; $('note-text').value = ''; $('err').hidden = true;
      state.pending = null;
      const ev = d[which];
      if (ev) {
        $('decided').hidden = false;
        $('decided').innerHTML = 'Decided: <b>' + ({ approve: 'Approved', deny: 'Denied', hold: 'Held' })[ev.decision] + '</b>' + (ev.note ? ' · “' + escapeHtml(ev.note) + '”' : '') + '. Choose again to change it.';
      } else { $('decided').hidden = true; }

      // Landed on the backup because the main was denied -- say so plainly,
      // with whatever note came with that denial, instead of the silent
      // hand-off reviewers were missing (subtitle alone was too easy to skim past).
      const mainEv = d.main;
      if (which === 'backup' && mainEv && mainEv.decision === 'deny') {
        $('handoff').hidden = false;
        $('handoff').innerHTML = '<b>Main image denied' + (mainEv.note ? ':</b> “' + escapeHtml(mainEv.note) + '”' : '.</b>') + ' Reviewing the backup now.';
      } else { $('handoff').hidden = true; }

      $('prev').disabled = state.i === 0;
      $('next').disabled = state.i >= state.slots.length - 1;
      fit();
    }

    /* Framing: pick.pos = {x,y} in object-position % (the image point at x%
       sits at x% of the frame), pick.zoom = scale around that same point.
       A flipped pick is mirrored about the frame centre: translateX makes a
       flip about the focal origin equal to a flip about the middle. */
    function frameDefault(s) { return s && s.display === 'card' ? { x: 50, y: 50 } : { x: 50, y: 40 }; }
    function applyFrame(s, pick) {
      const im = $('hero-img');
      if (!pick) { im.style.objectPosition = ''; im.style.transformOrigin = ''; im.style.transform = ''; return; }
      const pos = pick.pos || frameDefault(s); const z = pick.zoom || 1;
      im.style.objectPosition = pick.pos ? pos.x + '% ' + pos.y + '%' : '';
      im.style.transformOrigin = pos.x + '% ' + pos.y + '%';
      let t = '';
      if (pick.flip) t += 'translateX(' + (100 - 2 * pos.x) + '%) scaleX(-1) ';
      if (z !== 1) t += 'scale(' + z + ')';
      im.style.transform = t.trim();
    }
    function curPick() { const s = state.slots[state.i]; if (!s) return {}; const which = viewed(s); return { s, which, pick: which === 'backup' ? s.backup : s.main }; }
    function saveFrame() {
      const { s, which, pick } = curPick(); if (!pick) return;
      try { if (window.parent.__sitimePreviewSave) window.parent.__sitimePreviewSave(s.id, which, pick.pos || null, pick.zoom || 1); } catch (e) {}
      $('fval').textContent = (pick.pos || (pick.zoom && pick.zoom !== 1)) ? 'Custom framing' : 'Automatic';
    }
    if (LP) {
      let drag = null;
      $('st-hero').addEventListener('pointerdown', (e) => {
        if (!$('st-hero').classList.contains('canframe')) return;
        const { s, pick } = curPick(); const im = $('hero-img'); const box = $('imgbox');
        if (!pick || !im.naturalWidth) return;
        const r = box.getBoundingClientRect();
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) return;
        e.preventDefault();
        const sc = parseFloat(getComputedStyle($('stage')).getPropertyValue('--scale')) || 1;
        const bw = box.offsetWidth, bh = box.offsetHeight, z = pick.zoom || 1;
        const cover = Math.max(bw / im.naturalWidth, bh / im.naturalHeight);
        const spanX = Math.max(im.naturalWidth * cover * z - bw, bw * 0.25);
        const spanY = Math.max(im.naturalHeight * cover * z - bh, bh * 0.25);
        const start = pick.pos || frameDefault(s);
        drag = { x0: e.clientX, y0: e.clientY, sc, spanX, spanY, sx: start.x, sy: start.y, flip: !!pick.flip, pick, s };
        $('st-hero').classList.add('dragging');
        $('st-hero').setPointerCapture(e.pointerId);
      });
      $('st-hero').addEventListener('pointermove', (e) => {
        if (!drag) return;
        const dx = (e.clientX - drag.x0) / drag.sc * (drag.flip ? -1 : 1), dy = (e.clientY - drag.y0) / drag.sc;
        const cl = (v) => Math.round(Math.min(100, Math.max(0, v)) * 10) / 10;
        drag.pick.pos = { x: cl(drag.sx - dx / drag.spanX * 100), y: cl(drag.sy - dy / drag.spanY * 100) };
        applyFrame(drag.s, drag.pick);
      });
      const end = () => { if (!drag) return; const moved = drag.pick.pos; drag = null; $('st-hero').classList.remove('dragging'); if (moved) saveFrame(); };
      $('st-hero').addEventListener('pointerup', end);
      $('st-hero').addEventListener('pointercancel', end);
      $('fzoom').addEventListener('input', () => { const { s, pick } = curPick(); if (!pick) return; const z = parseFloat($('fzoom').value) || 1; if (z === 1) delete pick.zoom; else pick.zoom = z; applyFrame(s, pick); });
      $('fzoom').addEventListener('change', saveFrame);
      $('freset').addEventListener('click', () => { const { s, pick } = curPick(); if (!pick) return; delete pick.pos; delete pick.zoom; $('fzoom').value = '1'; applyFrame(s, pick); saveFrame(); });
    }

    function escapeHtml(s) { return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]); }

    function showSummary() {
      const counts = { approved: 0, denied: 0, held: 0 };
      const rows = [];
      state.slots.forEach((s) => {
        const o = outcome(s); if (o.outcome === 'pending') return;
        counts[o.outcome]++;
        const ev = (state.decisions[s.id] || {})[o.which] || {};
        if (o.outcome !== 'approved') rows.push('<div class="row"><span class="tag ' + (o.outcome === 'denied' ? 'deny' : 'hold') + '">' + (o.outcome === 'denied' ? 'Denied' : 'Held') + '</span><div>' + escapeHtml(s.page + ' · ' + s.name) + '<div class="n">' + (ev.note ? '“' + escapeHtml(ev.note) + '”' : 'No note.') + '</div></div></div>');
      });
      $('c-ok').textContent = counts.approved; $('c-deny').textContent = counts.denied; $('c-hold').textContent = counts.held;
      $('sum-rows').innerHTML = rows.join('');
      $('sum-label').textContent = $('batch-label').textContent;
      $('card').hidden = true; $('summary').hidden = false;
      window.scrollTo({ top: 0, behavior: REDUCE ? 'auto' : 'smooth' });
    }

    function advance() {
      const s = state.slots[state.i];
      const o = outcome(s);
      if (o.outcome === 'pending') { render(); return; } // main denied → backup now shows in place
      const j = firstPending(state.i + 1);
      if (j === -1) { showSummary(); return; }
      state.i = j; render();
      window.scrollTo({ top: $('card').offsetTop - 120, behavior: REDUCE ? 'auto' : 'smooth' });
    }

    document.querySelectorAll('#which button').forEach((btn) => btn.addEventListener('click', () => {
      const s = state.slots[state.i]; if (!s || btn.disabled) return;
      state.view[s.id] = btn.dataset.w; state.orig = null; render();
    }));
    $('bwbtn').addEventListener('click', () => {
      const { s, which, pick } = curPick(); if (!pick) return;
      const key = s.id + ':' + which;
      const cur = key in state.bwView ? state.bwView[key] : !!pick.bw;
      if (LP) {
        pick.bw = !cur; delete state.bwView[key];
        try { if (window.parent.__sitimePreviewSaveBw) window.parent.__sitimePreviewSaveBw(s.id, which, pick.bw); } catch (e) {}
      } else { state.bwView[key] = !cur; }
      render();
    });
    $('clean').addEventListener('click', () => {
      state.clean = !state.clean;
      try { localStorage.setItem('sitime-review-clean', state.clean ? '1' : '0'); } catch (e) {}
      render();
    });
    /* Context: page image scrolled to the slot, the slot outlined and flashing.
       By default the image being reviewed sits in the slot (cover-cropped, B&W
       if that view is on); masked slots (burst/arm) only flash, since a
       rectangle over a masked shape would misstate the design. */
    let ctxPut = true;
    function openCtx() {
      const s = state.slots[state.i]; const c = s && s.context; if (!c) return;
      const which = viewed(s); const pick = which === 'backup' ? s.backup : s.main;
      const [x, y, w, h] = c.rect;
      const box = $('ctx-box');
      box.style.left = (x / c.w * 100) + '%'; box.style.top = (y / c.h * 100) + '%';
      box.style.width = (w / c.w * 100) + '%'; box.style.height = (h / c.h * 100) + '%';
      box.style.animation = 'none'; void box.offsetWidth; box.style.animation = '';
      const masked = s.display === 'burst' || s.display === 'arm' || s.mask;
      const canPut = !!(pick && pick.url) && !masked;
      const bwKey = s.id + ':' + which;
      const bwOn = pick ? (bwKey in state.bwView ? state.bwView[bwKey] : !!pick.bw) : false;
      $('ctx-pick').src = canPut ? pick.url : '';
      $('ctx-pick').style.filter = bwOn ? 'grayscale(1)' : '';
      $('ctx-pick').style.transform = pick && pick.flip ? 'scaleX(-1)' : '';
      $('ctx-pick').hidden = !(canPut && ctxPut);
      $('ctx-put').hidden = !canPut;
      $('ctx-put').classList.toggle('on', ctxPut); $('ctx-put').setAttribute('aria-pressed', String(ctxPut));
      $('ctx-put').textContent = ctxPut ? 'Show the design’s image' : 'Show this image in place';
      $('ctx-title').textContent = s.page + ' · ' + s.name;
      $('ctx-src').textContent = c.live ? 'Current sitime.com page · new design not in yet' : 'Page design';
      const img = $('ctx-img');
      const go = () => { const sc = $('ctx-scroll'); const pg = $('ctx-page'); const k = pg.clientWidth / c.w; const top = sc.scrollTop + pg.getBoundingClientRect().top - sc.getBoundingClientRect().top; sc.scrollTop = Math.max(0, top + (y + h / 2) * k - sc.clientHeight / 2); };
      $('ctx').hidden = false; document.body.style.overflow = 'hidden';
      if (img.getAttribute('src') !== c.src) { img.onload = go; img.src = c.src; } else go();
      $('ctx-close').focus();
    }
    function closeCtx() { $('ctx').hidden = true; document.body.style.overflow = ''; $('ctxbtn').focus(); }
    $('ctxbtn').addEventListener('click', openCtx);
    $('ctx-close').addEventListener('click', closeCtx);
    $('ctx-put').addEventListener('click', () => { ctxPut = !ctxPut; openCtx(); });
    $('ctx').addEventListener('click', (e) => { if (e.target === $('ctx-scroll')) closeCtx(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$('ctx').hidden) closeCtx(); });
    $('orig').addEventListener('click', () => {
      const s = state.slots[state.i]; if (!s) return;
      state.orig = state.orig ? null : { id: s.id, k: 0 }; render();
    });
    $('oprev').addEventListener('click', () => { if (state.orig && state.orig.k > 0) { state.orig.k--; render(); } });
    $('onext').addEventListener('click', () => { const s = state.slots[state.i]; if (state.orig && s && state.orig.k < (s.original || []).length - 1) { state.orig.k++; render(); } });

    /* Approve saves on the click -- no note. Deny and hold open the note box.
       On an internal (COGNAK) batch approve opens the note box too, so a
       reviewer can approve with a comment. */
    const internalBatch = () => !!(state.batch && state.batch.internal);
    document.querySelectorAll('#pills .pill').forEach((p) => p.addEventListener('click', () => {
      document.querySelectorAll('#pills .pill').forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-pressed', 'false'); });
      p.classList.add('on'); p.setAttribute('aria-pressed', 'true');
      state.pending = p.dataset.v;
      $('err').hidden = true;
      if (state.pending === 'approve' && !internalBatch()) { $('note').hidden = true; $('note-text').value = ''; submit(); return; }
      $('note').hidden = false;
      $('note-text').focus({ preventScroll: true });
    }));

    let busy = false;
    async function submit() {
      if (!state.pending || busy) return;
      const s = state.slots[state.i];
      const which = viewed(s);
      const decision = state.pending;
      const note = decision === 'approve' && !internalBatch() ? '' : $('note-text').value.trim();
      busy = true; $('submit').disabled = true; $('saving').hidden = false; $('err').hidden = true;
      if (decision === 'approve' && !internalBatch()) { $('decided').hidden = false; $('decided').textContent = 'Saving…'; }
      const r = await api('/api/sitime-decide', { token, pass, slotId: s.id, which, decision, note });
      busy = false; $('submit').disabled = false; $('saving').hidden = true;
      if (!r.ok) {
        $('note').hidden = false;
        $('err').textContent = (r.data && r.data.error) || 'Could not save that. Try again.'; $('err').hidden = false; return;
      }
      if (!state.decisions[s.id]) state.decisions[s.id] = {};
      state.decisions[s.id][which] = { decision, note, at: Date.now() };
      delete state.view[s.id];   // let the stage follow the outcome again
      await resync();
      advance();
    }
    $('submit').addEventListener('click', submit);
    $('skip').addEventListener('click', () => { const j = firstPending(state.i + 1); if (j === -1 || j === state.i) { render(); return; } state.i = j; render(); });
    $('prev').addEventListener('click', () => { if (state.i > 0) { state.i--; render(); } });
    $('next').addEventListener('click', () => { if (state.i < state.slots.length - 1) { state.i++; render(); } });
    /* Left / right arrow keys step through the images; ignored while a note
       is being typed, while the Context view is open, and on the summary.
       Decisions stay on the buttons: no single key approves or denies. */
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const a = document.activeElement;
      if (a && /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName)) return;
      if (!$('ctx').hidden || $('card').hidden) return;
      e.preventDefault();
      $(e.key === 'ArrowLeft' ? 'prev' : 'next').click();
    });
    $('review-again').addEventListener('click', () => { state.i = 0; $('summary').hidden = true; $('card').hidden = false; render(); });

    async function load() {
      if (LP) {
        let P = null; try { P = window.parent !== window ? window.parent.__sitimePreview : null; } catch (e) {}
        $('loading').hidden = true;
        if (!P || !(P.slots || []).length) { $('invalid').hidden = false; $('invalid-note').textContent = 'Nothing to preview. Open this from the admin.'; return; }
        state.batch = { num: '', name: P.title || '' }; state.slots = P.slots; state.decisions = {};
        if (P.mock) applyMock(P.mock);
        state.i = 0; $('card').hidden = false; render(); return;
      }
      if (!token) { $('loading').hidden = true; $('invalid').hidden = false; return; }
      const r = await api('/api/sitime-batch', { token, pass });
      $('loading').hidden = true;
      if (r.status === 401 && r.data && r.data.needPass) {
        $('gate').hidden = false; $('card').hidden = true;
        if (pass) { $('pass-err').textContent = r.data.error; $('pass-err').hidden = false; }
        $('pass').focus(); return;
      }
      if (!r.ok || !r.data || !r.data.ok) { $('invalid').hidden = false; $('invalid-note').textContent = (r.data && r.data.error) || 'This link isn’t valid.'; return; }
      $('gate').hidden = true;
      try { sessionStorage.setItem('sitime-pass-' + token, pass); } catch (e) {}
      $('backlink').hidden = !r.data.me;
      state.batch = r.data.batch; state.slots = r.data.slots; state.decisions = r.data.decisions || {};
      if (r.data.mock) applyMock(r.data.mock);
      if (!state.slots.length) { $('invalid').hidden = false; $('invalid-note').textContent = 'This batch is empty.'; return; }
      const j = firstPending(0);
      if (j === -1) { $('card').hidden = false; render(); showSummary(); return; }
      state.i = j; $('card').hidden = false; render();
    }
    $('pass-go').addEventListener('click', () => { pass = $('pass').value; $('pass-err').hidden = true; $('gate').hidden = true; $('loading').hidden = false; load(); });
    $('pass').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('pass-go').click(); });
    document.addEventListener('visibilitychange', () => {
      if (!LP && !document.hidden && state.batch) resync().then(() => { if (!$('card').hidden) render(); });
    });
    load();
  })();
  </script>
</BaseLayout>
