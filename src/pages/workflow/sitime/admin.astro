      $('handoff-rows').innerHTML = rows.map(({ s, p, b }) => '<tr><td><div class="pg">' + esc(s.page) + '</div><div class="sub">' + esc(s.section + ' · ' + s.name) + '</div><div class="mini">' + esc((s.pageId || '') + ' · ' + s.id) + '</div></td><td>' + thumbCell(p) + '</td><td>' + esc(p.source) + '</td><td class="sub">' + (p.source === 'stock' ? (p.id ? '<a href="https://stock.adobe.com/images/x/' + esc(p.id) + '" target="_blank" rel="noopener">' + esc(p.id) + '</a>' : '—') : esc(p.source === 'library' ? p.path : p.title || '')) + '</td><td><input class="txt" data-lic="' + s.id + '" value="' + esc(s.license && s.license.id || '') + '" placeholder="' + (p.source === 'stock' ? 'License #' : 'n/a') + '"></td><td class="mini">' + (b ? String(b.num).padStart(2, '0') : '') + '</td></tr>').join('') || '<tr><td colspan="6" class="hint">Nothing approved yet.</td></tr>';
