        const b = { token: randomToken(10), num, name, scope: '', slotIds: [], status: 'draft', createdAt: new Date().toISOString(), plannedFor: date, sentAt: null };
        addCheckedTo(b); S.batches.push(b);
      }
      $('batch-dialog').close(); mark(); renderBatches(); renderStats(); renderSlots();
    });
    function addCheckedTo(b) {
      const m = byId();
      checked.forEach((id) => { const s = m.get(id); if (!s || s.batch) return; b.slotIds.push(id); s.batch = b.token; });
      const secs = new Set(b.slotIds.map((id) => m.get(id)?.section).filter(Boolean)); b.scope = Array.from(secs).slice(0, 3).join(', ') + (secs.size > 3 ? ' +' + (secs.size - 3) : '');
      checked.clear();
    }

    /* ---------- slots ---------- */
    // f-pri / f-status are plain <select>s in the markup (Priority, Status --
    // was a row of multi-select toggle pills; single-select dropdowns match
    // the section/recommendation filters beside them). renderFilters() now
    // only has the section list left to populate.
    function renderFilters() {
      const secs = Array.from(new Set(S.slots.map((s) => s.section))).filter((s) => s && s !== '(unmapped)').sort();
      const sel = $('f-section'); if (sel.options.length === 1) secs.forEach((s) => { const o = document.createElement('option'); o.value = s; o.textContent = s; sel.appendChild(o); });
    }
    function filtered() {
      const q = search.toLowerCase();
      return S.slots.filter((s) => (!fx.pri || s.priority === fx.pri)
        && (!fx.status || status(s) === fx.status)
        && (!fx.section || s.section === fx.section)
        && (!fx.rec || (s.rec || '').toUpperCase().startsWith(fx.rec))
        && (!fx.hideReuse || s.priority !== 'Reuse')
        && (!q || (s.page + ' ' + s.name + ' ' + s.url).toLowerCase().includes(q)));
    }
    /* The tiles: exactly two per slot, Main and Backup, not a candidate strip.
       Click a filled tile to reveal Swap (swaps main and backup with each
       other, no picker involved) and a trash icon (clears just that slot).
       Click an empty tile to open the picker for it directly. See
       swapTarget/assign() below -- no more click-to-assign / click-again-
       for-backup / click-again-to-clear cycling through candidates in the
       row itself. */
    function defaultSrcTab(s) { return (s.candidates || []).filter((c) => !(fx.hideAi && c.ai)).length ? 'stock' : 'library'; }
    function tileHtml(s, which) {
      const pick = s[which];
      if (!pick) return '<div class="tile empty" data-slot="' + s.id + '" data-which="' + which + '"><span>Choose ' + which + '</span><span class="mini">Stock · SiTime library · generate · upload</span></div>';
      const open = revealTile && revealTile.slotId === s.id && revealTile.which === which;
      return '<div class="tile filled is-' + which + (open ? ' is-open' : '') + '" title="' + esc(pick.title || '') + '" data-slot="' + s.id + '" data-which="' + which + '">' +
        '<img loading="lazy" src="' + esc(pick.thumb || pick.url) + '">' +
        '<span class="tag">' + which.toUpperCase() + '</span>' +
        '<span class="cap">' + esc(pick.title || pick.id || '') + '</span>' +
        '<div class="tile-actions"><button class="tact swap" data-act="swap" data-slot="' + s.id + '" data-which="' + which + '">Swap</button><button class="tact trash" data-act="trash" data-slot="' + s.id + '" data-which="' + which + '" title="Remove ' + which + '" aria-label="Remove ' + which + '">' + ICONS.delete + '</button></div></div>';
    }
    function tilesFor(s) { return '<div class="tiles">' + tileHtml(s, 'main') + tileHtml(s, 'backup') + '</div>'; }
    function thumbCell(p) { return p && (p.thumb || p.url) ? '<img class="thumb" src="' + esc(p.thumb || p.url) + '">' : '<div class="thumb empty"></div>'; }
    function renderSlots() {
      const list = filtered();
      const pages = Math.max(1, Math.ceil(list.length / PAGE));
      if (pageIdx >= pages) pageIdx = pages - 1;
      const start = pageIdx * PAGE;
      const rows = list.slice(start, start + PAGE).map((s) => {
        const st = status(s); const b = batchOf(s); const open = openSlot === s.id;
        return '<div class="srow ' + (open ? 'sel' : '') + '" data-id="' + s.id + '">' + tilesFor(s) +
          '<div class="mrow"><input type="checkbox" data-chk="' + s.id + '" ' + (checked.has(s.id) ? 'checked' : '') + ' ' + (s.batch ? 'disabled' : '') + '><div class="who"><div class="pg">' + esc(s.page) + '</div><div class="sub">' + esc(s.section + ' · ' + s.name) + '</div></div>' +
          '<span class="pri p-' + esc(s.priority.toLowerCase()) + '">' + esc(s.priority) + '</span><span class="pri">' + esc((s.rec || '').split(' ')[0]) + '</span>' +
          '<div class="end"><span class="st ' + st + '"><i></i>' + STATUS_LABEL[st] + '</span><span class="mini">' + (b ? 'Batch ' + String(b.num).padStart(2, '0') : '—') + '</span><span class="chev" title="Browse images for this slot">' + ICONS.chevron + '</span></div></div></div>' +
          (open ? '<div class="drawer-wrap"><div class="drawer" id="drawer"></div></div>' : '');
      });
      $('slot-rows').innerHTML = rows.join('') || '<p class="hint">Nothing matches.</p>';
      const count = list.length ? 'Showing ' + (start + 1) + '–' + Math.min(start + PAGE, list.length) + ' of ' + list.length : '0 slots';
      $('pg-count').textContent = count;
      $('pg-prev').disabled = pageIdx === 0; $('pg-next').disabled = start + PAGE >= list.length;
      $('slot-more').innerHTML = '<span class="mini">' + count + '</span><button class="sbtn" id="pg-prev2" ' + (pageIdx === 0 ? 'disabled' : '') + '>Prev</button><button class="sbtn" id="pg-next2" ' + (start + PAGE >= list.length ? 'disabled' : '') + '>Next</button>';
      $('pg-prev2').addEventListener('click', () => { if (pageIdx > 0) { pageIdx--; renderSlots(); window.scrollTo({ top: $('tab-slots').offsetTop - 80, behavior: 'smooth' }); } });
      $('pg-next2').addEventListener('click', () => { if (start + PAGE < list.length) { pageIdx++; renderSlots(); window.scrollTo({ top: $('tab-slots').offsetTop - 80, behavior: 'smooth' }); } });
      $('slot-rows').querySelectorAll('.tile.empty').forEach((tl) => tl.addEventListener('click', (e) => {
        e.stopPropagation();
        const s = byId().get(tl.dataset.slot);
        openSlot = s.id; swapTarget = tl.dataset.which; srcTab = defaultSrcTab(s); revealTile = null;
        renderSlots(); renderDrawer();
      }));
      $('slot-rows').querySelectorAll('.tile.filled').forEach((tl) => tl.addEventListener('click', (e) => {
        e.stopPropagation();
        const slotId = tl.dataset.slot, which = tl.dataset.which;
        revealTile = (revealTile && revealTile.slotId === slotId && revealTile.which === which) ? null : { slotId, which };
        renderSlots();
      }));
      $('slot-rows').querySelectorAll('.tact').forEach((btn) => btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const s = byId().get(btn.dataset.slot); const which = btn.dataset.which;
        if (btn.dataset.act === 'trash') {
          s[which] = null; revealTile = null;
          if (!s.main && !s.backup && s.id.startsWith('EX-')) s.state = 'unreviewed';
          mark(); renderSlots(); renderStats(); if (openSlot === s.id) renderDrawer();
        } else if (btn.dataset.act === 'swap') {
          const tmp = s.main; s.main = s.backup; s.backup = tmp; revealTile = null;
          mark(); renderSlots(); renderStats(); if (openSlot === s.id) renderDrawer();
        }
      }));
      if (openSlot) renderDrawer();
      $('slot-rows').querySelectorAll('input[data-chk]').forEach((c) => c.addEventListener('click', (e) => { e.stopPropagation(); c.checked ? checked.add(c.dataset.chk) : checked.delete(c.dataset.chk); updateChecked(); }));
      $('slot-rows').querySelectorAll('.srow .mrow').forEach((mr) => mr.addEventListener('click', () => { const id = mr.closest('.srow').dataset.id; openSlot = openSlot === id ? null : id; swapTarget = null; revealTile = null; srcTab = 'library'; renderSlots(); renderDrawer(); }));
      updateChecked();
    }
    function updateChecked() { $('checked-count').textContent = checked.size ? checked.size + ' checked' : ''; $('add-to-batch').disabled = !checked.size; $('checked-hint').textContent = checked.size ? checked.size + ' checked in Slots' : ''; }
    $('check-all').addEventListener('change', (e) => { filtered().slice(pageIdx * PAGE, pageIdx * PAGE + PAGE).forEach((s) => { if (s.batch) return; e.target.checked ? checked.add(s.id) : checked.delete(s.id); }); renderSlots(); });
    $('f-pri').addEventListener('change', (e) => { fx.pri = e.target.value; pageIdx = 0; renderSlots(); });
    $('f-status').addEventListener('change', (e) => { fx.status = e.target.value; pageIdx = 0; renderSlots(); });
    $('f-section').addEventListener('change', (e) => { fx.section = e.target.value; pageIdx = 0; renderSlots(); });
    $('f-rec').addEventListener('change', (e) => { fx.rec = e.target.value; pageIdx = 0; renderSlots(); });
    $('f-hideai').addEventListener('change', (e) => { fx.hideAi = e.target.checked; renderSlots(); });
    $('f-hidereuse').addEventListener('change', (e) => { fx.hideReuse = e.target.checked; pageIdx = 0; renderSlots(); });
    $('pg-prev').addEventListener('click', () => { if (pageIdx > 0) { pageIdx--; renderSlots(); } });
    $('pg-next').addEventListener('click', () => { if ((pageIdx + 1) * PAGE < filtered().length) { pageIdx++; renderSlots(); } });
    $('search').addEventListener('input', (e) => { search = e.target.value; pageIdx = 0; renderSlots(); });
    $('add-to-batch').addEventListener('click', () => {
      const drafts = S.batches.filter((b) => b.status === 'draft');
      if (!drafts.length) { openBatchDialog(null); return; }
      const choice = drafts.length === 1 ? drafts[0] : drafts.find((b) => String(b.num) === prompt('Which draft batch? ' + drafts.map((b) => b.num + ' = ' + b.name).join(', '), String(drafts[drafts.length - 1].num)));
      if (!choice) return; addCheckedTo(choice); mark(); renderSlots(); renderStats();
    });

    /* ---------- drawer: the source picker ---------- */
    function pickFrom(source, obj) {
      if (source === 'stock') return { source, id: obj.id, url: obj.comp, thumb: obj.comp, title: obj.title || '', manual: !!obj.manual };
      if (source === 'library') return { source, id: obj.id, url: obj.url, thumb: obj.thumb, title: obj.name, path: obj.path };
      if (source === 'existing') return { source, id: null, url: obj.url, thumb: obj.url, title: obj.label || 'Current' };
      if (source === 'generated') return { source, id: obj.id, url: obj.url, thumb: obj.thumb || obj.url, title: 'Generated' };
      return obj;
    }
    function assign(slot, pick) {
      if (swapTarget === 'main' || swapTarget === 'backup') {
        // Targeted from an empty tile or its Swap button: the pick lands in
        // exactly that slot, no matter what the other slot holds.
        slot[swapTarget] = pick;
        if (slot.state === 'unreviewed' || slot.state === 'kept') slot.state = 'assigned';
        swapTarget = null; openSlot = null; revealTile = null;
        mark(); renderSlots(); renderStats(); renderDrawer();
        return;
      }
      // Untargeted (opened by clicking the row itself to browse): empty main
      // → main; main set and pick differs → backup; clicking the current
      // main clears it, clicking the backup clears backup.
      const same = (a, b) => !!(a && b && a.url === b.url);
      if (same(slot.main, pick)) { slot.main = slot.backup || null; slot.backup = null; }
      else if (same(slot.backup, pick)) slot.backup = null;
      else if (!slot.main) slot.main = pick;
      else slot.backup = pick;
      if (slot.state === 'unreviewed' || slot.state === 'kept') slot.state = 'assigned';
      mark(); renderSlots(); renderDrawer(); renderStats();
    }
    function candCard(pick, slot, extra) {
      const cls = slot.main && slot.main.url === pick.url ? 'main' : slot.backup && slot.backup.url === pick.url ? 'backup' : '';
      return '<div class="cand ' + cls + (extra && extra.ai ? ' warn' : '') + '" data-url="' + esc(pick.url) + '"><img loading="lazy" src="' + esc(pick.thumb || pick.url) + '">' + (cls ? '<span class="tag">' + cls.toUpperCase() + '</span>' : '') + (pick.source === 'stock' ? '<button type="button" class="cand-x" data-remove-cand="' + esc(pick.url) + '" title="Remove this" aria-label="Remove this">' + ICONS.delete + '</button>' : '') + '<div class="cb"><b>' + esc(extra && extra.label || pick.id || '') + '</b>' + esc(extra && extra.text || pick.title || '') + '</div></div>';
    }
    function removeCandidate(slot, url) {
      slot.candidates = (slot.candidates || []).filter((c) => c.comp !== url);
      if (slot.main && slot.main.url === url) slot.main = null;
      if (slot.backup && slot.backup.url === url) slot.backup = null;
      mark(); renderSlots(); renderStats(); renderDrawer();
    }
    /* ---------- AI-generated candidates ---------- */
    const genBusy = {}; // slotId -> true while a generate call is in flight
    async function generateImages(slot, opts) {
      const idx = opts && typeof opts.index === 'number' ? opts.index : null;
      const count = idx === null ? 5 : 1;
      if (genBusy[slot.id]) return;
      if (!(slot.prompt || '').trim()) { alert('Write a brief first — that\u2019s what gets sent to the image generator.'); return; }
      genBusy[slot.id] = true; renderDrawer();
      try {
        const r = await api('/api/sitime-generate', { method: 'POST', body: { slotId: slot.id, prompt: slot.prompt || '', count } });
        if (!r.ok || !r.data || !r.data.ok) { alert((r.data && r.data.error) || 'Generation failed (' + r.status + ').'); return; }
        const images = r.data.images || [];
        if (idx === null) {
          slot.generated = images.map((im) => ({ id: im.id, url: im.url, thumb: im.url, at: im.at }));
        } else {
          slot.generated = slot.generated || [];
          if (images[0]) slot.generated[idx] = { id: images[0].id, url: images[0].url, thumb: images[0].url, at: images[0].at };
        }
        mark(); renderSlots(); renderStats();
      } catch (e) {
        alert('Generation failed: ' + (e && e.message ? e.message : e));
      } finally {
        genBusy[slot.id] = false; renderDrawer();
      }
    }
    /* ---------- live Adobe Stock search ---------- */
    async function searchStock(q) {
      stockQ = q; stockErr = '';
      const query = q.trim();
      if (!query) { stockResults = []; renderDrawer(); return; }
      stockBusy = true; renderDrawer();
      try {
        const r = await api('/api/sitime-stock-search', { method: 'POST', body: { query } });
        if (!r.ok || !r.data || !r.data.ok) { stockErr = (r.data && r.data.error) || 'Search failed (' + r.status + ').'; stockResults = []; }
        else stockResults = r.data.results || [];
      } catch (e) { stockErr = 'Search failed: ' + (e && e.message ? e.message : e); stockResults = []; }
      stockBusy = false; renderDrawer();
    }

    function renderDrawer() {
      const dr = $('drawer'); const s = openSlot && byId().get(openSlot);
      if (!s || !dr) return;
      if (stockSlotId !== s.id) { stockSlotId = s.id; stockQ = (s.terms && s.terms.length) ? s.terms.join(' ') : ''; stockResults = []; stockErr = ''; }
      const tabs = [['stock', 'Adobe Stock · ' + (s.candidates || []).length], ['library', 'SiTime library · ' + (S.library || []).length], ['existing', 'Current site · ' + (s.existing || []).length], ['generated', 'Generated · ' + (s.generated || []).length], ['upload', 'Upload']];
      let body = '';
      if (srcTab === 'stock') {
        // "Hide Gen-AI candidates" (f-hideai, checked by default) is meant to hide
        // AI-flagged Stock comps the way Ace's tool does -- it used to only steer
        // which tab opened by default and never filtered this list, so the checkbox
        // did nothing once you were on the Stock tab. Filtering here is the fix.
        const allCands = s.candidates || [];
        const shownCands = allCands.filter((c) => !(fx.hideAi && c.ai));
        const hiddenCount = allCands.length - shownCands.length;
        const cands = shownCands.map((c) => candCard(pickFrom('stock', c), s, { ai: c.ai, label: c.id, text: c.why || c.title }));
        if (hiddenCount) cands.push('<div class="hint" style="flex-basis:100%">' + hiddenCount + ' generative-AI result' + (hiddenCount === 1 ? '' : 's') + ' hidden \u2014 <a href="#" id="show-ai-cands">show ' + (hiddenCount === 1 ? 'it' : 'them') + '</a></div>');
        // The search link is built from the slot's own search terms (falling
        // back to its prompt, then its name) so it opens Stock already
        // searching the right thing instead of a blank search box.
        const stockQuery = (s.terms && s.terms.length) ? s.terms.join(' ') : (s.prompt || s.name || s.page || '');
        const stockSearchUrl = 'https://stock.adobe.com/search?k=' + encodeURIComponent(stockQuery);
        const searchCards = stockResults.map((r, i) => {
          const already = allCands.some((c) => c.id === r.id);
          return '<div class="cand' + (already ? ' added' : '') + '" data-srch-idx="' + i + '"><img loading="lazy" src="' + esc(r.thumb) + '">' + (already ? '<span class="tag">ADDED</span>' : '') + '<div class="cb"><b>' + esc(r.id) + (r.type ? ' · ' + esc(r.type) : '') + '</b>' + esc(r.creator ? 'by ' + r.creator : '') + '</div></div>';
        }).join('');
        body = '<div class="stocksearch"><input class="txt" type="text" id="stock-q" placeholder="Search Adobe Stock…" value="' + esc(stockQ) + '"><button type="button" class="sbtn p" id="stock-go" ' + (stockBusy ? 'disabled' : '') + '>' + (stockBusy ? 'Searching…' : 'Search') + '</button></div>' +
          (stockErr ? '<p class="hint" style="color:#B00020">' + esc(stockErr) + '</p>' : '') +
          (stockResults.length ? '<div class="cands">' + searchCards + '</div><p class="mini" style="margin:2px 0 18px">Click a result to add it here and assign it.</p>' : '') +
          '<div class="cands">' + cands.join('') + '<div class="up stock-add"><a class="sbtn p" href="' + esc(stockSearchUrl) + '" target="_blank" rel="noopener">Search Adobe Stock ↗</a><span class="mini paste-link" id="paste-stock" style="margin-top:8px">Paste a comp URL instead<br>(right-click the comp on stock.adobe.com, copy image address)</span></div></div>';
      } else if (srcTab === 'library') {
        const groups = Array.from(new Set((S.library || []).map((l) => l.group))).sort();
        const q = libQuery.toLowerCase();
        const items = (S.library || []).filter((l) => (!libGroup || l.group === libGroup) && (!q || (l.name + ' ' + l.group).toLowerCase().includes(q)));
        body = '<div class="srctabs"><input class="search" id="lib-q" placeholder="Search filenames" value="' + esc(libQuery) + '">' + ['', ...groups].map((g) => '<button class="sbtn ' + (libGroup === g ? 'on' : '') + '" data-g="' + esc(g) + '">' + (g || 'All') + '</button>').join('') + '</div>' +
          ((S.library || []).length ? '<div class="cands">' + items.slice(0, libShown).map((l) => candCard(pickFrom('library', l), s, { label: l.group, text: l.name })).join('') + (items.length > libShown ? '<button class="sbtn more" id="lib-more">Show more (' + (items.length - libShown) + ')</button>' : '') + '</div>' : '<p class="hint">The library is not indexed yet. Library tab, choose the Image Mapping folder.</p>');
      } else if (srcTab === 'existing') {
        const ex = (s.existing || []).map((e) => candCard(pickFrom('existing', e), s, { label: 'CURRENT', text: e.label }));
        body = ex.length ? '<div class="cands">' + ex.join('') + '</div>' : '<p class="hint">No existing image on this page in the Drupal export.</p>';
      } else if (srcTab === 'generated') {
        const busy = !!genBusy[s.id];
        const gens = s.generated || [];
        const cards = [0, 1, 2, 3, 4].map((i) => {
          const g = gens[i];
          if (!g) return '<div class="cand gen-empty">' + (busy ? 'Generating…' : 'Empty') + '</div>';
          const cls = s.main && s.main.url === g.url ? 'main' : s.backup && s.backup.url === g.url ? 'backup' : '';
          return '<div class="cand ' + cls + '" data-url="' + esc(g.url) + '"><img loading="lazy" src="' + esc(g.thumb || g.url) + '">' + (cls ? '<span class="tag">' + cls.toUpperCase() + '</span>' : '') + '<button type="button" class="cand-x gen-refresh" data-gen-idx="' + i + '" title="Regenerate this one" aria-label="Regenerate this one"' + (busy ? ' disabled' : '') + '>' + ICONS.refresh + '</button></div>';
        });
        body = '<div class="up" style="margin-bottom:12px"><button class="sbtn p" id="gen-all" ' + (busy ? 'disabled' : '') + '>' + (busy ? 'Generating…' : (gens.length ? 'Refresh all 5' : 'Generate 5')) + '</button><span class="mini" style="margin-left:10px">Uses the brief above, plus SiTime’s house subject rules (no hands, no light trails, etc.) added automatically.</span></div><div class="cands">' + cards.join('') + '</div>';
      } else {
        body = '<div class="cands"><label class="up" for="up-file">Drop or choose an image<br><span class="mini">JPG or PNG, becomes main if empty, else backup</span></label><input type="file" id="up-file" accept="image/*" hidden><span class="mini" id="up-status"></span></div>';
      }
      dr.innerHTML = '<div class="dhead"><div><div class="group-title" style="margin-bottom:6px">' + esc(s.page) + ' · ' + esc(s.name) + (swapTarget ? ' <span class="mini" style="color:#4B584E">— choosing ' + swapTarget + '</span>' : '') + '</div><span class="mini">' + esc(s.section + ' · sitime.com' + s.url + ' · ' + s.priority) + '</span></div><div class="actions">' + (s.state === 'unreviewed' ? '<button class="sbtn" id="keep-existing">Keep the current image</button>' : '') + '<button class="sbtn" id="clear-picks">Clear picks</button><button class="sbtn" id="close-drawer">Close</button></div></div>' +
        '<div class="meta"><div><b>The brief</b>' + esc(s.rec || '') + (s.action ? ' · ' + esc(s.action) : '') + '<textarea class="q2 brief-edit" id="brief-text" rows="3" placeholder="What should this image show? Editing this changes what Generate 5 sends.">' + esc(s.prompt || '') + '</textarea>' + '</div><div><b>Search</b><div class="q2">' + esc((s.terms || []).join(' · ') || '—') + '</div></div><div><b>Rules</b><div class="q2">no hands holding · no light trails · no deep space (LEO only) · no blue or cyan as shot · aircraft and defense only on their own market pages</div><label class="q" style="margin-top:10px"><span class="q-title" style="font-size:.8rem">Note to self</span><input class="txt" id="slot-note" value="' + esc(s.notes || '') + '"></label></div></div>' +
        '<div class="srctabs">' + tabs.map((t) => '<button class="sbtn ' + (srcTab === t[0] ? 'on' : '') + '" data-src="' + t[0] + '">' + t[1] + '</button>').join('') + '<span class="mini">' + (swapTarget ? 'Click a candidate to set the ' + swapTarget + ' image.' : 'Click a candidate for main, again for backup. Click a chosen one to clear it.') + '</span></div>' + body;

      dr.querySelectorAll('[data-src]').forEach((b) => b.addEventListener('click', () => { srcTab = b.dataset.src; libShown = 48; renderDrawer(); }));
      dr.querySelectorAll('[data-remove-cand]').forEach((b) => b.addEventListener('click', (ev) => { ev.stopPropagation(); removeCandidate(s, b.dataset.removeCand); }));
      const sq = $('stock-q'); const sg = $('stock-go');
      if (sq) sq.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); searchStock(sq.value); } });
      if (sg) sg.addEventListener('click', () => searchStock(($('stock-q') || {}).value || ''));
      dr.querySelectorAll('[data-srch-idx]').forEach((c) => c.addEventListener('click', () => {
        const r = stockResults[Number(c.dataset.srchIdx)]; if (!r) return;
        s.candidates = s.candidates || [];
        let cc = s.candidates.find((x) => x.id === r.id);
        if (!cc) { cc = { id: r.id, title: r.title || '', comp: r.comp, url: 'https://stock.adobe.com/images/x/' + r.id, why: r.creator ? 'by ' + r.creator + (r.type ? ' · ' + r.type : '') : 'Found via search', ai: false, manual: true }; s.candidates.unshift(cc); }
        assign(s, pickFrom('stock', cc));
      }));
      const showAi = dr.querySelector('#show-ai-cands'); if (showAi) showAi.addEventListener('click', (ev) => { ev.preventDefault(); fx.hideAi = false; $('f-hideai').checked = false; renderDrawer(); });
      const briefEl = $('brief-text'); if (briefEl) briefEl.addEventListener('change', (e) => { s.prompt = e.target.value; mark(); });
      const genAll = $('gen-all'); if (genAll) genAll.addEventListener('click', () => generateImages(s));
      dr.querySelectorAll('[data-gen-idx]').forEach((b) => b.addEventListener('click', (ev) => { ev.stopPropagation(); generateImages(s, { index: Number(b.dataset.genIdx) }); }));
      dr.querySelectorAll('.cand').forEach((c) => c.addEventListener('click', () => {
        const url = c.dataset.url; if (!url) return; let pick = null;
        if (srcTab === 'stock') { const cc = s.candidates.find((x) => x.comp === url); pick = pickFrom('stock', cc); }
        if (srcTab === 'library') { const l = S.library.find((x) => x.url === url); pick = pickFrom('library', l); }
        if (srcTab === 'existing') { const e = s.existing.find((x) => x.url === url); pick = pickFrom('existing', e); }
        if (srcTab === 'generated') { const g = (s.generated || []).find((x) => x.url === url); if (g) pick = pickFrom('generated', g); }
        if (pick) assign(s, pick);
      }));
      $('close-drawer').addEventListener('click', () => { openSlot = null; swapTarget = null; revealTile = null; renderSlots(); renderDrawer(); });
      $('clear-picks').addEventListener('click', () => { s.main = null; s.backup = null; if (s.id.startsWith('EX-')) s.state = 'unreviewed'; mark(); renderSlots(); renderDrawer(); renderStats(); });
      const keep = $('keep-existing'); if (keep) keep.addEventListener('click', () => { s.state = 'kept'; mark(); renderSlots(); renderDrawer(); renderStats(); });
      $('slot-note').addEventListener('change', (e) => { s.notes = e.target.value; mark(); });
      const ps = $('paste-stock'); if (ps) ps.addEventListener('click', () => { const u = prompt('Adobe Stock comp URL (…ftcdn.net/jpg/…/1000_F_<id>_….jpg) or a Stock ID:'); if (!u) return; const m = u.match(/1000_F_(\d+)_/) || u.match(/^(\d{6,12})$/); const id = m ? m[1] : ''; const url = /^https?:/.test(u) ? u : ''; if (!url) { alert('Paste the comp image URL, not just the ID: the tool can’t fetch a comp from an ID alone.'); return; } s.candidates = s.candidates || []; if (!s.candidates.find((c) => c.comp === url)) s.candidates.unshift({ id, title: 'Pasted', comp: url, url: id ? 'https://stock.adobe.com/images/x/' + id : url, why: 'Added by COGNAK', ai: false, manual: true }); assign(s, pickFrom('stock', s.candidates[0])); });
      const lq = $('lib-q'); if (lq) { lq.addEventListener('input', (e) => { libQuery = e.target.value; libShown = 48; renderDrawer(); const nq = $('lib-q'); nq.focus(); nq.setSelectionRange(nq.value.length, nq.value.length); }); }
      dr.querySelectorAll('[data-g]').forEach((b) => b.addEventListener('click', () => { libGroup = b.dataset.g; libShown = 48; renderDrawer(); }));
      const lm = $('lib-more'); if (lm) lm.addEventListener('click', () => { libShown += 48; renderDrawer(); });
      const uf = $('up-file'); if (uf) uf.addEventListener('change', async () => { const f = uf.files[0]; if (!f) return; $('up-status').textContent = 'Uploading…'; try { const r = await uploadBlob('sitime/uploads/' + s.id + '/' + f.name.replace(/[^\w.\-]+/g, '_'), f); assign(s, { source: 'upload', id: null, url: r.url, thumb: r.url, title: f.name }); } catch (e) { $('up-status').textContent = 'Upload failed: ' + (e.message || e); } });
    }

    /* ---------- replacements ---------- */
    function renderRepl() {
      const m = byId(); const items = [];
      S.batches.filter((b) => b.status !== 'draft').forEach((b) => (b.slotIds || []).forEach((id) => { const s = m.get(id); if (!s) return; const o = outcomeIn(s, b); if (o.outcome === 'denied' || o.outcome === 'held') items.push({ s, b, o }); }));
      $('repl-list').innerHTML = items.length ? items.map(({ s, b, o }) => '<div class="qitem" style="margin-bottom:12px"><img src="' + esc((o.which === 'backup' ? s.backup : s.main)?.thumb || '') + '"><div style="flex:1"><div class="t">' + esc(s.page + ' · ' + s.name) + '</div><div class="n"><span class="st ' + o.outcome + '"><i></i>' + STATUS_LABEL[o.outcome] + '</span> in batch ' + String(b.num).padStart(2, '0') + (o.which === 'backup' ? ' (main and backup both)' : '') + '. ' + (o.ev && o.ev.note ? '“' + esc(o.ev.note) + '”' : 'No note.') + '</div><div class="actions" style="margin-top:8px"><button class="link" data-re="' + s.id + '">Pick a replacement</button></div></div></div>').join('') : '<p class="hint">Nothing denied or held.</p>';
      $('repl-list').querySelectorAll('[data-re]').forEach((x) => x.addEventListener('click', () => { const s = m.get(x.dataset.re); s.batch = null; s.main = null; s.backup = null; s.state = 'assigned'; mark(); openSlot = s.id; srcTab = 'stock'; showTab('slots'); const tr = document.querySelector('#slot-rows tr[data-id="' + s.id + '"]'); if (tr) tr.scrollIntoView({ behavior: 'smooth', block: 'start' }); }));
    }

    /* ---------- handoff ---------- */
    function renderHandoff() {
      const rows = S.slots.map((s) => ({ s, p: finalPick(s), b: batchOf(s) })).filter((x) => x.p);
      $('handoff-rows').innerHTML = rows.map(({ s, p, b }) => '<tr><td><div class="pg">' + esc(s.page) + '</div><div class="sub">' + esc(s.section + ' · ' + s.name) + '</div></td><td>' + thumbCell(p) + '</td><td>' + esc(p.source) + '</td><td class="sub">' + esc(p.source === 'stock' ? 'Adobe Stock ' + (p.id || '') : p.source === 'library' ? p.path : p.title || '') + '</td><td><input class="txt" data-lic="' + s.id + '" value="' + esc(s.license && s.license.id || '') + '" placeholder="' + (p.source === 'stock' ? 'License #' : 'n/a') + '"></td><td class="mini">' + (b ? String(b.num).padStart(2, '0') : '') + '</td></tr>').join('') || '<tr><td colspan="6" class="hint">Nothing approved yet.</td></tr>';
      $('handoff-rows').querySelectorAll('[data-lic]').forEach((i) => i.addEventListener('change', (e) => { const s = byId().get(i.dataset.lic); s.license = { id: e.target.value.trim(), at: new Date().toISOString() }; mark(); }));
    }
    $('export-handoff').addEventListener('click', () => {
      const rows = [['page', 'section', 'url', 'slot', 'source', 'reference', 'image_url', 'license', 'batch']];
      S.slots.forEach((s) => { const p = finalPick(s); if (!p) return; const b = batchOf(s); rows.push([s.page, s.section, s.url, s.name, p.source, p.source === 'stock' ? p.id : (p.path || p.title || ''), p.url, s.license && s.license.id || '', b ? String(b.num).padStart(2, '0') : '']); });
      downloadCsv('sitime-approved-images.csv', rows);
    });

    /* ---------- library indexer + mock copy ---------- */
    let _blob = null;
    function blobClient() { if (!_blob) _blob = import('https://esm.sh/@vercel/blob@1/client'); return _blob; }
    async function uploadBlob(pathname, fileOrBlob) { const mod = await blobClient(); return mod.upload(pathname, fileOrBlob, { access: 'public', handleUploadUrl: '/api/sitime-upload-token', contentType: fileOrBlob.type || 'image/jpeg' }); }
    async function sha1(str) { const buf = await crypto.subtle.digest('SHA-1', new TextEncoder().encode(str)); return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('').slice(0, 12); }
    function resize(file, max) { return new Promise((resolve, reject) => { const img = new Image(); img.onload = () => { const sc = Math.min(1, max / Math.max(img.width, img.height)); const c = document.createElement('canvas'); c.width = Math.round(img.width * sc); c.height = Math.round(img.height * sc); c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); c.toBlob((b) => b ? resolve({ blob: b, w: img.width, h: img.height }) : reject(new Error('encode')), 'image/jpeg', 0.84); URL.revokeObjectURL(img.src); }; img.onerror = reject; img.src = URL.createObjectURL(file); }); }
    function sourcedRows() {
      const rows = [];
      (S.slots || []).forEach((s) => { ['main', 'backup'].forEach((which) => { const p = s[which]; if (p && (p.source === 'stock' || p.source === 'upload')) rows.push({ s, which, p }); }); });
      return rows;
    }
    function renderLib() {
      const n = (S.library || []).length; $('lib-status').textContent = n ? n + ' images indexed.' : 'Not indexed yet.';
      $('mock-h1').value = S.mock?.h1 || ''; $('mock-p').value = S.mock?.p || ''; $('mock-cta').value = S.mock?.cta || '';
      $('review-pass').value = S.reviewPass == null ? 'silicon' : S.reviewPass;
      const sourced = sourcedRows();
      $('sourced-count').textContent = sourced.length ? sourced.length + ' image' + (sourced.length === 1 ? '' : 's') : '';
      $('sourced-list').innerHTML = sourced.length ? sourced.map(({ s, which, p }) => '<div class="qitem"><img src="' + esc(p.thumb || p.url) + '"><div><div class="t">' + esc(s.page) + ' · ' + esc(s.name) + ' <span class="mini">(' + which + ')</span></div><div class="n">' + esc(p.source === 'stock' ? 'Adobe Stock' + (p.id ? ' · ' + p.id : '') : (p.title || p.path || 'Uploaded')) + '</div></div><button class="sbtn" data-unassign="' + s.id + ':' + which + '">Remove</button></div>').join('') : '<p class="hint">Nothing sourced from Stock or uploaded yet.</p>';
      $('sourced-list').querySelectorAll('[data-unassign]').forEach((b) => b.addEventListener('click', () => {
        const [id, which] = b.dataset.unassign.split(':');
        const s = byId().get(id); if (!s) return;
        s[which] = null;
        if (!s.main && !s.backup && s.id.startsWith('EX-')) s.state = 'unreviewed';
        mark(); renderLib(); renderSlots(); renderStats();
      }));
    }
    $('review-pass').addEventListener('change', (e) => { S.reviewPass = e.target.value.trim(); mark(); });
    ['mock-h1', 'mock-p', 'mock-cta'].forEach((id) => $(id).addEventListener('change', () => { S.mock = { h1: $('mock-h1').value, p: $('mock-p').value, cta: $('mock-cta').value }; mark(); }));
    $('lib-dir').addEventListener('change', async () => {
      const files = Array.from($('lib-dir').files).filter((f) => /\.(jpe?g|png)$/i.test(f.name));
      const wanted = files.filter((f) => { const p = f.webkitRelativePath; return /\/Digital-Web\//.test(p) || /(^|\/)MEMS-Products\//.test(p); }).filter((f) => !/\/(_index|__|\[Visual-Assets\]-Licensed-Image-Library)\//.test(f.webkitRelativePath) && !/^\[Visual-Assets\]/.test(f.webkitRelativePath.split('/')[1] || ''));
      const have = new Set((S.library || []).map((l) => l.id));
      $('lib-log').textContent = wanted.length + ' web-size images found, ' + have.size + ' already indexed.';
      let done = 0, added = 0, failed = 0; S.library = S.library || [];
      for (const f of wanted) {
        const rel = f.webkitRelativePath.split('/').slice(1).join('/'); // drop the chosen folder's own name
        const id = await sha1(rel);
        if (!have.has(id)) {
          try {
            const web = await resize(f, 1200); const th = await resize(f, 400);
            const r1 = await uploadBlob('sitime/library/' + id + '.jpg', web.blob);
            const r2 = await uploadBlob('sitime/library/t/' + id + '.jpg', th.blob);
            const parts = rel.split('/'); const tier = /Digital-Web/.test(rel) ? 'Digital-Web' : 'product'; const group = parts[0] === 'by-Segment' || parts[0] === 'Thematic' ? parts[1] : parts[0];
            S.library.push({ id, path: rel, name: f.name, group, tier, url: r1.url, thumb: r2.url, w: web.w, h: web.h });
            have.add(id); added++;
            if (added % 25 === 0) { mark(); }
          } catch (e) { failed++; console.error(rel, e); }
        }
        done++; $('lib-progress').textContent = done + ' / ' + wanted.length + (failed ? ' · ' + failed + ' failed' : '');
      }
      mark(); renderLib(); renderStats(); $('lib-log').textContent = 'Done. ' + added + ' added' + (failed ? ', ' + failed + ' failed (see console)' : '') + '.';
    });

    /* ---------- boot ---------- */
    async function boot() {
      const r = await api('/api/sitime-state');
      $('loading').hidden = true;
      if (r.status === 401) { $('gate').hidden = false; return; }
      if (!r.ok || !r.data) { $('gate').hidden = false; $('gate').querySelector('.hint').textContent = (r.data && r.data.error) || 'Could not load.'; return; }
      S = r.data.state; D = r.data.decisions || {};
      S.batches = S.batches || []; S.library = S.library || [];
      $('app').hidden = false; $('savestate').textContent = r.data.seeded ? 'Seeded' : 'Saved';
      renderStats(); renderFilters(); showTab('batches');
      // refresh decisions every 60s while the page is open
      setInterval(async () => { const rr = await api('/api/sitime-state'); if (rr.ok && rr.data) { D = rr.data.decisions || {}; if (!$('tab-batches').hidden) { renderBatches(); renderStats(); } } }, 60000);
    }
    boot();
  })();
  </script>
</BaseLayout>
