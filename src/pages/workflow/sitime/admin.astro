    }
    const upStatus = {};
    function wireSource(s, el) {
      el.querySelectorAll('[data-remove-cand]').forEach((b) => b.addEventListener('click', (ev) => { ev.stopPropagation(); removeCandidate(s, b.dataset.removeCand); }));
      el.querySelectorAll('.cand .adobe').forEach((a) => a.addEventListener('click', (ev) => ev.stopPropagation()));
      const sq = el.querySelector('[data-stockq]'); const sg = el.querySelector('[data-stockgo]');
      if (sq) sq.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); searchStock(s, sq.value); } });
      if (sg) sg.addEventListener('click', () => searchStock(s, sq ? sq.value : ''));
      el.querySelectorAll('[data-srch-idx]').forEach((c) => c.addEventListener('click', () => {
        const r = stockResults[Number(c.dataset.srchIdx)]; if (!r) return;
