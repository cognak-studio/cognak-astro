    function randomToken(len = 10) { const a = 'abcdefghjkmnpqrstuvwxyz23456789'; const b = crypto.getRandomValues(new Uint8Array(len)); return Array.from(b, (x) => a[x % a.length]).join(''); }

    let S = null;          // state document
    let D = {};            // decisions by batch token → { latest: {slotId: {main, backup}} }
    let checked = new Set();
    let openSlot = null;
    let swapTarget = null; // 'main' | 'backup' -- set when the drawer was opened to fill/replace one specific slot (an empty tile or its Swap button), so the next pick lands there instead of the old auto-fill logic
    let stockSlotId = null, stockQ = '', stockResults = [], stockBusy = false, stockErr = ''; // live Adobe Stock search state, reset when the drawer switches to a different slot
    let revealTile = null; // { slotId, which } -- which filled tile currently has its Swap/trash actions revealed
    let srcTab = 'stock';
    let libQuery = '', libGroup = '', libShown = 48;
    const fx = { pri: '', status: '', section: '', rec: '', hideAi: true, hideReuse: false };
    let search = '';
    const PAGE = 5;
    let pageIdx = 0;

    /* ---------- save (debounced, whole document) ---------- */
    let saveTimer = null, saving = false, dirty = false;
    function mark() { dirty = true; $('savestate').textContent = 'Unsaved'; clearTimeout(saveTimer); saveTimer = setTimeout(save, 1200); }
    async function verifySaved(savedAt, tries) {
      tries = tries || 0;
      const rr = await api('/api/sitime-state');
      if (rr.ok && rr.data && rr.data.state && rr.data.state.savedAt === savedAt) return true;
      if (tries >= 5) return false;
      await new Promise((res) => setTimeout(res, 400 * (tries + 1)));
      return verifySaved(savedAt, tries + 1);
    }
    async function save() {
      if (saving) { dirty = true; return; }
      saving = true; dirty = false; $('savestate').textContent = 'Saving…';
      const r = await api('/api/sitime-state', { method: 'POST', body: { state: S } });
      if (r.ok && r.data && r.data.savedAt) {
        $('savestate').textContent = 'Verifying…';
        const ok = await verifySaved(r.data.savedAt);
        $('savestate').textContent = ok ? 'Saved' : 'Saved (unverified — wait a moment before sharing the link)';
      } else {
        $('savestate').textContent = 'Save failed';
      }
      saving = false;
      if (dirty) save();
    }

    /* ---------- derived ---------- */
    const byId = () => new Map(S.slots.map((s) => [s.id, s]));
    function batchOf(slot) { return slot.batch ? S.batches.find((b) => b.token === slot.batch) : null; }
    function outcomeIn(slot, batch) {
      const d = batch && D[batch.token] && D[batch.token].latest && D[batch.token].latest[slot.id];
      const m = d && d.main, b = d && d.backup;
      if (!m) return { outcome: 'pending', which: null };
      if (m.decision === 'approve') return { outcome: 'approved', which: 'main', ev: m };
      if (m.decision === 'hold') return { outcome: 'held', which: 'main', ev: m };
      if (!slot.backup) return { outcome: 'denied', which: 'main', ev: m };
      if (!b) return { outcome: 'pending', which: 'backup', ev: m };
      if (b.decision === 'approve') return { outcome: 'approved', which: 'backup', ev: b };
      if (b.decision === 'hold') return { outcome: 'held', which: 'backup', ev: b };
      return { outcome: 'denied', which: 'backup', ev: b };
    }
    function status(slot) {
      const b = batchOf(slot);
      if (b) {
        if (b.status === 'draft') return 'queued';
        const o = outcomeIn(slot, b).outcome;
        return o === 'pending' ? 'sent' : o;
      }
      if (slot.state === 'kept') return 'kept';
      if (slot.state === 'unreviewed') return 'unreviewed';
      return slot.main ? 'assigned' : 'unassigned';
    }
    const STATUS_LABEL = { unassigned: 'Unassigned', assigned: 'Assigned', queued: 'In draft', sent: 'Sent', approved: 'Approved', denied: 'Denied', held: 'Held', unreviewed: 'Unreviewed', kept: 'Kept as is' };
    function finalPick(slot) { const b = batchOf(slot); const o = b ? outcomeIn(slot, b) : null; return o && o.outcome === 'approved' ? (o.which === 'backup' ? slot.backup : slot.main) : null; }

    /* ---------- render: stats + tabs ---------- */
    function renderStats() {
      const st = S.slots.map(status);
      const n = (k) => st.filter((x) => x === k).length;
      const inScope = S.slots.filter((s) => s.state !== 'unreviewed' && s.state !== 'kept').length;
      $('stats').innerHTML = [
        ['' + inScope, 'slots in scope'],
        ['' + S.slots.filter((s) => s.main && s.backup).length, 'main + backup assigned'],
        ['' + n('approved'), 'approved'],
        ['' + n('denied'), 'denied, need replacement', 'warn'],
        ['' + n('held'), 'held'],
      ].map((x) => '<div class="stat ' + (x[2] || '') + '"><b>' + x[0] + '</b><span>' + x[1] + '</span></div>').join('');
      $('n-batches').textContent = S.batches.length;
      $('n-slots').textContent = S.slots.length;
      $('n-repl').textContent = n('denied') + n('held');
      $('n-handoff').textContent = n('approved');
      $('n-lib').textContent = (S.library || []).length;
    }
    document.querySelectorAll('#tabs a').forEach((a) => a.addEventListener('click', () => showTab(a.dataset.tab)));
    function showTab(t) {
      document.querySelectorAll('#tabs a').forEach((a) => a.classList.toggle('on', a.dataset.tab === t));
      ['batches', 'slots', 'replacements', 'handoff', 'library'].forEach((k) => { $('tab-' + k).hidden = k !== t; });
      $('stats').hidden = t !== 'batches';
      if (t === 'batches') renderBatches(); if (t === 'slots') renderSlots(); if (t === 'replacements') renderRepl(); if (t === 'handoff') renderHandoff(); if (t === 'library') renderLib();
    }

    /* ---------- batches ---------- */
    function batchCounts(b) {
      const m = byId(); const c = { a: 0, d: 0, h: 0, p: 0 };
      (b.slotIds || []).forEach((id) => { const s = m.get(id); if (!s) return; const o = outcomeIn(s, b).outcome; c[o === 'approved' ? 'a' : o === 'denied' ? 'd' : o === 'held' ? 'h' : 'p']++; });
      return c;
    }
    const ICONS = {
      open: '<svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg>',
      preview: '<svg viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>',
      send: '<svg viewBox="0 0 24 24"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg>',
      copy: '<svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>',
      csv: '<svg viewBox="0 0 24 24"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/></svg>',
      delete: '<svg viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M6 6l1 14h10l1-14"/><path d="M10 11v6M14 11v6"/></svg>',
      refresh: '<svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 0 1 15.4-6.4L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.4 6.4L3 16"/><path d="M3 21v-5h5"/></svg>',
      chevron: '<svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>',
    };
    const ICON = (act, label) => '<button class="ibtn" data-act="' + act + '" title="' + esc(label) + '" aria-label="' + esc(label) + '">' + ICONS[act] + '</button>';
    function deleteBatch(b) {
      const total = (b.slotIds || []).length;
      const msg = b.status === 'draft' ? 'Delete this draft batch? Its ' + total + ' slots go back to assigned.' : 'Delete batch ' + String(b.num).padStart(2, '0') + '? It has been sent; its link stops working and its ' + total + ' slots go back to assigned. Decisions already made are discarded.';
      if (!confirm(msg)) return;
      const m = byId(); (b.slotIds || []).forEach((id) => { const s = m.get(id); if (s) s.batch = null; });
      S.batches = S.batches.filter((x) => x !== b); delete D[b.token];
      mark(); renderBatches(); renderStats();
    }
    function renderBatches() {
      const rows = S.batches.slice().sort((a, b) => b.num - a.num).map((b) => {
        const c = batchCounts(b);
        const total = (b.slotIds || []).length;
        const stat = b.status === 'draft' ? 'Draft' : (c.p === 0 && total ? 'Complete' : 'In review');
        const cls = b.status === 'draft' ? 'draft' : (c.p === 0 && total ? 'approved' : 'held');
        const link = location.origin + '/workflow/sitime/' + b.token;
        return '<div class="batchrow" data-b="' + b.token + '"><div><b>' + String(b.num).padStart(2, '0') + '</b> · ' + esc(b.name) + '</div><div class="sub">' + esc(b.scope || '') + '</div><div>' + total + '</div><div><span class="st ' + cls + '"><i></i>' + stat + '</span></div>' +
          '<div><span class="mini">' + (b.status === 'draft' ? '—' : '<b class="a">' + c.a + ' ✓</b><b class="d">' + c.d + ' ✕</b><b class="h">' + c.h + ' ◦</b>' + (c.p ? '<b>' + c.p + ' left</b>' : '')) + '</span></div>' +
          '<div class="mini">' + (b.sentAt ? fmtDate(b.sentAt.slice(0, 10)) : (b.plannedFor ? fmtDate(b.plannedFor) + ', planned' : '—')) + '</div>' +
          '<div class="acts">' + ICON('open', 'Open') + (b.status === 'draft' ? ICON('preview', 'Preview as SiTime') + ICON('send', 'Mark sent and copy the link') : ICON('copy', 'Copy link') + ICON('csv', 'Export CSV')) + ICON('delete', 'Delete batch') + '</div>' +
          '<div class="bdetail" hidden style="grid-column:1/-1"></div></div>';
      });
      $('batch-list').innerHTML = (S.batches.length ? '<div class="batchrow head"><div>Batch</div><div>Scope</div><div>Slots</div><div>Status</div><div>Decisions</div><div>Sent</div><div></div></div>' : '<p class="hint">No batches yet. Check slots in the Slots tab and add them to a batch, or make an empty one here.</p>') + rows.join('');
      $('batch-list').querySelectorAll('button[data-act]').forEach((btn) => btn.addEventListener('click', (e) => {
        const row = e.target.closest('.batchrow'); const b = S.batches.find((x) => x.token === row.dataset.b); const link = location.origin + '/workflow/sitime/' + b.token;
        const act = btn.dataset.act;
        if (act === 'open') { const d = row.querySelector('.bdetail'); d.hidden = !d.hidden; if (!d.hidden) renderBatchDetail(b, d); }
        if (act === 'preview') window.open(link, '_blank');
        if (act === 'copy') { navigator.clipboard.writeText(link); btn.classList.add('done'); setTimeout(() => btn.classList.remove('done'), 1500); }
        if (act === 'send') { if (!(b.slotIds || []).length) { alert('Add slots first.'); return; } b.status = 'sent'; b.sentAt = new Date().toISOString(); mark(); renderBatches(); renderStats(); navigator.clipboard.writeText(link); alert('Marked sent. The link is on your clipboard:\n' + link); }
        if (act === 'csv') exportBatchCsv(b);
        if (act === 'delete') deleteBatch(b);
      }));
      // waiting on you
      const m = byId(); const items = [];
      S.batches.filter((b) => b.status !== 'draft').forEach((b) => (b.slotIds || []).forEach((id) => { const s = m.get(id); if (!s) return; const o = outcomeIn(s, b); if (o.outcome === 'denied' || o.outcome === 'held') items.push({ s, b, o }); }));
      const approvedUnlicensed = S.slots.filter((s) => { const p = finalPick(s); return p && p.source === 'stock' && !(s.license && s.license.id); }).length;
      $('waiting').innerHTML = items.slice(0, 8).map(({ s, b, o }) => '<div class="qitem"><img src="' + esc((o.which === 'backup' ? s.backup : s.main)?.thumb || '') + '"><div><div class="t">' + esc(s.page + ' · ' + s.name) + '</div><div class="n">' + (o.outcome === 'denied' ? 'Denied' : 'Held') + ' in ' + String(b.num).padStart(2, '0') + '. ' + (o.ev && o.ev.note ? '“' + esc(o.ev.note) + '”' : 'No note.') + '</div></div></div>').join('') +
        (approvedUnlicensed ? '<div class="qitem"><div class="thumb empty" style="width:72px;height:48px"></div><div><div class="t">' + approvedUnlicensed + ' approved Stock image' + (approvedUnlicensed > 1 ? 's' : '') + ' to license</div><div class="n">Approved comps are ready to license on Adobe Stock. Handoff tab has the list and a field for the license ID.</div></div></div>' : '') ||
        '<p class="hint">Nothing waiting.</p>';
    }
    function renderBatchDetail(b, el) {
      const m = byId();
      el.innerHTML = '<div class="bslots">' + (b.slotIds || []).map((id) => { const s = m.get(id); if (!s) return ''; const o = outcomeIn(s, b); const p = (o.which === 'backup' ? s.backup : s.main) || s.main; return '<div class="bslot"><img src="' + esc(p?.thumb || '') + '"><b>' + esc(s.page) + '</b>' + esc(s.name) + '<div><span class="st ' + (b.status === 'draft' ? 'queued' : o.outcome === 'pending' ? 'sent' : o.outcome) + '"><i></i>' + (b.status === 'draft' ? 'In draft' : STATUS_LABEL[o.outcome === 'pending' ? 'sent' : o.outcome]) + '</span></div>' + (o.ev && o.ev.note ? '<div>“' + esc(o.ev.note) + '”</div>' : '') + (b.status === 'draft' ? '<button class="link" data-rm="' + s.id + '">Remove</button>' : '') + '</div>'; }).join('') + '</div>' +
        '<div class="actions"><button class="link" data-edit="1">Rename / reschedule</button><button class="link" data-del="1">Delete batch</button>' + '<span class="mini">' + location.origin + '/workflow/sitime/' + b.token + '</span></div>';
      el.querySelectorAll('[data-rm]').forEach((x) => x.addEventListener('click', () => { const s = m.get(x.dataset.rm); b.slotIds = b.slotIds.filter((i) => i !== s.id); s.batch = null; mark(); renderBatches(); renderStats(); }));
      el.querySelector('[data-edit]').addEventListener('click', () => openBatchDialog(b));
      const del = el.querySelector('[data-del]'); if (del) del.addEventListener('click', () => deleteBatch(b));
    }
    function exportBatchCsv(b) {
      const m = byId();
      const rows = [['batch', 'page', 'section', 'url', 'slot', 'outcome', 'via', 'source', 'reference', 'image_url', 'note']];
      (b.slotIds || []).forEach((id) => { const s = m.get(id); if (!s) return; const o = outcomeIn(s, b); const p = (o.which === 'backup' ? s.backup : s.main) || s.main || {}; rows.push([String(b.num).padStart(2, '0'), s.page, s.section, s.url, s.name, o.outcome, o.which || '', p.source || '', p.source === 'stock' ? p.id : (p.path || p.title || ''), p.url || '', (o.ev && o.ev.note) || '']); });
      downloadCsv('sitime-batch-' + String(b.num).padStart(2, '0') + '.csv', rows);
    }
    function downloadCsv(name, rows) { const csv = rows.map((r) => r.map((c) => '"' + String(c == null ? '' : c).replace(/"/g, '""') + '"').join(',')).join('\n'); const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = name; a.click(); }

    let dialogBatch = null;
    function openBatchDialog(b) {
      dialogBatch = b || null;
      $('bd-title').textContent = b ? 'Batch ' + String(b.num).padStart(2, '0') : 'New batch';
      $('bd-name').value = b ? b.name : ''; $('bd-date').value = b ? (b.plannedFor || '') : '';
      $('bd-hint').textContent = b ? '' : (checked.size ? checked.size + ' checked slot' + (checked.size > 1 ? 's' : '') + ' will go in.' : 'Starts empty. Add slots from the Slots tab.');
      $('batch-dialog').showModal();
    }
    $('new-batch').addEventListener('click', () => openBatchDialog(null));
    $('bd-cancel').addEventListener('click', () => $('batch-dialog').close());
    $('bd-save').addEventListener('click', () => {
