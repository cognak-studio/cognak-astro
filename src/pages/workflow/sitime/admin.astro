    /* The site's custom cursor (#cognak-cursor) is a fixed element on the
       page layer; a <dialog> renders in the browser's top layer above it, so
       the dot disappears behind the modal. While a dialog is open, hide the
       custom dot and let the native cursor show. */
    html:has(dialog[open]) #cognak-cursor{ display:none !important; }
    html:has(dialog[open]), html:has(dialog[open]) *{ cursor:auto !important; }
    html:has(dialog[open]) button, html:has(dialog[open]) .sbtn, html:has(dialog[open]) .link{ cursor:pointer !important; }
    .adm .actions{ display:flex; gap:12px; align-items:center; flex-wrap:wrap; }

    /* ---- Slots workspace: a left rail of sections and pages, like Ace's
       gallery, so 401 slots are navigable by where they live instead of only
       by a 5-at-a-time pager. Picking a page in the rail shows that page's
       slots whole, with no pager at all. ---- */
    .adm .workspace{ display:grid; grid-template-columns:264px minmax(0,1fr); gap:40px; align-items:start; }
    .adm .rail{ position:sticky; top:110px; max-height:calc(100vh - 150px); overflow-y:auto; overscroll-behavior:contain; padding-right:8px; border-right:1px solid var(--line); }
    .adm .railhead{ display:flex; align-items:center; justify-content:space-between; gap:8px; padding-bottom:10px; margin-bottom:8px; border-bottom:1px solid var(--line); position:sticky; top:0; background:#fff; z-index:1; }
    .adm .railhead .link{ margin:0; }
