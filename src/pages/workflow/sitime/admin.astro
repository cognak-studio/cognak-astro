    $('team-save').addEventListener('click', async () => {
      const pass = $('team-pass').value;
      $('team-status').textContent = 'Saving…';
      const r = await api('/api/sitime-team', { method: 'POST', body: { action: 'set', pass } });
      $('team-pass').value = '';
      $('team-status').textContent = r.ok ? (r.data.teamOn ? 'Set. Anyone signed in with the old one is signed out.' : 'Team access is off.') : ((r.data && r.data.error) || 'Could not save.');
    });
    $('review-pass').addEventListener('change', (e) => { S.reviewPass = e.target.value.trim(); mark(); });
    ['mock-h1', 'mock-p', 'mock-cta'].forEach((id) => $(id).addEventListener('change', () => { S.mock = { h1: $('mock-h1').value, p: $('mock-p').value, cta: $('mock-cta').value }; mark(); }));
    $('lib-dir').addEventListener('change', async () => {
      const files = Array.from($('lib-dir').files).filter((f) => /\.(jpe?g|png)$/i.test(f.name));
      const wanted = files.filter((f) => { const p = f.webkitRelativePath; return /\/Digital-Web\//.test(p) || /(^|\/)MEMS-Products\//.test(p); }).filter((f) => !/\/(_index|__|\[Visual-Assets\]-Licensed-Image-Library)\//.test(f.webkitRelativePath) && !/^\[Visual-Assets\]/.test(f.webkitRelativePath.split('/')[1] || ''));
      const have = new Set((S.library || []).map((l) => l.id));
      $('lib-log').textContent = wanted.length + ' web-size images found, ' + have.size + ' already indexed.';
      let done = 0, added = 0, failed = 0; S.library = S.library || [];
      for (const f of wanted) {
        const rel = f.webkitRelativePath.split('/').slice(1).join('/'); // drop the chosen folder's own name
        const id = await sha1(rel);
        if (!have.has(id)) {
          try {
            const web = await resize(f, 1200); const th = await resize(f, 400);
            const r1 = await uploadBlob('sitime/library/' + id + '.' + web.ext, web.blob);
            const r2 = await uploadBlob('sitime/library/t/' + id + '.' + th.ext, th.blob);
            const parts = rel.split('/'); const tier = /Digital-Web/.test(rel) ? 'Digital-Web' : 'product'; const group = parts[0] === 'by-Segment' || parts[0] === 'Thematic' ? parts[1] : parts[0];
            S.library.push({ id, path: rel, name: f.name, group, tier, url: r1.url, thumb: r2.url, w: web.w, h: web.h });
            have.add(id); added++;
            if (added % 25 === 0) { mark(); }
          } catch (e) { failed++; console.error(rel, e); }
        }
        done++; $('lib-progress').textContent = done + ' / ' + wanted.length + (failed ? ' · ' + failed + ' failed' : '');
      }
      mark(); renderLib(); renderStats(); $('lib-log').textContent = 'Done. ' + added + ' added' + (failed ? ', ' + failed + ' failed (see console)' : '') + '.';
    });

    /* ---------- boot ---------- */
    async function teamSignIn() {
      $('tl-err').hidden = true;
      const name = $('tl-name').value.trim();
      if (!name) { $('tl-err').textContent = 'Add your name, so edits show who made them.'; $('tl-err').hidden = false; return; }
      $('tl-go').disabled = true;
      const r = await api('/api/sitime-team', { method: 'POST', body: { action: 'login', name, pass: $('tl-pass').value } });
      $('tl-go').disabled = false;
      if (!r.ok) { $('tl-err').textContent = (r.data && r.data.error) || 'Could not sign in.'; $('tl-err').hidden = false; return; }
      $('gate').hidden = true; $('loading').hidden = false; boot();
    }
    $('tl-go').addEventListener('click', teamSignIn);
    $('tl-pass').addEventListener('keydown', (e) => { if (e.key === 'Enter') teamSignIn(); });
    let booted = false;
    async function boot() {
      const r = await api('/api/sitime-state');
      $('loading').hidden = true;
      if (r.status === 401) { $('gate').hidden = false; $('tl-name').focus(); return; }
      if (!r.ok || !r.data) { $('gate').hidden = false; $('gate').querySelector('.hint').textContent = (r.data && r.data.error) || 'Could not load.'; return; }
      S = r.data.state; D = r.data.decisions || {};
      S.batches = S.batches || []; S.library = S.library || [];
      base = clone(S);
      me = r.data.me || me;
      document.querySelector('.adm').classList.toggle('team', me.role !== 'admin');
      if (me.role !== 'admin') {
        $('lede').textContent = 'Pick a main and a backup for each slot. Your edits save as you go and show your name; Pierce builds the batches.';
        $('whoami').innerHTML = esc(me.name) + ' · <button type="button" id="signout">Sign out</button>';
        $('signout').addEventListener('click', async () => { await flush(); await api('/api/sitime-team', { method: 'POST', body: { action: 'logout' } }); location.reload(); });
      }
      if (booted) return; booted = true;
      $('app').hidden = false; $('savestate').textContent = r.data.seeded ? 'Seeded' : 'Saved';
      renderStats(); renderFilters(); showTab(me.role === 'admin' ? 'batches' : 'slots');
      // refresh decisions every 60s while the page is open
      // refresh decisions every 60s, and straight away when coming back from a review tab
      // and pull in other editors' saves (merged, never overwriting unsaved work here)
      const refreshDecisions = async () => {
        if (saving) return;
        const rr = await api('/api/sitime-state');
        if (!(rr.ok && rr.data)) return;
        D = rr.data.decisions || {};
        const sv = rr.data.state;
        if (sv && sv.savedAt && sv.savedAt > ((base && base.savedAt) || 0) && !saving) {
          rebase(sv);
          if (!typing()) { rerender(); return; }
        }
        renderStats(); if (!$('tab-batches').hidden) renderBatches();
      };
      setInterval(refreshDecisions, 30000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshDecisions(); });
    }
    boot();
  })();
  </script>
</BaseLayout>
