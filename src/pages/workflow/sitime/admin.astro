        });
      });
      const showAi = el.querySelector('[data-showai]'); if (showAi) showAi.addEventListener('click', (ev) => { ev.preventDefault(); fx.hideAi = false; $('f-hideai').checked = false; refreshDrawer(s.id); });
      const genAll = el.querySelector('[data-genall]'); if (genAll) genAll.addEventListener('click', () => {
