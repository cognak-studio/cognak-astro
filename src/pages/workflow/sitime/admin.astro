      $('repl-list').querySelectorAll('[data-re]').forEach((x) => x.addEventListener('click', () => { const s = m.get(x.dataset.re); s.batch = null; s.main = null; s.backup = null; s.state = 'assigned'; mark(); fx.page = s.pageId; pageIdx = 0; showTab('slots'); renderSlots(); openPicker(s.id, 'main'); }));
    }

    /* ---------- handoff ---------- */
