      background:linear-gradient(100deg,#F4F2ED 30%,#FBFAF7 50%,#F4F2ED 70%) 0 0/300% 100%; animation:gen-sheen 1.6s linear infinite; }
    .adm .gw-dot{ width:6px; height:6px; border-radius:50%; background:var(--accent); animation:gen-pulse 1s ease-in-out infinite alternate; }
