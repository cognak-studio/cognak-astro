        ['dragenter', 'dragover'].forEach((k) => card.addEventListener(k, (e) => { stop(e); card.classList.add('drop'); }));
        ['dragleave', 'dragend'].forEach((k) => card.addEventListener(k, (e) => { stop(e); card.classList.remove('drop'); }));
        card.addEventListener('drop', (e) => {
