    /* Two tiles per slot, Main and Backup. Clicking an empty tile -- or Swap
       on a filled one -- opens the FULL-SCREEN picker (openPicker below), not
       an inline drawer. The chevron opens the row's detail drawer, which is
       now just the brief, the search terms, the rules and the note: no
       candidate grid, so nothing about choosing an image lives under a fold. */
    function tileHtml(s, which) {
      const pick = s[which];
      if (!pick) return '<div class="tile empty" data-slot="' + s.id + '" data-which="' + which + '"><span>Choose ' + which + '</span><span class="mini">Stock · SiTime library · generate · upload</span></div>';
      const open = revealTile && revealTile.slotId === s.id && revealTile.which === which;
      return '<div class="tile filled is-' + which + (open ? ' is-open' : '') + '" title="' + esc(pick.title || '') + '" data-slot="' + s.id + '" data-which="' + which + '">' +
        '<img loading="lazy" src="' + esc(pick.thumb || pick.url) + '">' +
        '<span class="tag">' + which.toUpperCase() + '</span>' +
        '<span class="cap">' + esc(pick.title || pick.id || '') + '</span>' +
        '<div class="tile-actions"><button class="tact" data-act="replace" data-slot="' + s.id + '" data-which="' + which + '">Replace</button>' +
        (which === 'main' && s.backup ? '<button class="tact" data-act="swap" data-slot="' + s.id + '" data-which="' + which + '" title="Make the backup the main">Swap</button>' : '') +
        '<button class="tact trash" data-act="trash" data-slot="' + s.id + '" data-which="' + which + '" title="Remove ' + which + '" aria-label="Remove ' + which + '">' + ICONS.delete + '</button></div></div>';
    }
    function tilesFor(s) { return '<div class="tiles">' + tileHtml(s, 'main') + tileHtml(s, 'backup') + '</div>'; }
    function thumbCell(p) { return p && (p.thumb || p.url) ? '<img class="thumb" src="' + esc(p.thumb || p.url) + '">' : '<div class="thumb empty"></div>'; }
    function renderSlots() {
      renderRail(); renderPageCard();
      const list = filtered();
      // A page picked in the rail shows whole. Only the "whole site" view pages.
      const paged = !fx.page;
      const pages = Math.max(1, Math.ceil(list.length / PAGE));
      if (pageIdx >= pages) pageIdx = pages - 1;
      const start = paged ? pageIdx * PAGE : 0;
      const shown = paged ? list.slice(start, start + PAGE) : list;
      const rows = shown.map((s) => {
        const st = status(s); const b = batchOf(s); const open = openSlots.has(s.id);
        return '<div class="srow ' + (open ? 'sel' : '') + '" data-id="' + s.id + '">' + tilesFor(s) +
          '<div class="mrow">' + (me.role === 'admin' ? '<input type="checkbox" data-chk="' + s.id + '" ' + (checked.has(s.id) ? 'checked' : '') + ' ' + (s.batch ? 'disabled' : '') + '>' : '<span></span>') + '<div class="who"><div class="pg">' + esc(s.page) + '</div><div class="sub">' + esc(s.section + ' · ' + s.name) + '</div>' + (s.edit ? '<span class="edited">' + esc(s.edit.by) + ' · ' + ago(s.edit.at) + '</span>' : '') + '</div>' +
          '<span class="pri p-' + esc(s.priority.toLowerCase()) + '">' + esc(s.priority) + '</span><span class="pri">' + esc((s.rec || '').split(' ')[0]) + '</span>' +
          '<div class="end"><span class="st ' + st + '"><i></i>' + STATUS_LABEL[st] + '</span><span class="mini">' + (b ? 'Batch ' + String(b.num).padStart(2, '0') : '—') + '</span><span class="chev" title="Brief and notes">' + ICONS.chevron + '</span></div></div></div>' +
          (open ? '<div class="drawer-wrap"><div class="drawer" data-detail="' + s.id + '"></div></div>' : '');
      });
      $('slot-rows').innerHTML = rows.join('') || '<p class="hint">Nothing matches.</p>';
      const count = !list.length ? '0 slots' : paged
        ? 'Showing ' + (start + 1) + '–' + Math.min(start + PAGE, list.length) + ' of ' + list.length
        : list.length + ' slot' + (list.length === 1 ? '' : 's') + ' on this page';
      $('pg-count').textContent = count;
      $('pg-prev').hidden = !paged; $('pg-next').hidden = !paged;
      $('pg-prev').disabled = pageIdx === 0; $('pg-next').disabled = !paged || start + PAGE >= list.length;
      $('slot-more').innerHTML = paged
        ? '<span class="mini">' + count + '</span><button class="sbtn" id="pg-prev2" ' + (pageIdx === 0 ? 'disabled' : '') + '>Prev</button><button class="sbtn" id="pg-next2" ' + (start + PAGE >= list.length ? 'disabled' : '') + '>Next</button>'
        : '';
      const pv = $('pg-prev2'), nx = $('pg-next2');
      if (pv) pv.addEventListener('click', () => { if (pageIdx > 0) { pageIdx--; renderSlots(); window.scrollTo({ top: $('tab-slots').offsetTop - 80, behavior: 'smooth' }); } });
      if (nx) nx.addEventListener('click', () => { if (start + PAGE < list.length) { pageIdx++; renderSlots(); window.scrollTo({ top: $('tab-slots').offsetTop - 80, behavior: 'smooth' }); } });
      $('slot-rows').querySelectorAll('.tile.empty').forEach((tl) => tl.addEventListener('click', (e) => {
        e.stopPropagation(); openPicker(tl.dataset.slot, tl.dataset.which);
      }));
      $('slot-rows').querySelectorAll('.tile.filled').forEach((tl) => tl.addEventListener('click', (e) => {
        e.stopPropagation();
        const slotId = tl.dataset.slot, which = tl.dataset.which;
        revealTile = (revealTile && revealTile.slotId === slotId && revealTile.which === which) ? null : { slotId, which };
        renderSlots();
      }));
      $('slot-rows').querySelectorAll('.tact').forEach((btn) => btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const s = byId().get(btn.dataset.slot); const which = btn.dataset.which;
        if (btn.dataset.act === 'trash') {
          s[which] = null; revealTile = null;
          if (!s.main && !s.backup && s.id.startsWith('EX-')) s.state = 'unreviewed';
          mark(); renderSlots(); renderStats();
        } else if (btn.dataset.act === 'swap') {
          const tmp = s.main; s.main = s.backup; s.backup = tmp; revealTile = null;
          mark(); renderSlots(); renderStats();
        } else if (btn.dataset.act === 'replace') {
          revealTile = null; openPicker(s.id, which);
        }
      }));
      $('slot-rows').querySelectorAll('input[data-chk]').forEach((c) => c.addEventListener('click', (e) => { e.stopPropagation(); c.checked ? checked.add(c.dataset.chk) : checked.delete(c.dataset.chk); updateChecked(); }));
      $('slot-rows').querySelectorAll('.srow .mrow').forEach((mr) => mr.addEventListener('click', () => {
        const id = mr.closest('.srow').dataset.id;
        openSlots.has(id) ? openSlots.delete(id) : openSlots.add(id);
        revealTile = null; renderSlots();
      }));
      $('slot-rows').querySelectorAll('[data-detail]').forEach((el) => renderDetail(byId().get(el.dataset.detail), el));
      $('expand-all').textContent = shown.length && shown.every((s) => openSlots.has(s.id)) ? 'Collapse all' : 'Expand all';
      updateChecked();
    }
    /* The row drawer IS the picker. Header: who this slot is, plus the
       Main/Backup target the next click fills. Then the brief and the search
       terms, both editable. Then the sources and the candidate grid. No rules
       block, no note field -- they were taking the width the images want. */
    function renderDetail(s, el) {
      if (!s || !el) return;
      const which = targetOf(s);
      if (stockSlotId !== s.id) { stockSlotId = s.id; stockQ = (s.terms && s.terms.length) ? s.terms.join(' ') : ''; stockResults = []; stockErr = ''; }
      const tabs = [['stock', 'Adobe Stock · ' + (s.candidates || []).length], ['library', 'SiTime library · ' + (S.library || []).length], ['existing', 'Current site · ' + (s.existing || []).length], ['generated', 'Generated · ' + (s.generated || []).length], ['upload', 'Upload']];

      el.innerHTML = '<div class="dhead"><div><div class="group-title" style="margin-bottom:6px">' + esc(s.page) + ' · ' + esc(s.name) + '</div><span class="mini">' + esc([s.section === '(unmapped)' ? '' : s.section, 'sitime.com' + s.url, s.priority, s.action].filter(Boolean).join(' · ')) + '</span></div>' +
        '<div class="tgtbar"><span class="lbl">Setting</span>' + tgtBtn(s, 'main') + tgtBtn(s, 'backup') +
        (s.state === 'unreviewed' ? '<button class="sbtn" data-keep="1">Keep the current image</button>' : '') +
        '<button class="sbtn" data-clear="1">Clear picks</button><button class="sbtn" data-close="1">Close</button></div></div>' +
        '<div class="meta"><div><b>The brief</b>' + esc(s.rec || '') + '<textarea class="q2 brief-edit" data-brief="1" rows="3" placeholder="What should this image show? Editing this changes what Generate sends.">' + esc(s.prompt || '') + '</textarea></div>' +
        '<div><b>Search terms</b>One per line. Seeds the Stock search below.<textarea class="q2 terms-edit" data-terms="1" rows="3" placeholder="silicon wafer macro">' + esc((s.terms || []).join('\n')) + '</textarea></div></div>' +
        '<div class="srctabs">' + tabs.map((t) => '<button class="sbtn ' + (srcTab === t[0] ? 'on' : '') + '" data-src="' + t[0] + '">' + t[1] + '</button>').join('') + '<span class="mini">Click an image to set the <b>' + which + '</b>.</span></div>' +
        sourceBody(s);

      el.querySelectorAll('[data-tgt]').forEach((b) => b.addEventListener('click', () => { pkWhich[s.id] = b.dataset.tgt; refreshDrawer(s.id); }));
      const kp = el.querySelector('[data-keep]'); if (kp) kp.addEventListener('click', () => { s.state = 'kept'; mark(); renderSlots(); renderStats(); });
      el.querySelector('[data-clear]').addEventListener('click', () => { s.main = null; s.backup = null; if (s.id.startsWith('EX-')) s.state = 'unreviewed'; pkWhich[s.id] = 'main'; mark(); renderSlots(); renderStats(); });
      el.querySelector('[data-close]').addEventListener('click', () => { openSlots.delete(s.id); renderSlots(); });
      el.querySelector('[data-brief]').addEventListener('change', (e) => { s.prompt = e.target.value; mark(); });
      el.querySelector('[data-terms]').addEventListener('change', (e) => { s.terms = e.target.value.split('\n').map((t) => t.trim()).filter(Boolean); _hay.delete(s.id); stockSlotId = null; mark(); refreshDrawer(s.id); });
      el.querySelectorAll('[data-src]').forEach((b) => b.addEventListener('click', () => { srcTab = b.dataset.src; libShown = 48; refreshDrawer(s.id); }));
      wireSource(s, el);
    }
    function targetOf(s) { return pkWhich[s.id] === 'backup' ? 'backup' : 'main'; }
    function tgtBtn(s, which) {
      const p = s[which];
      return '<button class="tgt ' + (targetOf(s) === which ? 'on' : '') + '" data-tgt="' + which + '">' + (p ? '<img src="' + esc(p.thumb || p.url) + '">' : '<span class="ph"></span>') + which[0].toUpperCase() + which.slice(1) + '</button>';
    }
    /* Re-render just the one open drawer, leaving the rest of the list alone. */
    function refreshDrawer(id) {
      const el = document.querySelector('[data-detail="' + id + '"]');
      if (el) renderDetail(byId().get(id), el);
    }
    /* Open a row's drawer aimed at a particular tile. */
    function openPicker(slotId, which) {
      const s = byId().get(slotId); if (!s) return;
      pkWhich[slotId] = which === 'backup' ? 'backup' : 'main';
      srcTab = defaultSrcTab(s); libShown = 48; revealTile = null; delete addStatus[slotId];
      openSlots.add(slotId);
      renderSlots();
      const el = document.querySelector('[data-detail="' + slotId + '"]');
      if (el) el.closest('.drawer-wrap').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function updateChecked() { $('checked-count').textContent = checked.size ? checked.size + ' checked' : ''; $('add-to-batch').disabled = !checked.size; $('checked-hint').textContent = checked.size ? checked.size + ' checked in Slots' : ''; }
    function visibleSlots() { const l = filtered(); return fx.page ? l : l.slice(pageIdx * PAGE, pageIdx * PAGE + PAGE); }
    $('check-all').addEventListener('change', (e) => { visibleSlots().forEach((s) => { if (s.batch) return; e.target.checked ? checked.add(s.id) : checked.delete(s.id); }); renderSlots(); });
    $('f-pri').addEventListener('change', (e) => { fx.pri = e.target.value; pageIdx = 0; renderSlots(); });
    $('f-status').addEventListener('change', (e) => { fx.status = e.target.value; pageIdx = 0; renderSlots(); });
    $('f-rec').addEventListener('change', (e) => { fx.rec = e.target.value; pageIdx = 0; renderSlots(); });
    $('f-hideai').addEventListener('change', (e) => { fx.hideAi = e.target.checked; renderSlots(); });
    $('f-hidereuse').addEventListener('change', (e) => { fx.hideReuse = e.target.checked; pageIdx = 0; renderSlots(); });
    $('pg-prev').addEventListener('click', () => { if (pageIdx > 0) { pageIdx--; renderSlots(); } });
    $('pg-next').addEventListener('click', () => { if ((pageIdx + 1) * PAGE < filtered().length) { pageIdx++; renderSlots(); } });
    $('search').addEventListener('input', (e) => { search = e.target.value; pageIdx = 0; renderSlots(); });
    $('rail-clear').addEventListener('click', () => { fx.page = ''; fx.section = ''; pageIdx = 0; openSlots.clear(); renderSlots(); });
    $('expand-all').addEventListener('click', () => {
      const vis = visibleSlots();
      const allOpen = vis.length && vis.every((s) => openSlots.has(s.id));
      vis.forEach((s) => allOpen ? openSlots.delete(s.id) : openSlots.add(s.id));
      renderSlots();
    });
    $('add-to-batch').addEventListener('click', () => {
      /* Any batch still waiting on decisions can take more slots. */
      const drafts = S.batches.filter((b) => { const c = batchCounts(b); return !(b.slotIds || []).length || c.p > 0; });
      if (!drafts.length) { openBatchDialog(null); return; }
      const choice = drafts.length === 1 ? drafts[0] : drafts.find((b) => String(b.num) === prompt('Which batch? ' + drafts.map((b) => b.num + ' = ' + b.name).join(', '), String(drafts[drafts.length - 1].num)));
      if (!choice) return; addCheckedTo(choice); mark(); renderSlots(); renderStats();
    });

    /* ---------- drawer: the source picker ---------- */
    /* ---------- adding Adobe finds without the API ----------
       Adobe blocks server-side fetches of a stock page (403 from any
       datacenter IP) and the comp filename carries a hash that cannot be
       derived from the asset ID, so a pasted PAGE link can give us the ID but
       never the picture. Everything here exists to get pixels and an ID out of
       whatever gesture the person actually made: a dragged image, a pasted
       image, a comp URL, or a list of page URLs. */
    const isCompUrl = (u) => /ftcdn\.net\/jpg\//i.test(u || '');
    const isStockPage = (u) => /stock\.adobe\.com/i.test(u || '');
    function idFromAny(u) {
      const t = String(u || '');
      let m = t.match(/\/\d+_F_(\d+)_/); if (m) return m[1];              // 1000_F_<id>_hash.jpg
      m = t.match(/[?&]asset_id=(\d{5,12})/i); if (m) return m[1];
      if (isStockPage(t)) { m = t.match(/(\d{6,12})(?:[/?#]|$)/); if (m) return m[1]; }
      if (/^\d{6,12}$/.test(t.trim())) return t.trim();
      return '';
    }
    /* Pull every usable thing out of a drop or a paste. */
    function harvestTransfer(dt) {
      const out = [];
      Array.from((dt && dt.files) || []).filter((f) => /^image\//.test(f.type)).forEach((f) => out.push({ file: f }));
      const html = (dt && dt.getData) ? dt.getData('text/html') : '';
      if (html) {
        try {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          doc.querySelectorAll('img').forEach((img) => {
            const src = img.getAttribute('src') || '';
            const a2 = img.closest('a'); const href = a2 ? a2.getAttribute('href') : '';
            if (!/^https?:/i.test(src)) return;
            out.push({ comp: src, id: idFromAny(src) || idFromAny(href), page: isStockPage(href) ? href : '' });
          });
        } catch (e) { /* not html we understand */ }
      }
      const text = (dt && dt.getData) ? (dt.getData('text/uri-list') || dt.getData('text/plain') || '') : '';
      text.split(/\s+/).filter(Boolean).forEach((t) => {
        if (isCompUrl(t)) out.push({ comp: t, id: idFromAny(t) });
        else if (isStockPage(t)) out.push({ page: t, id: idFromAny(t) });
        else if (/^\d{6,12}$/.test(t)) out.push({ id: t });
      });
      // one gesture often reports the same asset twice (html + uri-list)
      const seen = new Set();
      return out.filter((it) => { const k = it.file ? 'f:' + it.file.name + it.file.size : (it.comp || it.page || 'id:' + it.id); if (seen.has(k)) return false; seen.add(k); return true; });
    }
    async function addFinds(s, items, statusEl) {
      if (!items.length) { addStatus[s.id] = 'Nothing usable in that. Copy the image itself, or paste an Adobe link.'; refreshDrawer(s.id); return; }
      s.candidates = s.candidates || [];
      let added = 0, filled = 0, dupes = 0, failed = 0;
      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        if (statusEl) statusEl.textContent = 'Adding ' + (i + 1) + ' of ' + items.length + '…';
        try {
          let comp = it.comp || ''; const id = it.id || ''; const page = it.page || '';
          if (it.file) {
            // a dropped/pasted image is hosted by us -- a hotlink to whatever
            // the browser handed over is not something to rely on
            const web = await resize(it.file, 1400);
            const key = await sha1('comp/' + it.file.name + '/' + it.file.size + '/' + (it.file.lastModified || 0));
            comp = (await uploadBlob('sitime/comps/' + key + '.' + web.ext, web.blob)).url;
          }
          const dup = s.candidates.find((c) => (id && c.id === id) || (comp && c.comp === comp));
          if (dup) { if (comp && !dup.comp) { dup.comp = comp; delete dup.needsPreview; dup.why = 'Added by COGNAK'; filled++; } else dupes++; continue; }
          // a picture with no ID completes the oldest link-only card if there is one
          if (comp && !id) {
            const need = s.candidates.find((c) => !c.comp);
            if (need) { need.comp = comp; delete need.needsPreview; need.why = 'Added by COGNAK'; filled++; continue; }
          }
          const c = { id: id, title: '', comp: comp, url: page || (id ? 'https://stock.adobe.com/images/x/' + id : ''), why: comp ? 'Added by COGNAK' : 'Link added — drag the image in to preview it', ai: false, manual: true };
          if (!comp) c.needsPreview = true;
          s.candidates.unshift(c); added++;
        } catch (e) { failed++; console.error(e); }
      }
      mark();
      addStatus[s.id] = [added ? added + ' added' : '', filled ? filled + ' preview' + (filled === 1 ? '' : 's') + ' filled' : '', dupes ? dupes + ' already here' : '', failed ? failed + ' failed (see console)' : ''].filter(Boolean).join(' · ') || 'Nothing new.';
      renderSlots(); renderStats();
    }
    function pickFrom(source, obj) {
      if (source === 'stock') return { source, id: obj.id, url: obj.comp, thumb: obj.comp, title: obj.title || '', manual: !!obj.manual };
      if (source === 'library') return { source, id: obj.id, url: obj.url, thumb: obj.thumb, title: obj.name, path: obj.path };
      if (source === 'existing') return { source, id: null, url: obj.url, thumb: obj.url, title: obj.label || 'Current' };
      if (source === 'generated') return { source, id: obj.id, url: obj.url, thumb: obj.thumb || obj.url, title: 'Generated' };
      return obj;
    }
    /* The pick always lands on whichever tile the picker is currently aiming
       at (pkWhich). Filling an empty main moves the aim to backup and keeps
       the picker open, so both are chosen in two clicks; anything else closes
       it, because the job is done. */
    function assign(slot, pick) {
      const which = targetOf(slot);
      slot[which] = pick;
      if (slot.state === 'unreviewed' || slot.state === 'kept') slot.state = 'assigned';
      revealTile = null;
      // Filling an empty main moves the aim to backup, so two clicks fill both.
      if (which === 'main' && !slot.backup) pkWhich[slot.id] = 'backup';
      mark(); renderSlots(); renderStats();
    }
    function candCard(pick, slot, extra) {
      extra = extra || {};
      const cls = slot.main && slot.main.url === pick.url ? 'main' : slot.backup && slot.backup.url === pick.url ? 'backup' : '';
      const flags = [];
      if (pick.source === 'stock') flags.push(extra.ai ? '<span class="flag ai">Generative AI</span>' : '<span class="flag real">Real photo</span>');
      if (extra.editorial) flags.push('<span class="flag ed">Editorial only</span>');
      if (extra.dims) flags.push('<span class="flag">' + esc(extra.dims) + '</span>');
      return '<div class="cand ' + cls + (extra.ai ? ' warn' : '') + '" data-url="' + esc(pick.url) + '"><img loading="lazy" src="' + esc(pick.thumb || pick.url) + '">' +
        (cls ? '<span class="tag">' + cls.toUpperCase() + '</span>' : '') +
        (pick.source === 'stock' ? '<button type="button" class="cand-x" data-remove-cand="' + esc(pick.url) + '" title="Remove this" aria-label="Remove this">' + ICONS.delete + '</button>' : '') +
        '<div class="cb"><b>' + esc(extra.label || pick.id || '') + '</b>' + esc(extra.text || pick.title || '') + '</div>' +
        (flags.length ? '<div class="meta2">' + flags.join('') + '</div>' : '') +
        (extra.adobe ? '<a class="adobe" href="' + esc(extra.adobe) + '" target="_blank" rel="noopener" data-stop="1">Open on Adobe Stock ↗</a>' : '') +
        '</div>';
    }
    function removeCandidate(slot, key) {
      slot.candidates = (slot.candidates || []).filter((c) => (c.comp || c.id) !== key);
      const url = key;
      if (slot.main && slot.main.url === url) slot.main = null;
      if (slot.backup && slot.backup.url === url) slot.backup = null;
      mark(); renderSlots(); renderStats();
    }
    /* ---------- AI-generated candidates ---------- */
    const genBusy = {}; // slotId -> true while a generate call is in flight
    async function generateImages(slot, opts) {
      const idx = opts && typeof opts.index === 'number' ? opts.index : null;
      const count = idx === null ? 5 : 1;
      if (genBusy[slot.id]) return;
      if (!(slot.prompt || '').trim()) { alert('Write a brief first — that’s what gets sent to the image generator.'); return; }
      genBusy[slot.id] = true; refreshDrawer(slot.id);
      try {
        const r = await api('/api/sitime-generate', { method: 'POST', body: { slotId: slot.id, prompt: slot.prompt || '', count } });
        if (!r.ok || !r.data || !r.data.ok) { alert((r.data && r.data.error) || 'Generation failed (' + r.status + ').'); return; }
        const images = r.data.images || [];
        if (idx === null) {
          slot.generated = images.map((im) => ({ id: im.id, url: im.url, thumb: im.url, at: im.at }));
        } else {
          slot.generated = slot.generated || [];
          if (images[0]) slot.generated[idx] = { id: images[0].id, url: images[0].url, thumb: images[0].url, at: images[0].at };
        }
        mark(); renderSlots(); renderStats();
      } catch (e) {
        alert('Generation failed: ' + (e && e.message ? e.message : e));
      } finally {
        genBusy[slot.id] = false; refreshDrawer(slot.id);
      }
    }
    /* ---------- live Adobe Stock search ---------- */
    async function searchStock(slot, q) {
      stockQ = q; stockErr = '';
      const query = q.trim();
      if (!query) { stockResults = []; refreshDrawer(slot.id); return; }
      stockBusy = true; refreshDrawer(slot.id);
      try {
        const r = await api('/api/sitime-stock-search', { method: 'POST', body: { query } });
        if (!r.ok || !r.data || !r.data.ok) { stockErr = (r.data && r.data.error) || 'Search failed (' + r.status + ').'; stockResults = []; }
        else stockResults = r.data.results || [];
      } catch (e) { stockErr = 'Search failed: ' + (e && e.message ? e.message : e); stockResults = []; }
      stockBusy = false; refreshDrawer(slot.id);
    }

    /* ---------- the source panels, rendered into the row drawer ---------- */
