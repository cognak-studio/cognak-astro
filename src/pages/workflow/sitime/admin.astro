    /* A finished batch is the one thing worth catching the eye across a long
       list, so only THAT dot gets the sitewide availability-dot blip ring
       (.avail-dot in custom.css). Scoped to .batchrow on purpose -- the slot
       rows reuse .st, and eight pulsing chips at once is noise, not signal. */
    .adm .batchrow .st.approved i::after{ content:''; position:absolute; inset:-1px; border-radius:50%;
      border:1px solid #6EB300; opacity:0; animation:adm-dot-blip 2.5s ease-out infinite; }
    @keyframes adm-dot-blip{ 0%{ transform:scale(1); opacity:.8; } 100%{ transform:scale(2.8); opacity:0; } }
    @media (prefers-reduced-motion:reduce){ .adm .batchrow .st.approved i::after{ animation:none; } }
    .adm .st.unreviewed i{ background:#fff; border:1px solid #9A9A96; } .adm .st.kept i{ background:#AAFF00; border:1px solid #6EB300; opacity:.5; }
    .adm .mini{ font-family:'Diatype Mono', monospace; font-size:var(--fs-11); letter-spacing:.05em; color:var(--ink-soft); }
