       cleared from every slot's main/backup, dropped from the library, the
       state is saved, and only THEN are the stored files deleted, so a failed
       save never leaves a slot pointing at a missing image. */
    async function deleteUpload(libId) {
      const l = (S.library || []).find((x) => x.id === libId);
      if (!l) return;
      const uses = S.slots.filter((x) => (x.main && x.main.url === l.url) || (x.backup && x.backup.url === l.url));
      const locked = uses.filter((x) => batchOf(x));
      if (locked.length) {
        const b = batchOf(locked[0]);
        alert('Can’t delete: ' + locked[0].page + ' · ' + locked[0].name + ' uses this image and is in Batch ' + String(b.num).padStart(2, '0') + '. Take the slot out of the batch first.');
        return;
      }
      const msg = 'Delete ' + (l.name || 'this upload') + ' from the library?' + (l.tier !== 'upload' ? '\n\nThe file in Drive is not touched. Re-running the indexer would add it back.' : '') + (uses.length ? '\n\nIt will also be cleared from ' + uses.length + ' slot' + (uses.length === 1 ? '' : 's') + ': ' + uses.slice(0, 4).map((x) => x.page + ' · ' + x.name).join(', ') + (uses.length > 4 ? '…' : '') + '.' : '') + '\n\nIt stays in Library → Recently deleted for 30 days.';
