          '<span class="ab-status mini" data-abstatus="1">' + esc(addStatus[s.id] || '') + '</span></div></div>';
        const searchRow = !stockSearchOpen ? '' :
          '<div class="stocksearch"><input class="txt" type="text" data-stockq="1" placeholder="Search Adobe Stock\u2026" value="' + esc(stockQ) + '"><button type="button" class="sbtn p" data-stockgo="1" ' + (stockBusy ? 'disabled' : '') + '>' + (stockBusy ? 'Searching\u2026' : 'Search') + '</button></div>' +
          (stockErr ? '<p class="hint" style="color:#B00020">' + esc(stockErr) + '</p>' : '') +
          (stockResults.length ? '<div class="cands">' + searchCards + '</div><p class="mini" style="margin:2px 0 18px">Click a result to add it here and assign it.</p>' : '');
        return addbox + searchRow + '<div class="cands">' + cands.join('') + '</div>';
      }
      if (srcTab === 'library') {
        const groups = Array.from(new Set((S.library || []).map((l) => l.group))).sort();
        const q = libQuery.toLowerCase();
        const items = (S.library || []).filter((l) => (!libGroup || l.group === libGroup) && (!q || (l.name + ' ' + l.group).toLowerCase().includes(q)));
        return '<div class="srctabs"><input class="search" data-libq="1" placeholder="Search filenames" value="' + esc(libQuery) + '">' + ['', ...groups].map((g) => '<button class="sbtn ' + (libGroup === g ? 'on' : '') + '" data-g="' + esc(g) + '">' + (g || 'All') + '</button>').join('') + '</div>' +
          ((S.library || []).length ? '<div class="cands">' + items.slice(0, libShown).map((l) => candCard(pickFrom('library', l), s, { label: l.group, text: l.name })).join('') + (items.length > libShown ? '<button class="sbtn more" data-libmore="1">Show more (' + (items.length - libShown) + ')</button>' : '') + '</div>' : '<p class="hint">The library is not indexed yet. Library tab, choose the Image Mapping folder.</p>');
      }
      if (srcTab === 'existing') {
        const ex = (s.existing || []).map((e) => candCard(pickFrom('existing', e), s, { label: 'CURRENT', text: e.label }));
        return ex.length ? '<div class="cands">' + ex.join('') + '</div>' : '<p class="hint">No existing image on this page in the Drupal export.</p>';
      }
      if (srcTab === 'generated') {
        const busy = !!genBusy[s.id];
