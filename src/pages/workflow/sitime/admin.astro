    /* display:flex only while open -- on the closed dialog it would beat the UA's display:none. */
    .adm dialog.pv{ width:min(96vw,1280px); height:min(94vh,1000px); max-width:none; max-height:none; padding:14px 14px 0; background:#F4F4F2; }
    .adm dialog.pv[open]{ display:flex; flex-direction:column; }
