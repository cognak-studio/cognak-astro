        if (pick) assign(s, pick);
      }));
      const ps = el.querySelector('[data-paste]'); if (ps) ps.addEventListener('click', () => { const u = prompt('Adobe Stock comp URL (…ftcdn.net/jpg/…/1000_F_<id>_….jpg) or a Stock ID:'); if (!u) return; const m = u.match(/1000_F_(\d+)_/) || u.match(/^(\d{6,12})$/); const id = m ? m[1] : ''; const url = /^https?:/.test(u) ? u : ''; if (!url) { alert('Paste the comp image URL, not just the ID: the tool can’t fetch a comp from an ID alone.'); return; } s.candidates = s.candidates || []; if (!s.candidates.find((c) => c.comp === url)) s.candidates.unshift({ id, title: 'Pasted', comp: url, url: id ? 'https://stock.adobe.com/images/x/' + id : url, why: 'Added by COGNAK', ai: false, manual: true }); assign(s, pickFrom('stock', s.candidates[0])); });
      const lq = el.querySelector('[data-libq]'); if (lq) lq.addEventListener('input', (e) => { libQuery = e.target.value; libShown = 48; refreshDrawer(s.id); const nq = document.querySelector('[data-detail="' + s.id + '"] [data-libq]'); if (nq) { nq.focus(); nq.setSelectionRange(nq.value.length, nq.value.length); } });
