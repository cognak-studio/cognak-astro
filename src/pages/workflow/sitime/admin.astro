        const b = batchOf(s); const o = b ? outcomeIn(s, b) : null; const ev = o && o.ev;
        rows.push([s.pageId || '', s.page, s.section, s.url, s.id, s.name, (o && o.outcome) || 'approved', isoAt(ev), ev ? DECIDED_BY : '', p.source, assetId(p), refOf(p), p.url, (s.license && s.license.id) || '', b ? String(b.num).padStart(2, '0') : '']);
