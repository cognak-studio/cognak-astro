---
/**
 * /workflow/sitime/admin — COGNAK's side of the SiTime image tool.
 *
 * Four tabs plus the library indexer:
 *   Batches      the project at a glance, batch list, "waiting on you"
 *   Slots        every slot from Ace's inventory (and the migrated pages'
 *                existing heroes as reviewable rows); pick a main and a
 *                backup from Adobe Stock (Ace's candidates or a pasted comp),
 *                SiTime's licensed library, the current site, or an upload;
 *                check rows, add to a batch
 *   Replacements anything SiTime denied or held, with the note, so the
 *                resubmit cycle is its own queue
 *   Handoff      approved images with source, Stock ID and a license field;
 *                CSV export for whoever authors AEM
 *   Library      one-time indexer: pick the Image Mapping folder, the
 *                Digital-Web + MEMS files are resized in the browser and
 *                pushed to Blob
 *
 * Auth is the existing admin session (sign in on /send). State is one
 * versioned Blob document written only from here; reviewer decisions are
 * append-only events read back alongside it. See api/_lib/sitimeStore.mjs.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  page="workflow"
  title="SiTime images — COGNAK"
  description="Internal."
  ogUrl="https://cognak.com/workflow/sitime/admin"
  noindex={true}
  pageBg="#F4F4F2"
>
  <main id="cognak-main"><section class="adm">

    <h1 class="headline"><em>SiTime</em> images. Internal.</h1>
    <p class="lede" id="lede">Assign a main and a backup to each slot, group slots into a batch, send SiTime one link. Decisions come back here; anything denied lands in Replacements.</p>

    <div class="card rise" id="gate" hidden><div class="group"><div class="group-title">Sign in</div><p class="hint">This page uses the admin session from <a href="/send">/send</a>. Sign in there, then reload this page.</p></div></div>
    <div class="card rise" id="loading"><div class="group"><div class="group-title">Loading</div><p class="hint">Reading the state.</p></div></div>

    <div id="app" hidden>
      <div class="tabs" id="tabs">
        <a data-tab="batches" class="on">Batches<i id="n-batches">0</i></a>
        <a data-tab="slots">Slots<i id="n-slots">0</i></a>
        <a data-tab="replacements">Replacements<i id="n-repl">0</i></a>
        <a data-tab="handoff">Handoff<i id="n-handoff">0</i></a>
        <a data-tab="library">Library<i id="n-lib">0</i></a>
        <span class="savestate" id="savestate"></span>
      </div>

      <div class="stats" id="stats"></div>

      <!-- BATCHES -->
      <div class="card rise tab" id="tab-batches">
        <div class="group">
          <div class="card-head"><div class="group-title">Batches</div><div><span class="mini" id="checked-hint"></span><button class="sbtn p" id="new-batch">New batch</button></div></div>
          <div id="batch-list"></div>
        </div>
        <div class="group" id="waiting-group">
          <div class="group-title">Waiting on you</div>
          <div class="queue" id="waiting"></div>
        </div>
      </div>

      <!-- SLOTS -->
      <div class="card rise tab" id="tab-slots" hidden>
        <div class="group">
          <div class="card-head">
            <div class="filters" id="filters"></div>
            <div class="right"><input class="search" id="search" placeholder="Search page or slot" /><span class="mini" id="checked-count"></span><button class="sbtn p" id="add-to-batch" disabled>Add to batch</button></div>
          </div>
          <div class="tablewrap"><table id="slot-table"><thead><tr><th><input type="checkbox" id="check-all" /></th><th>Page · slot</th><th>Pri</th><th>Rec</th><th>Main</th><th>Backup</th><th>State</th><th>Batch</th></tr></thead><tbody id="slot-rows"></tbody></table></div>
          <p class="hint" id="slot-more"></p>
        </div>
        <div class="group drawer" id="drawer" hidden></div>
      </div>

      <!-- REPLACEMENTS -->
      <div class="card rise tab" id="tab-replacements" hidden>
        <div class="group"><div class="group-title">Denied and held</div><div id="repl-list"></div></div>
      </div>

      <!-- HANDOFF -->
      <div class="card rise tab" id="tab-handoff" hidden>
        <div class="group">
          <div class="card-head"><div class="group-title">Approved</div><div><button class="sbtn" id="export-handoff">Export CSV</button></div></div>
          <div class="tablewrap"><table><thead><tr><th>Page · slot</th><th>Image</th><th>Source</th><th>Reference</th><th>License / note</th><th>Batch</th></tr></thead><tbody id="handoff-rows"></tbody></table></div>
        </div>
      </div>

      <!-- LIBRARY -->
      <div class="card rise tab" id="tab-library" hidden>
        <div class="group">
          <div class="group-title">SiTime licensed library</div>
          <p class="hint" id="lib-status"></p>
          <p class="hint">Pick the <b>Image Mapping</b> folder from Drive. Only the Digital-Web folders and MEMS-Products are indexed (web-size copy plus a thumbnail per image); everything else stays where it is. Re-run any time SiTime adds files; already-indexed images are skipped.</p>
          <div class="actions"><label class="sbtn p" for="lib-dir">Choose folder</label><input type="file" id="lib-dir" webkitdirectory directory multiple hidden /><span class="mini" id="lib-progress"></span></div>
          <div class="hint" id="lib-log"></div>
        </div>
        <div class="group">
          <div class="group-title">Review link passcode</div>
          <div class="grid3"><label class="q"><span class="q-title">Passcode</span><input class="txt" id="review-pass" placeholder="silicon" /></label><p class="hint" style="grid-column:2/4;align-self:end">Asked once per browser session on every review link, on top of the link itself. Blank turns it off.</p></div>
        </div>
        <div class="group">
          <div class="group-title">Mock copy</div>
          <div class="grid3">
            <label class="q"><span class="q-title">Headline</span><input class="txt" id="mock-h1" /></label>
            <label class="q"><span class="q-title">Subhead</span><input class="txt" id="mock-p" /></label>
            <label class="q"><span class="q-title">Button</span><input class="txt" id="mock-cta" /></label>
          </div>
        </div>
      </div>
    </div>

    <!-- batch modal -->
    <dialog id="batch-dialog">
      <div class="group-title" id="bd-title">New batch</div>
      <label class="q"><span class="q-title">Name</span><input class="txt" id="bd-name" placeholder="Homepage + Applications" /></label>
      <label class="q"><span class="q-title">Planned for</span><input class="txt" id="bd-date" type="date" /></label>
      <p class="hint" id="bd-hint"></p>
      <div class="actions"><button class="sbtn p" id="bd-save">Save</button><button class="sbtn" id="bd-cancel">Cancel</button></div>
    </dialog>

  </section></main>

  <style is:inline>
    html, body { background-color:#F4F4F2 !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }
    .adm label, .adm legend { display:block !important; }
    .adm{ --card:#FFFFFF; --field:#FAFAF9; --ink:#1A1A1A; --ink-soft:#6B6B6B; --accent:#B47CFF; --head:#4A3F6B; --deep:#1B1424; --line:#E6E6E3; --line-strong:#CFCFCB;
      max-width:1240px; margin:0 auto; padding:190px 4vw 18vh; color:var(--ink); font-family:'Diatype Variable', sans-serif; }
    .adm .headline{ font-size:clamp(24px,5.5vw,58px); font-weight:500; line-height:1.1; letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .adm .headline em{ font-style:normal; font-weight:500; color:var(--head); }
    .adm .lede{ font-size:1.05rem; line-height:1.65; color:var(--ink-soft); max-width:52ch; margin:0 0 2.4rem 40px; }
    .adm .card{ background:var(--card); border-radius:12px; padding:34px 34px 30px; box-shadow:0 1px 2px rgba(0,0,0,.04),0 12px 40px rgba(0,0,0,.07); border:1px solid #ECECE9; }
    .adm .group{ border-top:1px solid var(--line); padding-top:2.2rem; margin-top:2.6rem; }
    .adm .group:first-child{ border-top:none; padding-top:0; margin-top:0; }
    .adm .group-title{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.6rem; }
    .adm .hint{ font-size:.9rem; color:var(--ink-soft); line-height:1.5; margin:0 0 .8rem; }
    .adm .hint a{ color:var(--head); }
    .adm .q{ display:block; margin-bottom:1rem; }
    .adm .q-title{ display:block; font-size:.95rem; font-weight:500; margin-bottom:6px; }
    .adm .txt{ width:100%; font:inherit; font-size:.95rem; color:var(--ink); background:var(--field); border:1px solid var(--line-strong); border-radius:8px; padding:10px 12px; outline:none; }
    .adm .txt:focus{ border-color:var(--accent); }
    .adm .grid3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:18px; }
    .adm .tabs{ display:flex; gap:6px; margin:0 0 1.6rem 40px; align-items:center; flex-wrap:wrap; }
    .adm .tabs a{ font-size:.92rem; padding:9px 16px; border-radius:999px; border:1px solid var(--line-strong); color:var(--ink); text-decoration:none; cursor:pointer; user-select:none; }
    .adm .tabs a.on{ background:#1A1A1A; color:#fff; border-color:#1A1A1A; }
    .adm .tabs a i{ font-style:normal; color:inherit; opacity:.6; margin-left:6px; font-family:'Diatype Mono', monospace; font-size:.75rem; }
    .adm .savestate{ margin-left:auto; font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-soft); }
    .adm .stats{ display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:2rem; }
    .adm .stat{ background:#fff; border:1px solid #ECECE9; border-radius:10px; padding:16px 18px; }
    .adm .stat b{ display:block; font-size:1.9rem; font-weight:500; letter-spacing:-.02em; line-height:1; }
    .adm .stat span{ display:block; font-size:.8rem; color:var(--ink-soft); margin-top:8px; }
    .adm .stat.warn b{ color:#D94A00; }
    .adm .card-head{ display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:1.4rem; flex-wrap:wrap; }
    .adm .card-head .right{ display:flex; align-items:center; gap:12px; }
    .adm .search{ font:inherit; font-size:.9rem; padding:8px 12px; border:1px solid var(--line-strong); border-radius:999px; background:#fff; width:220px; outline:none; }
    .adm .filters{ display:flex; gap:8px; flex-wrap:wrap; }
    .adm .sbtn{ font:inherit; font-size:.85rem; font-weight:500; padding:8px 14px; border-radius:999px; border:1px solid var(--line-strong); background:#fff; color:var(--ink); cursor:pointer; white-space:nowrap; }
    .adm .sbtn.on{ background:#1A1A1A; color:#fff; border-color:#1A1A1A; }
    .adm .sbtn.p{ background:var(--accent); border-color:var(--accent); color:var(--deep); }
    .adm .sbtn:disabled{ opacity:.4; cursor:not-allowed; }
    .adm .sbtn.danger{ color:#B00020; border-color:#F0B6BE; }
    .adm .tablewrap{ overflow-x:auto; }
    .adm table{ width:100%; border-collapse:collapse; font-size:.92rem; }
    .adm th{ font-family:'Diatype Mono', monospace; font-size:.68rem; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft); text-align:left; padding:0 10px 12px; font-weight:400; border-bottom:1px solid var(--line); white-space:nowrap; }
    .adm td{ padding:12px 10px; border-bottom:1px solid var(--line); vertical-align:middle; }
    .adm tr.sel td{ background:#FAF7FF; }
    .adm tr.clickable{ cursor:pointer; }
    .adm .pg{ font-weight:500; }
    .adm .sub{ font-size:.8rem; color:var(--ink-soft); }
    .adm .pri{ font-family:'Diatype Mono', monospace; font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; }
    .adm .thumb{ width:64px; height:40px; object-fit:cover; border-radius:4px; background:#EEE; border:1px solid #E1E1DE; display:block; }
    .adm .thumb.empty{ background:repeating-linear-gradient(45deg,#F2F2EF,#F2F2EF 4px,#E8E8E4 4px,#E8E8E4 8px); }
    .adm .st{ display:inline-flex; align-items:center; gap:7px; font-size:.85rem; white-space:nowrap; }
    .adm .st i{ width:8px; height:8px; border-radius:50%; display:inline-block; background:#C9C9C4; }
    .adm .st.assigned i{ background:#1A1A1A; } .adm .st.queued i{ background:#B47CFF; } .adm .st.sent i{ background:#B47CFF; box-shadow:0 0 0 2px #EAD9FF; }
    .adm .st.approved i{ background:#9DFF00; border:1px solid #6EB300; } .adm .st.denied i{ background:#FF1E1E; } .adm .st.held i{ background:#FF7A00; }
    .adm .st.unreviewed i{ background:#fff; border:1px solid #9A9A96; } .adm .st.kept i{ background:#9DFF00; border:1px solid #6EB300; opacity:.5; }
    .adm .mini{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.05em; color:var(--ink-soft); }
    .adm .mini b{ font-weight:400; color:var(--ink); margin-right:10px; }
    .adm .mini .a{ color:#5A9E00; } .adm .mini .d{ color:#E5231B; } .adm .mini .h{ color:#E07000; }
    .adm .link{ font:inherit; background:none; border:0; padding:0; color:var(--head); text-decoration:underline; text-underline-offset:3px; font-size:.85rem; margin-right:12px; cursor:pointer; }
    .adm .queue{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .adm .qitem{ display:flex; gap:12px; align-items:flex-start; border:1px solid #ECECE9; border-radius:8px; padding:12px; }
    .adm .qitem img{ width:72px; height:48px; object-fit:cover; border-radius:4px; background:#EEE; }
    .adm .qitem .t{ font-size:.9rem; font-weight:500; }
    .adm .qitem .n{ font-size:.82rem; color:var(--ink-soft); margin-top:3px; line-height:1.4; }
    /* drawer */
    .adm .drawer .dhead{ display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap; }
    .adm .drawer .meta{ display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:24px; font-size:.88rem; line-height:1.5; color:var(--ink-soft); margin:1rem 0 1.4rem; }
    .adm .drawer .meta b{ color:var(--ink); font-weight:500; display:block; margin-bottom:4px; }
    .adm .drawer .meta .q2{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.04em; color:#4A3F6B; line-height:1.5; }
    .adm .picks{ display:flex; gap:14px; margin:0 0 1.4rem; }
    .adm .pick{ border:1px solid #E6E6E3; border-radius:8px; padding:10px; width:220px; }
    .adm .pick img{ width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:4px; background:#EEE; display:block; }
    .adm .pick .pl{ font-family:'Diatype Mono', monospace; font-size:.66rem; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:6px; display:flex; justify-content:space-between; }
    .adm .pick .pt{ font-size:.78rem; color:var(--ink-soft); margin-top:6px; line-height:1.3; word-break:break-word; }
    .adm .srctabs{ display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap; align-items:center; }
    .adm .cands{ display:grid; grid-template-columns:repeat(6,1fr); gap:12px; }
    .adm .cand{ border:1px solid #E6E6E3; border-radius:8px; overflow:hidden; background:#fff; position:relative; cursor:pointer; }
    .adm .cand img{ width:100%; aspect-ratio:4/3; object-fit:cover; display:block; background:#EEE; }
    .adm .cand .cb{ padding:8px 10px; font-size:.74rem; line-height:1.35; color:var(--ink-soft); display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
    .adm .cand .cb b{ display:block; color:var(--ink); font-weight:500; font-family:'Diatype Mono', monospace; font-size:.66rem; letter-spacing:.06em; margin-bottom:3px; }
    .adm .cand .tag{ position:absolute; top:8px; left:8px; font-family:'Diatype Mono', monospace; font-size:.62rem; letter-spacing:.12em; padding:4px 8px; border-radius:999px; background:#1A1A1A; color:#fff; }
    .adm .cand.main{ outline:2px solid #1A1A1A; } .adm .cand.backup{ outline:2px dashed #1A1A1A; } .adm .cand.backup .tag{ background:#fff; color:#1A1A1A; border:1px solid #1A1A1A; }
    .adm .cand.warn::after{ content:'AI'; position:absolute; top:8px; right:8px; font-family:'Diatype Mono', monospace; font-size:.62rem; padding:3px 6px; border-radius:4px; background:#FFF3CD; color:#8A5A00; }
    .adm .cands .more{ grid-column:1/-1; }
    .adm .up{ border:1px dashed var(--line-strong); border-radius:8px; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:.8rem; color:var(--ink-soft); aspect-ratio:4/3; text-align:center; padding:10px; cursor:pointer; gap:6px; }
    .adm .batchrow{ display:grid; grid-template-columns:1.4fr 1.2fr 60px 110px 1.2fr 1fr 1.6fr; gap:12px; align-items:center; padding:14px 0; border-bottom:1px solid var(--line); font-size:.92rem; }
    .adm .acts{ display:flex; gap:6px; justify-content:flex-end; }
    .adm .ibtn{ width:32px; height:32px; border-radius:999px; border:1px solid var(--line-strong); background:#fff; color:var(--ink); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; padding:0; transition:background var(--dur-s) var(--ease-standard), border-color var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard); }
    .adm .ibtn svg{ width:15px; height:15px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    .adm .ibtn:hover{ background:var(--accent); border-color:var(--accent); color:var(--deep); }
    .adm .ibtn[data-act=delete]:hover{ background:#FF1E1E; border-color:#FF7070; color:#fff; }
    .adm .ibtn.done{ background:#9DFF00; border-color:#D9FF66; color:#152400; }
    .adm .batchrow.head{ font-family:'Diatype Mono', monospace; font-size:.68rem; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft); padding:0 0 12px; }
    .adm .bslots{ display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:10px; margin:10px 0 18px; }
    .adm .bslot{ border:1px solid #ECECE9; border-radius:6px; padding:6px; font-size:.75rem; color:var(--ink-soft); }
    .adm .bslot img{ width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:3px; background:#EEE; display:block; margin-bottom:5px; }
    .adm .bslot b{ display:block; color:var(--ink); font-weight:500; font-size:.78rem; }
    .adm dialog{ border:1px solid #ECECE9; border-radius:12px; padding:26px; width:min(92vw,480px); font-family:'Diatype Variable', sans-serif; color:var(--ink); }
    .adm dialog::backdrop{ background:rgba(26,26,26,.35); }
    .adm dialog:focus{ outline:none; }
    /* The site's custom cursor (#cognak-cursor) is a fixed element on the
       page layer; a <dialog> renders in the browser's top layer above it, so
       the dot disappears behind the modal. While a dialog is open, hide the
       custom dot and let the native cursor show. */
    html:has(dialog[open]) #cognak-cursor{ display:none !important; }
    html:has(dialog[open]), html:has(dialog[open]) *{ cursor:auto !important; }
    html:has(dialog[open]) button, html:has(dialog[open]) .sbtn, html:has(dialog[open]) .link{ cursor:pointer !important; }
    .adm .actions{ display:flex; gap:12px; align-items:center; flex-wrap:wrap; }
    @media (max-width:900px){ .adm .stats{ grid-template-columns:repeat(2,1fr); } .adm .cands{ grid-template-columns:repeat(3,1fr); } .adm .grid3{ grid-template-columns:1fr; } .adm .drawer .meta{ grid-template-columns:1fr; } .adm .queue{ grid-template-columns:1fr; } .adm .lede{ margin-left:0; } .adm .tabs{ margin-left:0; } .adm .batchrow{ grid-template-columns:1fr 1fr; } }
  </style>

  <script is:inline>
  (function () {
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const fmtDate = (iso) => iso ? new Date(iso + (iso.length === 10 ? 'T12:00:00' : '')).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) : '';

    async function api(path, opts) {
      const res = await fetch(path, { method: (opts && opts.method) || 'GET', headers: { 'Content-Type': 'application/json' }, body: opts && opts.body ? JSON.stringify(opts.body) : undefined, credentials: 'same-origin' });
      let json = null; try { json = await res.json(); } catch (e) {}
      return { ok: res.ok, status: res.status, data: json };
    }
    function randomToken(len = 10) { const a = 'abcdefghjkmnpqrstuvwxyz23456789'; const b = crypto.getRandomValues(new Uint8Array(len)); return Array.from(b, (x) => a[x % a.length]).join(''); }

    let S = null;          // state document
    let D = {};            // decisions by batch token → { latest: {slotId: {main, backup}} }
    let checked = new Set();
    let openSlot = null;
    let srcTab = 'stock';
    let libQuery = '', libGroup = '', libShown = 48;
    const filters = { pri: new Set(), sec: new Set(), st: new Set() };
    let search = '';
    let slotsShown = 80;

    /* ---------- save (debounced, whole document) ---------- */
    let saveTimer = null, saving = false, dirty = false;
    function mark() { dirty = true; $('savestate').textContent = 'Unsaved'; clearTimeout(saveTimer); saveTimer = setTimeout(save, 1200); }
    async function save() {
      if (saving) { dirty = true; return; }
      saving = true; dirty = false; $('savestate').textContent = 'Saving…';
      const r = await api('/api/sitime-state', { method: 'POST', body: { state: S } });
      saving = false;
      $('savestate').textContent = r.ok ? 'Saved' : 'Save failed';
      if (dirty) save();
    }

    /* ---------- derived ---------- */
    const byId = () => new Map(S.slots.map((s) => [s.id, s]));
    function batchOf(slot) { return slot.batch ? S.batches.find((b) => b.token === slot.batch) : null; }
    function outcomeIn(slot, batch) {
      const d = batch && D[batch.token] && D[batch.token].latest && D[batch.token].latest[slot.id];
      const m = d && d.main, b = d && d.backup;
      if (!m) return { outcome: 'pending', which: null };
      if (m.decision === 'approve') return { outcome: 'approved', which: 'main', ev: m };
      if (m.decision === 'hold') return { outcome: 'held', which: 'main', ev: m };
      if (!slot.backup) return { outcome: 'denied', which: 'main', ev: m };
      if (!b) return { outcome: 'pending', which: 'backup', ev: m };
      if (b.decision === 'approve') return { outcome: 'approved', which: 'backup', ev: b };
      if (b.decision === 'hold') return { outcome: 'held', which: 'backup', ev: b };
      return { outcome: 'denied', which: 'backup', ev: b };
    }
    function status(slot) {
      const b = batchOf(slot);
      if (b) {
        if (b.status === 'draft') return 'queued';
        const o = outcomeIn(slot, b).outcome;
        return o === 'pending' ? 'sent' : o;
      }
