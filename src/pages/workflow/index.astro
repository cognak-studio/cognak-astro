---
/**
 * /workflow — the front door to COGNAK's client-facing tools. Linked from
 * the footer as "Workflows" (Pierce, 9/27); still noindex and not in the
 * sitemap. Typing "workflow" anywhere on the site also lands here
 * (public/js/cognak-global.js, same mechanism as "send").
 * One card per client tool; SiTime's image review is the first.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const TOOLS = [
  {
    key: 'sitime',
    client: 'SiTime',
    /* Public page since 9/27 (footer link): the card says what the tool is, not what the project is. */
    title: 'Image review',
    desc: 'Choose and approve the images for a new website, slot by slot, with every decision kept in one place.',
    href: '/workflow/sitime/admin',
    tag: 'Internal',
  },
];
---
<BaseLayout
  page="workflow"
  title="Workflows — COGNAK"
  description="Custom workflows for clients. Small, purpose-built pages for clients that need bespoke solutions."
  ogUrl="https://cognak.com/workflow/"
  noindex={true}
  pageBg="#F7F6FA"
>
  <main id="cognak-main"><section class="wf">
    <h1 class="headline">Custom <em>workflows</em> for clients.</h1>
    <p class="lede">Small, purpose-built pages for clients that need bespoke solutions.</p>
    <div class="picker rise">
      {TOOLS.map((t, i) => (
        <a class="pcard" href={t.href}>
          <span class="idx">0{i + 1}</span>
          <span class="ptag">{t.client} · {t.tag}</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </a>
      ))}
    </div>
  </section></main>

  <style is:inline>
    html, body { background-color:#F7F6FA !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }
    /* /workflow is the front door to the tools that live under it, not a
       peer of /projects or /schedule -- so it takes ITS interior pages'
       palette (admin.astro / review.astro's --head / --accent), matching
       what's one click away. Pale purple since 9/27 (Pierce, option A:
       ground #F7F6FA, buttons #C7BDDF, headline #6A5C8A); the sitewide
       vivid purple stays out of the tool. */
    /* Focus ring follows this page's accent, not the sitewide brand purple. */
    .wf a:focus-visible, .wf button:focus-visible, .wf [tabindex]:focus-visible{ outline-color:var(--head) !important; }
    .wf{ --ink:#1A1A1A; --ink-soft:#6B6B6B; --head:#6A5C8A; --accent:#C7BDDF; --accent-rgb:199,189,223;
      max-width:1040px; margin:0 auto; padding:190px 6vw 22vh; color:var(--ink); font-family:'Diatype Variable', sans-serif; }
    .wf .headline{ font-size:clamp(24px,5.5vw,58px); font-weight:500; line-height:1.1; letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .wf .headline em{ font-style:normal; font-weight:500; color:var(--head); }
    .wf .lede{ font-size:var(--fs-17); text-wrap:pretty; line-height:1.65; color:var(--ink-soft); max-width:52ch; margin:0 0 3.4rem 40px; }
    .wf .picker{ display:grid; grid-template-columns:1fr; gap:14px; }
    .wf .pcard{ position:relative; display:block; text-decoration:none; color:var(--ink); background:#fff; border:1px solid #E8E5EF; border-radius:12px; padding:24px 24px 22px;
      box-shadow:0 1px 2px rgba(0,0,0,.04),0 12px 40px rgba(0,0,0,.07); transition:background var(--dur-sm) var(--ease-standard), box-shadow var(--dur-sm) var(--ease-standard); }
    /* Hover is just a drop shadow, nothing else -- no background tint. Same
       offsetY + |spread| >= blur rule (20+12 >= 30) keeps it grounded under
       the card instead of haloing around it. */
    .wf .pcard:hover{ box-shadow:0 1px 2px rgba(0,0,0,.04),0 20px 30px -12px rgba(var(--accent-rgb),.38); }
    /* Like /brief (Pierce, 9/27): hover turns every word in the card the tool's purple, and the arrow slides. */
    .wf .pcard:hover .idx, .wf .pcard:hover .ptag, .wf .pcard:hover h3, .wf .pcard:hover p, .wf .pcard:hover .arrow{ color:var(--head); }
    .wf .pcard:active{ transform:scale(.995); }
    /* Index and tag share one line box (line-height 1, same size) so their tops align at the card's 24px padding. */
    .wf .pcard .idx{ display:block; line-height:1; font-family:'Diatype Mono', monospace; font-size:var(--fs-10); color:var(--ink-soft); letter-spacing:.14em; transition:color var(--dur-s) var(--ease-standard); }
    .wf .pcard .ptag{ position:absolute; top:24px; right:24px; line-height:1; font-family:'Diatype Mono', monospace; font-size:var(--fs-10); letter-spacing:.14em; text-transform:uppercase; color:rgba(106,92,138,.62); transition:color var(--dur-s) var(--ease-standard); }
    .wf .pcard h3{ font-size:1.5rem; font-weight:500; letter-spacing:-.01em; margin:.9rem 0 .35rem; color:var(--ink); transition:color var(--dur-s) var(--ease-standard); }
    .wf .pcard p{ font-size:var(--fs-14); line-height:1.45; color:var(--ink-soft); margin:0; max-width:60ch; transition:color var(--dur-s) var(--ease-standard); }
    .wf .pcard .arrow{ position:absolute; bottom:20px; right:24px; color:var(--ink-soft); transition:transform var(--dur-sm) var(--ease-standard), color var(--dur-sm) var(--ease-standard); }
    .wf .pcard:hover .arrow{ transform:translateX(4px); }
    @media (max-width:760px){ .wf{ padding:150px 5vw 12vh; } .wf .lede{ margin-left:0; } }
  </style>
</BaseLayout>
