            cx = right + 44;
          }
        } else {
          cx = vw * 0.5 - size / 2;
        }
        return { x: cx, y: cy - size / 2, s: size };
      }

      function lerpInto(a, b, k) {
        var i;
        for (i = 0; i < a.length; i++) {
          a[i][0] += (b[i][0] - a[i][0]) * k;
          a[i][1] += (b[i][1] - a[i][1]) * k;
        }
      }

      function matchLen(arr, n, seed) {
        while (arr.length < n) { arr.push([seed[0], seed[1]]); }
        while (arr.length > n) { arr.pop(); }
      }

      /* Read the wear variables rather than hardcoding the colophon's own
         ink and green, so the anatomy layer repaints with everything else.
         Cached per frame - getComputedStyle in a rAF loop is not free. */
      function inkRGB() {
        var cs = getComputedStyle(document.documentElement);
        return {
          ink: cs.getPropertyValue('--wear-ink').trim() || '#f4f4ee',
          accent: cs.getPropertyValue('--wear-accent').trim() || '#b6ff2e'
        };
      }
      function withAlpha(col, a) {
        if (col.charAt(0) === '#') {
          var r = parseInt(col.substr(1, 2), 16),
              g = parseInt(col.substr(3, 2), 16),
              bl = parseInt(col.substr(5, 2), 16);
          return 'rgba(' + r + ',' + g + ',' + bl + ',' + a + ')';
        }
        return col.replace(/^rgb\(/, 'rgba(').replace(/\)$/, ',' + a + ')');
      }

      function draw() {
        var b = box();
        var C = inkRGB();
        function X(u) { return b.x + u * b.s; }
        function Y(v) { return b.y + (1 - v) * b.s; }

        ctx.clearRect(0, 0, vw, vh);

        /* contour */
        ctx.beginPath();
        ctx.moveTo(X(cur.pts[0][0]), Y(cur.pts[0][1]));
        for (var i = 1; i < cur.pts.length; i++) { ctx.lineTo(X(cur.pts[i][0]), Y(cur.pts[i][1])); }
        ctx.strokeStyle = withAlpha(C.ink, 0.16 + 0.10 * fade);
        ctx.lineWidth = 1;
        ctx.stroke();

        /* handles, in the green the glyph plate uses for the same job */
        ctx.lineWidth = 1;
        cur.handles.forEach(function (h) {
          ctx.beginPath();
          ctx.moveTo(X(h[0][0]), Y(h[0][1]));
          ctx.lineTo(X(h[1][0]), Y(h[1][1]));
          ctx.strokeStyle = withAlpha(C.accent, 0.10 + 0.12 * fade);
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(X(h[1][0]), Y(h[1][1]), 2.5, 0, Math.PI * 2);
          ctx.fillStyle = withAlpha(C.accent, 0.14 + 0.16 * fade);
          ctx.fill();
        });

        /* anchors */
        ctx.fillStyle = withAlpha(C.ink, 0.20 + 0.18 * fade);
        cur.nodes.forEach(function (n) {
          ctx.fillRect(X(n[0]) - 3, Y(n[1]) - 3, 6, 6);
        });

        /* the ladder's hovered or worn page, ringed on the wheel */
        if (target === wheelState && window.__cmHot) {
          var hi = wheelState.keys.indexOf(window.__cmHot);
          if (hi > -1 && cur.nodes[hi]) {
            ctx.beginPath();
            ctx.arc(X(cur.nodes[hi][0]), Y(cur.nodes[hi][1]), 9, 0, Math.PI * 2);
            ctx.strokeStyle = withAlpha(C.accent, 0.9);
            ctx.lineWidth = 1.5;
            ctx.stroke();
          }
        }
      }

      function positionPlate(label) {
        if (!plate || vw < 900) { return; }
        var b = box();
        plate.style.left = Math.round(b.x) + 'px';
        plate.style.top = Math.round(b.y + b.s + 18) + 'px';
        if (plate.dataset.label !== label) {
          plate.dataset.label = label;
          plate.innerHTML = label;
        }
      }

      var raf = 0;
      function frame() {
        var pick = pickTarget();
        var st = pick.st;
        if (st !== target) { target = st; }
        var k = reduce ? 1 : 0.09;

        matchLen(cur.nodes, target.nodes.length, cur.nodes[cur.nodes.length - 1] || [0.5, 0.5]);
        while (cur.handles.length < target.handles.length) {
          cur.handles.push([[0.5, 0.5], [0.5, 0.5]]);
        }
        while (cur.handles.length > target.handles.length) { cur.handles.pop(); }

        lerpInto(cur.pts, target.pts, k);
        lerpInto(cur.nodes, target.nodes, k);
        for (var h = 0; h < cur.handles.length; h++) {
          lerpInto(cur.handles[h], target.handles[h], k);
        }
        fade += (pick.vis - fade) * (reduce ? 1 : 0.08);

        draw();
        positionPlate(
          '<span class="p-line p-name">' + target.name + '</span>' +
          '<span class="p-line">' + target.sub + '</span>'
        );
        if (plate) { plate.style.opacity = String(fade * 0.9); }
        raf = requestAnimationFrame(frame);
      }

      function boot() {
        cancelAnimationFrame(raf);
        resize();
        raf = requestAnimationFrame(frame);
      }

      window.addEventListener('resize', resize);
      window.addEventListener('pageshow', boot);
      boot();
    })();
  </script>
  <script is:inline>
    /* Ladder as control. Clicking a ground sets body[data-page] and paints
       the ground; the site's own per-page rules resolve the rest. Nothing
       runs on its own. Click the worn one again, or press Escape, to return
       to the colophon's own blue. */
    (function () {
      var nodes = Array.prototype.slice.call(document.querySelectorAll('.cm-l-node'));
      if (!nodes.length) { return; }
      var root = document.documentElement, body = document.body;
      var meta = document.getElementById('cm-l-meta');
      var restMeta = meta ? meta.textContent : '';
      var worn = null;

      function rgb(h) { return [1, 3, 5].map(function (i) { return parseInt(h.substr(i, 2), 16); }); }
      function lum(h) {
        var v = rgb(h).map(function (c) {
          c = c / 255;
          return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
        });
        return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
      }
      function mix(h, t, a) {
        var x = rgb(h), y = rgb(t);
        return 'rgb(' + x.map(function (c, i) { return Math.round(c + (y[i] - c) * a); }).join(',') + ')';
      }
      /* ::selection's accent is chosen against its own ground; lift it only
         if it fails there, which none currently do - this is a guard. */
      function contrast(a, b) {
        var la = lum(a), lb = lum(b);
        return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
      }

      function paint(g, ink, accent, key) {
        var dark = lum(g) < 0.35;
        root.style.setProperty('--wear-bg', g);
        root.style.setProperty('--wear-ink', ink);
        root.style.setProperty('--wear-accent', contrast(accent, g) >= 3 ? accent : ink);
        root.style.setProperty('--wear-dim', mix(ink, g, 0.42));
        /* Light pages don't darken their ground for the nav - they use the
           site's default frosted bar (Projects, Project Detail, Privacy all
           do), with the page's ink on it. Dark pages pull the ground down. */
        root.style.setProperty('--wear-nav', dark ? mix(g, '#000000', 0.28) : 'rgba(247, 241, 255, 0.75)');
        root.style.setProperty('--wear-nav-ink', dark ? '#ffffff' : ink);
        root.style.setProperty('--sb-thumb', dark ? 'rgba(255,255,255,0.15)' : 'rgba(23,21,26,0.15)');
        root.style.colorScheme = dark ? 'dark' : 'light';
        body.setAttribute('data-page', key);
      }

      function setUrl(key) {
        try {
          var u = new URL(location.href);
          if (key) { u.searchParams.set('wear', key); } else { u.searchParams.delete('wear'); }
          history.replaceState(null, '', u.toString());
        } catch (e) {}
      }

      function clearVars() {
        ['--wear-bg', '--wear-ink', '--wear-accent', '--wear-dim', '--wear-nav', '--wear-nav-ink', '--sb-thumb']
          .forEach(function (v) { root.style.removeProperty(v); });
        root.style.colorScheme = '';
        body.setAttribute('data-page', 'colophon');
      }

      function mark(n) {
        var key = n ? n.getAttribute('data-key') : null;
        nodes.forEach(function (o) {
          var on = key !== null && o.getAttribute('data-key') === key;
          o.classList.toggle('is-on', on);
          o.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }

      function nodeFor(key) {
        return nodes.filter(function (o) { return o.getAttribute('data-key') === key; })[0] || null;
      }

      /* show() paints a node without committing to it - used by hover.
         Passing null shows the committed state again. */
      function show(n, previewing) {
        window.__cmHot = n ? n.getAttribute('data-key') : null;
        if (!n || n.getAttribute('data-key') === 'colophon') {
          clearVars();
          mark(null);
          if (meta) { meta.textContent = restMeta; }
          return;
        }
        paint(n.getAttribute('data-ground'), n.getAttribute('data-ink'), n.getAttribute('data-accent'), n.getAttribute('data-key'));
        mark(n);
        if (meta) {
          meta.textContent = (previewing ? 'Previewing ' : 'Wearing ') + n.getAttribute('data-name') + ' · ' +
            n.getAttribute('data-ground').toUpperCase() + ' · ink ' + n.getAttribute('data-cr') + ':1' +
            (previewing ? '. Click to keep it.' : '. Click it again, or press Escape, to come back.');
        }
      }

      function rest() {
        worn = null;
        show(null);
        setUrl(null);
      }

      function wear(n) {
        var key = n.getAttribute('data-key');
        if (worn === key || key === 'colophon') { rest(); return; }
        worn = key;
        show(n, false);
        setUrl(key);
      }

      /* Hover previews; leaving the drawing returns to whatever was clicked.
         Listening on the svg rather than each node means sweeping across the
         ramp moves smoothly from page to page instead of flashing home in
         the gaps between circles. */
      var svgEl = document.getElementById('cm-ladder');
      var canHover = window.matchMedia('(hover: hover)').matches;
      if (svgEl && canHover) {
        nodes.forEach(function (n) {
          n.addEventListener('mouseenter', function () { show(n, n.getAttribute('data-key') !== worn); });
        });
        svgEl.addEventListener('mouseleave', function () { show(nodeFor(worn), false); });
      }

      nodes.forEach(function (n) {
        n.addEventListener('click', function () { wear(n); });
        n.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); wear(n); }
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && worn) { rest(); }
      });

      var want = null;
      try { want = new URL(location.href).searchParams.get('wear'); } catch (e) {}
      if (want) {
        var m = nodes.filter(function (n) { return n.getAttribute('data-key') === want; })[0];
        if (m) { wear(m); }
      }
    })();
  </script>
  <script is:inline>
    (function () {
      var sys = document.getElementById('cm-system');
      if (!sys) { return; }
      var raf = 0;
      function check() {
        raf = 0;
        document.body.classList.toggle('in-system', sys.getBoundingClientRect().top < window.innerHeight * 0.6);
      }
      function queue() { if (!raf) { raf = requestAnimationFrame(check); } }
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
      window.addEventListener('pageshow', check);
      check();
    })();
  </script>
</BaseLayout>
