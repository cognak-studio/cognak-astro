        var scale = gh / (meta.maxy - meta.miny);
        var gw = (meta.maxx - meta.minx) * scale;
        // Clamped so the glyph never fully leaves the viewport on the
        // narrower end of the desktop breakpoint (it's a faint z-index:0
        // background behind the text either way, so slight overlap there is
        // fine, matches how it already briefly overlapped near vw~900 before).
        // Shifted 300px further left (Pierce's call) from the locked position.
        var cx = vw > 900 ? Math.min(contentRight + GAP + gw / 2, vw - 24) - 300 : vw * 0.5;
        var cy = vh * 0.52;
        return {
          scale: scale,
          ox: cx - ((meta.minx + meta.maxx) / 2) * scale,
          oy: cy + ((meta.miny + meta.maxy) / 2) * scale
        };
      }

      function px(p, L) { return { x: p[0] * L.scale + L.ox, y: -p[1] * L.scale + L.oy }; }

      // HOLD is the pause between morphs, shortened so letters cycle through
      // sooner; MORPH (the morph itself) is untouched, its pace was already right.
      var HOLD = 3200, MORPH = 2400;
      function ease(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }

      function lerpContour(a, b, t, L) {
        var out = new Array(N);
        for (var i = 0; i < N; i++) {
          out[i] = px([a[i][0] + (b[i][0] - a[i][0]) * t, a[i][1] + (b[i][1] - a[i][1]) * t], L);
        }
        return out;
      }

      /* The outline is bone white for the six letters and tints toward the
         signal green for the ":)", the page's hidden joke, which until now
         drew identically to every other frame and so read as just another
         shape in the cycle. `tint` is 0..1 (the `smile` value in frame()), so
         the color arrives WITH the morph rather than snapping on at the end:
         the outline is already greening while the k is still resolving into
         the smile, which is what makes it feel found rather than announced. */
      var INK = [244, 244, 238];
      var SIGNAL = [170, 255, 0];
      var BG = [14, 6, 210];
      /* The glyph follows whichever page the colophon is wearing: outline and
         nodes in that page's ink, handles in its accent, fill a tint of its
         ground pulled 45% toward the ink - the same recipe the blue uses
         (#0E06D2 toward bone white gives the original rgb(117,113,223)). */
      function hexRGB(v, fb) {
        v = (v || '').trim();
        if (/^#[0-9a-f]{6}$/i.test(v)) {
          return [parseInt(v.substr(1, 2), 16), parseInt(v.substr(3, 2), 16), parseInt(v.substr(5, 2), 16)];
        }
        var m = v.match(/rgba?\(([^)]+)\)/);
        if (m) { return m[1].split(',').slice(0, 3).map(function (n) { return Math.round(parseFloat(n)); }); }
        return fb;
      }
      function readScheme() {
        var cs = getComputedStyle(document.documentElement);
        INK = hexRGB(cs.getPropertyValue('--wear-ink'), [244, 244, 238]);
        SIGNAL = hexRGB(cs.getPropertyValue('--wear-accent'), [170, 255, 0]);
        BG = hexRGB(cs.getPropertyValue('--wear-bg'), [14, 6, 210]);
        FILL = 'rgba(' + BG.map(function (c, i) { return Math.round(c + (INK[i] - c) * 0.45); }).join(',') + ',';
      }
      function drawContour(pts, alpha, tint) {
        ctx.beginPath();
        ctx.moveTo(pts[0].x, pts[0].y);
        for (var i = 1; i < N; i++) ctx.lineTo(pts[i].x, pts[i].y);
        ctx.closePath();
        var k = tint || 0;
        ctx.strokeStyle = 'rgba(' +
          Math.round(INK[0] + (SIGNAL[0] - INK[0]) * k) + ',' +
          Math.round(INK[1] + (SIGNAL[1] - INK[1]) * k) + ',' +
          Math.round(INK[2] + (SIGNAL[2] - INK[2]) * k) + ',' + alpha + ')';
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      // Solid fill for the glyph, drawn once across every contour as a single
      // evenodd path (so outer shapes stay solid, real holes like o/g/a's
      // counters stay cut out, and the degenerate padding contours, zero
      // area, contribute nothing). A fill using the exact page-background
      // blue would be invisible at any opacity (alpha-blending a color with
      // itself is a no-op), so this is a lightened tint of that blue instead:
      // #0E06D2 mixed 45% toward white, at 10% opacity as requested.
      var FILL = 'rgba(122,118,230,';
      function drawFill(contoursForFrame, alpha) {
        ctx.beginPath();
        for (var c = 0; c < contoursForFrame.length; c++) {
          var pts = contoursForFrame[c];
          ctx.moveTo(pts[0].x, pts[0].y);
          for (var i = 1; i < N; i++) ctx.lineTo(pts[i].x, pts[i].y);
          ctx.closePath();
        }
        ctx.fillStyle = FILL + alpha + ')';
        ctx.fill('evenodd');
      }

      /* ------------------------------------------------- cursor proximity ---
         The artwork invites inspection, so it answers the pointer: nodes and
         handles near the cursor brighten, and their tangent handles extend a
         little, so the area under your cursor reads like a live bezier editor.

         ptrX/ptrY are lerped toward the real cursor (ptrTX/ptrTY) rather than
         tracking it exactly, the light drags a frame or two behind, which
         reads as illumination instead of a hit-test. ptrS is a separate 0..1
         strength so the glow retreats smoothly when the pointer leaves the
         window rather than freezing lit wherever it exited.

         Desktop-with-a-real-pointer only: on touch, (hover:hover) fails and
         the effect never arms, so there's no phantom hotspot parked wherever
         the last tap landed. Under reduced motion the rAF loop renders exactly
         one frame, so responding to the pointer would mean re-rendering on
         every mousemove, precisely what that mode is asking us not to do. */
      var HOVERABLE = window.matchMedia('(hover: hover)').matches && !reduced;
      var PROX_R = 190;    // px, radius of influence
      var PROX_GAIN = 1.8; // alpha multiplier at dead center is 1 + this
      var ptrTX = -9999, ptrTY = -9999;  // raw cursor target
      var ptrX = -9999, ptrY = -9999;    // lerped influence point
      var ptrS = 0, ptrST = 0;           // strength, and its target

      if (HOVERABLE) {
        window.addEventListener('mousemove', function (e) {
          ptrTX = e.clientX; ptrTY = e.clientY; ptrST = 1;
          // First move after arming (or after leaving): jump the influence
          // point to the cursor instead of sweeping across the whole glyph
          // from its off-screen start, which would light up every node on
          // the way.
          if (ptrX < -9000) { ptrX = ptrTX; ptrY = ptrTY; }
        }, { passive: true });
        document.addEventListener('mouseleave', function () { ptrST = 0; }, { passive: true });
      }

      function stepPointer() {
        if (!HOVERABLE) return;
        ptrX += (ptrTX - ptrX) * 0.15;
        ptrY += (ptrTY - ptrY) * 0.15;
        ptrS += (ptrST - ptrS) * 0.12;
      }

      // 0 at the radius edge, 1 under the cursor, smoothstepped between.
      function proximity(x, y) {
        if (!HOVERABLE || ptrS < 0.002) return 0;
        var d = Math.hypot(x - ptrX, y - ptrY);
        if (d >= PROX_R) return 0;
        var q = 1 - d / PROX_R;
        return q * q * (3 - 2 * q) * ptrS;
      }

      function drawNodes(pts, t, fadeMul) {
        var step = 10;
        for (var i = 0; i < N; i += step) {
          var p = pts[i];
          var prev = pts[(i - 3 + N) % N];
          var next = pts[(i + 3) % N];
          var dx = next.x - prev.x, dy = next.y - prev.y;
          var len = Math.hypot(dx, dy) || 1;
          dx /= len; dy /= len;
          var pulse = 0.6 + 0.4 * Math.sin(t * 0.0012 + i * 0.7);

          /* Deliberately NOT damping `pulse` toward 1 as prox rises: letting
             the existing per-node breathing show through makes the halo
             slightly uneven, which keeps the hand-drawn quality and avoids a
             flashlight-cone look. If it ever reads as too busy, damping pulse
             here is the one-line way to make the lit area steady. */
          var prox = proximity(p.x, p.y);
          var boost = 1 + PROX_GAIN * prox;
          // Handles extend with proximity, the geometry tell, not just alpha.
          var h = 16 + 4 * prox;

          // Green handles kept at their existing brightness (not part of the
          // "10% more visible" bump below, only the white outline/nodes are).
          ctx.strokeStyle = 'rgba(' + SIGNAL.join(',') + ',' + (0.12 * pulse * fadeMul * boost) + ')';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(p.x - dx * h, p.y - dy * h);
          ctx.lineTo(p.x + dx * h, p.y + dy * h);
          ctx.stroke();

          ctx.fillStyle = 'rgba(' + SIGNAL.join(',') + ',' + (0.17 * pulse * fadeMul * boost) + ')';
          ctx.beginPath();
          ctx.arc(p.x - dx * h, p.y - dy * h, 2, 0, 6.2832);
          ctx.arc(p.x + dx * h, p.y + dy * h, 2, 0, 6.2832);
          ctx.fill();

          ctx.fillStyle = 'rgba(' + INK.join(',') + ',' + (0.22 * pulse * fadeMul * boost) + ')';
          ctx.fillRect(p.x - 2.5, p.y - 2.5, 5, 5);
        }
      }

      // How many contours to draw simultaneously per glyph, derived from the
      // data rather than hardcoded, since the ":)" combo needs 3 (two colon
      // dots + the paren) while every letter pads its unused slots with a
      // degenerate (invisible) contour to match.
      var NC = glyphs[order[0]].length;

      var INTRO_FADE = 900; // ms, first paint eases in so the artwork gets noticed, not popped
      var start = performance.now();
      var rafId = null;
      function frame(now) {
        readScheme();
        var L = layout();
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, vw, vh);

        // Clamp to 0: a rAF timestamp can land a hair before the `start` that
        // was just captured in boot() (clock rounding), which without this
        // guard turns into a negative `idx` below (order[-1] is undefined).
        var el = Math.max(0, now - start);
        // Reduced-motion shows one static frame with no animation to fade
        // through, so it should just be fully visible immediately.
        var fadeMul = reduced ? 1 : Math.min(1, el / INTRO_FADE);
        var cycle = HOLD + MORPH;
        var idx = Math.floor(el / cycle) % order.length;
        var next = (idx + 1) % order.length;
        var phase = el % cycle;
        var t = phase < HOLD ? 0 : ease((phase - HOLD) / MORPH);

        var A = glyphs[order[idx]], B = glyphs[order[next]];
        var contoursForFrame = new Array(NC);
        for (var c = 0; c < NC; c++) contoursForFrame[c] = lerpContour(A[c], B[c], t, L);

        stepPointer();
        updateCaption(idx, next, phase, fadeMul);

        /* How much of the ":)" is on screen this frame: 1 while it holds,
           and t / 1-t through the morphs on either side of it. Reading BOTH
           endpoints is what makes it work in both directions, k into smile
           (next is the smile, so it rises with t) and smile into c (idx is
           the smile, so it falls with t). */
        var smile = (order[idx] === ':)' ? 1 - t : 0) + (order[next] === ':)' ? t : 0);

        drawFill(contoursForFrame, 0.05 * fadeMul);
        for (var c2 = 0; c2 < NC; c2++) {
          var pts = contoursForFrame[c2];
          drawContour(pts, 0.12 * fadeMul, smile);
          drawNodes(pts, now, fadeMul);
        }
        rafId = reduced ? null : requestAnimationFrame(frame);
      }

      // (Re)starts the loop from a clean state: re-measures the canvas and
      // kicks off the first frame. Run on initial load AND on every
      // 'pageshow', a back/forward-cache restore, or this site's sitewide
      // cross-document view-transition (@view-transition{navigation:auto} in
      // custom.css, the "record" link is this page's only entry point, so
      // essentially every visit arrives through it), can leave the rAF loop
      // stalled or the canvas bitmap blank even though the DOM looks
      // untouched. That's what was making the artwork miss on some loads;
      // re-arming on pageshow makes it self-heal instead of staying dark.
      function boot() {
        resize();
        if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
        start = performance.now();
        if (reduced) {
          frame(start);
        } else {
          rafId = requestAnimationFrame(frame);
        }
      }

      if (reduced) {
        window.addEventListener('resize', function () { resize(); frame(start); });
      }
      window.addEventListener('pageshow', boot);
      boot();
    })();
  </script>
