---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
/* Vite inlines these as strings at build time, so the read is real and the
   page still has nothing to do at request time. */
import css from '../styles/custom.css?raw';
const PAGE_SRC = import.meta.glob('../pages/**/*.astro', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const ALL_SRC = import.meta.glob(['../**/*.astro', '../**/*.css', '../**/*.js', '../**/*.ts'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

/* Colophons traditionally date themselves, a printed one names the day the
   type was set. This resolves at BUILD time, not request time, so it names the
   day this deploy was cut and then stays put until the next one, which is the
   honest reading of "when was this set". Vercel builds in UTC, so a late-night
   Los Angeles deploy dates as the following day; that's a day's drift on a
   date whose whole job is to be approximate. */
const buildDate = new Date().toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
/* The edition mark. Vercel exposes the commit that built the page; a local
   build has none and prints only the date. */
const buildSha = (process.env.VERCEL_GIT_COMMIT_SHA || '').slice(0, 7);

/* ---- everything below is READ, not typed -----------------------------------
   The page claims every value on it comes from the stylesheet that ships. That
   is only true if the page reads the stylesheet, so it does: custom.css is
   opened at build time and the tokens are pulled out of it. A token that goes
   missing throws and fails the build, which is the right failure. A stale
   number printed on a page about not having stale numbers would be worse. */

function token(name: string): string {
  const m = css.match(new RegExp('^\\s*' + name + ':\\s*([^;]+);', 'm'));
  if (!m) { throw new Error('colophon: ' + name + ' is not in custom.css'); }
  let v = m[1].trim();
  const ref = v.match(/^var\((--[\w-]+)\)$/);
  if (ref) { v = token(ref[1]); }
  return v;
}
function bezier(v: string): number[] {
  const m = v.match(/cubic-bezier\(([^)]+)\)/);
  if (!m) { throw new Error('colophon: not a cubic-bezier: ' + v); }
  return m[1].split(',').map(s => parseFloat(s));
}
function ms(v: string): number { return parseFloat(v); }
function remPx(v: string): number {
  return v.endsWith('rem') ? parseFloat(v) * 16 : parseFloat(v);
}
function fmtPx(n: number): string {
  return (Math.round(n * 100) / 100) + 'px';
}

/* The notes are the only hand-written part: what each curve is for. */
const EASING_NOTES = {
  '--ease-standard':  'The default. Nav hovers, link underlines, every color change.',
  '--ease-out-expo':  'Arrivals. Content entering the frame, panels opening.',
  '--ease-drag':      'Anything that followed a finger and has to settle without a bounce.',
  '--ease-overshoot': 'Passes its mark and comes back. Used sparingly, on confirmations.',
  '--ease-press':     'The short trip a button makes under a cursor.'
};
const EASINGS = Object.keys(EASING_NOTES).map((t) => {
  const value = token(t);
  return { token: t, value, p: bezier(value), note: EASING_NOTES[t] };
});

const DURATION_NOTES = {
  '--dur-xs': 'Tap feedback', '--dur-s': 'The base', '--dur-sm': '',
  '--dur-m': 'Most hovers', '--dur-l': '', '--dur-xl': '', '--dur-2xl': 'Entrances, reveals'
};
const DURATIONS = Object.keys(DURATION_NOTES).map((t) => ({
  token: t, ms: ms(token(t)), note: DURATION_NOTES[t]
}));
const DUR_MAX = Math.max(...DURATIONS.map(d => d.ms));

/* Plot the curve as an SVG path in a 100x100 box, y inverted so progress
   runs upward. Control points can exceed the box (overshoot), the SVG
   is not clipped, and the padding in the wrapper accounts for it. */
function curvePath(p: number[]) {
  const x1 = p[0] * 100, y1 = 100 - p[1] * 100;
  const x2 = p[2] * 100, y2 = 100 - p[3] * 100;
  return 'M0,100 C' + x1 + ',' + y1 + ' ' + x2 + ',' + y2 + ' 100,0';
}

/* ---- grounds -----------------------------------------------------------
   Each page's ground is the pageBg it hands BaseLayout, read out of the page
   file itself. Two pages pass none: home paints its ground from CSS and the
   project template resolves to white (BaseLayout keeps the same two
   fallbacks). The highlight comes from the body[data-page] ::selection block
   in custom.css. The ink is the site's rule, not a list: light on a dark
   ground, dark on a light one. */
const COLOPHON_BG = '#0E06D2';
const PAGE_FILES = {
  home: 'pages/index.astro',
  studio: 'pages/studio.astro',
  projects: 'pages/projects/index.astro',
  project: 'pages/projects/[slug].astro',
  brief: 'pages/brief.astro',
  send: 'pages/send.astro',
  tools: 'pages/tools/index.astro',
  schedule: 'pages/schedule.astro',
  privacy: 'pages/privacy-policy.astro',
  '404': 'pages/404.astro'
};
const PAGE_NAMES = {
  home: 'Home', studio: 'Studio', projects: 'Projects', project: 'Project Detail',
  brief: 'Brief', send: 'Send', tools: 'Tools', schedule: 'Schedule',
  privacy: 'Privacy', colophon: 'Colophon', '404': '404'
};
const BG_FALLBACK = { home: '#17151A', project: '#FFFFFF' };

function groundOf(key: string): string {
  if (key === 'colophon') { return COLOPHON_BG; }
  /* Vite normalizes glob keys relative to this file, so match on the tail. */
  const rest = '/' + PAGE_FILES[key].replace(/^pages\//, '');
  const hit = Object.keys(PAGE_SRC).find(k => k.endsWith(rest));
  if (!hit) { throw new Error('colophon: cannot read ' + PAGE_FILES[key]); }
  const file = PAGE_SRC[hit];
  const m = file.match(/pageBg="(#[0-9a-fA-F]{6})"/);
  if (m) { return m[1].toUpperCase(); }
  if (BG_FALLBACK[key]) { return BG_FALLBACK[key]; }
  throw new Error('colophon: no pageBg in ' + PAGE_FILES[key]);
}
function selectionOf(key: string): { sel: string, selInk: string } {
  /* A selector list may name several pages before one block; match the
     block whose selector list contains this page. */
  const re = /((?:body\[data-page="[\w-]+"\]\s*::selection\s*,?\s*)+)\{([^}]*)\}/g;
  let m;
  while ((m = re.exec(css))) {
    if (m[1].indexOf('data-page="' + key + '"') === -1) { continue; }
    const bg = m[2].match(/background:\s*([^;]+);/);
    const fg = m[2].match(/color:\s*([^;]+);/);
    if (!bg || !fg) { break; }
    const resolve = (v: string) => {
      const ref = v.trim().match(/^var\((--[\w-]+)\)$/);
      return (ref ? token(ref[1]) : v.trim()).toUpperCase();
    };
    return { sel: resolve(bg[1]), selInk: resolve(fg[1]) };
  }
  /* No block of its own: the page takes the site default (home and 404 do). */
  const d = css.match(/^::selection\s*\{([^}]*)\}/m);
  const bg = d && d[1].match(/background:\s*([^;]+);/);
  const fg = d && d[1].match(/color:\s*([^;]+);/);
  if (!bg || !fg) { throw new Error('colophon: no ::selection rule for ' + key + ' in custom.css'); }
  const resolve = (v: string) => {
    const ref = v.trim().match(/^var\((--[\w-]+)\)$/);
    return (ref ? token(ref[1]) : v.trim()).toUpperCase();
  };
  return { sel: resolve(bg[1]), selInk: resolve(fg[1]) };
}

function lum(hex: string) {
  const v = [1, 3, 5].map(i => parseInt(hex.substr(i, 2), 16) / 255)
    .map(c => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4)));
  return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
}
function contrast(a: string, b: string) {
  const la = lum(a), lb = lum(b);
  return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
}
const INK_DARK_GROUND = '#F4F4EE';
const INK_LIGHT_GROUND = '#3A313B';

const PAGES = Object.keys(PAGE_NAMES).map((key) => {
  const ground = groundOf(key);
  const { sel, selInk } = selectionOf(key);
  const ink = lum(ground) < 0.35 ? INK_DARK_GROUND : INK_LIGHT_GROUND;
  return { key, name: PAGE_NAMES[key], ground, sel, selInk, ink, cr: contrast(ground, ink) };
});

/* The control is ordered by how dark the page is, not alphabetically and not
   by nav order. That ordering is the finding: eleven pages, eight distinct
   grounds, almost all of them at the dark end. */
const LADDER = PAGES
  .map(p => ({ ...p, l: lum(p.ground) }))
  .sort((a, b) => a.l - b.l);
/* The nav each ground gets, by the same rule the wear script applies at
   runtime: dark grounds pull their own color down, light grounds take the
   site's frosted bar with the page's ink on it. */
function mixHex(h: string, t: string, k: number) {
  const a = [1, 3, 5].map(i => parseInt(h.substr(i, 2), 16));
  const b = [1, 3, 5].map(i => parseInt(t.substr(i, 2), 16));
  return 'rgb(' + a.map((c, i) => Math.round(c + (b[i] - c) * k)).join(',') + ')';
}
const navOf = (pg) => (pg.l < 0.35 ? mixHex(pg.ground, '#000000', 0.28) : 'rgba(247,241,255,0.75)');
const navInkOf = (pg) => (pg.l < 0.35 ? '#ffffff' : pg.ink);
const markOf = (pg) => (contrast(pg.sel, pg.ground) >= 3 ? pg.sel : pg.ink);

const GROUND_COUNTS = PAGES.reduce((acc, p) => { acc[p.ground] = (acc[p.ground] || 0) + 1; return acc; }, {} as Record<string, number>);
const N_GROUNDS = Object.keys(GROUND_COUNTS).length;
const N_SHARED = Math.max(...Object.values(GROUND_COUNTS));
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const word = (n: number) => WORDS[n] || String(n);
const Word = (n: number) => { const w = word(n); return w.charAt(0).toUpperCase() + w.slice(1); };

/* ---- type ----------------------------------------------------------------
   The ten sizes come from the tokens. How often each one is used is counted
   across src/ at build time (every var(--fs-N) in a template, stylesheet or
   script), which is what the canvas in the Type section plots. */
const SRC_TEXT = Object.values(ALL_SRC).join('\n');

/* c = the treatment each size mostly gets on the site: r sans regular,
   mc mono caps, mo mono. */
const SCALE_META = [
  { t: '--fs-18', c: 'r' }, { t: '--fs-17', c: 'r' }, { t: '--fs-16', c: 'r' },
  { t: '--fs-15', c: 'r' }, { t: '--fs-14', c: 'r' }, { t: '--fs-13', c: 'r' },
  { t: '--fs-12', c: 'r' }, { t: '--fs-11', c: 'mc' }, { t: '--fs-10', c: 'mc' },
  { t: '--fs-9',  c: 'mo' }
];
const SCALE = SCALE_META.map((r) => {
  const pxN = remPx(token(r.t));
  const count = (SRC_TEXT.match(new RegExp('var\\(' + r.t + '\\)', 'g')) || []).length;
  return { ...r, px: fmtPx(pxN), pxN, count };
});
const SIZES = SCALE.slice().reverse().map(r => [r.pxN, r.count]);

const WEIGHTS = [
  { w: 400, n: 'Regular', t: 'Set by a person', file: 'ABCDiatype-Regular.woff2' },
  { w: 500, n: 'Medium',  t: 'Checked by eye',  file: 'ABCDiatype-Medium.woff2' },
  { w: 700, n: 'Bold',    t: 'Made by hand',    file: 'ABCDiatype-Bold.woff2' }
];
const MONO_FILE = 'ABCDiatypeMono-Regular.woff2';
/* The one real filesystem read: woff2 sizes. Astro builds from the project
   root, on Vercel and locally, so cwd is the anchor. */
const FONT_DIR = path.resolve(process.cwd(), 'public/theme/assets/fonts/diatype');
const kb = (file: string) => Math.round(fs.statSync(path.join(FONT_DIR, file)).size / 1024);
const FONT_KB = WEIGHTS.map(w => kb(w.file)).concat(kb(MONO_FILE));
const FONT_TOTAL_KB = FONT_KB.reduce((a, b) => a + b, 0);
---
<BaseLayout
  page="colophon"
  title="Colophon – COGNAK"
  description="A note on how this site is set: the type, the tools, the hands."
  ogUrl="https://cognak.com/colophon/"
  pageBg={COLOPHON_BG}
>
  <canvas id="colophon-anatomy" aria-hidden="true"></canvas>
  {/* Specimen-plate label for the glyph on the canvas. Positioned in JS from
      the same layout() the canvas draws with, and fed real measurements taken
      off the outline data, not decoration pretending to be data. Decorative
      in the a11y sense though (it labels artwork, and the artwork itself is
      aria-hidden), hence hidden from AT. */}
  <div id="glyph-caption" aria-hidden="true"></div>

  <canvas id="cm-anatomy" aria-hidden="true"></canvas>
  <div id="cm-plate" aria-hidden="true"></div>

  <main id="cognak-main"><section class="colophon">

    <h1 class="colophon-headline">A <em>colophon</em> is a site's fine print. Ours is the part we're proudest of.</h1>

    <div class="colophon-body">
      <h2 class="cm-h2 colophon-h2">Credits</h2>
      <p>Every word on cognak.com is set in <span class="no-widow"><strong>ABC&nbsp;Diatype</strong>,</span> a grotesque drawn by <a href="https://abcdinamo.com/typefaces/diatype" target="_blank" rel="noopener">Dinamo</a> in Basel &amp; Berlin, chosen for the way it stays neutral until you look closely, then reveals a little warmth in the curves. Code and figures fall back to <span class="no-widow"><strong>ABC&nbsp;Diatype Mono</strong>.</span></p>

      <p>The faces are self-hosted as <code>woff2</code> (Regular, Medium, Bold, and the Mono) so nothing about your visit is handed to a font CDN.</p>

      <p class="colophon-spec">
        <span>Typeface</span><span>ABC Diatype &amp; ABC Diatype Mono, by <a href="https://abcdinamo.com/typefaces/diatype" target="_blank" rel="noopener">Dinamo</a></span>
        <span>Built with</span><span><a href="https://astro.build" target="_blank" rel="noopener">Astro</a>, hand-written HTML/CSS/JS, WebGL</span>
        <span>Motion</span><span><a href="https://lenis.darkroom.engineering" target="_blank" rel="noopener">Lenis</a> smooth scroll, <a href="https://www.unicorn.studio" target="_blank" rel="noopener">UnicornStudio</a>, custom canvas</span>
        <span>Served from</span><span><a href="https://vercel.com" target="_blank" rel="noopener">Vercel</a></span>
        <span>Made in</span><span>Los Angeles, California</span>
        <span>Set</span><span>{buildDate}{buildSha && <span class="colophon-sha"> · {buildSha}</span>}</span>
      </p>

    </div>

  </section>

  <section class="cm cm-merged" id="cm-system">

    <script type="application/json" id="cm-sizes" set:html={JSON.stringify(SIZES)}></script>

    <p class="cm-eyebrow">System</p>


    <div class="cm-intro">
      <p>{Word(N_GROUNDS)} grounds, {word(EASINGS.length)} curves, {word(DURATIONS.length)} durations, one typeface. Every value below is read from the stylesheet that ships, at build time, by this page.</p>
    </div>

    <h2 class="cm-h2" id="cm-color">Color</h2>
    <div id="cm-color-sec">

    <p class="cm-sub">Each page makes one decision: its ground. The ink, the nav, the scrollbar and the highlight all follow from it by rule. {Word(PAGES.length)} pages, one function, run {word(PAGES.length)} times.</p>

    <figure class="cm-deck-wrap">
      {/* Eleven pages in miniature, edge to edge, darkest first. At rest each
          shows a sliver of itself: ground, nav, the left edge of its text and
          its highlight. Hover or focus widens one; click wears it. Every
          color on a card is derived from the ground by the site's own rules,
          so the cards show the derivation before anything is clicked. */}
      <div class="cm-deck" id="cm-ladder" role="group" aria-label={word(PAGES.length) + ' pages in miniature, darkest to lightest. Each one can be worn.'}>
        {LADDER.map((pg) => (
          <button
            type="button"
            class="cm-l-node cm-md"
            aria-label={'Wear ' + pg.name}
            aria-pressed="false"
            data-key={pg.key}
            data-name={pg.name}
            data-ground={pg.ground}
            data-ink={pg.ink}
            data-accent={pg.sel}
            data-cr={pg.cr.toFixed(1)}
            style={'--c:' + pg.ground + ';--ci:' + pg.ink + ';--ca:' + markOf(pg) + ';--cn:' + navOf(pg) + ';--cni:' + navInkOf(pg)}
          >
            <span class="cm-md-nav" aria-hidden="true"></span>
            <span class="cm-md-ln cm-md-ln1" aria-hidden="true"></span>
            <span class="cm-md-ln cm-md-ln2" aria-hidden="true"></span>
            <span class="cm-md-sel" aria-hidden="true"></span>
            <span class="cm-md-ln cm-md-ln3" aria-hidden="true"></span>
            <span class="cm-md-ln cm-md-ln4" aria-hidden="true"></span>
            <span class="cm-md-sq" aria-hidden="true"></span>
            <span class="cm-md-tag" aria-hidden="true">{pg.name}<small>{pg.ground}</small></span>
          </button>
        ))}
      </div>
      <figcaption class="cm-ladder-cap">
        <span class="cm-l-meta" id="cm-l-meta">{Word(PAGES.length)} pages by relative luminance, darkest to lightest. Click one to wear it.</span>
      </figcaption>
    </figure>

    <p class="cm-body">{Word(PAGES.length)} pages, {word(N_GROUNDS)} grounds. {Word(N_SHARED)} of them are the same near-black. Six sit stacked at the dark end, the 404's gray stands on its own in the middle, and the two light pages plus the white project template are the light end.</p>

    <p class="cm-aside">The green is the default rather than the rule. It holds the homepage and the 404, and yields wherever a page has a voice of its own.</p>

    </div>

    <h2 class="cm-h2" id="cm-motion">Motion</h2>

    <p class="cm-sub">The dot plots real elapsed time across the bottom against eased progress up the side, so it traces the curve at the speed the curve actually runs. The square travels on the same clock.</p>

    <h3 class="cm-h3">Curves</h3>

    <ul class="cm-curves">
      {EASINGS.map((e) => (
        <li class="cm-row" data-ease={e.value} data-p={e.p.join(',')}>
          <button class="cm-trigger" type="button" aria-label={'Play ' + e.token}>
            <span class="cm-graph">
              <svg viewBox="-6 -6 112 112" aria-hidden="true">
                <line class="cm-axis" x1="0" y1="100" x2="100" y2="100" />
                <line class="cm-axis" x1="0" y1="0" x2="0" y2="100" />
                <line class="cm-guide" x1="0" y1="0" x2="100" y2="0" />
                <line class="cm-guide" x1="100" y1="0" x2="100" y2="100" />
                <path class="cm-curve" d={curvePath(e.p)} />
                <circle class="cm-dot" cx="0" cy="100" r="4.5" />
              </svg>
            </span>
            <span class="cm-meta">
              <span class="cm-token">{e.token}</span>
              <span class="cm-value">{e.value}</span>
              <span class="cm-use">{e.note}</span>
              <span class="cm-track"><span class="cm-car"></span></span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <h3 class="cm-h3">Durations</h3>

    <p class="cm-sub">All seven, fired together, so the intervals read against each other.</p>

    <figure class="cm-durs cm-tl" id="cm-durs" data-max={DUR_MAX} aria-label={'The ' + word(DURATIONS.length) + ' durations, ' + DURATIONS[0].ms + ' to ' + DUR_MAX + ' milliseconds, on one line.'}>
      <div class="cm-tl-track">
        {DURATIONS.map((d, i) => (
          <span class={'cm-tl-tick' + (i % 2 ? ' is-down' : '') + (i === DURATIONS.length - 1 ? ' is-last' : '')} style={'--d:' + d.ms + 'ms; --x:' + (d.ms / DUR_MAX * 100) + '%'}>
            <span class="cm-tl-dot"></span>
            <span class="cm-tl-lab">
              <span class="cm-token">{d.token}</span>
              <span class="cm-ms">{d.ms}ms</span>
              {d.note && <span class="cm-ms cm-tl-note">{d.note}</span>}
            </span>
          </span>
        ))}
      </div>
    </figure>

    <p class="cm-body cm-body-last">Under <code>prefers-reduced-motion</code> none of this runs. The glyph holds one frame, the curves show their end state, and the reveals arrive at once.</p>

    <h2 class="cm-h2" id="cm-type">Type</h2>
    <div id="cm-type-sec">

    <p class="cm-sub">ABC Diatype, drawn by Dinamo, self-hosted as woff2 in three weights and a mono, {FONT_TOTAL_KB} KB in all. No CDN sees your visit.</p>

    <ul class="cm-weights">
      {WEIGHTS.map((w, i) => (
        <li class="cm-weight" style={'--fw:' + w.w}>
          <span class="cm-weight-spec">{w.w} &nbsp; {w.n} &nbsp; <span class="cm-weight-kb">{FONT_KB[i]} KB</span></span>
          <span class="cm-weight-set">{w.t}</span>
        </li>
      ))}
      <li class="cm-weight cm-weight-mono">
        <span class="cm-weight-spec">400 &nbsp; Mono &nbsp; <span class="cm-weight-kb">{FONT_KB[3]} KB</span></span>
        <span class="cm-weight-set">cubic-bezier(0.4, 0, 0.2, 1)</span>
      </li>
    </ul>

    <p class="cm-body">One OpenType feature is asked for by name: tabular figures on the project count in the Home and Projects headlines, so the number holds its width while it ticks up. Everything else is the face as Dinamo drew it. No stylistic sets, no alternates.</p>

    <p class="cm-body">Every page headline is the same size: 62px on a wide screen, down to 27px on a phone. Project titles are the one exception, a step larger.</p>

    <div class="cm-spec cm-spec-head">
      <span class="cm-spec-k">Headline · 27–62px<br /><span class="cm-spec-uses">Medium</span></span>
      <span class="cm-spec-v cm-spec-headline">Built by people</span>
    </div>

    <p class="cm-body">Everything under 18px uses {word(SCALE.length)} named sizes. The number under each is how many times the source reaches for it.</p>

    <figure class="cm-band" aria-label={'The ' + word(SCALE.length) + ' sizes, ' + SCALE[SCALE.length - 1].px + ' to ' + SCALE[0].px + ', set side by side.'}>
      {SCALE.slice().reverse().map((r) => (
        <span class="cm-band-i">
          <span class={'cm-band-w cm-ex-' + r.c} style={'font-size:var(' + r.t + ')'}>cognak</span>
          <span class="cm-band-k">{r.px.replace('px', '')}<span class="cm-band-n">×{r.count}</span></span>
        </span>
      ))}
    </figure>

    </div>

    <h2 class="cm-h2" id="cm-voice">Voice</h2>

    <p class="cm-sub">The rules the copy on this site is written against.</p>

    <ol class="cm-rules">
      <li>One paragraph. Name the work, list the range in a short series, stop.</li>
      <li>Scale is implied by what's listed, never asserted with adjectives.</li>
      <li>No sensory image standing in for a claim. No closing thesis statement.</li>
      <li>When in doubt, match the shortest entry on the site, not the longest.</li>
      <li>Nothing romantic, abstract, or sales-inflected. Declarative, or cut it.</li>
    </ol>

    <h2 class="cm-h2" id="cm-outside">Outside the system</h2>

    <p class="cm-sub">What the tokens deliberately do not reach.</p>

    <ul class="cm-outside">
      <li><span class="cm-o-n">Homepage ground</span><span class="cm-o-d">A WebGL field, not a color token.</span></li>
      <li><span class="cm-o-n">Character sweep</span><span class="cm-o-d">Per-letter timing, authored against the text it runs on.</span></li>
