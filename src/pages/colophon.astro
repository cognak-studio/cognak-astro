      /* Reveal guards. .stagger-word is the site-wide splitter's output;
         .colophon-spec/.colophon-sign use this page's own IO fade. Both start
         hidden and both must be forced on for print. */
      .stagger-word,
      .colophon-headline,
      .colophon-body,
      .colophon-body p,
      .colophon-spec,
