      .colophon-spec {
        color: #111111 !important;
        border-top: 1px solid #111111 !important;
        border-bottom: 1px solid #111111 !important;
        padding: 10pt 0 !important;
        margin: 14pt 0 !important;
        max-width: none !important;
        break-inside: avoid;
      }
      .colophon-spec span:nth-child(odd) { color: #555555 !important; }
      .colophon-sign { color: #333333 !important; break-inside: avoid; }

      /* ---- the system sections on paper ----------------------------------
         Everything in them reads --wear-*, so re-pointing the four variables
         at ink on paper recolors the lot: curves, ladder, specimens, rules.
         !important here beats the inline values the wear script sets on
         :root, so a page printed while wearing Studio still prints in ink.
         The blanket opacity/transform guard does double duty: it forces the
         scroll reveals on (same problem as above) and it leaves every
         demonstration at its end state, so the duration bars print full and
         the ladder labels print visible. */
      :root {
        --wear-bg: #ffffff !important;
        --wear-ink: #111111 !important;
        --wear-accent: #111111 !important;
        --wear-dim: #555555 !important;
      }
      #cm-anatomy,
      #cm-plate,
      .cm-ladder-cap,
      .cm-track { display: none !important; }
      .cm {
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        color: #111111 !important;
      }
      .cm, .cm * {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        transition: none !important;
      }
      .cm-h2 { break-after: avoid; margin-top: 18pt; }
      .cm-row, .cm-spec, .cm-weight, .cm-rules li, .cm-outside li,
      .cm-deck-wrap, .cm-intro, .cm-durs, .cm-band, .cm .colophon-body { break-inside: avoid; }
      .cm-trigger { padding: 8pt 0 !important; }
      .cm-md, .cm-md * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      .cm-md { flex: 1 1 0 !important; }
      .cm-md-tag { display: none !important; }
      .cm-body, .cm-sub, .cm-intro p { max-width: 68ch !important; }
    }
