---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import fs from 'node:fs';

export async function getStaticPaths() {
  const all = (await getCollection('projects', (p) => !p.data.draft));
  // Newest-first ordering (get_adjacent_post by date) for prev/next.
  const ordered = [...all].sort((a, b) => {
    const ta = a.data.date ? a.data.date.getTime() : 0;
    const tb = b.data.date ? b.data.date.getTime() : 0;
    return tb - ta;
  });
  return ordered.map((entry, i) => {
    // "previous" = older (next in newest-first list),
    // "next" = newer (previous in list); newest wraps to oldest.
    const prev = ordered[i + 1] ?? null; // older
    let next = ordered[i - 1] ?? null;   // newer
    if (!next && ordered.length > 1) next = ordered[ordered.length - 1]; // wrap
    return {
      params: { slug: entry.data.slug ?? entry.id },
      props: {
        entry,
        prev: prev ? { slug: prev.data.slug ?? prev.id, title: prev.data.title } : null,
        next: next && next.id !== entry.id ? { slug: next.data.slug ?? next.id, title: next.data.title } : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const slug = d.slug ?? entry.id;
// The project's gallery lives in the markdown body.
const { Content } = await render(entry);

/* Cask grade for the chip beside the category. Identical BNIC thresholds and
   identical output format to vintageOf() on /projects ("XO · 12y") — the grade
   already appears in the archive list and the homepage hover-meta, so a project
   must not read as XO in one place and VSOP in another.
   projectYear is NOT a reliable fallback here: several projects carry a RANGE
   ("2016-2026"), and Number() on that is NaN, which would date them to 1970 and
   grade everything XO. Only a real `date` counts; anything else gets no chip. */
const NOW_UNIX = Math.floor(Date.now() / 1000);
const YEAR_SECONDS = 31557600;
const projectUnix = d.date ? Math.floor(d.date.getTime() / 1000) : 0;
let vintage = '';
if (projectUnix > 0 && projectUnix < NOW_UNIX) {
  const years = (NOW_UNIX - projectUnix) / YEAR_SECONDS;
  const grade = years >= 10 ? 'XO' : years >= 4 ? 'VSOP' : 'VS';
  vintage = grade + ' · ' + (years < 1 ? '<1y' : Math.floor(years) + 'y');
}

/* Strip the authored "• " from each More-details line. 184 of the 188 items
   across the archive are written as `<p>• fact</p>`, some with a non-breaking
   space after the bullet — the character is baked into the content, not added
   by CSS, so it can't be hidden with a rule. The block is set as a mono spec
   list with hairline rules doing the separating, and a literal bullet inside
   that reads as a leftover. Items authored WITHOUT a bullet are untouched. */
let moreDetailsHtml = (d.moreDetails ?? '').replace(/(<p[^>]*>)\s*•[\s\u00A0]*/g, '$1');

/* Drop the FIRST detail row when it merely restates engagement length —
   "5+ year relationship", "1-month project", "Ongoing project". The cask grade
   directly above already carries duration ("XO · 12Y") and now carries live
   status too, so the row was saying the same thing a third way, in a third
   format. 42 of the 49 projects with details match; the other 7 open with a URL
   or a location and are left alone.

   KNOWN TRADE-OFF: the grade is year-granular, so "6+ month project" collapses
   to "VS · <1Y" and month-level precision is lost. Accepted for consistency —
   delete this one replace() to bring the rows back. */
const RESTATES_DURATION = /^(\d+\s*\+?\s*[-–]?\s*(year|month|week)s?\b|ongoing\b)/i;
moreDetailsHtml = moreDetailsHtml.replace(/<p[^>]*>([\s\S]*?)<\/p>\s*/, (whole, inner) =>
  RESTATES_DURATION.test(inner.replace(/<[^>]+>/g, '').trim()) ? '' : whole
);

/* Client status. Folded into the grade rather than given its own row: the
   grade already answers "how long", and "is it still live" is the one thing it
   couldn't say — which is exactly what the old "ongoing relationship" copy was
   selling. undefined renders nothing at all. */
const clientStatus = d.activeClient === true ? 'Active'
                   : d.activeClient === false ? 'Past'
                   : null;

/* Does this project actually have a gallery? 17 of the 53 don't, and an empty
   <figure> plus the CTA's full 120px top margin left a large void between the
   information block and "Start a project" (spotted on /projects/sipmargs).

   A blank-body test is NOT enough: sipmargs' body is not empty, it holds the
   scaffold comment "<!-- Gallery images go here... -->" left by new-project.
   Comments are stripped before looking for a real <img> or a markdown ![.

   FAIL-SAFE ON PURPOSE: if `entry.body` is ever not a string (an Astro content
   API change), this returns TRUE and every gallery renders exactly as it does
   today. The inverse default would silently delete 97 images across 36
   projects, and nothing in the build would flag it. */
const bodyRaw = typeof entry.body === 'string' ? entry.body : null;
const hasGallery = bodyRaw === null
  ? true
  : /<img|!\[/.test(bodyRaw.replace(/<!--[\s\S]*?-->/g, ''));

const heroImg = await getImage({ src: d.hero, format: 'webp', width: 2000 });
// Branded OG share image (pre-generated by scripts/generate-og.py, mirrors the old
// og-image.php compositor). Falls back to the hero image if a card hasn't been
// generated yet, so a freshly-added project never has a broken share preview.
const ogCard = new URL(`../../../public/og/${slug}.jpg`, import.meta.url);
const ogImage = fs.existsSync(ogCard)
  ? `https://cognak.com/og/${slug}.jpg`
  : `https://cognak.com${heroImg.src}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  url: `https://cognak.com/projects/${slug}/`,
  description: d.metaDescription ?? '',
  creator: { '@type': 'Organization', name: 'COGNAK', url: 'https://cognak.com' },
  image: ogImage,
};
---
<BaseLayout
  page="project"
  title={`${d.title} – COGNAK`}
  description={d.metaDescription ?? `${d.title} by COGNAK.`}
  ogType="article"
  ogImage={ogImage}
  ogUrl={`https://cognak.com/projects/${slug}/`}
  noindex={d.noindex}
  jsonLd={jsonLd}
  heroPreload={heroImg.src}
>
  <main id="cognak-main"><article class="template-single-project">

    <figure class="img-wide img-wide--hero" style={`view-transition-name: project-thumb-${slug}`}>
      {d.heroVideo ? (
        <>
          <video class="hero-video" src={d.heroVideo} autoplay muted loop playsinline webkit-playsinline x5-playsinline preload="auto"></video>
          <div class="hero-video-loader" aria-hidden="true"><span class="hero-video-spinner"></span></div>
          <button class="hero-mute-btn" aria-label="Toggle sound">
            <svg class="hero-mute-icon hero-mute-icon--muted" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8H7L12 4V18L7 14H3V8Z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
              <line x1="16" y1="8" x2="20" y2="14" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="20" y1="8" x2="16" y2="14" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <svg class="hero-mute-icon hero-mute-icon--unmuted" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none">
              <path d="M3 8H7L12 4V18L7 14H3V8Z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M15 7.5C16.5 8.8 17.5 10.3 17.5 11S16.5 13.2 15 14.5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M17.5 5C20 7 21.5 9 21.5 11S20 15 17.5 17" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </>
      ) : (
        <img src={heroImg.src} alt={`${d.title} – COGNAK`} width={heroImg.attributes.width} height={heroImg.attributes.height} />
      )}

      {(prev || next) && (
        <div class="mobile-project-nav">
          {prev && (
            <a href={`/projects/${prev.slug}`} class="mobile-pager mobile-pager--prev" aria-label={`Previous project: ${prev.title}`}>
              <span class="mobile-pager-arrow"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4L6 10L12 16" stroke="#3A313B" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="mobile-pager-title">{prev.title}</span>
            </a>
          )}
          {next && (
            <a href={`/projects/${next.slug}`} class="mobile-pager mobile-pager--next" aria-label={`Next project: ${next.title}`}>
              <span class="mobile-pager-arrow"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 4L14 10L8 16" stroke="#3A313B" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="mobile-pager-title">{next.title}</span>
            </a>
          )}
        </div>
      )}
    </figure>

    {/* Asymmetric split: the identity (title, category, grade, invitation) holds
        the left, the three text groups stack in a measured right-hand column.
        The three groups are unchanged — same classes, same order, same copy —
        so the existing typography in custom.css still applies; only the
        container's shape changes.

        Type is deliberately NOT redesigned here. The category is already
        Diatype Mono in the page's purple, the body copy is already 15px/1.75
        and the labels are already sentence-case by an explicit override — all
        of it good, none of it WordPress residue. This changes the LAYOUT only. */}
    <section class="information">
      <div class="container--work-single">
        <div class="info-split">
          <div class="info-lead">
            <h1 class="title">{d.title}</h1>
            <p class="category">{d.category}</p>
            {(vintage || clientStatus) && (
              <span class="project-vintage">
                {vintage}
                {vintage && (
                  <span class="pv-note" aria-hidden="true">Cask grade &mdash; VS under 4 years &middot; VSOP 4&ndash;10 &middot; XO 10+</span>
                )}
                {vintage && clientStatus && ' · '}
                {clientStatus && (
                  <span class:list={["pv-status", clientStatus === 'Active' ? 'pv-status--active' : 'pv-status--past']}>
                    <span class="pv-dot" aria-hidden="true"></span>{clientStatus}
                  </span>
                )}
              </span>
            )}
          </div>

          {/* "More details" is paired with the identity, not with the two
              narrative groups: it's four short facts, and holding it in a
              column beside 400-word prose gave it a weight it doesn't have.
              Kept inside a `.details` wrapper so every existing
              `.information .details h2 / p / ul / a` rule still applies —
              moving it out of that scope would silently drop its typography. */}
          {/* No heading. "More details" labelled four self-evident facts and,
              set in the same mono as the facts themselves, read as a fifth row.
              The grade directly above already anchors the block. */}
          <aside class="details details-extra">
            <div class="col">
              <Fragment set:html={moreDetailsHtml} />
            </div>
          </aside>

          {/* ONE CTA per project page, and it lives here rather than at the
              bottom. Two asks (a soft mailto here, "Start a project" after the
              gallery) split the intent and neither carried weight; this is the
              site's standard closing block — same .hp-start-wrap +
              .projects-start-link + availability beacon as /projects and
              /studio, gradient hover included — parked at the foot of the
              identity column where the eye already ends up. */}
          <div class="info-invite">
            <div class="hp-start-wrap">
              <a href="/brief" class="projects-start-link">Start a project</a>
              <span class="availability-sub"><span class="avail-dot" aria-hidden="true"></span> Currently booking 30–60 days out</span>
            </div>
          </div>

          <aside class="details details-main">
            <div class="col">
              <h2>About the client</h2>
              <Fragment set:html={d.aboutTheClient ?? ''} />
            </div>
            <div class="col end">
              <h2>The work</h2>
              <Fragment set:html={d.theWork ?? ''} />
            </div>
          </aside>
        </div>
      </div>
    </section>

    {/* Body gallery. `project-gallery` exists because `.img-wide` is ALSO the
        hero's class — any bare `.img-wide img` rule would style the hero video
        frame too. 36 of the 53 projects have a gallery here (97 images in
        total), so this is the dominant look of the section, not an edge case;
        the other 17 render this figure empty, which is why the spacing rule
        below is written so an empty figure collapses. */}
    {hasGallery && (
      <figure class="img-wide project-gallery">
        <Content />
      </figure>
    )}

    <nav id="work-pagers" class="pagers group">
      {prev && (
        <a href={`/projects/${prev.slug}`} rel="prev" aria-label={`Previous project: ${prev.title}`}>
          <span class="title">{prev.title}</span>
          <svg class="pager-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 5L9 12L15 19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      )}
      {next && (
        <a href={`/projects/${next.slug}`} rel="next" aria-label={`Next project: ${next.title}`}>
          <svg class="pager-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 5L15 12L9 19" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="title">{next.title}</span>
        </a>
      )}
    </nav>
  </article></main>
</BaseLayout>
