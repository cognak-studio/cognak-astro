---
/**
 * /receive — client-facing file-download page.
 * Reached as cognak.com/r/<token> via a vercel.json rewrite (so the browser
 * URL stays clean); also readable directly as /receive?t=<token> for local
 * testing, since Vercel-only rewrites don't apply under `astro dev`.
 *
 * Passcode-gated: posts { token, passcode } to /api/deliver-get.js, which
 * checks the share's manifest (deliveries/<token>/manifest.json in Vercel
 * Blob) and returns the file list once the passcode matches. No admin
 * session is needed here — this is the link COGNAK sends a client instead
 * of a Hightail link.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="receive"
  title="Files from COGNAK"
  description="A file delivery from COGNAK."
  ogUrl="https://cognak.com/receive/"
  noindex={true}
  pageBg="#384237"
>
  <canvas id="send-transit" aria-hidden="true"></canvas>

  <main id="cognak-main"><section class="receive">

    <h1 class="headline receive-headline"><em>Files</em> from COGNAK.</h1>
    <p class="lede receive-lede" id="receive-lede">Enter the passcode you were sent to view and download.</p>

    <div class="dcard rise" id="gate">
      <div class="group">
        <div class="field">
          <label class="q" for="passcode-input">
            <span class="q-title">Passcode</span>
          </label>
          <input class="txt mono" id="passcode-input" type="text" autocomplete="off" spellcheck="false" />
          <p class="note" id="gate-note" role="status" aria-live="polite"></p>
        </div>
      </div>
      <div class="actions">
        <button type="button" class="btn btn-primary" id="unlock-btn">Unlock</button>
      </div>
    </div>

    <div class="dcard rise" id="invalid" hidden>
      <p class="note is-error" id="invalid-note" role="alert">This link isn't complete. Check the URL your recipient sent you.</p>
    </div>

    <div class="dcard rise" id="files-card" hidden>
      <div class="group">
        <div class="group-title" id="files-title">Files</div>
        <ul class="flist" id="flist"></ul>
      </div>
    </div>

  </section></main>

  <style is:inline>
    html, body { background-color:#384237 !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }

    /* "Transit" background — see src/lib/send-background.js. Fixed behind
       #cognak-main, faded in once the first frame has painted so there's no
       pop. Under reduced motion the script never starts, so this would just
       sit empty; hidden outright instead. */
    #send-transit{ position:fixed; inset:0; width:100vw; height:100vh; z-index:0;
      pointer-events:none; opacity:0; transition:opacity 1.4s ease; }
    #send-transit.is-in{ opacity:1; }
    @media (prefers-reduced-motion:reduce){ #send-transit{ display:none; } }

    /* Same deep sage colorway as /send — see that page's comment for the
       full rationale and the WCAG AA contrast notes. */
    .receive {
      --bg:#384237;
      --card:rgba(66,77,65,0.62); --field:rgba(0,0,0,0.28); --field-focus:rgba(0,0,0,0.40);
      --ink:#D2DACF; --ink-soft:#AEB8AB; --accent:#C3CCBF; --accent-hi:#D2DACF;
      --accent-soft:#C3CCBF; --deep:#384237; --line:rgba(210,218,207,0.18);
      --line-strong:rgba(210,218,207,0.52); --placeholder:#9BA598;
      --ok:#8FE7B4; --err:#FFA79A;
      /* Brightest-thing-on-the-page CTA, matching /send. */
      --cta:#E4EADF; --cta-hi:#F2F5EF;
      min-height:100vh; min-height:100dvh;
      display:flex; flex-direction:column; justify-content:center; /* align-items left at the
      default "stretch" so headline/lede/cards keep filling the column's width, same as before */
      max-width:720px; margin:0 auto; padding:24px 6vw 104px;
      color:var(--ink); font-family:'Diatype Variable', sans-serif;
    }
    /* True viewport centering, both axes — see /send's comment on the same
       rule for why this replaces the padding-top:190px convention. */
    .receive .mono{ font-family:'Diatype Mono', monospace; }
    .receive label.q{ display:block !important; }

    .receive .headline{ font-size:clamp(20px,5.5vw,52px); font-weight:500; line-height:1.1;
      letter-spacing:-.02em; margin:0 0 .9rem; color:var(--ink); }
    .receive .headline em{ font-style:normal; font-weight:500; color:var(--accent-soft); }
    .receive .lede{ font-size:1.05rem; line-height:1.65; color:var(--ink-soft); max-width:56ch; margin:0 0 1.1rem 0; }
    @media (max-width:720px){ .receive .headline{ font-size:clamp(24px,7vw,38px); } }
    html.js .receive-headline, html.js .receive-lede{ opacity:0; }
    @media (prefers-reduced-motion:reduce){
      html.js .receive-headline, html.js .receive-lede{ opacity:1; }
    }
    .receive-lede .stagger-word{ transform:none; transition:opacity .55s ease; }

    .receive .dcard{ border-radius:10px; padding:34px 34px 30px;
      box-shadow:0 2px 18px rgba(0,0,0,.26); margin-bottom:1.4rem;
      /* Renders EXACTLY the nav's rgba(66,77,65,0.62) over the page bg —
         same colour as before, Pierce's card-matches-nav rule intact — but
         opaque, so the transit lines behind it don't show through. That
         matters for more than taste: measured with a dash drifting under a
         card, contrast fell under the AA line, i.e. the page
         stopped passing AA whenever the animation happened to pass behind
         text. The animation now reads around the cards, not through them.
         (Tried backdrop-filter first — it softens but doesn't remove the
         shift, and costs a full-viewport blur every frame.) */
      background:linear-gradient(rgba(66,77,65,0.62), rgba(66,77,65,0.62)) var(--bg);
    }
    @media (max-width:600px){ .receive .dcard{ padding:24px 20px 22px; } }

    .receive .group-title{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.2em;
      text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.6rem; }
    .receive .field{ margin-bottom:0; }
    .receive .q{ display:block; margin-bottom:.85rem; padding:0; }
    .receive .q-title{ display:block; font-size:1.02rem; font-weight:500; line-height:1.3; color:var(--ink); }

    .receive .txt{
      width:100%; box-sizing:border-box; margin:0;
      background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:1.1rem; letter-spacing:.08em; line-height:1.5; padding:14px 16px;
      transition:border-color .2s ease, background .2s ease; outline:none; }
    .receive .txt:focus{ border-color:var(--accent); background:var(--field-focus); }
    .receive .txt.is-error{ border-color:var(--err); }
    .receive a:focus-visible, .receive button:focus-visible, .receive input:focus-visible{ outline-color:var(--accent) !important; }

    .receive .note{ margin:.7rem 0 0; font-size:.84rem; line-height:1.45; color:var(--ink-soft); min-height:1.2em; }
    .receive .note.is-error{ color:var(--err); }

    .receive .actions{ margin-top:1.6rem; }
    .receive .btn{ font-family:inherit; font-size:.98rem; font-weight:500; cursor:pointer;
      display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
      border-radius:999px; padding:14px 26px; background:none; color:var(--ink);
      border:1px solid var(--line-strong);
      transition:background .2s ease, color .2s ease, border-color .2s ease, box-shadow .25s ease; }
    .receive .btn.btn-primary{ background:var(--cta); border-color:var(--cta); color:var(--deep); }
    .receive .btn.btn-primary:hover:not(:disabled){ background:var(--cta-hi); border-color:var(--cta-hi);
      box-shadow:0 0 24px rgba(228,234,223,.24); }
    .receive .btn:active:not(:disabled){ transform:scale(.98); }
    .receive .btn:disabled{ opacity:.55; cursor:not-allowed; }

    .receive .flist{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
    .receive .frow{ display:flex; align-items:center; gap:14px; background:var(--field);
      border:1px solid var(--line); border-radius:8px; padding:14px 16px; }
    .receive .frow-name{ flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:.96rem; }
    .receive .frow-size{ color:var(--ink-soft); font-family:'Diatype Mono', monospace; font-size:.8rem; flex:0 0 auto; }
    .receive .frow-dl{ flex:0 0 auto; text-decoration:none; }

    .receive .rise{ opacity:0; transform:translateY(8px); transition:opacity .6s ease, transform .6s ease; }
    .receive .rise.in{ opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce){ .receive .rise{ opacity:1; transform:none; transition:none; } }

    .home-bottom-bar.inner-page-nav.send-nav{ background:rgba(66,77,65,0.62) !important;
      -webkit-backdrop-filter:blur(12px) !important; backdrop-filter:blur(12px) !important; }
    .send-nav .home-bottom-email,
    .send-nav .home-bottom-location,
    .send-nav .inner-nav-links a,
    .send-nav .pulse-dot{ color:#AEB8AB !important; }
    .send-nav .home-bottom-email,
    .send-nav .inner-nav-links a{ transition:color .2s ease; }
    @media (hover:hover){
      .send-nav .home-bottom-email:hover,
      .send-nav .inner-nav-links a:hover{ color:#D2DACF !important; }
    }
  </style>

  <script>
    import { initTransit } from '../lib/send-background.js';
    initTransit(document.getElementById('send-transit'));

    const $ = (id) => document.getElementById(id);
    function humanSize(b) {
      return b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB';
    }

    function getToken() {
      const m = location.pathname.match(/\/r\/([a-zA-Z0-9]+)/);
      if (m) return m[1];
      const t = new URLSearchParams(location.search).get('t');
      return t || null;
    }

    const token = getToken();

    async function unlock(passcode) {
      const res = await fetch('/api/deliver-get', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, passcode }),
      });
      let data = null;
      try { data = await res.json(); } catch (e) { /* no body */ }
      return { ok: res.ok, data };
    }

    function renderFiles(payload) {
      $('gate').hidden = true;
      $('files-card').hidden = false;
      $('receive-lede').textContent = payload.client ? 'From COGNAK, for ' + payload.client + '.' : 'Ready to download.';
      // The project name headlines the file list when there is one — it's the
      // label the client actually recognises. Falls back to plain "Files".
      $('files-title').textContent = payload.project || 'Files';
      document.title =
        [payload.client, payload.project].filter(Boolean).join(' — ') +
        (payload.client || payload.project ? ' — ' : '') + 'Files from COGNAK';

      const list = $('flist');
      list.innerHTML = '';
      (payload.files || []).forEach((f) => {
        const li = document.createElement('li');
        li.className = 'frow';
        li.innerHTML =
          '<span class="frow-name"></span>' +
          '<span class="frow-size"></span>' +
          '<a class="btn frow-dl" download></a>';
        li.querySelector('.frow-name').textContent = f.name;
        li.querySelector('.frow-size').textContent = humanSize(f.size || 0);
        const a = li.querySelector('.frow-dl');
        a.href = f.url;
        a.setAttribute('download', f.name);
        a.textContent = 'Download';
        // Per-row label so a screen reader hears which file, not N x "Download".
        a.setAttribute('aria-label', 'Download ' + f.name);
        list.appendChild(li);
      });
    }

    if (!token) {
      $('gate').hidden = true;
      $('invalid').hidden = false;
    } else {
      $('unlock-btn').addEventListener('click', async () => {
        const note = $('gate-note');
        const input = $('passcode-input');
        const passcode = input.value.trim();
        input.removeAttribute('aria-invalid');
        if (!passcode) {
          note.textContent = 'Enter the passcode you were sent.';
          note.className = 'note is-error';
          return;
        }
        $('unlock-btn').disabled = true;
        const r = await unlock(passcode);
        $('unlock-btn').disabled = false;
        if (r.ok && r.data && r.data.ok) {
          renderFiles(r.data);
          return;
        }
        input.classList.add('is-error');
        input.setAttribute('aria-invalid', 'true');
        note.textContent = (r.data && r.data.error) || 'Something went wrong. Please retry.';
        note.className = 'note is-error';
      });
      $('passcode-input').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('unlock-btn').click(); });
    }

    requestAnimationFrame(() => {
      document.querySelectorAll('.receive .rise').forEach((el) => el.classList.add('in'));
    });
  </script>
</BaseLayout>
