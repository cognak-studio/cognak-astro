      animation:signin-ring-spin 3.4s linear infinite; }
    @media (prefers-reduced-motion:reduce){
      .send .signin-icon-shimmer{ animation:none; } }

    /* Single primary action reads better centered than left-aligned; still
       fine if the password fallback appears alongside it during recovery. */
    .send .actions.actions-center{ justify-content:center; }
    .send .btn .btn-icon{ display:inline-flex; opacity:.92; }
    .send .btn .btn-icon svg{ display:block; }

    .send .field{ margin-bottom:1.8rem; }
    .send .field:last-child{ margin-bottom:0; }
    .send .q{ display:block; margin-bottom:.85rem; padding:0; }
    .send .q-title{ display:block; font-size:1.02rem; font-weight:500; line-height:1.3; color:var(--ink); }
    .send .q-sub{ display:block; font-size:.86rem; font-weight:450; line-height:1.4; color:var(--ink-soft); margin-top:.2rem; max-width:54ch; }

    .send .txt{
      width:100%; box-sizing:border-box; margin:0;
      background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:1rem; line-height:1.5; padding:14px 16px;
      transition:border-color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard); outline:none; }
    .send .txt::placeholder{ color:var(--placeholder); }

    /* Typed text was going illegible: WebKit paints autofilled fields with its
       own dark-on-pale treatment, and on a dark field that lands as near-black
       on near-black. -webkit-text-fill-color is the only thing that overrides
       the text colour there (plain `color` is ignored), and the giant inset
       shadow is the standard way to repaint the background, since
       background-color is likewise overridden. The absurd transition delay
       stops WebKit animating its yellow back in on re-focus. */
    .send .txt, .receive .txt{ -webkit-text-fill-color:var(--ink); caret-color:var(--accent); }
    .send .txt:-webkit-autofill,
    .send .txt:-webkit-autofill:hover,
    .send .txt:-webkit-autofill:focus,
    .send .txt:-webkit-autofill:active,
    .receive .txt:-webkit-autofill,
    .receive .txt:-webkit-autofill:hover,
    .receive .txt:-webkit-autofill:focus,
    .receive .txt:-webkit-autofill:active{
      -webkit-text-fill-color:var(--ink) !important;
      caret-color:var(--accent);
      -webkit-box-shadow:0 0 0 1000px var(--field) inset !important;
      box-shadow:0 0 0 1000px var(--field) inset !important;
      transition:background-color 9999s ease-out 0s; }

    .send .txt:focus{ border-color:var(--accent); background:var(--field-focus); }
    .send .txt[readonly]{ cursor:text; }
    .send a:focus-visible, .send button:focus-visible, .send input:focus-visible,
    .send [tabindex]:focus-visible{ outline-color:var(--accent) !important; }

    .send .note{ margin:.7rem 0 0; font-size:.84rem; line-height:1.45; color:var(--ink-soft); min-height:1.2em; }
    /* A note with nothing in it yet (the common case for pw-note before any
       sign-in attempt) shouldn't reserve its line-height + margin — that dead
       space was most of the gap Pierce flagged between the subtitle and the
       passkey button. Collapses automatically once JS fills in a message. */
    .send .note:empty{ margin:0; min-height:0; }
    .send .note.is-error{ color:var(--err); }
    .send .note.is-ok{ color:var(--ok); }

    /* Sits below the sign-in card, centered under it the way the card's own
       content is centered. Margin overrides .note's own 0.7rem: this sits
       outside the card now, so it needs a little more air than a note packed
       directly under a field. Size and color match .srow-expiry's "expires in
       N days" line rather than the client-facing /receive note — this is a
       heads-up about a security event (getting timed out), so it takes the
       same warm --warn tone as the other "pay attention" text on this page,
       not the quiet --ink-soft of a status line (Pierce, 2026-07-29). */
    .send .idle-note{ text-align:center; font-family:'Diatype Mono', monospace;
      font-size:.74rem; line-height:1.75; color:var(--warn); margin:1.1rem 0 0; }

    .send .copy-row{ display:flex; gap:10px; }
    .send .copy-row .txt{ flex:1 1 auto; min-width:0; }

    /* ------------------------------------------------- client picker --- */
    /* Round profile pictures, three sizes: -sm sits beside each recent-share
       row, -md in the picker menu and the field chip, -xl in the modal.
       Initials fill in when a client has no photo — tinted with the page's
       one blue so they read as part of the palette, never as a broken image. */
    .send .avatar{ display:inline-flex; align-items:center; justify-content:center;
      border-radius:50%; overflow:hidden; flex:0 0 auto; user-select:none;
      background:rgba(143,194,242,.14); color:var(--accent-soft);
      border:1px solid var(--line); font-family:'Diatype Mono', monospace; }
    .send .avatar img{ width:100%; height:100%; object-fit:cover; display:block; }
    .send .avatar-sm{ width:22px; height:22px; font-size:.56rem; letter-spacing:.04em; }
    .send .avatar-md{ width:30px; height:30px; font-size:.64rem; letter-spacing:.04em; }
    .send .avatar-xl{ width:96px; height:96px; font-size:1.5rem; letter-spacing:.06em; }

    .send .client-row{ position:relative; }
    /* Chip inside the field's left edge; the input pads over to make room.
       It's a button — clicking it opens the photo modal for the selection. */
    .send .client-chip{ position:absolute; left:11px; top:50%; transform:translateY(-50%);
      z-index:2; padding:0; margin:0; background:none; border:none; cursor:pointer;
      display:inline-flex; border-radius:50%; }
    .send .client-chip .avatar{ transition:border-color var(--dur-s) var(--ease-standard),
      box-shadow var(--dur-s) var(--ease-standard); }
    .send .client-chip:hover .avatar{ border-color:var(--accent-soft);
      box-shadow:0 0 12px rgba(143,194,242,.35); }
    .send .client-txt{ padding-right:44px; }
    .send .client-txt.has-chip{ padding-left:52px; }
    .send .client-caret{ position:absolute; right:6px; top:50%; transform:translateY(-50%);
      width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center;
      padding:0; background:none; border:none; border-radius:8px; cursor:pointer;
      color:var(--ink-soft); transition:color var(--dur-s) var(--ease-standard),
      transform var(--dur-s) var(--ease-standard); }
    .send .client-caret:hover{ color:var(--ink); }
    .send .client-caret.open{ transform:translateY(-50%) rotate(180deg); }

    /* The menu floats over whatever is beneath the field rather than pushing
       it down — same surface treatment as the cards, one step lifted. */
    .send .client-menu{ position:absolute; left:0; right:0; top:calc(100% + 6px); z-index:30;
      list-style:none; margin:0; padding:6px; max-height:264px; overflow-y:auto;
      /* Reaching the end of the list must not hand the wheel to the page —
         with the menu open, page scroll under the pointer reads as breakage. */
      overscroll-behavior:contain;
      background:var(--card); border:1px solid var(--line-strong); border-radius:10px;
      box-shadow:0 18px 44px rgba(0,0,0,.5); }
    .send .client-opt{ display:flex; align-items:center; gap:12px; padding:9px 10px;
      border-radius:7px; cursor:pointer; font-size:.94rem; color:var(--ink); }
    .send .client-opt:hover, .send .client-opt.is-active{ background:rgba(213,230,228,.08); }
    .send .client-opt .co-name{ flex:1 1 auto; min-width:0; overflow:hidden;
      text-overflow:ellipsis; white-space:nowrap; line-height:1.5; }
    /* Quiet "already saved" tick on the row that exactly matches the field. */
    .send .client-opt .co-check{ flex:0 0 auto; color:var(--ok); display:inline-flex; }
    /* Edit affordance per saved row — appears the moment the row is hovered
       (started as a 3s dwell; Pierce, 2026-08-08: "change the 3 second hover
       to immediate"). Pure CSS, no timer. Sits where the checkmark does,
       next to it when both show. */
    .send .client-opt .co-edit{ flex:0 0 auto; opacity:0; pointer-events:none;
      background:none; border:1px solid var(--line-strong); border-radius:999px;
      color:var(--ink-soft); font-family:'Diatype Mono', monospace; font-size:.62rem;
      letter-spacing:.1em; text-transform:uppercase; padding:4px 11px; cursor:pointer;
      transition:opacity var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard),
        border-color var(--dur-s) var(--ease-standard); }
    .send .client-opt:hover .co-edit{ opacity:1; pointer-events:auto; }
    .send .client-opt .co-edit:hover{ color:var(--ink); border-color:var(--ink); }
    @media (prefers-reduced-motion:reduce){ .send .client-opt .co-edit{ transition:none; } }
    /* The "add new" row sits under a hairline when saved clients are above it;
       its circle is dashed — a photo slot not yet filled. */
    .send .client-opt.co-add{ color:var(--accent-soft); }
    .send .client-opt.co-add .avatar{ background:none; border-style:dashed;
      border-color:rgba(143,194,242,.55); color:var(--accent-soft); font-family:inherit;
      font-size:1rem; line-height:1; }
    .send .client-menu .co-rule{ height:1px; background:var(--line); margin:6px 4px; }
    .send .client-menu .co-empty{ padding:10px 12px; font-size:.84rem; color:var(--ink-soft); }

    /* Recent shares: the picture sits before the client name so the list
       scans by face first, name second. */
    .send .srow-client .avatar{ margin-right:.1rem; }

    /* ---------------------------------------------------- client modal --- */
    .send .cmodal{ position:fixed; inset:0; z-index:9999997; display:flex;
      align-items:center; justify-content:center; padding:24px; }
    .send .cmodal-backdrop{ position:absolute; inset:0; background:rgba(5,8,7,.72);
      backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px); }
    .send .cmodal-card{ position:relative; width:min(400px, 100%);
      background:var(--card); border:1px solid var(--line-strong); border-radius:12px;
      padding:30px 30px 26px; box-shadow:0 28px 70px rgba(0,0,0,.6);
      display:flex; flex-direction:column; }
    .send .cmodal-card .group-title{ margin-bottom:1.5rem; }
    /* The photo well: one big tap target — circle plus caption both open the
       file picker. Dashed until a photo is in, solid after. */
    .send .cmodal-pic{ align-self:center; display:flex; flex-direction:column; align-items:center;
      gap:.7rem; padding:0 0 1.6rem; margin:0; background:none; border:none; cursor:pointer; }
    .send .cmodal-pic .avatar-xl{ border-style:dashed; border-color:rgba(143,194,242,.55);
      transition:border-color var(--dur-s) var(--ease-standard), box-shadow var(--dur-s) var(--ease-standard); }
    .send .cmodal-pic .avatar-xl.has-img{ border-style:solid; border-color:var(--line-strong); }
    .send .cmodal-pic:hover .avatar-xl{ border-color:var(--accent-soft);
      box-shadow:0 0 22px rgba(143,194,242,.3); }
    .send .cmodal-pic.is-over .avatar-xl{ border-color:var(--accent-soft);
      box-shadow:0 0 22px rgba(143,194,242,.4); }
    .send .cmodal-pic-hint{ font-family:'Diatype Mono', monospace; font-size:.7rem;
      letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); }
    .send .cmodal-pic:hover .cmodal-pic-hint{ color:var(--ink); }
    /* Crop mode: the circle is a drag surface, so the cursor says so and the
       canvas fills it edge to edge. touch-action:none lets one-finger drags
       reposition on touch instead of scrolling the page behind the modal. */
    .send .cmodal-pic.is-cropping{ cursor:grab; touch-action:none; }
    .send .cmodal-pic.is-cropping:active{ cursor:grabbing; }
    .send .cmodal-pic canvas{ width:100%; height:100%; display:block; }
    /* Zoom row under the circle — mono glyphs either side of a thin slider,
       restyled to the page's tokens (the UA range control is grey-on-grey
       here). Sized to the circle above it, not the card. */
    .send .cmodal-crop{ align-self:center; display:flex; align-items:center; gap:10px;
      width:200px; margin:-0.5rem 0 1.4rem; color:var(--ink-soft); }
    .send .cmodal-zoom{ flex:1 1 auto; appearance:none; -webkit-appearance:none;
      height:3px; border-radius:2px; background:var(--line-strong); outline:none; cursor:pointer; }
    .send .cmodal-zoom::-webkit-slider-thumb{ appearance:none; -webkit-appearance:none;
      width:16px; height:16px; border-radius:50%; background:var(--cta);
      border:none; box-shadow:0 0 10px rgba(143,194,242,.35); cursor:grab; }
    .send .cmodal-zoom::-webkit-slider-thumb:active{ cursor:grabbing; }
    .send .cmodal-zoom::-moz-range-thumb{ width:16px; height:16px; border-radius:50%;
      background:var(--cta); border:none; box-shadow:0 0 10px rgba(143,194,242,.35); cursor:grab; }
    .send .cmodal-zoom:focus-visible{ outline:2px solid var(--accent); outline-offset:4px; }
    .send .cmodal-actions{ justify-content:flex-end; }
    /* Delete stands apart on the left — it shouldn't read as a sibling of
       Save/Cancel, and the gap makes a mis-tap that much harder. */
    .send .cmodal-actions #cmodal-delete{ margin-right:auto; }

    /* -------------------------------------------------------- drop zone --- */
    .send .drop{ border:1.5px dashed var(--line-strong); border-radius:10px; padding:28px 16px;
      text-align:center; color:var(--ink-soft); font-size:.94rem; cursor:pointer;
      transition:border-color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard); }
    .send .drop:hover, .send .drop:focus-visible{ border-color:var(--accent); color:var(--ink); }
    .send .drop.is-over{ border-color:var(--accent); background:rgba(213,230,228,.07); color:var(--ink); }

    /* Expiry pills — same component as /brief's single-select pills, in this
       page's tokens. The <label>.on class is kept in sync by JS so the styling
       doesn't depend on :has() support. */
    .send .expiry-set{ border:0; margin:0; padding:0; min-width:0; }
    .send .pills{ display:flex; flex-wrap:wrap; gap:10px; margin-top:.85rem; }
    .send .pill{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
      border-radius:999px; padding:10px 18px; font-size:.92rem; color:var(--ink); background:var(--field);
      transition:transform var(--dur-xs) var(--ease-press),border-color var(--dur-s) var(--ease-standard),color var(--dur-s) var(--ease-standard),background var(--dur-s) var(--ease-standard); }
    .send .pill:hover{ border-color:var(--ink); }
    .send .pill:active{ transform:scale(.96); }
    .send .pill input{ position:absolute; opacity:0; pointer-events:none; }
    .send .pill:focus-within{ outline:2px solid var(--accent); outline-offset:2px; }
    .send .pill.on{ border-color:var(--accent); background:var(--accent); color:var(--deep); font-weight:500; }
    @media (prefers-reduced-motion:reduce){ .send .pill{ transition:none; } }

    .send .filelist{ list-style:none; margin:1rem 0 0; padding:0; display:flex; flex-direction:column; gap:8px; }
    .send .filelist:empty{ margin:0; }
    .send .frow{ position:relative; overflow:hidden; display:flex; align-items:center; gap:12px;
