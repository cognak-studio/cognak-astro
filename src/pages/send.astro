---
/**
 * /send — hidden, password-protected client-delivery tool.
 * Not in nav, footer, or sitemap; noindex. Same "unlinked utility" model as
 * /tools, but gated behind ADMIN_PASSWORD (see api/_lib/adminAuth.mjs)
 * because this one handles real client files, not a stateless generator.
 *
 * Flow: sign in once (12h session cookie) -> name a client + set a passcode
 * -> drop files (uploaded straight to Vercel Blob via api/deliver-upload-
 * token.js, same client-upload handshake /brief already uses) -> get back a
 * cognak.com/files/<token> link + the passcode to send the client, instead of a
 * Hightail link. Recent shares are listed below with a delete action.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="send"
  title="Send – COGNAK"
  description="Internal client-delivery tool."
  ogUrl="https://cognak.com/send/"
  noindex={true}
  pageBg="#090C0B"
>
  <div class="send-webgl" data-us-project="PWb8s0lxglpnSGUgkkIR" aria-hidden="true"></div>

  <main id="cognak-main"><section class="send">

    {/* Kept on one source line, same as /tools: the word-splitter turns the
        text nodes either side of the <em> into spans, and a newline there is
        swallowed rather than kept as the space after "Send". */}
    <h1 class="headline send-headline"><em>Send</em> files to clients, no third-party link required.</h1>
    <p class="lede send-lede">Add details, drop files, and set a passcode. The client gets a cognak.com link so nothing leaves this domain.</p>

    <!-- ------------------------------------------------------- sign in --- -->
    {/* Passkey shows first paint, no flash — but the password fallback is
        NOT deleted: it's how [[send-lockout-recovery]] gets Pierce back in
        when ADMIN_PASSWORD_FALLBACK=1 is set after a lost device. The old
        bug wasn't the fallback logic (initGate() below is unchanged and was
        already correct) — it was that .btn{display:inline-flex} outranks the
        browser's own [hidden]{display:none} default (author CSS beats the UA
        sheet regardless of selector specificity), so hidden=true on these
        buttons never actually hid them; all three always rendered regardless
        of server state, including before initGate()'s fetch resolved. Fixed
        with the .send [hidden] rule in the stylesheet below. The remaining
        change here is just the DEFAULT markup state pre-JS: passkey-signin
        starts visible and everything else starts hidden, so first paint
        already matches the common case instead of a mid-load flash. */}
    <div class="acard rise" id="gate">
      <div class="group">
        {/* Icon badge + subtitle, added 2026-07-28 — a single centered pill
            button under the bare "SIGN IN" mono label read as unfinished
            once the password field (which used to fill this space) came out.
            Same accent-soft blue as the headline <em> and the CTA glow, so
            it reads as part of the existing palette rather than a new one. */}
        <div class="signin-head">
          {/* Pierce's second passkey mark (passkey.eps, replacing the first
              one, converted 2026-07-28 the same way: gs -> PDF -> pdftocairo
              -svg, fills swapped to currentColor. Native aspect ratio
              179.3:240.66 preserved via viewBox. The .signin-icon-shimmer
              overlay is new too — a radial highlight orbiting the icon on
              the same 3.4s cadence and rgba(213,230,228,.9)->
              rgba(143,194,242,x)->transparent colors as the ring's conic
              gradient below, so the two read as one synced light system
              rather than two independent animations. */}
          <span class="signin-icon" aria-hidden="true">
            <svg viewBox="0 0 179.3 240.66" width="30" height="40.3">
              <defs>
                <clipPath id="signin-icon-clip-0"><path clip-rule="nonzero" d="M 19 57 L 178.601562 57 L 178.601562 240.023438 L 19 240.023438 Z M 19 57 "/></clipPath>
                <clipPath id="signin-icon-clip-1"><path clip-rule="nonzero" d="M 11 0.296875 L 130 0.296875 L 130 41 L 11 41 Z M 11 0.296875 "/></clipPath>
              </defs>
              <g clip-path="url(#signin-icon-clip-0)">
                <path fill-rule="nonzero" fill="currentColor" d="M 93.210938 115.222656 C 107.15625 113.523438 121.269531 124.769531 125.609375 138.671875 C 128.976562 149.453125 130.324219 160.707031 129.890625 172.015625 L 129.421875 177.101562 C 128.40625 188.171875 125.367188 198.511719 120.59375 208.507812 C 114.390625 221.492188 104.683594 232.160156 92.285156 239.300781 C 90.722656 240.199219 88.964844 240.25 87.304688 239.507812 C 84.859375 238.414062 83.339844 231.871094 87.355469 229.390625 C 94.808594 224.789062 101.617188 219.304688 106.65625 212.03125 C 120.460938 192.113281 123.679688 169.105469 118.558594 145.683594 C 116.875 137.996094 112.269531 131.546875 105.453125 128.101562 C 95.28125 122.960938 84.210938 127.757812 79.992188 138.164062 C 77.585938 144.097656 78.101562 150.21875 79.207031 156.652344 C 80.984375 166.964844 78.5 177.152344 71.722656 184.929688 C 65.304688 192.292969 55.84375 195.335938 46.214844 192.53125 C 36.824219 189.800781 29.070312 182.703125 24.90625 173.75 C 21.015625 165.375 20.246094 156.496094 19.28125 147.484375 C 18.894531 143.898438 19.230469 140.582031 19.324219 137.050781 C 19.792969 119.679688 24.859375 103.386719 34.246094 88.847656 C 47.601562 68.15625 70.234375 55.625 95.242188 57.285156 C 111.503906 58.363281 127.011719 64.664062 139.75 74.667969 C 157.949219 88.957031 171.753906 113.613281 175.6875 136.261719 L 177.445312 146.371094 L 178.519531 157.671875 L 178.601562 182.433594 C 178.609375 184.136719 176.882812 185.382812 175.796875 185.554688 C 174.3125 185.789062 172.179688 185.769531 171.382812 184.464844 C 169.703125 181.730469 169.980469 178.875 169.96875 175.921875 L 169.882812 156.910156 C 168.867188 146.136719 167.101562 135.972656 163.886719 125.703125 C 156.734375 102.855469 140.828125 84.148438 119.089844 74.0625 C 108.386719 69.09375 97.011719 67.144531 85.339844 68.75 C 72.542969 70.503906 60.722656 75.484375 51.402344 84.621094 C 38.253906 97.511719 30.488281 114.777344 28.472656 133.175781 C