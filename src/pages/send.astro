      -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat;
      -webkit-mask-position:center; mask-position:center;
      background:conic-gradient(from var(--spin-angle,0deg),
        rgba(143,194,242,0) 0deg, rgba(143,194,242,0) 250deg,
        rgba(213,230,228,.95) 300deg, rgba(143,194,242,1) 328deg,
