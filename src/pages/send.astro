---
/**
 * /send — hidden, password-protected client-delivery tool.
 * Not in nav, footer, or sitemap; noindex. Same "unlinked utility" model as
 * /tools, but gated behind ADMIN_PASSWORD (see api/_lib/adminAuth.mjs)
 * because this one handles real client files, not a stateless generator.
 *
 * Sign-in lives on /admin (2026-09-27): a signed-out visit is sent to
 * /admin?next=/send and comes back here once the session cookie is set.
 *
 * Flow: sign in once (1-week session cookie) -> name a client -> drop files
 * (uploaded straight to Vercel Blob via api/deliver-upload-token.js, same
 * client-upload handshake /brief already uses) -> get back a
 * cognak.com/files/<token> link to send the client, instead of a Hightail
 * link. Recent shares are listed below with a delete action. No passcode any
 * more (removed 2026-07-29) — the link itself is the credential, matching
 * /receive, which had already stopped checking one.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="send"
  title="Send – COGNAK"
  description="Internal client-delivery tool."
  ogUrl="https://cognak.com/send/"
  noindex={true}
  pageBg="#090C0B"
>
  <div class="send-webgl" data-us-project="PWb8s0lxglpnSGUgkkIR" aria-hidden="true"></div>

  <script is:inline>
    /* No flash before the redirect: unless this browser was signed in last
       time (a hint /admin and this page keep in localStorage — a paint
       hint only, the server still decides), hold the page back until
       checkAuth() hears back. Failsafe lifts it after 5s regardless. */
    (function () {
      try {
        if (localStorage.getItem('cognak-admin-hint') !== '1') {
          var root = document.documentElement;
          root.classList.add('send-auth-pending');
          setTimeout(function () { root.classList.remove('send-auth-pending'); }, 5000);
        }
      } catch (e) {}
    })();
  </script>

  <main id="cognak-main"><section class="send">

    {/* Kept on one source line, same as /tools: the word-splitter turns the
        text nodes either side of the <em> into spans, and a newline there is
        swallowed rather than kept as the space after "Send". */}
    <h1 class="headline send-headline"><em>Send</em> files.</h1>
    <p class="lede send-lede">Add details, drop files, and get a cognak.com link for clients.</p>

    {/* Sign-in moved to /admin (2026-09-27). A signed-out visitor is sent to
        /admin?next=/send by checkAuth() below, with the page held back by the
        inline script above <main> so nothing paints first. */}
    {/* Status line above the dashboard — e.g. the share list failing to load. */}
    <p class="note idle-note" id="idle-note" role="status" aria-live="polite"></p>

    <!-- ------------------------------------------------------ dashboard --- -->
    <div id="dash" hidden>

      {/* This card is also the EDITOR for a share that's already been sent —
          the Edit button on a Recent shares row fills it in and swaps three
          things (title, expiry control, button row). Same fields, same
          uploader, same validation, because "add the file I forgot" is the
          same act as adding it in the first place, and a second card would be
          a second place for the two to drift apart. enterEdit()/setMode()
          below are the whole of the difference. */}
      <div class="acard rise" id="new-share">
        <div class="group">
          <div class="group-title" id="new-share-title">New share</div>
          {/* Which share is being edited. The link is the share's name as far
              as the client is concerned, so it's the thing worth showing. */}
          <p class="edit-target mono" id="edit-target" hidden></p>

          <div class="field">
            <label class="q" for="client-input">
              <span class="q-title">Client</span>
              <span class="q-sub">Pick a saved client, or type a new name.</span>
            </label>
            {/* Combobox over the saved-clients address book (api/clients.js).
                The input stays a free-text field — a one-off recipient never
                has to be saved — but saved clients surface in a menu beneath
                it, each with their round profile picture, and an unmatched
                name gets an "add as new client" row that opens the photo
                modal. The chip on the left of the field shows the current
                selection's picture (or initials) and doubles as the "edit
                photo" button for a saved client. */}
            <div class="client-row" id="client-row">
              <button type="button" class="client-chip" id="client-chip" hidden
                      aria-label="Edit client photo"></button>
              <input class="txt client-txt" id="client-input" type="text" autocomplete="off"
                     role="combobox" aria-expanded="false" aria-controls="client-menu"
                     aria-autocomplete="list" aria-haspopup="listbox" />
              <button type="button" class="client-caret" id="client-caret" tabindex="-1"
                      aria-label="Show saved clients">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>
              {/* data-lenis-prevent is what makes this scrollable AT ALL:
                  Lenis captures wheel events site-wide and scrolls the page,
                  so a nested overflow panel never sees them without this
                  opt-out (Pierce, 2026-08-08: "the clients aren't
                  scrollable"). */}
              <ul class="client-menu" id="client-menu" role="listbox" aria-label="Saved clients"
                  data-lenis-prevent hidden></ul>
            </div>
          </div>

          <div class="field">
            <label class="q" for="project-input">
              <span class="q-title">Project details</span>
              <span class="q-sub">Shown to the client on the download page.</span>
            </label>
            <input class="txt" id="project-input" type="text" autocomplete="off" />
          </div>

          <div class="field" id="expiry-field">
            <fieldset class="q expiry-set">
              <legend class="q">
                <span class="q-title">Link expiry</span>
                <span class="q-sub">Choose how long the link is live for before automatic deletion.</span>
              </legend>
              {/* Capped at 90 days, deliberately no "1 year" or "Never" option
                  anymore — Pierce, 2026-07-28: with expiry as the only thing
                  that gets a forgotten share off Blob storage, an indefinite
                  option meant links (and their files) could sit there forever
                  if nobody circled back to delete them. 90 days is generous
                  slack for any real client hand-off while still guaranteeing
                  the daily sweep clears everything out on a bounded horizon. */}
              <div class="pills" id="expiry-pills">
                <label class="pill on"><input type="radio" name="expiry" value="7" checked>1 week</label>
                <label class="pill"><input type="radio" name="expiry" value="30">1 month</label>
                <label class="pill"><input type="radio" name="expiry" value="90">3 months</label>
              </div>
            </fieldset>
          </div>

          {/* Expiry in edit mode: shown, not hidden. It's the one property of
              a sent share that can't be changed (api/deliver-update.js has the
              reasoning — an edit that re-armed the countdown would let a share
              outlive the 7/30/90 cap by way of small corrections), and the
              answer to "why can't I change this" is easier to see than to
              remember. */}
          <div class="field" id="edit-expiry-field" hidden>
            <div class="q">
              <span class="q-title">Link expiry</span>
              <span class="q-sub">Fixed when the share was created — editing doesn’t restart it.</span>
            </div>
            <p class="srow-expiry" id="edit-expiry" role="status" aria-live="polite"></p>
          </div>

          <div class="field">
            <label class="q" for="drop-input">
              <span class="q-title">Files</span>
            </label>
            <div class="drop" id="drop" tabindex="0" role="button" aria-describedby="drop-hint">
              <span id="drop-hint">Drag files here, or click to choose</span>
              <input type="file" id="drop-input" multiple hidden />
            </div>
            <ul class="filelist" id="filelist"></ul>
          </div>
        </div>

        <p class="note" id="create-note" role="status" aria-live="polite"></p>

        <div class="actions">
          <button type="button" class="btn btn-primary" id="create-btn" disabled>Create share</button>
          <button type="button" class="btn btn-ghost" id="cancel-edit" hidden>Cancel</button>
        </div>
      </div>

      <div class="acard rise" id="success" hidden>
        <div class="group">
          <div class="group-title">Ready to send</div>
          <div class="field">
            <label class="q"><span class="q-title">Link</span></label>
            <div class="copy-row">
              <input class="txt mono" id="out-link" type="text" readonly />
              <button type="button" class="btn btn-ghost" data-copy="out-link" aria-label="Copy link">Copy</button>
            </div>
          </div>
        </div>
        <div class="actions">
          <button type="button" class="btn" id="start-another">Share another link</button>
        </div>
      </div>

      <div class="acard rise" id="shares-card">
        <div class="group">
          <div class="group-title">Recent shares</div>
          <p class="note" id="shares-empty">Nothing sent yet.</p>
          <ul class="shares" id="shares-list"></ul>
        </div>
      </div>

      <div class="acard rise" id="security-card">
        {/* Collapsible, added 2026-07-28 — this card is set-and-forget most
            visits (check the device list once, then never touch it again),
            so it can fold away instead of always claiming a full card's
            worth of vertical space above Sign out. group-title moved out of
            .group and into its own header row so the +/- toggle can sit at
            top-right of the CARD, not just the text baseline. Body content
            is one wrapper so hidden can collapse/expand it all at once —
            safe now that .send [hidden] actually works (see the sign-in gate
            comment above for why that wasn't always true). */}
        <div class="card-head">
          <div class="group-title">Sign-in security</div>
          {/* Starts collapsed (Pierce, 2026-07-28: "make registered devices
              default to collapsed") -- the passkey list is something you
              check on, not something you need on every visit to the
              dashboard, so it stays out of the way until asked for. */}
          <button type="button" class="collapse-toggle" id="security-toggle"
                  aria-expanded="false" aria-controls="security-body" aria-label="Expand sign-in security">
            <span class="toggle-glyph" aria-hidden="true">&plus;</span>
          </button>
        </div>
        <div class="group" id="security-body" hidden>
          <p class="note" id="pk-note" role="status" aria-live="polite"></p>
          <ul class="shares" id="pk-list"></ul>
          <p class="note" id="pk-empty">No passkeys yet — the password is currently the only way in.</p>
          <div class="actions">
            <button type="button" class="btn btn-primary" id="pk-add">Add this device</button>
          </div>
        </div>
      </div>

      <div class="actions signout-row">
        <button type="button" class="btn btn-ghost" id="signout-btn">Sign out</button>
      </div>

      {/* Save-client modal — reached from the client picker ("add … as a new
          client", or the chip on a saved client to change their photo). The
          photo is optional both ways: "Save without photo" is a real path,
          not a failure state. Lives inside #dash so signing out takes it off
          screen with everything else. */}
      <div class="cmodal" id="client-modal" hidden>
        <div class="cmodal-backdrop" id="cmodal-backdrop"></div>
        <div class="cmodal-card" role="dialog" aria-modal="true" aria-labelledby="cmodal-title">
          <div class="group-title" id="cmodal-title">New client</div>
          <button type="button" class="cmodal-pic" id="cmodal-pic">
            <span class="avatar avatar-xl" id="cmodal-avatar"></span>
            <span class="cmodal-pic-hint" id="cmodal-pic-hint">Add photo</span>
          </button>
          {/* Crop controls, shown once a photo is in: the circle above becomes
              a live crop stage (drag to reposition) and this slider zooms.
              What the circle shows is exactly what gets saved. */}
          <div class="cmodal-crop" id="cmodal-crop" hidden>
            <span class="cmodal-zoom-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.2-4.2"/><path d="M8.5 11h5"/></svg>
            </span>
            <input type="range" class="cmodal-zoom" id="cmodal-zoom" min="1" max="3" step="0.01" value="1" aria-label="Zoom photo" />
            <span class="cmodal-zoom-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.2-4.2"/><path d="M8.5 11h5"/><path d="M11 8.5v5"/></svg>
            </span>
          </div>
          <input type="file" id="cmodal-file" accept="image/png,image/jpeg,image/webp,image/avif,image/gif" hidden />
          <div class="field">
            <label class="q" for="cmodal-name">
              <span class="q-title">Name</span>
            </label>
            <input class="txt" id="cmodal-name" type="text" autocomplete="off" />
          </div>
          <p class="note" id="cmodal-note" role="status" aria-live="polite"></p>
          <div class="actions cmodal-actions">
            {/* Only when editing a saved client. Removes them from the address
                book; shares already sent stay exactly as they are. */}
            <button type="button" class="btn btn-ghost btn-danger" id="cmodal-delete" hidden>Delete</button>
            <button type="button" class="btn btn-primary" id="cmodal-save">Save client</button>
            <button type="button" class="btn btn-ghost" id="cmodal-cancel">Cancel</button>
          </div>
        </div>
      </div>
    </div>

  </section></main>

  <style is:inline>
    html, body { background-color:#090C0B !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }

    /* WebGL background (UnicornStudio, project PWb8s0lxglpnSGUgkkIR) — fixed
       behind #cognak-main, fades in once the canvas mounts. Same setup as
       /brief and /studio; skipped entirely on reduced-motion. Replaced the
       hand-drawn "transit" canvas (src/lib/send-background.js) on 2026-07-28. */
    .send-webgl{ position:fixed; inset:0; width:100vw; height:100vh; z-index:0;
      pointer-events:none; opacity:0; transition:opacity 1.6s var(--ease-standard); }
    .send-webgl.webgl-ready{ opacity:1; }
    @media (prefers-reduced-motion:reduce){ .send-webgl{ display:none; } }

    /* Dark teal colorway (6th revision, 2026-07-28), picked by Pierce off the
       colorway comparator and replacing the deep sage. Same light-on-dark
       structure as the sage pass — that decision still holds, see git history
       for why darkening the page while keeping dark text couldn't clear AA —
       but the hue moves off green onto teal and the whole page goes darker.

       The card is now a shade BELOW the page background rather than a
       translucent lift above it. Pierce's card-matches-nav rule is intact
       (--card and the nav bar are the same value); what changed is that both
       are opaque, so the transit dashes read around the cards instead of
       drifting under the text. That was an AA problem, not just taste.

       The card and nav dropped to #0E1413 once the WebGL scene went in — at
       #171E1D they read as grey panels floating on a near-black field.

       --bg is #090C0B rather than the teal it started as, matched to the
       scene's own near-black. The scene is fixed behind the content and fades
       in over 1.6s, so --bg is what's on screen until it mounts (and forever
       under prefers-reduced-motion, where it never mounts at all) — a lighter
       page colour meant a visible wash-to-dark on every load. The cards now
       sit just ABOVE the page rather than below it, which is the inverse of
       the earlier arrangement but keeps them legible against the scene.

       Contrast, measured against the card: ink 14.42, ink-soft/accent 11.61,
       placeholder 6.34, CTA label 15.62, accent-soft (the headline's blue)
       9.90, line-strong 4.62. Everything clears WCAG AA with room — the sage
       pass was scraping by at 3.02 on line-strong and 4.61 on ink-soft. */
    .send {
      --bg:#090C0B;
      --card:#0E1413; --field:rgba(0,0,0,0.28); --field-focus:rgba(0,0,0,0.40);
      --ink:#D5E6E4; --ink-soft:#BED0CD; --accent:#BED0CD; --accent-hi:#D5E6E4;
      --accent-soft:#8FC2F2; --deep:#151B1A; --line:rgba(213,230,228,0.18);
      --line-strong:rgba(213,230,228,0.52); --placeholder:#829C98;
      --ok:#8FE7B4; --err:#FFA79A;
      /* Warm orange-red for the expiry countdown — 7.26:1 on the card, so it
         clears WCAG AA (and AAA) while staying distinctly warmer than --err,
         which is reserved for genuine failure states. */
      --warn:#FF7A5C;
      /* The CTA is the one place the page departs from --ink — now the
         BRIGHTEST thing on the page rather than the darkest, since the page
         itself went dark. Same intent as the light pass: "Create share" /
         "Sign in" / "Unlock" sit clearly above the outline buttons. */
      --cta:#8FC2F2; --cta-hi:#A9D2F6;
      /* Fixed 190px, matching the shared header position across
         projects/studio/privacy/colophon/brief/tools. /send used to vertically
         center instead, which made it the one inner page whose headline didn't
         line up with the rest of the site — Pierce, 2026-07-28. The centering
         also meant the page visibly re-centered itself the moment the sign-in
         gate swapped for the taller dashboard; top-aligned, it doesn't move. */
      max-width:820px; margin:0 auto; padding:190px 6vw 22vh;
      color:var(--ink); font-family:'Diatype Variable', sans-serif;
    }
    @media (max-width:720px){ .send{ padding-top:100px; } }
    .send .mono{ font-family:'Diatype Mono', monospace; }

    .send label.q, .send legend.q{ display:block !important; }
    /* Same Ninja Forms leftover, same fix as /brief: screen.css carries a
       global `label{display:none!important}`, so every <label> this page uses
       has to opt back in explicitly. The expiry pills ARE labels — without
       this they collapse to nothing and the row renders as blank space. */
    .send label.pill{ display:inline-flex !important; align-items:center; }

    /* Site headline scale — clamp(20px,5.5vw,62px) desktop / clamp(24px,7vw,42px)
       under 720px, identical to .projects-display-headline, .colophon-headline,
       .tools .headline and .brief .headline. /send and /receive were the only
       inner pages running a smaller 52/38 ramp, so their headline read a size
       down from every other page at the same 190px top offset. */
    .send .headline{ font-size:clamp(20px,5.5vw,62px); font-weight:500; line-height:1.1;
      letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .send .headline em{ font-style:normal; font-weight:500; color:var(--accent-soft); }
    /* The tight 1.1rem was there to claw back space when the block was
       vertically centred and colliding with the cards. Now that the page is
       top-aligned on the 190px grid that pressure is gone, and the lede needs
       room to read as a separate block from the card below it. */
    .send .lede{ font-size:var(--fs-17); text-wrap:pretty; line-height:1.65; color:var(--ink-soft); max-width:56ch;
      margin:0 0 3.4rem 0; }
    @media (max-width:720px){ .send .headline{ font-size:clamp(24px,7vw,42px); } }
    html.js .send-headline, html.js .send-lede{ opacity:0; }
    @media (prefers-reduced-motion:reduce){
      html.js .send-headline, html.js .send-lede{ opacity:1; }
    }
    .send-lede .stagger-word{ transform:none; transition:opacity var(--dur-xl) var(--ease-standard); }

    .send .acard{ border-radius:10px; padding:34px 34px 30px;
      box-shadow:0 2px 18px rgba(0,0,0,.26); margin-bottom:1.6rem;
      /* Opaque, so the transit dashes can't drift under body text. That
         matters for more than taste: measured with a dash passing behind a
         card, contrast fell under the AA line — the page stopped passing AA
         for exactly as long as the animation took to cross. The animation now
         reads around the cards, not through them. (backdrop-filter was tried
         and rejected: it softens the shift without removing it, and costs a
         full-viewport blur every frame.) */
      background:var(--card);
    }
    @media (max-width:600px){ .send .acard{ padding:24px 20px 22px; } }

    .send .group-title{ font-family:'Diatype Mono', monospace; font-size:var(--fs-11); letter-spacing:.2em;
      text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.9rem; }

    /* ------------------------------------------------------- collapsible card --- */
    /* Sign-in security card only, added 2026-07-28: title + +/- toggle share a
       row so the toggle sits top-right of the CARD, not just the text
       baseline. group-title's own margin-bottom is cancelled here since the
       row itself carries the spacing down to #security-body. */
    .send .card-head{ display:flex; align-items:center; justify-content:space-between;
      margin-bottom:1.9rem; }
    .send .card-head .group-title{ margin-bottom:0; }
    .send .collapse-toggle{ flex:0 0 auto; width:28px; height:28px; border-radius:999px;
      display:inline-flex; align-items:center; justify-content:center; padding:0;
      background:none; color:var(--ink-soft); border:1px solid var(--line-strong);
      cursor:pointer; transition:border-color var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard); }
    .send .collapse-toggle:hover{ border-color:var(--accent); color:var(--ink); }
    .send .collapse-toggle .toggle-glyph{ font-family:'Diatype Mono', monospace; font-size:var(--fs-16);
      line-height:1; transform:translateY(-.5px); }

    .send .btn .btn-icon{ display:inline-flex; opacity:.92; }
    .send .btn .btn-icon svg{ display:block; }

    .send .field{ margin-bottom:1.8rem; }
    .send .field:last-child{ margin-bottom:0; }
    .send .q{ display:block; margin-bottom:.85rem; padding:0; }
    .send .q-title{ display:block; font-size:var(--fs-16); font-weight:500; line-height:1.3; color:var(--ink); }
    .send .q-sub{ display:block; font-size:var(--fs-14); font-weight:450; line-height:1.4; color:var(--ink-soft); margin-top:.2rem; max-width:54ch; }

    .send .txt{
      width:100%; box-sizing:border-box; margin:0;
      background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:var(--fs-16); line-height:1.5; padding:14px 16px;
      transition:border-color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard); outline:none; }
    .send .txt::placeholder{ color:var(--placeholder); }

    /* Typed text was going illegible: WebKit paints autofilled fields with its
       own dark-on-pale treatment, and on a dark field that lands as near-black
       on near-black. -webkit-text-fill-color is the only thing that overrides
       the text colour there (plain `color` is ignored), and the giant inset
       shadow is the standard way to repaint the background, since
       background-color is likewise overridden. The absurd transition delay
       stops WebKit animating its yellow back in on re-focus. */
    .send .txt, .receive .txt{ -webkit-text-fill-color:var(--ink); caret-color:var(--accent); }
    .send .txt:-webkit-autofill,
    .send .txt:-webkit-autofill:hover,
    .send .txt:-webkit-autofill:focus,
    .send .txt:-webkit-autofill:active,
    .receive .txt:-webkit-autofill,
    .receive .txt:-webkit-autofill:hover,
    .receive .txt:-webkit-autofill:focus,
    .receive .txt:-webkit-autofill:active{
      -webkit-text-fill-color:var(--ink) !important;
      caret-color:var(--accent);
      -webkit-box-shadow:0 0 0 1000px var(--field) inset !important;
      box-shadow:0 0 0 1000px var(--field) inset !important;
      transition:background-color 9999s ease-out 0s; }

    .send .txt:focus{ border-color:var(--accent); background:var(--field-focus); }
    .send .txt[readonly]{ cursor:text; }
    .send a:focus-visible, .send button:focus-visible, .send input:focus-visible,
    .send [tabindex]:focus-visible{ outline-color:var(--accent) !important; }

    /* The link of the share being edited, under the "Edit share" title. Sits
       in the space group-title's own margin was holding, so it doesn't push
       the first field down when it appears — it takes the gap rather than
       adding to it. Blue, because that is the URL colour everywhere on these
       two pages (--accent-soft is the <em> in "Send files" and the word
       "files" in the link itself). */
    .send .edit-target{ margin:-1.2rem 0 1.9rem; font-size:var(--fs-12); line-height:1.4;
      color:var(--accent-soft); word-break:break-all; }
    .send .edit-target[hidden]{ display:none; }

    .send .note{ margin:.7rem 0 0; font-size:var(--fs-13); line-height:1.45; color:var(--ink-soft); min-height:1.2em; }
    /* A note with nothing in it yet (the common case for pw-note before any
       sign-in attempt) shouldn't reserve its line-height + margin — that dead
       space was most of the gap Pierce flagged between the subtitle and the
       passkey button. Collapses automatically once JS fills in a message. */
    .send .note:empty{ margin:0; min-height:0; }
    .send .note.is-error{ color:var(--err); }
    .send .note.is-ok{ color:var(--ok); }

    /* Sits below the sign-in card, centered under it the way the card's own
       content is centered. Margin overrides .note's own 0.7rem: this sits
       outside the card now, so it needs a little more air than a note packed
       directly under a field. Size and color match .srow-expiry's "expires in
       N days" line rather than the client-facing /receive note — this is a
       heads-up about a security event (getting timed out), so it takes the
       same warm --warn tone as the other "pay attention" text on this page,
       not the quiet --ink-soft of a status line (Pierce, 2026-07-29). */
    .send .idle-note{ text-align:center; font-family:'Diatype Mono', monospace;
      font-size:var(--fs-12); line-height:1.75; color:var(--warn); margin:1.1rem 0 0; }

    .send .copy-row{ display:flex; gap:10px; }
    .send .copy-row .txt{ flex:1 1 auto; min-width:0; }

    /* ------------------------------------------------- client picker --- */
    /* Round profile pictures, three sizes: -sm sits beside each recent-share
       row, -md in the picker menu and the field chip, -xl in the modal.
       Initials fill in when a client has no photo — tinted with the page's
       one blue so they read as part of the palette, never as a broken image. */
    .send .avatar{ display:inline-flex; align-items:center; justify-content:center;
      border-radius:50%; overflow:hidden; flex:0 0 auto; user-select:none;
      background:rgba(143,194,242,.14); color:var(--accent-soft);
      border:1px solid var(--line); font-family:'Diatype Mono', monospace; }
    .send .avatar img{ width:100%; height:100%; object-fit:cover; display:block; }
    .send .avatar-sm{ width:22px; height:22px; font-size:var(--fs-9); letter-spacing:.04em; }
    .send .avatar-md{ width:30px; height:30px; font-size:var(--fs-10); letter-spacing:.04em; }
    .send .avatar-xl{ width:96px; height:96px; font-size:1.5rem; letter-spacing:.06em; }

    .send .client-row{ position:relative; }
    /* Chip inside the field's left edge; the input pads over to make room.
       It's a button — clicking it opens the photo modal for the selection. */
    .send .client-chip{ position:absolute; left:11px; top:50%; transform:translateY(-50%);
      z-index:2; padding:0; margin:0; background:none; border:none; cursor:pointer;
      display:inline-flex; border-radius:50%; }
    .send .client-chip .avatar{ transition:border-color var(--dur-s) var(--ease-standard),
      box-shadow var(--dur-s) var(--ease-standard); }
    .send .client-chip:hover .avatar{ border-color:var(--accent-soft);
      box-shadow:0 0 12px rgba(143,194,242,.35); }
    .send .client-txt{ padding-right:44px; }
    .send .client-txt.has-chip{ padding-left:52px; }
    .send .client-caret{ position:absolute; right:6px; top:50%; transform:translateY(-50%);
      width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center;
      padding:0; background:none; border:none; border-radius:8px; cursor:pointer;
      color:var(--ink-soft); transition:color var(--dur-s) var(--ease-standard),
      transform var(--dur-s) var(--ease-standard); }
    .send .client-caret:hover{ color:var(--ink); }
    .send .client-caret.open{ transform:translateY(-50%) rotate(180deg); }

    /* The menu floats over whatever is beneath the field rather than pushing
       it down — same surface treatment as the cards, one step lifted. */
    .send .client-menu{ position:absolute; left:0; right:0; top:calc(100% + 6px); z-index:30;
      list-style:none; margin:0; padding:6px; max-height:264px; overflow-y:auto;
      /* Reaching the end of the list must not hand the wheel to the page —
         with the menu open, page scroll under the pointer reads as breakage. */
      overscroll-behavior:contain;
      background:var(--card); border:1px solid var(--line-strong); border-radius:10px;
      box-shadow:0 18px 44px rgba(0,0,0,.5); }
    .send .client-opt{ display:flex; align-items:center; gap:12px; padding:9px 10px;
      border-radius:7px; cursor:pointer; font-size:var(--fs-15); color:var(--ink); }
    .send .client-opt:hover, .send .client-opt.is-active{ background:rgba(213,230,228,.08); }
    .send .client-opt .co-name{ flex:1 1 auto; min-width:0; overflow:hidden;
      text-overflow:ellipsis; white-space:nowrap; line-height:1.5; }
    /* Quiet "already saved" tick on the row that exactly matches the field. */
    .send .client-opt .co-check{ flex:0 0 auto; color:var(--ok); display:inline-flex; }
    /* Edit affordance per saved row — appears the moment the row is hovered
       (started as a 3s dwell; Pierce, 2026-08-08: "change the 3 second hover
       to immediate"). Pure CSS, no timer. Sits where the checkmark does,
       next to it when both show. */
    .send .client-opt .co-edit{ flex:0 0 auto; opacity:0; pointer-events:none;
      background:none; border:1px solid var(--line-strong); border-radius:999px;
      color:var(--ink-soft); font-family:'Diatype Mono', monospace; font-size:var(--fs-10);
      letter-spacing:.1em; text-transform:uppercase; padding:4px 11px; cursor:pointer;
      transition:opacity var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard),
        border-color var(--dur-s) var(--ease-standard); }
    .send .client-opt:hover .co-edit{ opacity:1; pointer-events:auto; }
    .send .client-opt .co-edit:hover{ color:var(--ink); border-color:var(--ink); }
    @media (prefers-reduced-motion:reduce){ .send .client-opt .co-edit{ transition:none; } }
    /* The "add new" row sits under a hairline when saved clients are above it;
       its circle is dashed — a photo slot not yet filled. */
    .send .client-opt.co-add{ color:var(--accent-soft); }
    .send .client-opt.co-add .avatar{ background:none; border-style:dashed;
      border-color:rgba(143,194,242,.55); color:var(--accent-soft); font-family:inherit;
      font-size:var(--fs-16); line-height:1; }
    .send .client-menu .co-rule{ height:1px; background:var(--line); margin:6px 4px; }
    .send .client-menu .co-empty{ padding:10px 12px; font-size:var(--fs-13); color:var(--ink-soft); }

    /* Recent shares: the picture sits before the client name so the list
       scans by face first, name second. */
    .send .srow-client .avatar{ margin-right:.1rem; }

    /* ---------------------------------------------------- client modal --- */
    .send .cmodal{ position:fixed; inset:0; z-index:9999997; display:flex;
      align-items:center; justify-content:center; padding:24px; }
    .send .cmodal-backdrop{ position:absolute; inset:0; background:rgba(5,8,7,.72);
      backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px); }
    .send .cmodal-card{ position:relative; width:min(400px, 100%);
      background:var(--card); border:1px solid var(--line-strong); border-radius:12px;
      padding:30px 30px 26px; box-shadow:0 28px 70px rgba(0,0,0,.6);
      display:flex; flex-direction:column; }
    .send .cmodal-card .group-title{ margin-bottom:1.5rem; }
    /* The photo well: one big tap target — circle plus caption both open the
       file picker. Dashed until a photo is in, solid after. */
    .send .cmodal-pic{ align-self:center; display:flex; flex-direction:column; align-items:center;
      gap:.7rem; padding:0 0 1.6rem; margin:0; background:none; border:none; cursor:pointer; }
    .send .cmodal-pic .avatar-xl{ border-style:dashed; border-color:rgba(143,194,242,.55);
      transition:border-color var(--dur-s) var(--ease-standard), box-shadow var(--dur-s) var(--ease-standard); }
    .send .cmodal-pic .avatar-xl.has-img{ border-style:solid; border-color:var(--line-strong); }
    .send .cmodal-pic:hover .avatar-xl{ border-color:var(--accent-soft);
      box-shadow:0 0 22px rgba(143,194,242,.3); }
    .send .cmodal-pic.is-over .avatar-xl{ border-color:var(--accent-soft);
      box-shadow:0 0 22px rgba(143,194,242,.4); }
    .send .cmodal-pic-hint{ font-family:'Diatype Mono', monospace; font-size:var(--fs-11);
      letter-spacing:.14em; text-transform:uppercase; color:var(--ink-soft); }
    .send .cmodal-pic:hover .cmodal-pic-hint{ color:var(--ink); }
    /* Crop mode: the circle is a drag surface, so the cursor says so and the
       canvas fills it edge to edge. touch-action:none lets one-finger drags
       reposition on touch instead of scrolling the page behind the modal. */
    .send .cmodal-pic.is-cropping{ cursor:grab; touch-action:none; }
    .send .cmodal-pic.is-cropping:active{ cursor:grabbing; }
    .send .cmodal-pic canvas{ width:100%; height:100%; display:block; }
    /* Zoom row under the circle — mono glyphs either side of a thin slider,
       restyled to the page's tokens (the UA range control is grey-on-grey
       here). Sized to the circle above it, not the card. */
    .send .cmodal-crop{ align-self:center; display:flex; align-items:center; gap:10px;
      width:200px; margin:-0.5rem 0 1.4rem; color:var(--ink-soft); }
    .send .cmodal-zoom{ flex:1 1 auto; appearance:none; -webkit-appearance:none;
      height:3px; border-radius:2px; background:var(--line-strong); outline:none; cursor:pointer; }
    .send .cmodal-zoom::-webkit-slider-thumb{ appearance:none; -webkit-appearance:none;
      width:16px; height:16px; border-radius:50%; background:var(--cta);
      border:none; box-shadow:0 0 10px rgba(143,194,242,.35); cursor:grab; }
    .send .cmodal-zoom::-webkit-slider-thumb:active{ cursor:grabbing; }
    .send .cmodal-zoom::-moz-range-thumb{ width:16px; height:16px; border-radius:50%;
      background:var(--cta); border:none; box-shadow:0 0 10px rgba(143,194,242,.35); cursor:grab; }
    .send .cmodal-zoom:focus-visible{ outline:2px solid var(--accent); outline-offset:4px; }
    .send .cmodal-actions{ justify-content:flex-end; }
    /* Delete stands apart on the left — it shouldn't read as a sibling of
       Save/Cancel, and the gap makes a mis-tap that much harder. */
    .send .cmodal-actions #cmodal-delete{ margin-right:auto; }

    /* -------------------------------------------------------- drop zone --- */
    .send .drop{ border:1.5px dashed var(--line-strong); border-radius:10px; padding:28px 16px;
      text-align:center; color:var(--ink-soft); font-size:var(--fs-15); cursor:pointer;
      transition:border-color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard); }
    .send .drop:hover, .send .drop:focus-visible{ border-color:var(--accent); color:var(--ink); }
    .send .drop.is-over{ border-color:var(--accent); background:rgba(213,230,228,.07); color:var(--ink); }

    /* Expiry pills — same component as /brief's single-select pills, in this
       page's tokens. The <label>.on class is kept in sync by JS so the styling
       doesn't depend on :has() support. */
    .send .expiry-set{ border:0; margin:0; padding:0; min-width:0; }
    .send .pills{ display:flex; flex-wrap:wrap; gap:10px; margin-top:.85rem; }
    .send .pill{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
      border-radius:999px; padding:10px 18px; font-size:var(--fs-15); color:var(--ink); background:var(--field);
      transition:transform var(--dur-xs) var(--ease-press),border-color var(--dur-s) var(--ease-standard),color var(--dur-s) var(--ease-standard),background var(--dur-s) var(--ease-standard); }
    .send .pill:hover{ border-color:var(--ink); }
    .send .pill:active{ transform:scale(.96); }
    .send .pill input{ position:absolute; opacity:0; pointer-events:none; }
    .send .pill:focus-within{ outline:2px solid var(--accent); outline-offset:2px; }
    .send .pill.on{ border-color:var(--accent); background:var(--accent); color:var(--deep); font-weight:500; }
    @media (prefers-reduced-motion:reduce){ .send .pill{ transition:none; } }

    .send .filelist{ list-style:none; margin:1rem 0 0; padding:0; display:flex; flex-direction:column; gap:8px; }
    .send .filelist:empty{ margin:0; }
    .send .frow{ position:relative; overflow:hidden; display:flex; align-items:center; gap:12px;
      background:var(--field);
      border:1px solid var(--line); border-radius:8px; padding:10px 14px; font-size:var(--fs-14); }
    /* Progress fill that sweeps left->right behind the row and goes solid on
       completion — same treatment as /brief's upload rows, in this page's
       accent instead of /brief's orange. Row content sits above it. */
    .send .frow > *{ position:relative; z-index:1; }
    .send .frow-fill{ position:absolute; left:0; top:0; bottom:0; width:0; z-index:0;
      background:var(--cta); transition:width var(--dur-m) var(--ease-standard); }
    .send .frow.is-done .frow-fill{ width:100%; }
    @media (prefers-reduced-motion:reduce){ .send .frow-fill{ transition:none; } }
    /* line-height matters here: reset.css sets `font:inherit` on these
       elements, and with overflow:hidden a tight line box clips descenders —
       "Dark Yak.png" lost the tail of its g. 1.5 gives the box room. */
    .send .frow-name{ flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; line-height:1.5; }
    .send .frow-size{ color:var(--ink-soft); font-family:'Diatype Mono', monospace; font-size:var(--fs-12); flex:0 0 auto; }
    .send .frow-status{ flex:0 0 auto; font-family:'Diatype Mono', monospace; font-size:var(--fs-12); min-width:64px; text-align:right; }
    .send .frow-status.is-wait{ color:var(--ink-soft); }
    .send .frow-status.is-up{ color:var(--accent-hi); }
    .send .frow-status.is-ok{ color:var(--ok); }
    .send .frow-status.is-err{ color:var(--err); }
    /* A file that was ALREADY in the share when the editor opened. It gets no
       fill and no lit text: the blue sweep is the uploader saying "this just
       went up", and firing it for three files that have been sitting on the
       client's download page for a week turns the whole list into a wall of
       blue that reads as an upload in progress. These rows are just present,
       so they look present — the status column is the only thing that has to
       say anything, and it says it quietly. */
    .send .frow-status.is-sent{ color:var(--ink-soft); }
    /* The fill uses --cta, the same blue as the Create share button, so the
       upload reads as the button's colour filling up. --deep on it measures
       9.28:1, so each element flips to dark ink as the fill reaches its side:
       name (left) early, size/percent and the remove button (right) near the
       end. Error rows never light up. */
    .send .frow.name-lit .frow-name{ color:var(--deep); }
    .send .frow.meta-lit .frow-size,
    .send .frow.meta-lit .frow-status,
    .send .frow.meta-lit .frow-remove{ color:var(--deep); }
    /* min 24x24 hit area — WCAG 2.5.8 target size (minimum). */
    .send .frow-remove{ flex:0 0 auto; background:none; border:none; color:var(--ink-soft); cursor:pointer;
      font-size:var(--fs-16); line-height:1; padding:0; min-width:24px; min-height:24px;
      display:inline-flex; align-items:center; justify-content:center; border-radius:6px; }
    .send .frow-remove:hover{ color:var(--err); }

    /* -------------------------------------------------------------- shares --- */
    .send .shares{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
    /* position:relative so the downloaded badge can pin to the rectangle's
       top-right corner (Pierce, 2026-08-08) instead of sitting in the name
       row — beside the profile picture it read as two competing circles. */
    .send .srow{ position:relative; display:flex; flex-wrap:wrap; align-items:center; gap:10px 16px;
      background:var(--field); border:1px solid var(--line); border-radius:8px; padding:14px 16px; }
    .send .srow-main{ flex:1 1 200px; min-width:0; }
    /* Shares rows only (passkey rows keep the side-by-side layout): the
       TITLE line owns the card's full width — a long "Client — Project" was
       wrapping at half-width against the buttons — while the buttons stay on
       the right, just pushed below the title into the meta block's band
       (Pierce, 2026-08-08, second pass: "just down a little to make room",
       not a full bottom row). Actions are pinned to the row's vertical
       centre; the meta/expiry/filename lines reserve their width so text
       never runs underneath them. */
    #shares-list .srow{ flex-direction:column; align-items:stretch; }
    #shares-list .srow-main{ flex:1 1 auto; width:100%; }
    /* The corner badge floats over the first line's right end; keep the
       title's text from running underneath it. */
    #shares-list .srow-client{ padding-right:28px; }
    /* 285px, up from 220px when Edit joined Copy link and Delete on the row.
       This number is the gutter the three buttons occupy plus their right
       offset — if a label changes, re-measure it rather than guessing, or the
       filename line starts running underneath the buttons. */
    #shares-list .srow-meta,
    #shares-list .srow-expiry,
    #shares-list .srow-files{ padding-right:285px; }
    /* Anchored to the row's BOTTOM, not its centre — the buttons share their
       bottom edge with the filename line (Pierce, 2026-08-08: "they should
       just share a baseline with the file row"). Bottom-anchoring also means
       a second line of filenames moves the buttons down with it instead of
       leaving them floating mid-card. 14px matches .srow's own padding, so
       the buttons and the filename text end on the same line. */
    #shares-list .srow-actions{ position:absolute; right:16px; bottom:14px;
      margin-top:0; }
    /* Narrow screens can't spare the gutter — fall back to the stacked
       shape: full-width text, buttons on their own line, bottom-right. */
    @media (max-width:640px){
      #shares-list .srow-meta,
      #shares-list .srow-expiry,
      #shares-list .srow-files{ padding-right:0; }
      #shares-list .srow-actions{ position:static; transform:none;
        justify-content:flex-end; margin-top:.9rem; }
    }
    /* Three tiers, not two: the client/project name is the thing you scan for,
       so it gets air beneath it; the mono metadata sits a step down in size,
       and expiry takes its own line at that same size rather than wrapping the
       stats line mid-phrase ("expires in / 7 days" was breaking across lines). */
    .send .srow-client{ font-weight:500; font-size:var(--fs-16); color:var(--ink); margin-bottom:.55rem;
      display:flex; align-items:center; gap:.5rem; }
    /* Long client/project names wrap to two lines, and at the page's inherited
       line-height:1 the second line sat almost on top of the first. The name
       gets its own leading, and the half-leading that adds above the first line
       and below the last is pulled straight back off with negative block
       margins — so a two-line title breathes while every one-line row keeps
       exactly the height it had before (Pierce, 2026-08-21). */
    .send .srow-client-name{ line-height:1.4; margin-block:calc((1 - 1.4) * .5em); }
    /* At-least-one-file-opened indicator (Pierce, 2026-07-29). Third pass:
       kept the --ok green from the avail-dot-style attempt, but swapped the
       dot/ring for an actual download glyph in a small circle — reads as
       "downloaded" on its own rather than needing the title tooltip to
       explain a bare dot. Motion is back to a light/dark opacity breathe
       (Pierce: "can get lighter and darker pulse too") rather than the
       expanding ring, applied to the whole badge so the circle and glyph
       fade together as one unit. */
    .send .srow-dl-badge{ position:absolute; top:10px; right:10px;
      display:inline-flex; align-items:center; justify-content:center;
      width:16px; height:16px; border-radius:50%; color:var(--ok);
      background:rgba(143,231,180,.16); border:1px solid rgba(143,231,180,.55);
      animation:srow-dl-pulse 2.2s ease-in-out infinite; }
    .send .srow-dl-badge svg{ display:block; }
    @keyframes srow-dl-pulse{ 0%, 100%{ opacity:1; } 50%{ opacity:.5; } }
    @media (prefers-reduced-motion:reduce){
      .send .srow-dl-badge{ animation:none; } }
    /* Mono at this size sets tight — 1.75 gives the two metadata lines room to
       breathe against each other and against the name above. */
    .send .srow-meta{ font-size:var(--fs-12); line-height:1.75; color:var(--ink-soft);
      font-family:'Diatype Mono', monospace; }
    .send .srow-expiry{ font-size:var(--fs-12); line-height:1.75; color:var(--warn);
      font-family:'Diatype Mono', monospace; margin-top:.1rem; }
    /* "Never expires" is a statement of fact, not a warning — it drops back to
       the same ink as the rest of the metadata. */
    .send .srow-expiry.is-forever{ color:var(--ink-soft); }
    /* The status line sits directly above the device list, so it needs its own
       breathing room — .note only carries a top margin. */
    #pk-note:not(:empty){ margin-bottom:1.1rem; }
    #pk-empty{ margin-top:0; }
    .send .srow.is-expired{ opacity:.55; }
    .send .srow.is-expired .srow-expiry{ color:var(--err); }
    /* The row currently open in the editor above. Just the accent edge — the
       card at the top of the page is already saying "Edit share", so this only
       has to answer "which one", not compete with it. */
    .send .srow.is-editing{ border-color:var(--accent-soft); }
    /* Filenames under each share. Clamped to two lines so a 30-file send
       doesn't push the rest of the list off the screen — full list on hover
       via the title attribute. */
    .send .srow-files{ font-size:var(--fs-12); line-height:1.45; color:var(--ink-soft); margin-top:.45rem;
      opacity:.85; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
      overflow:hidden; word-break:break-word; }
    .send .srow-files[hidden]{ display:none; }
    .send .srow-actions{ display:flex; gap:8px; flex:0 0 auto; }

    /* -------------------------------------------------------------- buttons --- */
    /* The browser's own [hidden]{display:none} default is UA-origin, so any
       author rule that sets display on the same element beats it regardless
       of selector specificity — .btn{display:inline-flex} below was silently
       cancelling every button's hidden attribute. This restores hidden as the
       hard override it's supposed to be, for buttons and anything else. */
    .send [hidden]{ display:none !important; }

    /* ---- first paint -----------------------------------------------------
       Held back while the auth check is in flight on a browser with no
       signed-in hint (see the inline script at the top of <main>), so a
       signed-out visit goes straight to /admin without painting /send. */
    html.send-auth-pending #cognak-main{ opacity:0; pointer-events:none; }
    #cognak-main{ transition:opacity var(--dur-l, .4s) var(--ease-standard); }
    .send .actions{ display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-top:1.6rem; }
    .send .signout-row{ justify-content:flex-end; margin-top:0; }
    .send .btn{ font-family:inherit; font-size:var(--fs-15); font-weight:500; cursor:pointer;
      display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
      border-radius:999px; padding:12px 22px; background:none; color:var(--ink);
      border:1px solid var(--line-strong);
      transition:background var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard), border-color var(--dur-s) var(--ease-standard), box-shadow var(--dur-sm) var(--ease-standard); }
    .send .btn:hover:not(:disabled){ border-color:var(--ink); }
    /* Primary CTA carries the headline's blue, and glows on hover the way
       /brief's does — same 0 0 24px shadow, same .45 alpha, just this page's
       accent instead of /brief's orange. --deep on #8FC2F2 is 9.28:1, so the
       label clears AA comfortably; the hover tint lightens rather than
       darkens so contrast only ever improves. */
    .send .btn.btn-primary{ background:var(--cta); border-color:var(--cta); color:var(--deep);
      transition:box-shadow var(--dur-sm) var(--ease-standard), background var(--dur-s) var(--ease-standard), border-color var(--dur-s) var(--ease-standard); }
    .send .btn.btn-primary:hover:not(:disabled){ background:var(--cta-hi); border-color:var(--cta-hi);
      box-shadow:0 0 24px rgba(143,194,242,.45); }
    .send .btn.btn-ghost{ padding:12px 18px; font-size:var(--fs-14); }
    /* Delete carries the warn colour at rest, not just on hover — it's the one
       irreversible control on the page and shouldn't look identical to "Copy
       link" until you're already pointing at it. 7.26:1 on the card. */
    .send .btn.btn-danger{ color:var(--warn); border-color:var(--warn); }
    .send .btn.btn-danger:hover:not(:disabled){ background:var(--warn); color:var(--deep);
      border-color:var(--warn); }
    .send .btn:active:not(:disabled){ transform:scale(.98); }
    /* .32 rendered the (default-state) "Create share" button barely readable;
       .55 keeps it legible while still reading as disabled. */
    .send .btn:disabled{ opacity:.55; cursor:not-allowed; }

    .send .rise{ opacity:0; transform:translateY(8px); transition:opacity var(--dur-2xl) var(--ease-standard), transform var(--dur-2xl) var(--ease-standard); }
    .send .rise.in{ opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce){ .send .rise{ opacity:1; transform:none; transition:none; } }


    /* ---- step transition: gate <-> the view behind it -------------------
       Lifted from /brief's picker->questionnaire swap so the two flows feel
       like the same site: the outgoing panel fades up and out over 260ms,
       then the incoming panel's blocks rise in staggered 60ms apart. Both
       collapse to an instant swap under prefers-reduced-motion. */
    .step-fade{ transition:opacity var(--dur-sm) var(--ease-standard), transform var(--dur-sm) var(--ease-standard); }
    .step-fade.step-hide{ opacity:0; transform:translateY(-8px); pointer-events:none; }
    @media (prefers-reduced-motion:reduce){
      .step-fade{ transition:none; }
      .step-fade.step-hide{ transform:none; }
    }

    /* ------------------------------------------------------------- nav --- */
    /* Literal rgba of --card (#0E1413), not var(--card) — the bar is a sibling
       of .send/.receive, so the page's custom properties don't reach it. Keep
       this in sync with --card; the bar and the cards share a surface tone.

       Frosted like every other inner-page nav: translucent tint + the 6px
       backdrop blur inherited from the base .inner-page-nav rule (and
       BaseLayout's inline fallback). The bar was opaque with blur disabled
       until 2026-07-30 as a perf guard against blurring over the
       always-animating transit canvas; the background's load has since been
       lightened, so the full frost is back to match the rest of the site. */
    .home-bottom-bar.inner-page-nav.send-nav{ background:rgba(14,20,19,0.75) !important; }
    .send-nav .home-bottom-email,
    .send-nav .home-bottom-location,
    .send-nav .inner-nav-links a,
    .send-nav .pulse-dot{ color:#BED0CD !important; }
    .send-nav .home-bottom-email,
    .send-nav .inner-nav-links a{ transition:color var(--dur-s) var(--ease-standard); }
    /* Hover DARKENS rather than brightens — the nav text already sits near the
       top of the ramp, so there was nowhere brighter to go that read as a
       change. #93A29F is 7.01:1 on the #0E1413 bar: still WCAG AAA for body
       text, so the link stays fully legible while it's being pointed at. The
       AA floor for reference is #73807D (4.51:1) — noticeably darker, but it
       starts to read as disabled rather than hovered. */
    @media (hover:hover){
      .send-nav .home-bottom-email:hover,
      .send-nav .inner-nav-links a:hover{ color:#93A29F !important; }
    }
    /* Focus-visible keeps the bright treatment: keyboard users get a positive
       highlight rather than the pointer's dimming, and it can't be confused
       with a disabled control. */
    .send-nav .home-bottom-email:focus-visible,
    .send-nav .inner-nav-links a:focus-visible{ color:#D5E6E4 !important; }
  </style>

  <script>

    const $ = (id) => document.getElementById(id);
    function humanSize(b) {
      return b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB';
    }

    /* ---------------------------------------------- blob client, on demand --- */
    let _blobClient = null;
    function blobClient() {
      if (!_blobClient) {
        _blobClient = import('https://esm.sh/@vercel/blob@1/client').catch((e) => {
          _blobClient = null;
          throw new Error('Uploader could not load. Check your connection and retry.');
        });
      }
      return _blobClient;
    }

    /* ---------------------------------------------- preview thumbnails ------
       /receive shows a thumbnail per file and a hover preview card. Images it
       can display directly, but a PDF it can't: a client's browser has to open
       the PDF itself, which desktop browsers do in an iframe and Chrome on
       Android flatly doesn't. So the rasterizing happens HERE, once, at upload
       time — page 1 of every PDF becomes a small JPEG that gets uploaded
       alongside the file and recorded as `thumbUrl` in the manifest. /receive
       then just shows an image, which works on everything. Same trick every
       file-transfer service uses; the only difference is that theirs runs on a
       server and this runs in Pierce's browser while he's uploading anyway.

       Big images get the same treatment for a different reason: Blob has no
       resize endpoint, so without a thumbnail /receive either downloads a 30MB
       original to paint a 46px square or shows a placeholder tile. One 640px
       JPEG solves both ends.

       Entirely best-effort. Any failure here leaves `thumbUrl` unset and the
       share is created exactly as it was before this existed — a preview is
       never worth failing a delivery over. */
    const THUMB_EDGE = 640;      // longest side of the generated JPEG
    const THUMB_QUALITY = 0.75;
    // Under this, /receive can just use the original as its own thumbnail and
    // a second copy on Blob would be pure waste.
    const THUMB_IMAGE_MIN = 2 * 1024 * 1024;
    const RE_THUMB_IMG = /\.(png|jpe?g|webp|avif)$/i;  // NOT svg: it scales itself, and rasterizing it via canvas is a browser-by-browser coin flip
    const RE_THUMB_PDF = /\.pdf$/i;

    /* pdf.js is vendored at /js/pdfjs/ rather than pulled from esm.sh like the
       Blob client above, because it needs a Worker and `new Worker()` refuses
       a cross-origin URL regardless of CSP. Served from our own origin,
       `worker-src 'self'` already covers it. Loaded on demand — nothing is
       fetched unless a PDF is actually queued. See public/js/pdfjs/README.md. */
    /* Astro runs this <script> through Vite, which tries to RESOLVE dynamic
       imports at build time — and files in public/ aren't modules in the graph,
       they're copied verbatim, so the build dies with
       "[UNRESOLVED_IMPORT] Could not resolve '/js/pdfjs/pdf.min.mjs'".
       (The esm.sh imports elsewhere on this page are fine as literals because
       Vite leaves absolute http(s) specifiers alone.)

       THE SPECIFIER MUST BE OPAQUE TO THE BUNDLER, not merely non-literal.
       `PDFJS_DIR + 'pdf.min.mjs'` LOOKS dynamic, but both operands are consts
       holding literals, so esbuild can constant-fold it straight back into
       "/js/pdfjs/pdf.min.mjs" before the resolver runs — and a folded
       expression can lose the vite-ignore annotation along with it. Building
       the URL with `new URL(..., location.origin)` cannot be folded, because
       location.origin does not exist until the browser evaluates it.
       Keep BOTH the runtime URL and the annotation: belt and braces. */
    const PDFJS_DIR = '/js/pdfjs/';
    function pdfjsUrl(file) {
      return new URL(PDFJS_DIR + file, location.origin).href;
    }
    let _pdfjs = null;
    function pdfjs() {
      if (!_pdfjs) {
        const url = pdfjsUrl('pdf.min.mjs');
        _pdfjs = import(/* @vite-ignore */ url).then((mod) => {
          mod.GlobalWorkerOptions.workerSrc = pdfjsUrl('pdf.worker.min.mjs');
          return mod;
        }).catch((e) => { _pdfjs = null; throw e; });
      }
      return _pdfjs;
    }

    function canvasToJpeg(canvas) {
      return new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', THUMB_QUALITY));
    }
    function fitScale(w, h) {
      return Math.min(1, THUMB_EDGE / Math.max(w, h));
    }

    async function pdfThumb(file) {
      const mod = await pdfjs();
      // getDocument takes the bytes directly — the file is right here in
      // memory, no reason to make it fetch the uploaded copy back.
      const doc = await mod.getDocument({ data: await file.arrayBuffer() }).promise;
      const page = await doc.getPage(1);
      const base = page.getViewport({ scale: 1 });
      const vp = page.getViewport({ scale: fitScale(base.width, base.height) });
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(vp.width));
      canvas.height = Math.max(1, Math.round(vp.height));
      const ctx = canvas.getContext('2d');
      // White under the page: PDFs don't paint their own background, and on a
      // transparent canvas a JPEG flattens that to black.
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      await page.render({ canvasContext: ctx, viewport: vp }).promise;
      const out = await canvasToJpeg(canvas);
      // Frees the worker's copy of the document; without it a batch of large
      // PDFs keeps every one of them alive until the tab is closed.
      doc.destroy();
      return out;
    }

    async function imageThumb(file) {
      const bmp = await createImageBitmap(file);
      const scale = fitScale(bmp.width, bmp.height);
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(bmp.width * scale));
      canvas.height = Math.max(1, Math.round(bmp.height * scale));
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(bmp, 0, 0, canvas.width, canvas.height);
      bmp.close();
      return canvasToJpeg(canvas);
    }

    async function makeThumb(file) {
      if (RE_THUMB_PDF.test(file.name)) return pdfThumb(file);
      if (RE_THUMB_IMG.test(file.name) && file.size >= THUMB_IMAGE_MIN) return imageThumb(file);
      return null;
    }

    /* Thumbnails live under deliveries/<token>/thumbs/ — inside the share's own
       prefix, so deliver-delete.js and deliver-sweep.js (both of which delete
       by prefix) already clean them up with everything else.
       Keyed at random rather than named after the file, so two files with the
       same basename in different states can't collide — and, since /send
       learned to edit a sent share, so that a file added on a later pass
       can't land on the thumbnail of one already in the share. (A random key
       does orphan the old thumbnail when a file is replaced;
       api/deliver-update.js deletes those.) */
    async function uploadThumb(blob, token, key) {
      const mod = await blobClient();
      const result = await mod.upload(
        'deliveries/' + token + '/thumbs/' + key + '.jpg',
        blob,
        { access: 'public', handleUploadUrl: '/api/deliver-upload-token', contentType: 'image/jpeg' }
      );
      return result.url;
    }

    function randomToken(len = 10) {
      const alphabet = 'abcdefghjkmnpqrstuvwxyz23456789'; // no 0/o/1/i/l
      const bytes = crypto.getRandomValues(new Uint8Array(len));
      return Array.from(bytes, (b) => alphabet[b % alphabet.length]).join('');
    }

    async function api(path, opts) {
      const res = await fetch(path, {
        method: (opts && opts.method) || 'GET',
        headers: { 'Content-Type': 'application/json' },
        body: opts && opts.body ? JSON.stringify(opts.body) : undefined,
        credentials: 'same-origin',
      });
      let json = null;
      try { json = await res.json(); } catch (e) { /* no body */ }
      return { ok: res.ok, status: res.status, data: json };
    }


    /* Step transition, same shape as /brief's showForm(). `outEl` fades out,
       then `inEl` is revealed and its direct blocks rise in staggered. */
    const REDUCE = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function swapStep(outEl, inEl, done) {
      if (!outEl || !inEl) return;
      if (REDUCE()) {
        outEl.hidden = true; inEl.hidden = false;
        syncScroll();
        if (done) done();
        return;
      }
      outEl.classList.add('step-fade', 'step-hide');
      setTimeout(() => {
        outEl.hidden = true;
        outEl.classList.remove('step-hide');
        inEl.hidden = false;
        const items = inEl.matches('.acard, .dcard') ? [inEl] : inEl.querySelectorAll(':scope > .acard, :scope > .dcard, :scope > .actions');
        items.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(10px)';
          const dl = (i * 0.06).toFixed(2) + 's';
          el.style.transition = 'opacity var(--dur-xl) var(--ease-standard) ' + dl + ', transform var(--dur-xl) var(--ease-standard) ' + dl;
          requestAnimationFrame(() => requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'none';
          }));
          setTimeout(() => { el.style.transition = ''; el.style.transform = ''; el.style.opacity = ''; },
                     600 + i * 60);
        });
        syncScroll();
        // Card heights are still settling through the staggered rise, so sync
        // again once it's done — otherwise Lenis caches the mid-animation height.
        setTimeout(syncScroll, 700);
        if (done) done();
      }, 260);
    }

    /* Lenis caches the document height. Swapping the gate for the (much taller)
       view behind it changes that height without a resize event, so Lenis keeps
       scrolling against the OLD bounds and the page dead-ends partway down the
       card. /brief hit the same thing on its picker->form swap and solves it the
       same way — see refreshScroll() there. Deliberately does NOT jump to top:
       unlike /brief's full step change, these swaps happen in place. */
    function syncScroll() {
      requestAnimationFrame(() => {
        try {
          if (window._lenis && window._lenis.resize) window._lenis.resize();
        } catch (e) {}
        window.dispatchEvent(new Event('resize'));
      });
    }

    /* The gate->dash swap wasn't the only height change. renderShares() runs
       AFTER the shares fetch resolves, so Lenis measured the dashboard while the
       list was still empty and then the cards arrived against a stale limit —
       the page dead-ended partway down, with the Sign-in security card and the
       whole footer unreachable. Deleting a share, adding files, and expanding
       the security card all move the height too.
       Rather than chase each call site, watch the page: any height change
       re-measures. rAF-coalesced so a burst of mutations costs one resize.

       ** DO NOT observe document.body. ** That is what this block did between
       July 2026 and 2026-07-31, and it never fired once. custom.css:463 sets
       `html, body { height: 100% }`, pinning body's box to the viewport: content
       that overflows it grows documentElement.scrollHeight while
       body.offsetHeight stays exactly innerHeight forever, and a
       ResizeObserver on a box that never resizes never fires. Measured live:
       injecting 800px moved scrollHeight 1387 -> 2187, body.offsetHeight stayed
       945. The footer bug therefore never actually got fixed — it just looked
       fixed because the swapStep/syncScroll calls cover the gate->dash step,
       and only the LATER async growth (the share list arriving) was stranded.

       Guarding on documentElement.scrollHeight rather than the target's own
       height: scrollHeight is the number Lenis actually clamps against, so it
       is the thing worth reacting to, and it stays correct even if the growth
       happens somewhere other than the observed element. */
    (function observePageHeight() {
      if (!window.ResizeObserver) return;
      var pending = false, lastH = 0;
      var ro = new ResizeObserver(function () {
        var h = document.documentElement.scrollHeight;
        if (h === lastH || pending) return;
        lastH = h;
        pending = true;
        requestAnimationFrame(function () { pending = false; syncScroll(); });
      });
      // #cognak-main is not height-pinned and wraps both the gate and the
      // dashboard, so it grows with everything this page can render.
      var target = document.getElementById('cognak-main');
      if (target) ro.observe(target);
    })();

    /* -------------------------------------------------------------- auth --- */
    /* Signing in lives on /admin now (2026-09-27). This page just asks the
       server whether the session is good: /api/deliver-list 401s through the
       same requireAdmin() that /admin's check (/api/admin-passkey?action=list)
       uses, so the two can't disagree. Only a real 401 bounces to /admin —
       any other failure (store down, network) keeps you here with a note,
       never a redirect loop. /admin also has its own loop breaker. */
    const dash = $('dash');
    const HINT = 'cognak-admin-hint';
    function setHint(on) {
      try { if (on) localStorage.setItem(HINT, '1'); else localStorage.removeItem(HINT); } catch (e) {}
    }
    function toAdmin(query) {
      location.replace('/admin' + (query || ''));
    }

    async function checkAuth() {
      const r = await api('/api/deliver-list');
      if (r.status === 401) {
        setHint(false);
        toAdmin('?next=/send');
        return false;
      }
      setHint(true);
      try { sessionStorage.removeItem('cognak-admin-bounce'); } catch (e) {}
      document.documentElement.classList.remove('send-auth-pending');
      dash.hidden = false;
      $('idle-note').textContent = r.ok ? '' : 'Could not load shares. Reload to try again.';
      // Address book first: renderShares uses it to show each row's current
      // client photo rather than the one snapshotted into the manifest.
      await loadClients();
      renderShares((r.ok && r.data && r.data.shares) || []);
      renderPasskeys();
      resetIdle();
      syncScroll();
      return true;
    }

    async function signOut(reason) {
      clearTimeout(idleTimer);
      await api('/api/admin-logout', { method: 'POST' });
      setHint(false);
      // Idle sign-out comes back here after signing in again; a deliberate
      // sign-out just lands on /admin.
      toAdmin(reason === 'idle' ? '?next=/send&reason=idle' : '');
    }

    $('signout-btn').addEventListener('click', () => signOut(''));

    /* ------------------------------------------------------- passkeys --- */
    /* The browser half of WebAuthn comes from esm.sh on demand, the same way
       the Blob uploader does — no build step, and nothing downloaded unless
       you actually use a passkey. */
    let _webauthn = null;
    function webauthn() {
      if (!_webauthn) {
        _webauthn = import('https://esm.sh/@simplewebauthn/browser@13').catch((e) => {
          _webauthn = null;
          throw new Error('Passkey support could not load. Check your connection.');
        });
      }
      return _webauthn;
    }

    /* Sign-in (passkey / password fallback) moved to /admin — see admin.astro.
       webauthn() above is still used here to enrol new devices. */

    async function renderPasskeys() {
      const r = await api('/api/admin-passkey?action=list');
      if (!r.ok) return;
      const list = $('pk-list');
      const keys = (r.data && r.data.passkeys) || [];
      list.innerHTML = '';
      $('pk-empty').hidden = keys.length > 0;

      if (r.data && r.data.fallbackEnabled && keys.length) {
        const note = $('pk-note');
        note.textContent =
          'ADMIN_PASSWORD_FALLBACK is on, so the password still works. Turn it off in Vercel to make passkeys the only way in.';
        note.className = 'note is-error';
      }

      keys.forEach((k) => {
        const li = document.createElement('li');
        li.className = 'srow';
        li.innerHTML =
          '<div class="srow-main"><div class="srow-client"></div><div class="srow-meta"></div></div>' +
          '<div class="srow-actions">' +
          '<button type="button" class="btn btn-ghost btn-danger" data-action="pk-del">Remove</button>' +
          '</div>';
        li.querySelector('.srow-client').textContent = k.label;
        const added = k.createdAt ? new Date(k.createdAt).toLocaleDateString() : '';
        const used = k.lastUsedAt ? new Date(k.lastUsedAt).toLocaleDateString() : 'never used';
        // "last used never used" read as a typo; drop the prefix when unused.
        li.querySelector('.srow-meta').textContent =
          'added ' + added + ' · ' + (k.lastUsedAt ? 'last used ' + used : 'never used') +
          (k.backedUp ? ' · synced' : ' · this device only');
        li.querySelector('[data-action="pk-del"]').setAttribute('aria-label', 'Remove passkey ' + k.label);
        li.querySelector('[data-action="pk-del"]').addEventListener('click', async () => {
          const last = keys.length === 1;
          const msg = last
            ? 'Remove the last passkey? The password becomes the only way in again.'
            : 'Remove "' + k.label + '"? That device will no longer be able to sign in.';
          if (!confirm(msg)) return;
          await api('/api/admin-passkey?action=delete', { method: 'POST', body: { id: k.id } });
          await renderPasskeys();
        });
        list.appendChild(li);
      });

      /* The button stays whatever happens: it enrols the device you're ON, so
         on your phone it's the only way to add the phone. Once something is
         registered the wording shifts to "another" so it doesn't look like it
         didn't take the first time. */
      $('pk-add').textContent = keys.length ? 'Add another device' : 'Add this device';
    }

    /* Sign-in security card collapse/expand — set-and-forget content that
       doesn't need to claim vertical space on every visit. */
    $('security-toggle').addEventListener('click', () => {
      const toggle = $('security-toggle');
      const body = $('security-body');
      const collapsing = !body.hidden;
      body.hidden = collapsing;
      toggle.setAttribute('aria-expanded', String(!collapsing));
      toggle.setAttribute('aria-label', collapsing ? 'Expand sign-in security' : 'Collapse sign-in security');
      toggle.querySelector('.toggle-glyph').textContent = collapsing ? '+' : '−';
    });

    $('pk-add').addEventListener('click', async () => {
      const note = $('pk-note');
      const btn = $('pk-add');
      note.textContent = '';
      note.className = 'note';
      if (typeof window.PublicKeyCredential === 'undefined') {
        note.textContent = 'This browser does not support passkeys.';
        note.className = 'note is-error';
        return;
      }
      const label = prompt('Name this device (e.g. "MacBook Pro", "iPhone")', 'This device');
      if (label === null) return;
      btn.disabled = true;
      try {
        const optRes = await api('/api/admin-passkey?action=register-options');
        if (!optRes.ok) throw new Error((optRes.data && optRes.data.error) || 'Could not start enrolment.');
        const { startRegistration } = await webauthn();
        const response = await startRegistration({ optionsJSON: optRes.data });
        const verify = await api('/api/admin-passkey?action=register-verify', {
          method: 'POST', body: { response, label },
        });
        if (!verify.ok) throw new Error((verify.data && verify.data.error) || 'Could not add this device.');
        note.textContent = 'Added. The password will stop working on the next sign-in.';
        note.className = 'note is-ok';
        await renderPasskeys();
      } catch (err) {
        const msg = err && err.name === 'NotAllowedError' ? '' : (err && err.message) || 'Could not add this device.';
        note.textContent = msg;
        note.className = msg ? 'note is-error' : 'note';
      } finally {
        btn.disabled = false;
      }
    });

    /* Idle sign-out. The server cookie also expires at 1 week, so this is the
       courtesy half — it clears the dashboard off the screen and says why,
       instead of leaving a full client list visible until someone clicks
       something and gets a surprise 401. Any real interaction resets it;
       scroll deliberately doesn't count, since a cat on a trackpad shouldn't
       hold the session open. An in-flight upload does hold it (see below) —
       signing out mid-upload would fail the very thing you're waiting on.
       Was 15 minutes; Pierce flagged that as wildly fast for a tool he's
       in and out of all day, so both this and SESSION_MS in adminAuth.mjs
       moved to a week (Pierce, 2026-07-29). */
    const IDLE_MS = 7 * 24 * 60 * 60 * 1000;
    let idleTimer = 0;
    let uploading = 0; // count, not a flag — three workers upload at once

    function resetIdle() {
      clearTimeout(idleTimer);
      if (dash.hidden) return;
      idleTimer = setTimeout(() => {
        if (uploading) { resetIdle(); return; }
        signOut('idle');
      }, IDLE_MS);
    }

    ['click', 'keydown', 'pointerdown', 'focusin'].forEach((ev) => {
      document.addEventListener(ev, resetIdle, { passive: true });
    });

    /* ---------------------------------------------------------- new share --- */
    /* One card, two jobs: composing a new share, and editing one that's
       already been sent. `editing` is null in the first case and holds the
       share being edited in the second — every branch below that behaves
       differently keys off it, so there is exactly one thing to check.

       A queued item is { name, size, status, pct } plus either a `file` (it
       still has to be uploaded) or `sent: true` and a `url` (it's already in
       the share, pulled from the manifest). Name and size are copied off the
       File rather than read through it, so a row from the manifest and a row
       from the disk render through the same code. */
    let editing = null;
    let queued = [];

    /* One place decides what a row's status column says, because paintRow()
       has to reproduce it mid-upload without re-rendering the row. */
    function rowStatus(item) {
      if (item.sent) return { cls: 'sent', text: 'in share' };
      if (item.status === 'up') return { cls: 'up', text: Math.round(item.pct || 0) + '%' };
      if (item.status === 'ok') return { cls: 'ok', text: 'done' };
      if (item.status === 'err') return { cls: 'err', text: 'failed' };
      return { cls: 'wait', text: item.prev ? 'replaces' : 'waiting' };
    }

    function renderFiles() {
      const list = $('filelist');
      list.innerHTML = '';
      queued.forEach((item, i) => {
        const li = document.createElement('li');
        li.className = 'frow';
        const st = rowStatus(item);
        li.innerHTML =
          '<span class="frow-fill" aria-hidden="true"></span>' +
          '<span class="frow-name"></span>' +
          '<span class="frow-size"></span>' +
          '<span class="frow-status is-' + st.cls + '"></span>' +
          '<button type="button" class="frow-remove">×</button>';
        li.querySelector('.frow-name').textContent = item.name;
        // Per-row label, so the button isn't just one of N identical "Remove"s.
        // A file already in the share is deleted, not just unqueued, so the
        // label says which of the two this one is.
        li.querySelector('.frow-remove').setAttribute('aria-label',
          'Remove ' + item.name + (item.sent ? ' from this share' : ''));
        li.querySelector('.frow-size').textContent = humanSize(item.size);
        li.querySelector('.frow-status').textContent = st.text;
        item._el = li;
        li.querySelector('.frow-remove').addEventListener('click', () => {
          /* No confirm here even for a file that's already in the share —
             nothing is deleted until Save, and asking twice for one decision
             trains you to click through it. The single confirm lives in
             submitShare(), where it can name everything that's about to go. */
          queued.splice(i, 1);
          renderFiles();
          updateCreateBtn();
        });
        list.appendChild(li);
        paintRow(item);
      });
    }

    function addFiles(fileList) {
      let blocked = 0;
      Array.from(fileList).forEach((file) => {
        /* deliveries/<token>/manifest.json is where a share's own record used
           to live, and still does for every share sent before manifests went
           versioned — a file by that name would land on top of it and take
           the share with it. api/deliver-upload-token.js refuses the path as
           well; this is the copy that says so before wasting the upload. */
        if (file.name.toLowerCase() === 'manifest.json') { blocked++; return; }
        const item = { file, name: file.name, size: file.size, status: 'wait', pct: 0 };
        /* Same filename as something already in the list = a new version of
           it, not a second copy. It uploads to the same blob path, so the URL
           already in the client's hands keeps working and simply serves the
           new bytes — which is exactly what "I sent the wrong version" wants
           — and it takes the old row's place instead of sitting under it
           looking like a duplicate. The displaced row is kept on `prev` so a
           failed upload can put it back rather than silently costing a file. */
        const at = queued.findIndex((q) => q.name === file.name);
        if (at >= 0) {
          if (queued[at].sent) item.prev = queued[at];
          queued[at] = item;
        } else {
          queued.push(item);
        }
      });
      if (blocked) {
        const note = $('create-note');
        note.textContent = blocked === 1
          ? 'A file can’t be named “manifest.json” — rename it and add it again.'
          : blocked + ' files named “manifest.json” were skipped — rename them and add them again.';
        note.className = 'note is-error';
      }
      renderFiles();
      updateCreateBtn();
    }

    const drop = $('drop');
    const dropInput = $('drop-input');
    drop.addEventListener('click', () => dropInput.click());
    drop.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); dropInput.click(); } });
    dropInput.addEventListener('change', () => { addFiles(dropInput.files); dropInput.value = ''; });
    ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('is-over'); }));
    ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('is-over'); }));
    drop.addEventListener('drop', (e) => { if (e.dataTransfer && e.dataTransfer.files) addFiles(e.dataTransfer.files); });

    function updateCreateBtn() {
      const client = $('client-input').value.trim();
      $('create-btn').disabled = !(client && queued.length > 0);
    }
    /* Pill selection state. Radio inputs stay the source of truth (keyboard and
       screen readers get real radio semantics); .on is only the paint. */
    const expiryPills = $('expiry-pills');
    expiryPills.addEventListener('change', () => {
      expiryPills.querySelectorAll('.pill').forEach((l) => {
        l.classList.toggle('on', l.querySelector('input').checked);
      });
    });
    function selectedExpiryDays() {
      const el = expiryPills.querySelector('input:checked');
      return el ? Number(el.value) : 7;
    }

    /* ------------------------------------------------- saved clients --- */
    /* The address book behind the Client field. Loaded once per sign-in from
       /api/clients; selecting a saved client attaches their profile picture
       to the share (deliver-create snapshots it into the manifest, /receive
       shows it next to their name). Free text still works exactly as before
       — a one-off recipient never has to be saved. */
    let savedClients = [];
    let selectedClient = null;

    function initialsOf(name) {
      const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
      if (!parts.length) return '?';
      return (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
    }

    /* One builder for every round picture on the page: photo when there is
       one, initials when there isn't — never an empty or broken circle. */
    function avatarNode(client, sizeClass) {
      const span = document.createElement('span');
      span.className = 'avatar ' + sizeClass;
      span.setAttribute('aria-hidden', 'true');
      if (client && client.avatarUrl) {
        const img = document.createElement('img');
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.src = client.avatarUrl;
        // A dead avatar URL falls back to initials rather than a blank circle.
        img.addEventListener('error', () => {
          img.remove();
          span.textContent = initialsOf(client.name);
        });
        span.appendChild(img);
      } else {
        span.textContent = initialsOf(client && client.name);
      }
      return span;
    }

    async function loadClients() {
      const r = await api('/api/clients');
      if (r.ok) savedClients = (r.data && r.data.clients) || [];
    }

    function findClientByName(name) {
      const n = String(name || '').trim().toLowerCase();
      if (!n) return null;
      return savedClients.find((c) => String(c.name).toLowerCase() === n) || null;
    }

    /* What actually goes on the share: the explicit selection, or — if Pierce
       typed a name that happens to exactly match a saved client — that client.
       Typing "DuVine" should never lose the photo just because the menu row
       wasn't clicked. */
    function resolvedClient() {
      const typed = $('client-input').value.trim();
      if (selectedClient && selectedClient.name === typed) return selectedClient;
      return findClientByName(typed);
    }

    const clientInput = $('client-input');
    const clientMenu = $('client-menu');
    const clientChip = $('client-chip');
    const clientCaret = $('client-caret');
    let menuIndex = -1;

    function syncChip() {
      const c = resolvedClient();
      clientChip.hidden = !c;
      clientInput.classList.toggle('has-chip', !!c);
      if (c) {
        clientChip.textContent = '';
        clientChip.appendChild(avatarNode(c, 'avatar-md'));
        clientChip.setAttribute('aria-label', 'Change photo for ' + c.name);
      }
    }

    function closeMenu() {
      clientMenu.hidden = true;
      clientCaret.classList.remove('open');
      clientInput.setAttribute('aria-expanded', 'false');
      menuIndex = -1;
    }

    function menuRows() {
      return Array.from(clientMenu.querySelectorAll('.client-opt'));
    }

    function setActive(i) {
      const rows = menuRows();
      if (!rows.length) return;
      menuIndex = ((i % rows.length) + rows.length) % rows.length;
      rows.forEach((r, j) => r.classList.toggle('is-active', j === menuIndex));
      rows[menuIndex].scrollIntoView({ block: 'nearest' });
    }

    function pickClient(c) {
      selectedClient = c;
      clientInput.value = c.name;
      closeMenu();
      syncChip();
      updateCreateBtn();
    }

    function openMenu() {
      const typed = clientInput.value.trim();
      const filter = typed.toLowerCase();
      /* resolvedClient(), not findClientByName(): the current selection
         counts as saved even if the fetched list doesn't contain it yet.
         Belt-and-braces against a stale address-book read — without it the
         menu offered to "save as new" a client whose photo was sitting in
         the chip right next to it (Pierce, 2026-08-08; root cause was CDN
         caching on clients/index.json, fixed in api/clients.js). */
      const exact = resolvedClient();
      /* Once the field holds an exact saved client, the text is a SELECTION,
         not a search — filtering by it would show only the already-chosen
         row, which answers nothing (Pierce, 2026-08-08). Reopening the menu
         shows the whole address book, current pick checked, so switching
         clients is one click instead of clear-then-retype. */
      const matches = exact
        ? savedClients.slice()
        : savedClients.filter((c) => String(c.name).toLowerCase().includes(filter));
      if (exact && !matches.some((c) => c.id === exact.id)) matches.unshift(exact);
      clientMenu.innerHTML = '';

      matches.forEach((c) => {
        const li = document.createElement('li');
        li.className = 'client-opt';
        li.setAttribute('role', 'option');
        li.appendChild(avatarNode(c, 'avatar-md'));
        const name = document.createElement('span');
        name.className = 'co-name';
        name.textContent = c.name;
        li.appendChild(name);
        if (exact && exact.id === c.id) {
          li.setAttribute('aria-selected', 'true');
          const check = document.createElement('span');
          check.className = 'co-check';
          check.setAttribute('aria-hidden', 'true');
          check.innerHTML = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" ' +
            'stroke="currentColor" stroke-width="2.6" stroke-linecap="round" ' +
            'stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
          li.appendChild(check);
        }
        /* Edit button, shown on row hover (CSS) — opens the same modal
           (name + photo + Delete). mousedown with stopPropagation so it
           never also picks the row. */
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'co-edit';
        edit.textContent = 'Edit';
        edit.setAttribute('aria-label', 'Edit ' + c.name);
        edit.addEventListener('mousedown', (e) => {
          e.preventDefault();
          e.stopPropagation();
          closeMenu();
          openClientModal({ client: c });
        });
        li.appendChild(edit);
        /* mousedown, not click: click fires after the input's blur has
           already closed the menu and the row is gone. */
        li.addEventListener('mousedown', (e) => { e.preventDefault(); pickClient(c); });
        clientMenu.appendChild(li);
      });

      if (typed && !exact) {
        if (matches.length) {
          const rule = document.createElement('li');
          rule.className = 'co-rule';
          rule.setAttribute('role', 'presentation');
          clientMenu.appendChild(rule);
        }
        const li = document.createElement('li');
        li.className = 'client-opt co-add';
        li.setAttribute('role', 'option');
        const plus = document.createElement('span');
        plus.className = 'avatar avatar-md';
        plus.setAttribute('aria-hidden', 'true');
        plus.textContent = '+';
        li.appendChild(plus);
        const name = document.createElement('span');
        name.className = 'co-name';
        name.textContent = 'Save “' + typed + '” as a new client';
        li.appendChild(name);
        li.addEventListener('mousedown', (e) => { e.preventDefault(); closeMenu(); openClientModal({ name: typed }); });
        clientMenu.appendChild(li);
      }

      if (!clientMenu.children.length) {
        const li = document.createElement('li');
        li.className = 'co-empty';
        li.textContent = 'No saved clients yet — type a name, then save it here.';
        clientMenu.appendChild(li);
      }

      clientMenu.hidden = false;
      clientCaret.classList.add('open');
      clientInput.setAttribute('aria-expanded', 'true');
      menuIndex = -1;
    }

    clientInput.addEventListener('input', () => {
      if (selectedClient && selectedClient.name !== clientInput.value.trim()) selectedClient = null;
      syncChip();
      openMenu();
      updateCreateBtn();
    });
    clientInput.addEventListener('focus', openMenu);
    // Focus doesn't re-fire on an already-focused input — after picking a
    // client the menu closes but focus stays, so a plain click must reopen.
    clientInput.addEventListener('click', () => { if (clientMenu.hidden) openMenu(); });
    clientInput.addEventListener('blur', () => setTimeout(closeMenu, 120));
    clientInput.addEventListener('keydown', (e) => {
      if (clientMenu.hidden && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) { openMenu(); e.preventDefault(); return; }
      if (clientMenu.hidden) return;
      if (e.key === 'ArrowDown') { setActive(menuIndex + 1); e.preventDefault(); }
      else if (e.key === 'ArrowUp') { setActive(menuIndex - 1); e.preventDefault(); }
      else if (e.key === 'Enter') {
        const rows = menuRows();
        if (menuIndex >= 0 && rows[menuIndex]) {
          rows[menuIndex].dispatchEvent(new MouseEvent('mousedown'));
          e.preventDefault();
        } else closeMenu();
      }
      else if (e.key === 'Escape') closeMenu();
    });
    // mousedown so it wins the race against the input's blur → closeMenu.
    clientCaret.addEventListener('mousedown', (e) => {
      e.preventDefault();
      if (clientMenu.hidden) { clientInput.focus(); openMenu(); } else closeMenu();
    });
    clientChip.addEventListener('click', () => {
      const c = resolvedClient();
      if (c) openClientModal({ client: c });
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#client-row')) closeMenu();
    });

    /* ---------------------------------------------------- client modal --- */
    const cmodal = $('client-modal');
    let cmodalClient = null;   // editing this saved client, or null for new

    /* ---- crop state -----------------------------------------------------
       The preview is a live <canvas>, never an object URL. The first version
       previewed through URL.createObjectURL(), and the page's CSP (img-src
       'self' data: https:) silently blocked the blob: URL — the circle showed
       nothing until the photo came back from Blob storage as https after
       saving. A canvas needs no URL at all, and it's what makes the crop
       interactive: drag repositions, the slider zooms, and save bakes exactly
       the framing on screen.

       Geometry lives in output space (the AVATAR_EDGE square): `zoom` is a
       multiplier on the cover scale (1 = smallest scale that still fills the
       circle), offX/offY are the draw origin, clamped so the photo can never
       be dragged off the circle's edge. */
    const AVATAR_EDGE = 512;
    let cmodalBmp = null;      // ImageBitmap of the chosen photo, full size
    let cmodalZoom = 1;
    let cmodalOffX = 0, cmodalOffY = 0;

    function cropScale() {
      return (AVATAR_EDGE / Math.min(cmodalBmp.width, cmodalBmp.height)) * cmodalZoom;
    }
    function clampOffsets() {
      const s = cropScale();
      cmodalOffX = Math.min(0, Math.max(AVATAR_EDGE - cmodalBmp.width * s, cmodalOffX));
      cmodalOffY = Math.min(0, Math.max(AVATAR_EDGE - cmodalBmp.height * s, cmodalOffY));
    }
    function centerCrop() {
      const s = cropScale();
      cmodalOffX = (AVATAR_EDGE - cmodalBmp.width * s) / 2;
      cmodalOffY = (AVATAR_EDGE - cmodalBmp.height * s) / 2;
    }
    /* One draw routine for both the 96px preview and the 512px save — the
       factor k maps output space onto whatever canvas it's given, so the two
       cannot disagree about the framing. */
    function drawCrop(canvas) {
      const k = canvas.width / AVATAR_EDGE;
      const s = cropScale();
      const ctx = canvas.getContext('2d');
      ctx.fillStyle = '#fff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(cmodalBmp, cmodalOffX * k, cmodalOffY * k,
        cmodalBmp.width * s * k, cmodalBmp.height * s * k);
    }

    let cropCanvas = null;
    function paintCropPreview() {
      if (!cropCanvas || !cmodalBmp) return;
      drawCrop(cropCanvas);
    }
    /* The saved avatar, baked from the crop state at full size. */
    function bakeAvatar() {
      const out = document.createElement('canvas');
      out.width = AVATAR_EDGE; out.height = AVATAR_EDGE;
      drawCrop(out);
      return new Promise((resolve) => out.toBlob(resolve, 'image/jpeg', 0.82));
    }

    function cmodalPaintAvatar() {
      const holder = $('cmodal-avatar');
      holder.textContent = '';
      holder.classList.remove('has-img');
      $('cmodal-pic').classList.toggle('is-cropping', !!cmodalBmp);
      $('cmodal-crop').hidden = !cmodalBmp;
      if (cmodalBmp) {
        // Backing store at 2x the layout size so the round preview stays
        // crisp on retina; drawCrop scales through canvas.width either way.
        cropCanvas = document.createElement('canvas');
        cropCanvas.width = 192; cropCanvas.height = 192;
        holder.appendChild(cropCanvas);
        holder.classList.add('has-img');
        paintCropPreview();
        $('cmodal-pic-hint').textContent = 'Drag to frame · click to replace';
      } else if (cmodalClient && cmodalClient.avatarUrl) {
        // Existing saved photo: an https URL from our Blob store — CSP-fine.
        const img = document.createElement('img');
        img.alt = '';
        img.src = cmodalClient.avatarUrl;
        holder.appendChild(img);
        holder.classList.add('has-img');
        $('cmodal-pic-hint').textContent = 'Change photo';
      } else {
        cropCanvas = null;
        holder.textContent = initialsOf($('cmodal-name').value || (cmodalClient && cmodalClient.name));
        $('cmodal-pic-hint').textContent = 'Add photo';
      }
    }

    let cmodalReturnFocus = null;
    function openClientModal(opts) {
      cmodalClient = (opts && opts.client) || null;
      if (cmodalBmp) { cmodalBmp.close(); cmodalBmp = null; }
      cmodalZoom = 1;
      $('cmodal-zoom').value = '1';
      cmodalReturnFocus = document.activeElement;
      $('cmodal-title').textContent = cmodalClient ? 'Edit client' : 'New client';
      $('cmodal-save').textContent = 'Save client';
      $('cmodal-save').disabled = false;
      $('cmodal-name').value = cmodalClient ? cmodalClient.name : String((opts && opts.name) || '');
      const note = $('cmodal-note');
      note.textContent = '';
      note.className = 'note';
      $('cmodal-delete').hidden = !cmodalClient;
      cmodalPaintAvatar();
      cmodal.hidden = false;
      // New client with a name already typed: the photo is the missing piece,
      // so the photo well gets focus. Blank name gets the name field.
      ($('cmodal-name').value ? $('cmodal-pic') : $('cmodal-name')).focus();
    }

    function closeClientModal() {
      cmodal.hidden = true;
      if (cmodalBmp) { cmodalBmp.close(); cmodalBmp = null; }
      if (cmodalReturnFocus && cmodalReturnFocus.isConnected) cmodalReturnFocus.focus();
    }

    async function cmodalTakeFile(file) {
      if (!file || !/^image\//.test(file.type)) return;
      const note = $('cmodal-note');
      note.textContent = '';
      note.className = 'note';
      try {
        /* from-image = respect EXIF rotation, so a phone photo doesn't come
           in sideways. Older Safari rejects the options bag; fall back bare. */
        let bmp;
        try { bmp = await createImageBitmap(file, { imageOrientation: 'from-image' }); }
        catch (e) { bmp = await createImageBitmap(file); }
        if (cmodalBmp) cmodalBmp.close();
        cmodalBmp = bmp;
        cmodalZoom = 1;
        $('cmodal-zoom').value = '1';
        centerCrop();
        cmodalPaintAvatar();
      } catch (e) {
        note.textContent = 'Could not read that image. Try a JPEG or PNG.';
        note.className = 'note is-error';
      }
    }

    /* ---- drag to reposition / slider to zoom ---------------------------
       Pointer events on the circle. A press-and-move drags the photo; a
       press that never travels past the threshold is a click, which opens
       the file picker (both before a photo exists and after — "click to
       replace"). The threshold is what lets one surface do both without a
       separate replace button. */
    const picBtn = $('cmodal-pic');
    let dragId = null, dragMoved = false, dragTravel = 0, dragLastX = 0, dragLastY = 0;

    picBtn.addEventListener('pointerdown', (e) => {
      if (!cmodalBmp) return;
      dragId = e.pointerId;
      dragMoved = false;
      dragTravel = 0;
      dragLastX = e.clientX; dragLastY = e.clientY;
      picBtn.setPointerCapture(dragId);
    });
    picBtn.addEventListener('pointermove', (e) => {
      if (dragId === null || e.pointerId !== dragId || !cmodalBmp) return;
      const dx = e.clientX - dragLastX, dy = e.clientY - dragLastY;
      if (!dx && !dy) return;
      dragLastX = e.clientX; dragLastY = e.clientY;
      // A few pixels of travel is still a click; past that it's a drag.
      dragTravel += Math.hypot(dx, dy);
      if (dragTravel > 3) dragMoved = true;
      if (!dragMoved) return;
      // Screen pixels -> output space: the circle is 96 CSS px for a 512 square.
      const k = AVATAR_EDGE / picBtn.querySelector('.avatar-xl').offsetWidth;
      cmodalOffX += dx * k;
      cmodalOffY += dy * k;
      clampOffsets();
      paintCropPreview();
    });
    function endDrag(e) {
      if (dragId === null || e.pointerId !== dragId) return;
      try { picBtn.releasePointerCapture(dragId); } catch (err) {}
      dragId = null;
      // Swallow the click this press would produce if it was really a drag.
      if (dragMoved) {
        const stop = (ev) => { ev.stopPropagation(); ev.preventDefault(); };
        picBtn.addEventListener('click', stop, { capture: true, once: true });
        // If no click follows (pointer released off-element), drop the trap.
        setTimeout(() => picBtn.removeEventListener('click', stop, { capture: true }), 0);
      }
    }
    picBtn.addEventListener('pointerup', endDrag);
    picBtn.addEventListener('pointercancel', endDrag);

    $('cmodal-zoom').addEventListener('input', () => {
      if (!cmodalBmp) return;
      const prev = cropScale();
      cmodalZoom = Number($('cmodal-zoom').value) || 1;
      const next = cropScale();
      /* Zoom about the circle's centre, not the top-left corner — keep the
         output-space point currently at centre where it is. */
      const c = AVATAR_EDGE / 2;
      cmodalOffX = c - ((c - cmodalOffX) / prev) * next;
      cmodalOffY = c - ((c - cmodalOffY) / prev) * next;
      clampOffsets();
      paintCropPreview();
    });

    picBtn.addEventListener('click', () => $('cmodal-file').click());
    $('cmodal-file').addEventListener('change', () => {
      cmodalTakeFile($('cmodal-file').files[0]);
      $('cmodal-file').value = '';
    });
    ['dragenter', 'dragover'].forEach((ev) => $('cmodal-pic').addEventListener(ev, (e) => {
      e.preventDefault(); $('cmodal-pic').classList.add('is-over');
    }));
    ['dragleave', 'drop'].forEach((ev) => $('cmodal-pic').addEventListener(ev, (e) => {
      e.preventDefault(); $('cmodal-pic').classList.remove('is-over');
    }));
    $('cmodal-pic').addEventListener('drop', (e) => {
      if (e.dataTransfer && e.dataTransfer.files[0]) cmodalTakeFile(e.dataTransfer.files[0]);
    });
    // Typing a name updates the initials preview live (photo-less case only).
    $('cmodal-name').addEventListener('input', () => {
      if (!cmodalBmp && !(cmodalClient && cmodalClient.avatarUrl)) cmodalPaintAvatar();
    });

    $('cmodal-delete').addEventListener('click', async () => {
      if (!cmodalClient) return;
      if (!confirm('Delete "' + cmodalClient.name + '" from saved clients? Shares already sent are untouched.')) return;
      const note = $('cmodal-note');
      const btn = $('cmodal-delete');
      btn.disabled = true;
      try {
        const r = await api('/api/clients', { method: 'POST', body: { action: 'delete', id: cmodalClient.id } });
        if (!r.ok) throw new Error((r.data && r.data.error) || 'Could not delete this client.');
        await loadClients();
        if (selectedClient && selectedClient.id === cmodalClient.id) selectedClient = null;
        syncChip();
        closeClientModal();
        refreshShares(); // their rows fall back to the manifest photo or initials
      } catch (err) {
        note.textContent = (err && err.message) || 'Could not delete. Please retry.';
        note.className = 'note is-error';
      } finally {
        btn.disabled = false;
      }
    });

    $('cmodal-cancel').addEventListener('click', closeClientModal);
    $('cmodal-backdrop').addEventListener('click', closeClientModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !cmodal.hidden) closeClientModal();
    });

    $('cmodal-save').addEventListener('click', async () => {
      const note = $('cmodal-note');
      const btn = $('cmodal-save');
      const name = $('cmodal-name').value.trim();
      note.textContent = '';
      note.className = 'note';
      if (!name) {
        note.textContent = 'A client needs a name.';
        note.className = 'note is-error';
        $('cmodal-name').focus();
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try {
        /* Upload FIRST, save ONCE. The old shape (save name -> upload ->
           save again with the URL) was two index writes ~1s apart with a
           read in between, and Blob overwrite propagation meant that read
           could see a base from before the first write — which is how
           DuVine kept un-saving (2026-08-08). The id is generated here for
           new clients so the avatar has its path before the client exists;
           api/clients.js accepts it. */
        const id = (cmodalClient && cmodalClient.id) || randomToken(12);
        let avatarUrl = null;
        if (cmodalBmp) {
          // Bake the on-screen framing to a 512px JPEG — a phone photo comes
          // in at 4MB+; the avatar painted at 30px should be kilobytes.
          const baked = await bakeAvatar();
          const mod = await blobClient();
          /* Timestamped path rather than a fixed one: Blob serves public URLs
             with long cache headers, so overwriting <id>.jpg in place would
             keep showing the OLD photo everywhere until caches expired. A new
             URL is correct immediately; api/clients.js deletes by the <id>
             prefix, so old versions still get cleaned up with the client. */
          const up = await mod.upload(
            'clients/avatars/' + id + '-' + Date.now() + '.jpg',
            baked,
            { access: 'public', handleUploadUrl: '/api/deliver-upload-token', contentType: 'image/jpeg' }
          );
          avatarUrl = up.url;
        }

        const r = await api('/api/clients', { method: 'POST', body: {
          action: 'save', id, name, ...(avatarUrl ? { avatarUrl } : {}),
        }});
        if (!r.ok) throw new Error((r.data && r.data.error) || 'Could not save this client.');
        const client = r.data.client;

        await loadClients();
        /* The reloaded list can lag a just-written index by a beat; the save
           response is authoritative, so make sure it's represented locally. */
        if (!savedClients.some((c) => c.id === client.id)) savedClients.push(client);
        const fresh = savedClients.find((c) => c.id === client.id) || client;
        closeClientModal();
        pickClient(fresh);
        refreshShares(); // recent rows for this client pick up the new photo
      } catch (err) {
        note.textContent = (err && err.message) || 'Could not save. Please retry.';
        note.className = 'note is-error';
        btn.disabled = false;
        btn.textContent = 'Save client';
      } finally {
        if (cmodal.hidden) { btn.disabled = false; btn.textContent = 'Save client'; }
      }
    });

    /* Update one row's fill and label in place. A full renderFiles() on every
       progress tick would rebuild the <li> and restart the width transition
       from 0, so the bar could never actually animate — and it thrashed the
       DOM during the upload, which is exactly when there's least to spare. */
    function paintRow(item) {
      const li = item._el;
      if (!li) return;
      /* A row that was already in the share is deliberately left un-filled and
         un-lit — see .frow-status.is-sent in the CSS for why. */
      const sent = !!item.sent;
      const done = item.status === 'ok';
      const pct = sent ? 0
        : done ? 100
        : item.status === 'err' ? 0
        : (typeof item.pct === 'number' ? item.pct : 0);
      const fill = li.querySelector('.frow-fill');
      if (fill) fill.style.width = pct + '%';
      li.classList.toggle('is-sent', sent);
      li.classList.toggle('is-done', !sent && done);
      const lit = !sent && item.status !== 'err';
      li.classList.toggle('name-lit', lit && (done || pct >= 22));
      li.classList.toggle('meta-lit', lit && (done || pct >= 90));
      const el = li.querySelector('.frow-status');
      if (el) {
        const st = rowStatus(item);
        el.className = 'frow-status is-' + st.cls;
        el.textContent = st.text;
      }
    }

    /* Anything past this goes up in 8MB parts instead of one enormous PUT.
       A single-request upload dies somewhere north of half a gigabyte — the
       socket just stops, no error, and the row sits frozen at whatever percent
       it reached. Multipart also means a dropped part retries on its own
       instead of restarting the entire file from zero. */
    const MULTIPART_THRESHOLD = 50 * 1024 * 1024;

    /* And a watchdog on top of that, because the failure mode here is silence.
       When a socket dies mid-transfer nothing rejects — the byte counter simply
       stops moving and the row goes on looking busy forever, which is the worst
       possible thing for it to do. So we watch the counter ourselves: no bytes
       for STALL_MS means the transfer is dead, and we'd rather say so and let
       the file be retried than leave it spinning. Ninety seconds is long enough
       that a genuinely slow uplink between 8MB parts never trips it. */
    const STALL_MS = 90 * 1000;
    const STALL_CHECK_MS = 5 * 1000;

    async function uploadOne(item, token) {
      uploading++;
      item.status = 'up';
      item.pct = 0;
      paintRow(item);
      const mod = await blobClient();

      const ctrl = new AbortController();
      let lastProgressAt = Date.now();
      let stalled = false;
      const watchdog = setInterval(() => {
        if (Date.now() - lastProgressAt < STALL_MS) return;
        stalled = true;
        clearInterval(watchdog);
        ctrl.abort();
      }, STALL_CHECK_MS);

      let result;
      try {
        result = await mod.upload('deliveries/' + token + '/' + item.file.name, item.file, {
          access: 'public',
          handleUploadUrl: '/api/deliver-upload-token',
          multipart: item.file.size > MULTIPART_THRESHOLD,
          abortSignal: ctrl.signal,
          onUploadProgress: (p) => {
            lastProgressAt = Date.now();
            item.pct = p && typeof p.percentage === 'number' ? p.percentage : item.pct;
            paintRow(item);
          },
        });
      } catch (e) {
        /* Rewrite the abort into something that says what actually happened —
           an AbortError here means our own watchdog pulled the plug, and the
           file needs sending again. */
        if (stalled) {
          throw new Error('\u201C' + item.file.name + '\u201D stopped sending at ' + Math.round(item.pct) + '%. The connection dropped \u2014 remove it from the list and add it again to retry.');
        }
        throw e;
      } finally {
        clearInterval(watchdog);
      }

      item.status = 'ok';
      item.url = result.url;
      paintRow(item);
      /* Then the preview thumbnail, if this file gets one. Deliberately after
         the row reads "done" — the file IS delivered at this point, and the
         thumbnail is a nicety on top. Swallowing the error is the whole design:
         a PDF that pdf.js can't parse (or an image the canvas won't take) still
         ships, it just falls back to /receive's extension tile. */
      try {
        const t = await makeThumb(item.file);
        if (t) item.thumbUrl = await uploadThumb(t, token, randomToken(8));
      } catch (e) {
        console.warn('Preview thumbnail skipped for ' + item.file.name, e);
      }
      uploading--;
      resetIdle();
      paintRow(item);
    }

    async function submitShare() {
      const note = $('create-note');
      note.textContent = '';
      note.className = 'note';
      const client = $('client-input').value.trim();
      const project = $('project-input').value.trim();
      if (!client || !queued.length) return;

      // Editing keeps the share's own token — that IS the link the client
      // already has, and not changing it is the entire point of the feature.
      const token = editing ? editing.token : randomToken();

      /* The one irreversible thing on this page, so the one thing that asks
         first. Removing a file from a sent share deletes the blob, which means
         the direct URL stops working too — including for anyone the client
         forwarded it to. That's usually exactly what's wanted, but it isn't
         guessable from a × on a row, so it gets named out loud, once, here
         rather than per-click in renderFiles(). */
      if (editing) {
        const kept = new Set(queued.map((q) => q.name));
        const gone = editing.files.filter((f) => !kept.has(f.name));
        if (gone.length) {
          const what = gone.length === 1
            ? '“' + gone[0].name + '”'
            : gone.length + ' files (' + gone.map((f) => f.name).join(', ') + ')';
          if (!confirm('Permanently delete ' + what + ' from this share?\n\nThe file itself is deleted, not just hidden — anyone holding the direct link loses it too. This can’t be undone.')) return;
        }
      }

      $('create-btn').disabled = true;

      try {
        // Small concurrency cap so a big batch doesn't open dozens of PUTs at once.
        const CONCURRENCY = 3;
        let cursor = 0;
        async function worker() {
          while (cursor < queued.length) {
            const item = queued[cursor++];
            // Already in the share — it has a URL, there's nothing to send.
            if (item.sent) continue;
            try { await uploadOne(item, token); } catch (e) {
              item.status = 'err';
              uploading = Math.max(0, uploading - 1);
              paintRow(item);
              throw e;
            }
          }
        }
        await Promise.all(Array.from({ length: Math.min(CONCURRENCY, queued.length) }, worker));

        /* Files already in the share come through untouched; the rest need a
           finished upload to have a URL at all. thumbUrl is only present on
           the ones that got a preview generated above — deliver-create and
           deliver-update both keep it optional and /receive falls back to its
           extension tile without it. */
        const files = queued.filter((i) => i.sent || i.status === 'ok').map((i) => ({
          name: i.name, url: i.url, size: i.size,
          ...(i.thumbUrl ? { thumbUrl: i.thumbUrl } : {}),
        }));
        if (!files.length) throw new Error('No files uploaded successfully.');

        /* Saved client selected (or name-matched): their profile picture rides
           along and /receive shows it next to their name. On an edit where the
           name no longer matches anyone in the address book, the picture the
           manifest already stored is written back rather than dropped — a
           copy-edit to the project line shouldn't cost the share its avatar. */
        const rc = resolvedClient();
        const avatarUrl = (rc && rc.avatarUrl) || (editing ? editing.storedAvatarUrl : null);
        const body = { token, client, project, files, ...(avatarUrl ? { avatarUrl } : {}) };

        if (editing) {
          const r = await api('/api/deliver-update', { method: 'POST', body });
          if (!r.ok) throw new Error((r.data && r.data.error) || 'Could not save this share.');
          /* Repaint the row from what the server just wrote instead of waiting
             on a re-list: a brand-new manifest version takes a moment to turn
             up in a list(), and "Saved" next to an unchanged row reads as a
             failed save. refreshShares() still runs, it just isn't the thing
             the confirmation depends on. */
          if (r.data && r.data.share) {
            const at = sharesCache.findIndex((s) => s.token === token);
            if (at >= 0) sharesCache[at] = r.data.share;
            else sharesCache.unshift(r.data.share);
          }
          const savedTo = editing.url.replace(/^https?:\/\//, '');
          leaveEdit();
          renderShares(sharesCache);
          note.textContent = 'Saved. ' + savedTo + ' is unchanged — the client sees the update on their next visit.';
          note.className = 'note is-ok';
          refreshShares();
        } else {
          const r = await api('/api/deliver-create', { method: 'POST', body: {
            ...body, expiresInDays: selectedExpiryDays(),
          } });
          if (!r.ok) throw new Error((r.data && r.data.error) || 'Could not save this share.');
          $('out-link').value = r.data.url;
          swapStep($('new-share'), $('success'));
          await refreshShares();
        }
      } catch (err) {
        note.textContent = err && err.message ? err.message : 'Something went wrong. Please retry.';
        note.className = 'note is-error';
        /* A replacement that never uploaded took the row it displaced with it.
           Put that row back: the share still has that file, and leaving the
           list saying otherwise would delete it on the next Save. */
        let restored = false;
        queued = queued.map((i) => {
          if (i.status === 'err' && i.prev) { restored = true; return i.prev; }
          return i;
        });
        if (restored) renderFiles();
      } finally {
        updateCreateBtn();
      }
    }

    $('create-btn').addEventListener('click', submitShare);

    /* ------------------------------------------------------ editing a share --- */
    /* Everything that differs between "New share" and "Edit share" happens
       here, in one function, so the card can't end up half-swapped: title,
       which share, the expiry control (a live picker vs a fixed read-out),
       the drop hint, and the button row. */
    function setMode() {
      const on = !!editing;
      $('new-share-title').textContent = on ? 'Edit share' : 'New share';
      const target = $('edit-target');
      target.hidden = !on;
      if (on) target.textContent = editing.url.replace(/^https?:\/\//, '');
      $('expiry-field').hidden = on;
      $('edit-expiry-field').hidden = !on;
      if (on) {
        const exp = $('edit-expiry');
        exp.textContent = expiryText(editing.expiresAt);
        exp.classList.toggle('is-forever', !editing.expiresAt);
      }
      $('create-btn').textContent = on ? 'Save changes' : 'Create share';
      $('cancel-edit').hidden = !on;
      $('drop-hint').textContent = on
        ? 'Drag files here to add them, or click to choose'
        : 'Drag files here, or click to choose';
      updateCreateBtn();
    }

    /* Lenis owns the scroll on this page, so scrollIntoView() fights it —
       ask Lenis when it's there and fall back only when it isn't. */
    function focusEditor() {
      const el = $('new-share');
      try {
        if (window._lenis && window._lenis.scrollTo) {
          window._lenis.scrollTo(el, { offset: -120 });
          return;
        }
      } catch (e) { /* fall through */ }
      el.scrollIntoView({ behavior: REDUCE() ? 'auto' : 'smooth', block: 'start' });
    }

    /* Load a sent share into the card above. The row only carries a summary
       (deliver-list deliberately withholds the file URLs), so the full
       manifest comes from deliver-get — the same call /receive makes, which
       also means an expired share answers 410 here and can't be edited, which
       is right: expiry is fixed, so there'd be nothing to save it into. */
    async function enterEdit(share, btn) {
      if (!editing && queued.length &&
          !confirm('Discard the files queued for the new share and edit “' + (share.client || 'this share') + '” instead?')) return;

      const label = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Opening'; }
      const r = await api('/api/deliver-get', { method: 'POST', body: { token: share.token } });
      if (btn) { btn.disabled = false; btn.textContent = label; }

      const note = $('create-note');
      if (!r.ok) {
        note.textContent = r.status === 410
          ? 'This share has expired, so there’s nothing left to edit — delete it and send a new link.'
          : ((r.data && r.data.error) || 'Could not open this share.');
        note.className = 'note is-error';
        focusEditor();
        return;
      }

      const d = r.data || {};
      editing = {
        token: share.token,
        url: 'https://cognak.com/files/' + share.token,
        expiresAt: d.expiresAt || null,
        // The manifest's own snapshot, NOT the live address-book photo
        // deliver-get resolves for display — see submitShare().
        storedAvatarUrl: d.storedAvatarUrl || null,
        files: (d.files || []).map((f) => ({
          name: String(f.name || ''), url: f.url, size: Number(f.size) || 0,
          ...(f.thumbUrl ? { thumbUrl: f.thumbUrl } : {}),
        })),
      };
      // A copy per list: `queued` is edited freely, `editing.files` stays as
      // the record of what the share held when it was opened, which is what
      // submitShare() diffs against to name the deletions.
      queued = editing.files.map((f) => ({ ...f, sent: true, status: 'ok', pct: 100 }));

      $('client-input').value = d.client || '';
      selectedClient = findClientByName(d.client || '') || null;
      syncChip();
      $('project-input').value = d.project || '';
      note.textContent = '';
      note.className = 'note';
      renderFiles();
      setMode();
      renderShares(sharesCache); // marks the row being edited

      // If the success card is showing, the form isn't on screen to edit.
      if (!$('success').hidden) swapStep($('success'), $('new-share'), focusEditor);
      else focusEditor();
    }

    function leaveEdit() {
      editing = null;
      queued = [];
      $('client-input').value = '';
      selectedClient = null;
      syncChip();
      $('project-input').value = '';
      renderFiles();
      setMode();
    }

    $('cancel-edit').addEventListener('click', () => {
      leaveEdit();
      $('create-note').textContent = '';
      $('create-note').className = 'note';
      renderShares(sharesCache); // clears the row highlight
    });

    $('start-another').addEventListener('click', () => {
      queued = [];
      renderFiles();
      $('client-input').value = '';
      selectedClient = null;
      syncChip();
      $('project-input').value = '';
      $('create-note').textContent = '';
      swapStep($('success'), $('new-share'));
      updateCreateBtn();
    });

    /* Only ever ONE button reads "Copied" — the clipboard holds one thing, so
       two buttons both claiming to be the copied one is a lie about which
       value you actually have. Clicking any copy button reverts the previous
       one immediately rather than waiting out its own timer. Labels are
       remembered on the node, so this survives the shares list re-rendering. */
    let copiedBtn = null;
    let copiedTimer = 0;

    function resetCopied() {
      if (!copiedBtn) return;
      if (copiedBtn.isConnected) {
        copiedBtn.textContent = copiedBtn.dataset.copyLabel || 'Copy';
        if (copiedBtn.dataset.copyAria) copiedBtn.setAttribute('aria-label', copiedBtn.dataset.copyAria);
        copiedBtn.style.minWidth = '';
      }
      copiedBtn = null;
    }

    function markCopied(btn) {
      clearTimeout(copiedTimer);
      resetCopied();
      if (!btn.dataset.copyLabel) btn.dataset.copyLabel = btn.textContent;
      const aria = btn.getAttribute('aria-label');
      if (aria && !btn.dataset.copyAria) btn.dataset.copyAria = aria;
      // Lock the pill at its resting width BEFORE swapping the label — "Copy
      // link" (9 chars) -> "Copied" (6) would otherwise shrink the button for
      // those 2 seconds, which read as a layout hiccup rather than a
      // confirmation (Pierce, 2026-07-29). min-width only sets a floor, so
      // the "Copy" -> "Copied" case (where Copied is the wider one) can still
      // grow to fit — only shrinking was the complaint.
      btn.style.minWidth = btn.getBoundingClientRect().width + 'px';
      btn.textContent = 'Copied';
      // Swap the aria-label too, not just the visible text — otherwise the
      // label overrides the contents and screen readers never hear "Copied".
      if (btn.dataset.copyAria) btn.setAttribute('aria-label', btn.dataset.copyAria + ' — copied');
      copiedBtn = btn;
      copiedTimer = setTimeout(resetCopied, 2000);
    }

    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const input = document.getElementById(btn.dataset.copy);
        try {
          await navigator.clipboard.writeText(input.value);
          markCopied(btn);
        } catch (e) {
          input.select();
        }
      });
    });

    /* -------------------------------------------------------------- shares --- */
    /* Single source of truth for the countdown wording, used both at render
       time and by the ticker below. Under a day it counts in hours and then
       minutes — that's the window where the number actually changes while
       you're looking at it. Above that, days/weeks/months/years, because
       "expires in 340 days" is a number you'd have to convert yourself. */
    function expiryText(expiresAt) {
      if (!expiresAt) return 'Never expires';
      const ms = new Date(expiresAt) - Date.now();
      if (ms <= 0) return 'EXPIRED';
      const mins = Math.floor(ms / 60000);
      if (mins < 60) return 'Expires in ' + mins + (mins === 1 ? ' minute' : ' minutes');
      const hours = Math.floor(ms / 3600000);
      if (hours < 24) return 'Expires in ' + hours + (hours === 1 ? ' hour' : ' hours');
      const days = Math.ceil(ms / 86400000);
      const human =
        days < 14 ? days + ' days' :
        days < 60 ? Math.round(days / 7) + ' weeks' :
        days < 365 ? Math.round(days / 30) + ' months' :
        Math.round(days / 365) + (Math.round(days / 365) === 1 ? ' year' : ' years');
      return 'Expires in ' + human;
    }

    /* Live countdown. Every 30s is enough for a minutes-resolution label and
       cheap enough to leave running — it only touches textContent on rows
       whose wording actually changed, so an idle dashboard does no DOM work.
       Rows crossing zero pick up .is-expired without needing a refetch. */
    setInterval(() => {
      document.querySelectorAll('.srow-expiry[data-expires-at]').forEach((el) => {
        const next = expiryText(el.dataset.expiresAt);
        if (el.textContent !== next) el.textContent = next;
        if (next === 'EXPIRED') el.closest('.srow').classList.add('is-expired');
      });
    }, 30000);

    /* The rows as last fetched. Held rather than passed straight through so
       the list can be repainted without a round-trip — marking which row is
       open in the editor, or swapping in the row the server just returned
       from a save (see submitShare()). */
    let sharesCache = [];

    function renderShares(shares) {
      sharesCache = shares;
      // The list is rebuilt from scratch, so any "Copied" button in it is about
      // to be detached; forget it rather than leave a dangling reference.
      if (copiedBtn && copiedBtn.closest('#shares-list')) { clearTimeout(copiedTimer); copiedBtn = null; }
      const list = $('shares-list');
      const empty = $('shares-empty');
      list.innerHTML = '';
      empty.hidden = shares.length > 0;
      shares.forEach((s) => {
        const li = document.createElement('li');
        li.className = 'srow';
        // Date AND time — two shares to the same client on one day are common,
        // and the date alone doesn't tell them apart. createdAt has always been
        // written by api/deliver-create.js; it just wasn't fully surfaced.
        const stamp = s.createdAt
          ? new Date(s.createdAt).toLocaleString(undefined, {
              month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
            })
          : '';
        li.innerHTML =
          '<div class="srow-main"><div class="srow-client">' +
          '<span class="srow-dl-badge" aria-hidden="true" hidden>' +
          '<svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" ' +
          'stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">' +
          '<path d="M12 3v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M5 20h14"/>' +
          '</svg></span>' +
          '<span class="srow-client-name"></span></div>' +
          '<div class="srow-meta"></div><div class="srow-expiry"></div>' +
          '<div class="srow-files"></div></div>' +
          '<div class="srow-actions">' +
          '<button type="button" class="btn btn-ghost" data-action="edit">Edit</button>' +
          '<button type="button" class="btn btn-ghost" data-action="copy">Copy link</button>' +
          '<button type="button" class="btn btn-ghost btn-danger" data-action="delete">Delete</button>' +
          '</div>';
        const clientName = s.client || 'Client';
        // "Client — Project" on one line, so the list scans as one column.
        li.querySelector('.srow-client-name').textContent =
          s.project ? clientName + ' — ' + s.project : clientName;
        /* Round client picture in front of the name. The LIVE address-book
           photo wins over the manifest's snapshot, so updating a client's
           photo updates their whole history here; initials otherwise. */
        const saved = findClientByName(clientName);
        const rowClient = (saved && saved.avatarUrl) ? saved : { name: clientName, avatarUrl: s.avatarUrl };
        const clientRow = li.querySelector('.srow-client');
        clientRow.insertBefore(avatarNode(rowClient, 'avatar-sm'), clientRow.firstChild);
        /* Download badge: has this client opened at least one file yet? Set
           server-side on the manifest the first time a /receive download
           link is clicked (api/deliver-track-download.js) — Pierce,
           2026-07-29. Title carries the "when" so it's not just a mystery
           icon; the badge itself stays a quiet yes/no. */
        const dlBadge = li.querySelector('.srow-dl-badge');
        dlBadge.hidden = !s.downloadedAt;
        if (s.downloadedAt) {
          dlBadge.title = 'Downloaded ' + new Date(s.downloadedAt).toLocaleString(undefined, {
            month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
          });
        }
        const rowLabel = s.project ? clientName + ', ' + s.project : clientName;
        li.querySelector('[data-action="copy"]').setAttribute('aria-label', 'Copy link for ' + rowLabel);
        li.querySelector('[data-action="delete"]').setAttribute('aria-label', 'Delete share for ' + rowLabel);
        const editBtn = li.querySelector('[data-action="edit"]');
        editBtn.setAttribute('aria-label', 'Edit share for ' + rowLabel);
        /* Expiry is the one piece of a share's state that changes on its own,
           so it reads as a live status rather than a static timestamp. */
        const expiryLabel = expiryText(s.expiresAt);
        const expired = !!(s.expiresAt && new Date(s.expiresAt) - Date.now() <= 0);
        if (expired) li.classList.add('is-expired');
        /* An expired share has nothing to edit into: expiry is fixed at
           creation (api/deliver-update.js), so saving couldn't bring the link
           back and the sweep is about to take the files anyway. Delete stays
           live — that's the useful action on a dead row. */
        if (expired) {
          editBtn.disabled = true;
          editBtn.title = 'Expired shares can’t be edited — the link is already dead.';
        }
        // Which row is currently loaded in the card at the top of the page.
        if (editing && editing.token === s.token) {
          li.classList.add('is-editing');
          editBtn.textContent = 'Editing';
          editBtn.disabled = true;
        }
        li.querySelector('.srow-meta').textContent =
          stamp + ' · ' + s.fileCount + (s.fileCount === 1 ? ' file' : ' files') + ' · ' + humanSize(s.totalSize || 0);
        const expEl = li.querySelector('.srow-expiry');
        expEl.textContent = expiryLabel;
        // Stamped on the node so the ticker can refresh it without a re-render.
        if (s.expiresAt) expEl.dataset.expiresAt = s.expiresAt;
        expEl.classList.toggle('is-forever', !s.expiresAt);
        // The actual filenames, so a share is identifiable without opening it —
        // Pierce: "otherwise i won't know what the sends were". CSS clamps this
        // to two lines; the full list is in the title attribute on hover.
        const fileNames = (s.fileNames || []).join(', ');
        const filesEl = li.querySelector('.srow-files');
        filesEl.textContent = fileNames;
        filesEl.hidden = !fileNames;
        if (fileNames) filesEl.title = (s.fileNames || []).join('\n');
        li.querySelector('[data-action="copy"]').addEventListener('click', async (e) => {
          // Capture the button BEFORE the await, not after: the browser nulls
          // out a DOM event's currentTarget once dispatch finishes, and an
          // await hands control back to the event loop, so by the time the
          // clipboard promise settles e.currentTarget is already null. That
          // was throwing "Cannot read properties of null (reading 'dataset')"
          // inside markCopied, silently, every single click — the button
          // never flipped to "Copied" (Pierce, 2026-07-29).
          const btn = e.currentTarget;
          const url = 'https://cognak.com/files/' + s.token;
          try { await navigator.clipboard.writeText(url); } catch (err) { /* ignore */ }
          markCopied(btn);
        });
        editBtn.addEventListener('click', (e) => enterEdit(s, e.currentTarget));
        li.querySelector('[data-action="delete"]').addEventListener('click', async () => {
          if (!confirm('Delete this share for "' + (s.client || 'this client') + '"? The link stops working immediately.')) return;
          await api('/api/deliver-delete', { method: 'POST', body: { token: s.token } });
          // Deleting the share you're editing leaves the card pointed at
          // nothing — close it rather than let Save 404 later.
          if (editing && editing.token === s.token) leaveEdit();
          await refreshShares();
        });
        list.appendChild(li);
      });
    }

    async function refreshShares() {
      const r = await api('/api/deliver-list');
      if (r.ok) renderShares((r.data && r.data.shares) || []);
    }

    checkAuth();
    requestAnimationFrame(() => {
      document.querySelectorAll('.send .rise').forEach((el) => el.classList.add('in'));
    });
  </script>

  <script is:inline>
    /* Fade the WebGL background in once UnicornStudio mounts its canvas (with a
       timed fallback), matching /brief and the site's hero fade. */
    (function(){
      var el=document.querySelector('.send-webgl');
      if(!el) return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      function ready(){ el.classList.add('webgl-ready'); }
      if('MutationObserver' in window){
        var mo=new MutationObserver(function(){ if(el.querySelector('canvas')){ ready(); mo.disconnect(); } });
        mo.observe(el,{childList:true,subtree:true});
        setTimeout(function(){ ready(); mo.disconnect(); }, 4000);
      } else {
        setTimeout(ready, 1200);
      }
    })();
  </script>
</BaseLayout>
