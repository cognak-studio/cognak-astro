---
/**
 * /send — hidden, password-protected client-delivery tool.
 * Not in nav, footer, or sitemap; noindex. Same "unlinked utility" model as
 * /tools, but gated behind ADMIN_PASSWORD (see api/_lib/adminAuth.mjs)
 * because this one handles real client files, not a stateless generator.
 *
 * Flow: sign in once (12h session cookie) -> name a client + set a passcode
 * -> drop files (uploaded straight to Vercel Blob via api/deliver-upload-
 * token.js, same client-upload handshake /brief already uses) -> get back a
 * cognak.com/files/<token> link + the passcode to send the client, instead of a
 * Hightail link. Recent shares are listed below with a delete action.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="send"
  title="Send – COGNAK"
  description="Internal client-delivery tool."
  ogUrl="https://cognak.com/send/"
  noindex={true}
  pageBg="#090C0B"
>
  <div class="send-webgl" data-us-project="PWb8s0lxglpnSGUgkkIR" aria-hidden="true"></div>

  <main id="cognak-main"><section class="send">

    {/* Kept on one source line, same as /tools: the word-splitter turns the
        text nodes either side of the <em> into spans, and a newline there is
        swallowed rather than kept as the space after "Send". */}
    <h1 class="headline send-headline"><em>Send</em> files to clients, no third-party link required.</h1>
    <p class="lede send-lede">Add details, drop files, and set a passcode. The client gets a cognak.com link so nothing leaves this domain.</p>

    <!-- ------------------------------------------------------- sign in --- -->
    {/* Passkey shows first paint, no flash — but the password fallback is
        NOT deleted: it's how [[send-lockout-recovery]] gets Pierce back in
        when ADMIN_PASSWORD_FALLBACK=1 is set after a lost device. The old
        bug wasn't the fallback logic (initGate() below is unchanged and was
        already correct) — it was that .btn{display:inline-flex} outranks the
        browser's own [hidden]{display:none} default (author CSS beats the UA
        sheet regardless of selector specificity), so hidden=true on these
        buttons never actually hid them; all three always rendered regardless
        of server state, including before initGate()'s fetch resolved. Fixed
        with the .send [hidden] rule in the stylesheet below. The remaining
        change here is just the DEFAULT markup state pre-JS: passkey-signin
        starts visible and everything else starts hidden, so first paint
        already matches the common case instead of a mid-load flash. */}
    <div class="acard rise" id="gate">
      <div class="group">
        {/* Icon badge + subtitle, added 2026-07-28 — a single centered pill
            button under the bare "SIGN IN" mono label read as unfinished
            once the password field (which used to fill this space) came out.
            Same accent-soft blue as the headline <em> and the CTA glow, so
            it reads as part of the existing palette rather than a new one. */}
        <div class="signin-head">
          {/* Pierce's own passkey mark (passkey.eps, converted 2026-07-28:
              gs -> PDF -> pdftocairo -svg, then every fill swapped to
              currentColor so it inherits --accent-soft like the rest of the
              badge). Native aspect ratio 90:107.3 preserved via viewBox. */}
          <span class="signin-icon" aria-hidden="true">
            <svg viewBox="0 0 90 107.3" width="34" height="40.5">
