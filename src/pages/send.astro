              <g clip-path="url(#signin-icon-clip-0)">
                <path fill-rule="nonzero" fill="currentColor" d="M 23.441406 106.605469 C 22.050781 106.605469 20.757812 105.609375 20.460938 104.121094 C 20.160156 102.53125 21.253906 100.941406 22.84375 100.644531 C 32.183594 99.054688 40.828125 94.484375 47.1875 87.925781 C 48.875 86.136719 51.257812 85.144531 53.742188 85.144531 C 56.128906 85.144531 58.3125 86.039062 60.003906 87.726562 C 63.679688 91.503906 68.644531 93.390625 74.707031 93.390625 C 76.394531 93.390625 77.6875 94.683594 77.6875 96.371094 C 77.6875 98.058594 76.394531 99.351562 74.707031 99.351562 C 65.070312 99.351562 59.109375 95.378906 55.730469 92 C 55.035156 91.304688 54.238281 91.203125 53.742188 91.203125 C 52.949219 91.203125 52.054688 91.601562 51.457031 92.199219 C 44.207031 99.648438 34.371094 104.816406 23.839844 106.605469 C 23.839844 106.605469 23.640625 106.605469 23.441406 106.605469 Z M 15.195312 83.457031 L 7.246094 83.457031 C 5.558594 83.457031 4.265625 82.164062 4.265625 80.476562 C 4.265625 78.785156 5.558594 77.496094 7.246094 77.496094 L 15.195312 77.496094 C 23.242188 77.496094 30.394531 73.023438 33.972656 65.769531 C 34.667969 64.28125 36.457031 63.683594 37.945312 64.378906 C 39.4375 65.074219 40.03125 66.863281 39.335938 68.355469 C 34.765625 77.691406 25.527344 83.457031 15.195312 83.457031 "/>
