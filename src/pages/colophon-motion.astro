---
import BaseLayout from '../layouts/BaseLayout.astro';

/* PROTOTYPE — the motion section of an extended /colophon.
   Standalone so it can be looked at without touching the live page.
   Delete or fold into colophon.astro once the treatment is settled. */

const EASINGS = [
  {
    token: '--ease-standard',
    value: 'cubic-bezier(0.4, 0, 0.2, 1)',
    p: [0.4, 0, 0.2, 1],
    note: 'The default. Nav hovers, link underlines, every colour change.'
  },
  {
    token: '--ease-out-expo',
    value: 'cubic-bezier(0.16, 1, 0.3, 1)',
    p: [0.16, 1, 0.3, 1],
    note: 'Arrivals. Content entering the frame, panels opening.'
  },
  {
    token: '--ease-drag',
    value: 'cubic-bezier(0.1, 0.75, 0.25, 1)',
    p: [0.1, 0.75, 0.25, 1],
    note: 'Anything that followed a finger and has to settle without a bounce.'
  },
  {
    token: '--ease-overshoot',
    value: 'cubic-bezier(0.34, 1.56, 0.64, 1)',
    p: [0.34, 1.56, 0.64, 1],
    note: 'Passes its mark and comes back. Used sparingly, on confirmations.'
  },
  {
    token: '--ease-press',
    value: 'cubic-bezier(0.2, 0.7, 0.3, 1)',
    p: [0.2, 0.7, 0.3, 1],
    note: 'The short trip a button makes under a cursor.'
  }
];

const DURATIONS = [
  { token: '--dur-xs',  ms: 150, note: 'Tap feedback' },
  { token: '--dur-s',   ms: 200, note: 'The base' },
  { token: '--dur-sm',  ms: 250, note: '' },
  { token: '--dur-m',   ms: 300, note: 'Most hovers' },
  { token: '--dur-l',   ms: 400, note: '' },
  { token: '--dur-xl',  ms: 500, note: '' },
  { token: '--dur-2xl', ms: 600, note: 'Entrances, reveals' }
];

/* Plot the curve as an SVG path in a 100x100 box, y inverted so progress
   runs upward. Control points can exceed the box (overshoot) — the SVG
   is not clipped, and the padding in the wrapper accounts for it. */
function curvePath(p: number[]) {
  const x1 = p[0] * 100, y1 = 100 - p[1] * 100;
  const x2 = p[2] * 100, y2 = 100 - p[3] * 100;
  return 'M0,100 C' + x1 + ',' + y1 + ' ' + x2 + ',' + y2 + ' 100,0';
}

/* The per-page tint system, read off the values that actually ship:
   pageBg props on each page template, and the body[data-page] ::selection
   block in custom.css. Kept as data so the section can't drift from a
   hand-written table - if this survives, it should read the custom
   properties at runtime instead. */
const PAGES = [
  { key: 'home', name: 'Home',       ground: '#17151A', sel: '#AAFF00', selInk: '#000000', ink: '#F4F4EE' },
  { key: 'studio', name: 'Studio',     ground: '#17151A', sel: '#FFB2E4', selInk: '#17151A', ink: '#F4F4EE' },
  { key: 'projects', name: 'Projects',   ground: '#EAE5F2', sel: '#9647F0', selInk: '#FFFFFF', ink: '#3A313B' },
  { key: 'project', name: 'Project',    ground: '#FFFFFF', sel: '#9647F0', selInk: '#FFFFFF', ink: '#3A313B' },
  { key: 'brief', name: 'Brief',      ground: '#140E07', sel: '#EF9146', selInk: '#2A2010', ink: '#F4F4EE' },
  { key: 'send', name: 'Send',       ground: '#090C0B', sel: '#8FC2F2', selInk: '#090C0B', ink: '#F4F4EE' },
  { key: 'tools', name: 'Tools',      ground: '#17151A', sel: '#B47CFF', selInk: '#17151A', ink: '#F4F4EE' },
  { key: 'schedule', name: 'Schedule',   ground: '#17151A', sel: '#9F50FF', selInk: '#1B1424', ink: '#F4F4EE' },
  { key: 'privacy', name: 'Privacy',    ground: '#F1D6EA', sel: '#4A2840', selInk: '#F1D6EA', ink: '#3A313B' },
  { key: 'colophon', name: 'Colophon',   ground: '#0E06D2', sel: '#AAFF00', selInk: '#0E06D2', ink: '#F4F4EE' },
  { key: '404', name: '404',        ground: '#6F6F6F', sel: '#AAFF00', selInk: '#000000', ink: '#F4F4EE' }
];

function lum(hex) {
  const v = [1, 3, 5].map(i => parseInt(hex.substr(i, 2), 16) / 255)
    .map(c => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4)));
  return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
}

/* The control is ordered by how dark the page is, not alphabetically and not
   by nav order. That ordering is the finding: eleven pages, eight distinct
   grounds, almost all of them at the dark end. */
const LADDER = PAGES
  .map(p => ({ ...p, l: lum(p.ground) }))
  .sort((a, b) => a.l - b.l);
const L_MIN = LADDER[0].l;
const L_MAX = LADDER[LADDER.length - 1].l;
const LX = (i: number) => 40 + i * (920 / (LADDER.length - 1));
const LY = (l: number) => 132 - ((l - L_MIN) / (L_MAX - L_MIN)) * 112;

/* Measured 2026-09-18 across src/ and public/js: 380 declarations, 96 as
   written, 79 once whitespace and leading zeros are normalised. Of the 55
   fixed sizes, 44 fall between 8px and 18px. */
const TYPE_FACTS = [
  ['Declarations', '380'],
  ['Distinct, as written', '96'],
  ['Distinct, normalised', '79'],
  ['Fixed (px / rem)', '55'],
  ['Fluid (clamp, em)', '24'],
  ['Fixed sizes between 8px and 18px', '44']
];
const SIZES = [[6.5, 1], [8, 1], [8.32, 3], [8.96, 3], [9.28, 1], [9.92, 8], [10, 7], [10.24, 4], [10.56, 10], [10.88, 9], [11, 6], [11.2, 5], [11.52, 31], [11.84, 6], [12, 11], [12.16, 4], [12.48, 6], [12.8, 9], [13, 10], [13.12, 7], [13.44, 5], [13.6, 12], [13.76, 4], [14, 13], [14.08, 17], [14.4, 12], [14.72, 14], [15, 10], [15.04, 5], [15.2, 9], [15.36, 2], [15.68, 3], [16, 22], [16.32, 2], [16.8, 12], [16.96, 1], [17, 4], [17.28, 6], [17.6, 2], [18, 3], [18.4, 2], [20, 2], [20.8, 1], [22, 4], [24, 4], [25.6, 1], [28, 1], [30.4, 1], [35.2, 1], [40, 2], [70, 1], [72, 1]];
const WEIGHTS = [
  { w: 400, n: 'Regular' },
  { w: 500, n: 'Medium' },
  { w: 700, n: 'Bold' }
];
---
<BaseLayout
  page="colophon"
  title="Motion – COGNAK"
  description="Prototype: the motion section of an extended colophon."
  ogUrl="https://cognak.com/colophon-motion/"
  noindex={true}
  pageBg="#0E06D2"
>
  <canvas id="cm-anatomy" aria-hidden="true"></canvas>
  <div id="cm-plate" aria-hidden="true"></div>

  <main id="cognak-main"><section class="cm">

    <script type="application/json" id="cm-sizes" set:html={JSON.stringify(SIZES)}></script>

    <p class="cm-eyebrow">Colophon &nbsp;/&nbsp; System</p>

    <h1 class="cm-headline">A colophon names the paper and the press. This is <em>the rest of it</em>.</h1>

    <div class="cm-intro">
      <p>Eleven grounds, five curves, seven durations, one typeface. Nothing below is a picture of the system — every value on this page is read from the stylesheet that ships, so the page cannot describe a site it no longer matches.</p>
    </div>

    <h2 class="cm-h2" id="cm-colour">Colour</h2>
    <div id="cm-colour-sec">

    <p class="cm-sub">One decision per page — what is this page's ground — and the ink, the nav, the scrollbar and the highlight all follow from it by rule. Eleven pages, one function, run eleven times.</p>

    <figure class="cm-ladder-wrap">
      <svg class="cm-ladder" id="cm-ladder" viewBox="0 0 1000 180"
           aria-label="The site's eleven page grounds, darkest to lightest. Each one can be worn.">
        <line class="cm-l-axis" x1="40" y1="165" x2="960" y2="165" />
        <polyline class="cm-l-path" points={LADDER.map((pg, i) => LX(i) + ',' + (LY(pg.l) + 20)).join(' ')} />
        {LADDER.map((pg, i) => (
          <g
            class="cm-l-node"
            role="button"
            tabindex="0"
            aria-label={'Wear ' + pg.name}
            aria-pressed="false"
            data-key={pg.key}
            data-name={pg.name}
            data-ground={pg.ground}
            data-ink={pg.ink}
            data-accent={pg.sel}
            style={'--cx:' + LX(i) + 'px;--cy:' + (LY(pg.l) + 20) + 'px'}
          >
            <line class="cm-l-stem" x1={LX(i)} y1={LY(pg.l) + 20} x2={LX(i)} y2="165" />
            <circle class="cm-l-hit" cx={LX(i)} cy={LY(pg.l) + 20} r="26" />
            <circle class="cm-l-dot" cx={LX(i)} cy={LY(pg.l) + 20} r="10" fill={pg.ground} />
            <text class="cm-l-label" x={LX(i)} y={LY(pg.l) + 20 - 22} text-anchor="middle">{pg.name}</text>
          </g>
        ))}
      </svg>
      <figcaption class="cm-ladder-cap">
        <span class="cm-l-meta" id="cm-l-meta">Eleven pages by relative luminance, darkest to lightest. Click one to wear it.</span>
      </figcaption>
    </figure>

    <p class="cm-body">Eleven pages, eight grounds — four of them the same near-black. Six sit stacked at the dark end, the 404's grey stands on its own in the middle, and the two light pages plus the white project template are the whole of the top. The shape is the palette. The hex values are only how it gets written down.</p>

    <p class="cm-aside">The green is the default rather than the rule. It holds the homepage and the 404, and yields wherever a page has a voice of its own.</p>

    </div>

    <h2 class="cm-h2" id="cm-motion">Motion</h2>

    <p class="cm-sub">The dot plots real elapsed time across the bottom against eased progress up the side, so it traces the curve at the speed the curve actually runs. The square travels on the same clock.</p>

    <h3 class="cm-h3">Curves</h3>

    <ul class="cm-curves">
      {EASINGS.map((e) => (
        <li class="cm-row" data-ease={e.value} data-p={e.p.join(',')}>
          <button class="cm-trigger" type="button" aria-label={'Play ' + e.token}>
            <span class="cm-graph">
              <svg viewBox="-6 -6 112 112" aria-hidden="true">
                <line class="cm-axis" x1="0" y1="100" x2="100" y2="100" />
                <line class="cm-axis" x1="0" y1="0" x2="0" y2="100" />
                <line class="cm-guide" x1="0" y1="0" x2="100" y2="0" />
                <line class="cm-guide" x1="100" y1="0" x2="100" y2="100" />
                <path class="cm-curve" d={curvePath(e.p)} />
                <circle class="cm-dot" cx="0" cy="100" r="4.5" />
              </svg>
            </span>
            <span class="cm-meta">
              <span class="cm-token">{e.token}</span>
              <span class="cm-value">{e.value}</span>
              <span class="cm-use">{e.note}</span>
              <span class="cm-track"><span class="cm-car"></span></span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <h3 class="cm-h3">Durations</h3>

    <p class="cm-sub">All seven, fired together, so the intervals read against each other.</p>

    <ul class="cm-durs" id="cm-durs">
      {DURATIONS.map((d) => (
        <li class="cm-dur" style={'--d:' + d.ms + 'ms; --w:' + Math.round(d.ms / 600 * 100) + '%'}>
          <span class="cm-token">{d.token}</span>
          <span class="cm-bar"><span class="cm-fill"></span></span>
          <span class="cm-ms">{d.ms}ms</span>
          <span class="cm-use">{d.note}</span>
        </li>
      ))}
    </ul>

    <h2 class="cm-h2" id="cm-type">Type</h2>
    <div id="cm-type-sec">

    <p class="cm-sub">ABC Diatype, drawn by Dinamo, self-hosted as woff2 in three weights and a mono. No CDN sees your visit.</p>

    <ul class="cm-weights">
      {WEIGHTS.map((w) => (
        <li class="cm-weight" style={'--fw:' + w.w}>
          <span class="cm-weight-spec">{w.w} &nbsp; {w.n}</span>
          <span class="cm-weight-set">Handled by hand</span>
        </li>
      ))}
      <li class="cm-weight cm-weight-mono">
        <span class="cm-weight-spec">400 &nbsp; Mono</span>
        <span class="cm-weight-set">cubic-bezier(0.4, 0, 0.2, 1)</span>
      </li>
    </ul>

    <p class="cm-body">There is no type scale here, and that is a decision rather than an omission. A scale is a promise that every page you have not built yet will want one of eleven sizes. It never holds — the work outruns the system, and what you actually get is a ladder plus a quietly growing pile of exceptions. Headlines on this site are sized to the page they sit on, because the pages have different jobs, and flattening them onto shared steps would make a worse site, not a tidier one.</p>

    <p class="cm-body">Restraint earns its place in exactly one register: the small band where labels, captions and body copy live. Nobody is expressing anything at 13.6px versus 13.76px. Counted across the stylesheets that ship:</p>

    <ul class="cm-facts">
      {TYPE_FACTS.map(([k, v]) => (
        <li class="cm-fact"><span class="cm-fact-k">{k}</span><span class="cm-fact-v">{v}</span></li>
      ))}
    </ul>

    <p class="cm-body">Forty-four distinct sizes inside a ten-pixel band is not range. It is thirteen years of reaching for a number slightly smaller than the one beside it, and the eye cannot tell the difference anyway. That band gets named steps. Above it, nothing — a headline answers to its page.</p>

    <p class="cm-aside">Core and exceptions. Most systems get this backwards: they discipline the display type, where the variation is doing work, and leave the small sizes to drift, where it isn't.</p>

    </div>

    <h2 class="cm-h2" id="cm-voice">Voice</h2>

    <p class="cm-sub">The rules the copy on this site is written against.</p>

    <ol class="cm-rules">
      <li>One paragraph. Name the work, list the range in a short series, stop.</li>
      <li>Scale is implied by what's listed, never asserted with adjectives.</li>
      <li>No sensory image standing in for a claim. No closing thesis statement.</li>
      <li>When in doubt, match the shortest entry on the site, not the longest.</li>
      <li>Nothing romantic, abstract, or sales-inflected. Declarative, or cut it.</li>
    </ol>

    <p class="cm-aside">Written down because it is the part of a brand that drifts first and the part almost nobody publishes.</p>

    <h2 class="cm-h2" id="cm-outside">Outside the system</h2>

    <p class="cm-sub">What the tokens deliberately do not reach.</p>

    <ul class="cm-outside">
      <li><span class="cm-o-n">Homepage ground</span><span class="cm-o-d">A WebGL field, not a colour token.</span></li>
      <li><span class="cm-o-n">Character sweep</span><span class="cm-o-d">Per-letter timing, authored against the text it runs on.</span></li>
      <li><span class="cm-o-n">Scroll choreography</span><span class="cm-o-d">Page-specific. Shares the easings, nothing else.</span></li>
      <li><span class="cm-o-n">Living backgrounds</span><span class="cm-o-d">The glyph anatomy here, the baseline grid on /privacy-policy.</span></li>
      <li><span class="cm-o-n">Project hero video</span><span class="cm-o-d">Cut per project. A convention, not a component.</span></li>
    </ul>

    <p class="cm-aside">A system that marks its own edge is describing something real. One claiming to cover everything is describing an intention.</p>

    <p class="cm-sign">Five curves is the entire claim. A brand book can print the numbers; it cannot show you what 0.34,&nbsp;1.56 feels like, which is the only part that matters.</p>

  </section></main>

  <style is:inline>
    :root {
      --wear-bg: #0E06D2;
      --wear-ink: #f4f4ee;
      --wear-accent: #b6ff2e;
      --wear-dim: #a9abbd;
      --wear-nav: rgba(7, 0, 172, 0.80);
    }
    html, body {
      background-color: var(--wear-bg) !important;
      transition: background-color var(--dur-2xl) var(--ease-standard);
    }

    /* ---- scroll-driven anatomy canvas -------------------------------------
       Same drawing vocabulary as the glyph canvas on /colophon: faint contour
       stroke, white node squares on the anchors, acid-green handle lines out
       to the control points. Here the contour being dissected is the easing
       curve rather than a letter, which is the point - a type designer's
       curve and a CSS easing curve are the same object.
       Fixed, behind everything, and it never contributes layout. */
    #cm-anatomy {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }
    #cm-plate {
      position: fixed;
      z-index: 0;
      pointer-events: none;
      font-family: 'Diatype Mono', monospace;
      font-size: 0.72rem;
      line-height: 1.6;
      letter-spacing: 0.04em;
      color: var(--wear-dim);
      opacity: 0;
      transition: opacity var(--dur-l) var(--ease-standard);
    }
    #cm-plate .p-line { display: block; white-space: nowrap; }
    #cm-plate .p-name { color: var(--wear-accent); }
    /* Below 900px the canvas centres behind the text column, where a caption
       would land on the copy - same call as the glyph caption on /colophon. */
    @media (max-width: 900px) { #cm-plate { display: none; } }

    #cognak-main { position: relative; z-index: 1; overflow-x: clip; }

    .home-bottom-bar.inner-page-nav.colophon-nav {
      background: var(--wear-nav) !important;
    }
    .home-bottom-bar.inner-page-nav.colophon-nav .home-bottom-email,
    .home-bottom-bar.inner-page-nav.colophon-nav .home-bottom-location,
    .home-bottom-bar.inner-page-nav.colophon-nav .inner-nav-links a,
    .home-bottom-bar.inner-page-nav.colophon-nav .pulse-dot {
      color: #ffffff !important;
    }
    .home-bottom-bar.inner-page-nav.colophon-nav .home-bottom-email,
    .home-bottom-bar.inner-page-nav.colophon-nav .inner-nav-links a {
      transition: color var(--dur-s) var(--ease-standard);
    }
    @media (hover: hover) {
      .home-bottom-bar.inner-page-nav.colophon-nav .home-bottom-email:hover,
      .home-bottom-bar.inner-page-nav.colophon-nav .inner-nav-links a:hover {
        color: #A9C4FF !important;
      }
    }

    .cm {
      max-width: 930px;
      margin: 0 auto;
      padding: 190px 6vw 22vh;
      color: var(--wear-ink);
      font-family: 'Diatype Variable', sans-serif;
      transition: color var(--dur-2xl) var(--ease-standard);
    }
    @media (max-width: 720px) { .cm { padding-top: 100px; } }
    @media (min-width: 900px) {
      .cm { margin-left: clamp(48px, 11vw, 210px); margin-right: auto; }
    }

    .cm-eyebrow {
      font-family: 'Diatype Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--wear-dim);
      margin: 0 0 1.6rem;
    }

    .cm-headline {
      font-size: clamp(30px, 4.6vw, 54px);
      font-weight: 500;
      line-height: 1.08;
      letter-spacing: -0.02em;
      margin: 0 0 2.2rem;
      max-width: 17ch;
    }
    .cm-headline em { font-style: normal; font-weight: 500; color: var(--wear-accent); }

    .cm-intro { max-width: 58ch; margin-bottom: 5.5rem; }
    .cm-intro p { font-size: 1.05rem; line-height: 1.6; margin: 0 0 1rem; }
    .cm-note { color: var(--wear-dim); font-size: 0.92rem !important; }

    .cm-h2 {
      font-family: 'Diatype Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--wear-accent);
      font-weight: 400;
      margin: 0 0 2rem;
      padding-bottom: 0.7rem;
      border-bottom: 1px solid rgba(255,255,255,0.14);
    }

    .cm-sub {
      color: var(--wear-dim);
      font-size: 0.92rem;
      line-height: 1.55;
      max-width: 58ch;
      margin: -1rem 0 2.4rem;
    }

    /* ---- curves ---- */
    .cm-curves { list-style: none; margin: 0 0 6rem; padding: 0; }
    .cm-row { border-bottom: 1px solid rgba(255,255,255,0.09); }
    .cm-row:last-child { border-bottom: 0; }

    .cm-trigger {
      display: grid;
      grid-template-columns: 132px 1fr;
      gap: 2.2rem;
      align-items: center;
      width: 100%;
      padding: 1.8rem 0.6rem 1.8rem 0;
      background: none;
      border: 0;
      color: inherit;
      text-align: left;
      cursor: pointer;
      font: inherit;
      transition: background var(--dur-m) var(--ease-standard);
    }
    @media (hover: hover) {
      .cm-trigger:hover { background: rgba(255,255,255,0.035); }
    }
    .cm-trigger:focus-visible { outline: 2px solid var(--wear-accent); outline-offset: 2px; }

    .cm-graph { display: block; }
    .cm-graph svg { display: block; width: 100%; height: auto; overflow: visible; }
    .cm-axis  { stroke: rgba(255,255,255,0.30); stroke-width: 1; }
    .cm-guide { stroke: rgba(255,255,255,0.10); stroke-width: 1; stroke-dasharray: 2 3; }
    .cm-curve { fill: none; stroke: #f4f4ee; stroke-width: 2; vector-effect: non-scaling-stroke; }
    .cm-dot   { fill: #b6ff2e; }

    .cm-meta { display: block; min-width: 0; }
    .cm-token {
      display: block;
      font-family: 'Diatype Mono', monospace;
      font-size: 0.88rem;
      color: var(--wear-accent);
      letter-spacing: 0.01em;
    }
    .cm-value {
      display: block;
      font-family: 'Diatype Mono', monospace;
      font-size: 0.72rem;
      color: var(--wear-dim);
      margin-top: 0.3rem;
    }
    .cm-use {
      display: block;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #e2e2ea;
      margin-top: 0.6rem;
      max-width: 44ch;
    }

    .cm-track {
      display: block;
      position: relative;
      height: 2px;
      margin-top: 1.4rem;
      background: rgba(255,255,255,0.12);
      max-width: 340px;
    }
    .cm-car {
      position: absolute;
      top: -4px;
      left: 0;
      width: 10px;
      height: 10px;
      background: #f4f4ee;
      transform: translateX(0);
    }
    .cm-row.is-running .cm-car { transform: translateX(calc(340px - 10px)); }

    /* ---- durations ---- */
    .cm-durs { list-style: none; margin: 0 0 5rem; padding: 0; }
    .cm-dur {
      display: grid;
      grid-template-columns: 110px 1fr 64px 1fr;
      gap: 1.4rem;
      align-items: center;
      padding: 0.85rem 0;
    }
    .cm-bar {
      display: block;
      height: 3px;
      width: var(--w);
      background: rgba(255,255,255,0.12);
      overflow: hidden;
    }
    .cm-fill {
      display: block;
      height: 100%;
      width: 100%;
      background: var(--wear-accent);
