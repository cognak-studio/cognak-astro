  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var SPAN = 900; /* how long a demo run takes, independent of the token */

      /* Solve a cubic-bezier easing for y at a given x (time), the same way a
         browser does: Newton-Raphson on x, bisection as the fallback. */
      function bez(p) {
        var x1 = p[0], y1 = p[1], x2 = p[2], y2 = p[3];
        function cx(t) { var u = 1 - t; return 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t; }
        function cy(t) { var u = 1 - t; return 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t; }
        function dx(t) { var u = 1 - t; return 3 * u * u * x1 + 6 * u * t * (x2 - x1) + 3 * t * t * (1 - x2); }
        return function (x) {
          if (x <= 0) return 0;
          if (x >= 1) return 1;
          var t = x, i, d, s;
          for (i = 0; i < 8; i++) {
            d = cx(t) - x;
            if (Math.abs(d) < 1e-5) return cy(t);
            s = dx(t);
            if (Math.abs(s) < 1e-6) break;
            t -= d / s;
          }
          var lo = 0, hi = 1;
          t = x;
          for (i = 0; i < 24; i++) {
            if (cx(t) > x) { hi = t; } else { lo = t; }
            t = (lo + hi) / 2;
          }
          return cy(t);
        };
      }

      var rows = Array.prototype.slice.call(document.querySelectorAll('.cm-row'));

      rows.forEach(function (row) {
        var dot = row.querySelector('.cm-dot');
        var car = row.querySelector('.cm-car');
        var ease = row.getAttribute('data-ease');
        var p = row.getAttribute('data-p').split(',').map(Number);
        var solve = bez(p);
        var raf = 0;

        car.style.transitionProperty = 'transform';
        car.style.transitionTimingFunction = ease;
        car.style.transitionDuration = SPAN + 'ms';

        function play() {
          if (reduce) { dot.setAttribute('cx', '100'); dot.setAttribute('cy', '0'); return; }
          cancelAnimationFrame(raf);
          row.classList.remove('is-running');
          /* force a style flush so the transition restarts from zero */
          void row.offsetWidth;
          row.classList.add('is-running');

          var start = performance.now();
          function frame(now) {
            var x = Math.min(1, Math.max(0, (now - start) / SPAN));
            var y = solve(x);
            dot.setAttribute('cx', String(x * 100));
            dot.setAttribute('cy', String(100 - y * 100));
            if (x < 1) { raf = requestAnimationFrame(frame); }
          }
          raf = requestAnimationFrame(frame);
        }

        function reset() {
          cancelAnimationFrame(raf);
          row.classList.remove('is-running');
          dot.setAttribute('cx', '0');
          dot.setAttribute('cy', '100');
        }

        row.addEventListener('mouseenter', play);
        row.addEventListener('mouseleave', reset);
        row.querySelector('.cm-trigger').addEventListener('click', play);
        row.querySelector('.cm-trigger').addEventListener('blur', reset);
      });

      /* Durations: fire all seven together when the block scrolls in, and
         again on click, so the intervals are compared rather than described. */
      var durs = document.getElementById('cm-durs');
      if (durs) {
        var fire = function () {
          durs.classList.remove('is-running');
          void durs.offsetWidth;
          durs.classList.add('is-running');
        };
        durs.addEventListener('click', fire);
        if (!reduce && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { fire(); } });
          }, { threshold: 0.4 });
          io.observe(durs);
        } else {
          durs.classList.add('is-running');
        }
      }
    })();
  </script>

  <script is:inline>
    /* ---------------------------------------------------------------------
       Scroll-driven anatomy canvas.

       Every state the canvas can hold is expressed the same way - a contour
       of N sampled points, plus anchor nodes and handle pairs - so moving
       between states is a straight per-point lerp, exactly as the glyph
       morph on /colophon interpolates between two letters. Scroll position
       picks the target; the drawing never runs on a timer.

       States: the intro holds --ease-standard faintly; the curves section
       holds whichever row is hovered, or nearest the viewport middle; the
       durations section flattens the curve into its own timeline, the seven
       nodes landing at x proportional to milliseconds.
       --------------------------------------------------------------------- */
    (function () {
      var cv = document.getElementById('cm-anatomy');
      var plate = document.getElementById('cm-plate');
      if (!cv) { return; }
      var ctx = cv.getContext('2d');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var N = 160;           /* samples per contour - fixed, so states morph 1:1 */
      var dpr = 1, vw = 0, vh = 0;

      function sampleBezier(p) {
        var x1 = p[0], y1 = p[1], x2 = p[2], y2 = p[3], out = [], i, t, u;
        for (i = 0; i < N; i++) {
          t = i / (N - 1); u = 1 - t;
          out.push([
            3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t,
            3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t
          ]);
        }
        return out;
      }

      /* A flat baseline, sampled to the same N, so the curve can collapse
         into the durations timeline without a cut. */
      function baseline() {
        var out = [], i;
        for (i = 0; i < N; i++) { out.push([i / (N - 1), 0.5]); }
        return out;
      }

      var states = [];
      var rows = Array.prototype.slice.call(document.querySelectorAll('.cm-row'));
      rows.forEach(function (row) {
        var p = row.getAttribute('data-p').split(',').map(Number);
        states.push({
          el: row,
          pts: sampleBezier(p),
          nodes: [[0, 0], [1, 1]],
          handles: [[[0, 0], [p[0], p[1]]], [[1, 1], [p[2], p[3]]]],
          name: row.querySelector('.cm-token').textContent,
          sub: row.querySelector('.cm-value').textContent
        });
      });

      /* Every fixed font-size on the site: x is size, y is how often it is
         used. The cluster on the left IS the finding. */
      var SIZES = JSON.parse(document.getElementById('cm-sizes').textContent);
      var maxUse = Math.max.apply(null, SIZES.map(function (q) { return q[1]; }));
      var typeState = {
        el: document.getElementById('cm-type-sec'),
        pts: baseline(),
        nodes: SIZES.map(function (q) { return [Math.min(q[0] / 72, 1), 0.08 + (q[1] / maxUse) * 0.8]; }),
        handles: [],
        name: '55 fixed sizes',
        sub: '44 of them under 18px'
      };

      var durEl = document.getElementById('cm-durs');
      var durNodes = Array.prototype.slice.call(document.querySelectorAll('.cm-dur'))
        .map(function (li) {
          var ms = parseInt(li.style.getPropertyValue('--d'), 10);
          return [ms / 600, 0.5];
        });
      var durState = {
        el: durEl,
        pts: baseline(),
        nodes: durNodes,
        handles: [],
        name: '7 durations',
        sub: '150ms - 600ms'
      };

      var idle = states.length ? states[0] : null;
      if (!idle) { return; }

      /* current = what is drawn this frame; it chases target */
      var cur = {
        pts: idle.pts.map(function (q) { return [q[0], q[1]]; }),
        nodes: idle.nodes.map(function (q) { return [q[0], q[1]]; }),
        handles: JSON.parse(JSON.stringify(idle.handles))
      };
      var target = idle, targetLabel = '', hovered = null, fade = 0;

      rows.forEach(function (row, i) {
        row.addEventListener('mouseenter', function () { hovered = states[i]; });
        row.addEventListener('mouseleave', function () { hovered = null; });
      });

      function pickTarget() {
        if (hovered) { return { st: hovered, vis: 1 }; }
        var mid = window.innerHeight * 0.5, best = null, bestD = Infinity, vis = 0;
        function consider(st) {
          if (!st.el) { return; }
          var r = st.el.getBoundingClientRect();
          if (r.bottom < 0 || r.top > window.innerHeight) { return; }
          var d = Math.abs(r.top + r.height / 2 - mid);
          if (d < bestD) { bestD = d; best = st; }
        }
        states.forEach(consider);
        if (durEl) { consider(durState); }
        if (typeState.el) { consider(typeState); }
        if (!best) { return { st: idle, vis: 0 }; }
        /* fade the plate in only while the section is genuinely the subject */
        vis = bestD < window.innerHeight * 0.42 ? 1 : 0;
        return { st: best, vis: vis };
      }

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        vw = window.innerWidth; vh = window.innerHeight;
        cv.width = Math.round(vw * dpr);
        cv.height = Math.round(vh * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      /* Box geometry: locked to the right of the text column on desktop, the
         same measurement /colophon uses so the artwork can't drift away from
         the copy as the viewport grows. Centred behind the text below 900. */
      function box() {
        var size = Math.min(vh * 0.42, 420);
        var cx, cy = vh * 0.5;
        if (vw >= 900) {
          var col = document.querySelector('.cm');
          var right = col ? col.getBoundingClientRect().right : vw * 0.6;
          /* Size to the gutter that actually exists rather than clamping the
             centre - clamping the centre and then subtracting half the width
             pushed the right edge of the box off-screen by half its size.
             Below ~200px the gutter is not worth drawing into, so the artwork
             falls back to sitting behind the column as it does on mobile. */
          var gutter = vw - right - 88;
          size = Math.min(size, Math.max(gutter, 0));
          if (size < 200) {
            size = Math.min(vh * 0.42, 420);
            cx = vw * 0.5 - size / 2;
          } else {
            cx = right + 44;
          }
        } else {
          cx = vw * 0.5 - size / 2;
        }
        return { x: cx, y: cy - size / 2, s: size };
      }

      function lerpInto(a, b, k) {
        var i;
        for (i = 0; i < a.length; i++) {
          a[i][0] += (b[i][0] - a[i][0]) * k;
          a[i][1] += (b[i][1] - a[i][1]) * k;
        }
      }

      function matchLen(arr, n, seed) {
        while (arr.length < n) { arr.push([seed[0], seed[1]]); }
        while (arr.length > n) { arr.pop(); }
      }

      /* Read the wear variables rather than hardcoding the colophon's own
         ink and green, so the anatomy layer repaints with everything else.
         Cached per frame - getComputedStyle in a rAF loop is not free. */
      function inkRGB() {
        var cs = getComputedStyle(document.documentElement);
        return {
          ink: cs.getPropertyValue('--wear-ink').trim() || '#f4f4ee',
          accent: cs.getPropertyValue('--wear-accent').trim() || '#b6ff2e'
        };
      }
      function withAlpha(col, a) {
        if (col.charAt(0) === '#') {
          var r = parseInt(col.substr(1, 2), 16),
              g = parseInt(col.substr(3, 2), 16),
              bl = parseInt(col.substr(5, 2), 16);
          return 'rgba(' + r + ',' + g + ',' + bl + ',' + a + ')';
        }
        return col.replace(/^rgb\(/, 'rgba(').replace(/\)$/, ',' + a + ')');
      }

      function draw() {
        var b = box();
        var C = inkRGB();
        function X(u) { return b.x + u * b.s; }
        function Y(v) { return b.y + (1 - v) * b.s; }

        ctx.clearRect(0, 0, vw, vh);

        /* contour */
        ctx.beginPath();
        ctx.moveTo(X(cur.pts[0][0]), Y(cur.pts[0][1]));
        for (var i = 1; i < cur.pts.length; i++) { ctx.lineTo(X(cur.pts[i][0]), Y(cur.pts[i][1])); }
        ctx.strokeStyle = withAlpha(C.ink, 0.16 + 0.10 * fade);
        ctx.lineWidth = 1;
        ctx.stroke();

        /* handles, in the green the glyph plate uses for the same job */
        ctx.lineWidth = 1;
        cur.handles.forEach(function (h) {
          ctx.beginPath();
          ctx.moveTo(X(h[0][0]), Y(h[0][1]));
          ctx.lineTo(X(h[1][0]), Y(h[1][1]));
          ctx.strokeStyle = withAlpha(C.accent, 0.10 + 0.12 * fade);
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(X(h[1][0]), Y(h[1][1]), 2.5, 0, Math.PI * 2);
          ctx.fillStyle = withAlpha(C.accent, 0.14 + 0.16 * fade);
          ctx.fill();
        });

        /* anchors */
        ctx.fillStyle = withAlpha(C.ink, 0.20 + 0.18 * fade);
        cur.nodes.forEach(function (n) {
          ctx.fillRect(X(n[0]) - 3, Y(n[1]) - 3, 6, 6);
        });
      }

      function positionPlate(label) {
        if (!plate || vw < 900) { return; }
        var b = box();
        plate.style.left = Math.round(b.x) + 'px';
        plate.style.top = Math.round(b.y + b.s + 18) + 'px';
        if (plate.dataset.label !== label) {
          plate.dataset.label = label;
          plate.innerHTML = label;
        }
      }

      var raf = 0;
      function frame() {
        var pick = pickTarget();
        var st = pick.st;
        if (st !== target) { target = st; }
        var k = reduce ? 1 : 0.09;

        matchLen(cur.nodes, target.nodes.length, cur.nodes[cur.nodes.length - 1] || [0.5, 0.5]);
        while (cur.handles.length < target.handles.length) {
          cur.handles.push([[0.5, 0.5], [0.5, 0.5]]);
        }
        while (cur.handles.length > target.handles.length) { cur.handles.pop(); }

        lerpInto(cur.pts, target.pts, k);
        lerpInto(cur.nodes, target.nodes, k);
        for (var h = 0; h < cur.handles.length; h++) {
          lerpInto(cur.handles[h], target.handles[h], k);
        }
        fade += (pick.vis - fade) * (reduce ? 1 : 0.08);

        draw();
        positionPlate(
          '<span class="p-line p-name">' + target.name + '</span>' +
          '<span class="p-line">' + target.sub + '</span>'
