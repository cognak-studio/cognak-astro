---
/**
 * /tools — public barcode generator, linked from the footer next to Colophon
 * (2026-07-28). noindex stays on though, same as /colophon — a footer-linked
 * page we're happy for visitors to find, but not one we want ranking in
 * search results for generic "barcode generator" queries.
 *
 * Everything runs client-side: the UPC-A encoder, the QR encoder and all three
 * vector emitters live in src/lib/barcode/ and are bundled into the page, so
 * nothing typed here is ever sent anywhere.
 *
 * Palette: violet ink on near-black — the site's own #16151A used as the
 * ground. Verified WCAG AA (see :root comment).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  page="tools"
  title="Tools – COGNAK"
  description="A UPC-A and QR generator built for print — real vector out (SVG, PDF, EPS), GS1-legal magnification, nothing you type ever leaves the browser."
  ogUrl="https://cognak.com/tools/"
  noindex={true}
  pageBg="#16151A"
>
  <canvas id="tools-lattice" aria-hidden="true"></canvas>

  <main id="cognak-main"><section class="tools">

    {/* No eyebrow: the headline is the first thing in the column, which is what
        puts its text at the same height as projects / studio / brief. */}
    <h1 class="headline tools-headline">
      {/* Kept on one source line: the word-splitter turns the surrounding text
          nodes into spans, and a newline either side of the <em> loses the space. */}
      <em>Tools</em> for the part of the work that gets scanned, not seen.
    </h1>
    <p class="lede tools-lede">
      Pick a format, type in the number or the link, and take it away as SVG,
      PDF or EPS — real vector, sized for print. UPC-A comes out at GS1 nominal
      and stays legal anywhere from 80 to 200%. Nothing you type here leaves
      the browser.
    </p>

    <div class="tcard rise" id="tcard">

      <!-- ------------------------------------------------------ format --- -->
      <div class="group">
        <div class="group-title">Format</div>
        <div class="field">
          <label class="q" for="tool-select">
            <span class="q-title">What are you making?</span>
            <span class="q-sub">Two for now. More whenever a job asks for one.</span>
          </label>
          <div class="selwrap">
            <select class="sel" id="tool-select">
              <option value="upc">UPC-A — retail product barcode</option>
              <option value="qr">QR code — link to a URL</option>
            </select>
            <span class="selchev" aria-hidden="true">
              <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </div>

      <!-- ------------------------------------------------------- UPC-A --- -->
      <div class="group panel" id="panel-upc">
        <div class="group-title">The number</div>

        <div class="field">
          <label class="q" for="upc-input">
            <span class="q-title">UPC number</span>
            <span class="q-sub">Twelve digits — or eleven, and the check digit gets worked out for you.</span>
          </label>
          <input
            class="txt mono" id="upc-input" type="text"
            inputmode="numeric" autocomplete="off" spellcheck="false"
            placeholder="036000291452" value="036000291452"
            aria-describedby="upc-note" />
          <p class="note" id="upc-note"></p>
        </div>

        <div class="field pair">
          <div class="half">
            <label class="q" for="upc-mag">
              <span class="q-title">Magnification</span>
              <span class="q-sub">GS1 allows 80–200%.</span>
            </label>
            <div class="suffixed">
              <input class="txt" id="upc-mag" type="number" min="80" max="200" step="1" value="100" />
              <span class="suffix">%</span>
            </div>
          </div>
          <div class="half">
            <label class="q" for="upc-bwr">
              <span class="q-title">Bar width reduction</span>
              <span class="q-sub">Only if the printer asks for it.</span>
            </label>
            <div class="suffixed">
              <input class="txt" id="upc-bwr" type="number" min="0" max="0.05" step="0.005" value="0" />
              <span class="suffix">mm</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ---------------------------------------------------------- QR --- -->
      <div class="group panel" id="panel-qr" hidden>
        <div class="group-title">The link</div>

        <div class="field">
          <label class="q" for="qr-input">
            <span class="q-title">Destination</span>
            <span class="q-sub">A shorter URL makes a coarser code, and a coarser code scans better.</span>
          </label>
          <input
            class="txt mono" id="qr-input" type="text"
            autocomplete="off" spellcheck="false"
            placeholder="https://cognak.com" value="https://cognak.com"
            aria-describedby="qr-note" />
          <p class="note" id="qr-note"></p>
        </div>

        <div class="field">
          <label class="q" for="qr-size">
            <span class="q-title">Finished size</span>
            <span class="q-sub">Width of the square, quiet zone included.</span>
          </label>
          <div class="suffixed suffixed--narrow">
            <input class="txt" id="qr-size" type="number" min="10" max="300" step="1" value="30" />
            <span class="suffix">mm</span>
          </div>
        </div>

        <fieldset class="field fieldset">
          <legend class="q">
            <span class="q-title">Damage tolerance</span>
            <span class="q-sub">How much of the code can be scuffed, folded or covered and still read. Higher costs you resolution.</span>
          </legend>
          <div class="pills" id="qr-ec">
            <label class="pill"><input type="radio" name="ec" value="L" /> Low <span class="pct">7%</span></label>
            <label class="pill on"><input type="radio" name="ec" value="M" checked /> Medium <span class="pct">15%</span></label>
            <label class="pill"><input type="radio" name="ec" value="Q" /> Quartile <span class="pct">25%</span></label>
            <label class="pill"><input type="radio" name="ec" value="H" /> High <span class="pct">30%</span></label>
          </div>
        </fieldset>
      </div>

      <!-- ------------------------------------------------------- proof --- -->
      <div class="group">
        <div class="group-title">Proof</div>
        <div class="proof" id="proof" aria-live="polite"></div>
        <p class="meta mono" id="meta"></p>
      </div>

      <div class="actions" id="actions">
        <button type="button" class="btn" data-fmt="svg"><svg class="btn-ico" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1.25V9.4M3.6 6.2 7 9.6l3.4-3.4M1.75 12.25h10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>SVG</button>
        <button type="button" class="btn" data-fmt="pdf"><svg class="btn-ico" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1.25V9.4M3.6 6.2 7 9.6l3.4-3.4M1.75 12.25h10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>PDF</button>
        <button type="button" class="btn" data-fmt="eps"><svg class="btn-ico" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1.25V9.4M3.6 6.2 7 9.6l3.4-3.4M1.75 12.25h10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>EPS</button>
        <span class="actions-note mono">true vector, no raster fallback</span>
      </div>
    </div>

    <p class="tfoot">
      UPC-A follows the GS1 nominal symbol — 0.33&nbsp;mm module,
      37.29&nbsp;&times;&nbsp;25.91&nbsp;mm at 100%, nine-module quiet zones,
      guard bars run to the baseline. The human-readable line is OCR-B at 9pt
      with no tracking — the size where each digit's advance matches one
      7-module cell — exported as outlines, so there's no font to embed,
      install or substitute. COGNAK doesn't issue UPC numbers — those come
      from <a href="https://www.gs1us.org/upcs-barcodes-prefixes/how-to-get-a-upc-barcode" target="_blank" rel="noopener noreferrer">GS1</a>.
    </p>

  </section></main>

  <style is:inline>
    html, body { background-color:#16151A !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }

    /* Module-lattice background — fixed behind the content, fades in once the
       canvas has painted. Skipped entirely under reduced motion (the script
       never starts, so the canvas just stays empty and invisible). */
    #tools-lattice{ position:fixed; inset:0; width:100vw; height:100vh; z-index:0;
      pointer-events:none; opacity:0; transition:opacity 1.4s ease; }
    #tools-lattice.is-in{ opacity:1; }
    @media (prefers-reduced-motion:reduce){ #tools-lattice{ display:none; } }

    /* ============================================================
       COGNAK barcode tools — violet ink on the site's own #16151A.
       Contrast against the ground, all AA or better:
       ink 15.3:1, ink-soft 7.5:1, accent 6.3:1, placeholder 5.1:1,
       ok 11.5:1, err 9.1:1, dark-ink on the accent button 6.2:1.
       ============================================================ */
    .tools {
      --bg:#16151A;
      --card:rgba(33,31,40,0.90); --field:rgba(0,0,0,0.30); --field-focus:rgba(0,0,0,0.42);
      --ink:#EDEAF3; --ink-soft:#A9A3B8; --accent:#B47CFF; --accent-hi:#C79BFF;
      /* Headline accent only — the brand violet at full chroma shouts at 62px,
         so this sits at the lede's value with just enough hue to read as colour. */
      --accent-soft:#B0A3CF;
      --deep:#1B1424; --line:rgba(237,234,243,0.13); --line-strong:rgba(237,234,243,0.28);
      --placeholder:#8A8499; --ok:#7EE2A8; --err:#FF9E90;
      /* Fixed 190px, matching the shared header position across
         projects/studio/privacy/colophon/brief. */
      max-width:1040px; margin:0 auto; padding:190px 6vw 22vh;
      color:var(--ink); font-family:'Diatype Variable', sans-serif;
    }
    @media (max-width:720px){ .tools{ padding-top:100px; } }
    @media (min-width:960px){ .tools{ margin-left:clamp(48px,10vw,180px); margin-right:auto; } }
    .tools .mono{ font-family:'Diatype Mono', monospace; }

    /* screen.css hides every <label> globally (a Ninja Forms leftover). Restore
       the ones this page relies on, same as /brief does. */
    .tools label.q, .tools legend.q{ display:block !important; }
    .tools label.pill{ display:inline-flex !important; align-items:center; }
    /* screen.css also puts a 0.7s "transition:all" and a negative bottom margin
       on every text input. Both are overridden below. */

    /* ---------------------------------------------------------- header --- */
    .tools .headline{ font-size:clamp(20px,5.5vw,62px); font-weight:500; line-height:1.1;
      letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .tools .headline em{ font-style:normal; font-weight:500; color:var(--accent-soft); }
    .tools .lede{ font-size:1.05rem; line-height:1.65; color:var(--ink-soft); max-width:52ch;
      margin:0 0 3.4rem 40px; }
    @media (max-width:720px){
      .tools .headline{ font-size:clamp(24px,7vw,42px); }
      .tools .lede{ margin-left:0; }
    }
    /* Hidden until the site-wide word-stagger in cognak-global.js splits them,
       so the full line never flashes in first. */
    html.js .tools-headline, html.js .tools-lede{ opacity:0; }
    @media (prefers-reduced-motion:reduce){
      html.js .tools-headline, html.js .tools-lede{ opacity:1; }
    }
    /* Lede fades without the slide, matching the other inner pages' body copy. */
    .tools-lede .stagger-word{ transform:none; transition:opacity .55s ease; }

    /* ------------------------------------------------------------ card --- */
    /* No backdrop-filter anywhere on this page. The lattice behind it repaints
       as the cursor moves, and a blurred backdrop forces the browser to re-blur
       that whole region every single frame — it cost roughly half the frame rate
       at 1440p and two thirds at 2560px. The translucency itself is free, so the
       card keeps its tint and the modules simply show through unblurred. */
    .tools .tcard{ background:var(--card); border-radius:10px; padding:34px 34px 30px;
      box-shadow:0 2px 18px rgba(0,0,0,.28); }
    @media (max-width:600px){ .tools .tcard{ padding:24px 20px 22px; } }

    .tools .group{ border-top:1px solid var(--line); padding-top:2.2rem; margin-top:2.6rem; }
    .tools .group:first-of-type{ border-top:none; padding-top:0; margin-top:0; }
    .tools .group[hidden]{ display:none; }
    .tools .group-title{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.2em;
      text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.9rem; }

    .tools .field{ margin-bottom:2rem; }
    .tools .field:last-child{ margin-bottom:0; }
    .tools .fieldset{ border:none; padding:0; margin-inline:0; }
    .tools .q{ display:block; margin-bottom:.85rem; padding:0; }
    .tools .q-title{ display:block; font-size:1.08rem; font-weight:500; line-height:1.3; color:var(--ink); }
    .tools .q-sub{ display:block; font-size:.88rem; font-weight:450; line-height:1.4; color:var(--ink-soft); margin-top:.2rem; max-width:54ch; }

    .tools .pair{ display:flex; gap:20px; }
    .tools .half{ flex:1 1 0; min-width:0; }
    @media (max-width:600px){ .tools .pair{ flex-direction:column; gap:1.6rem; } }

    /* ---------------------------------------------------------- inputs --- */
    .tools .txt{
      width:100%; box-sizing:border-box; margin:0;
      background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:1rem; line-height:1.5; padding:14px 16px;
      transition:border-color .2s ease, background .2s ease; outline:none;
      -moz-appearance:textfield; }
    .tools .txt::-webkit-outer-spin-button,
    .tools .txt::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
    .tools .txt::placeholder{ color:var(--placeholder); }
    .tools .txt:focus{ border-color:var(--accent); background:var(--field-focus); color:var(--ink); }
    .tools .txt.mono{ font-family:'Diatype Mono', monospace; letter-spacing:.05em; }
    .tools .txt.is-error{ border-color:var(--err); }
    /* Recolor the site's global purple :focus-visible ring to this page's violet. */
    .tools a:focus-visible, .tools button:focus-visible, .tools input:focus-visible,
    .tools select:focus-visible, .tools [tabindex]:focus-visible{ outline-color:var(--accent) !important; }

    .tools .selwrap{ position:relative; }
    .tools .sel{
      width:100%; box-sizing:border-box; -webkit-appearance:none; appearance:none;
      background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:1rem; line-height:1.5; padding:14px 46px 14px 16px;
      transition:border-color .2s ease, background .2s ease; outline:none; cursor:pointer; }
    .tools .sel:focus{ border-color:var(--accent); background:var(--field-focus); }
    /* Native option lists render in the OS palette; force dark so the menu
       doesn't flash white against the page. */
    .tools .sel option{ background:#1E1C24; color:#EDEAF3; }
    .tools .selchev{ position:absolute; right:17px; top:50%; transform:translateY(-50%);
      color:var(--accent); pointer-events:none; display:flex; }

    .tools .suffixed{ position:relative; }
    .tools .suffixed--narrow{ max-width:220px; }
    .tools .suffix{ position:absolute; right:16px; top:50%; transform:translateY(-50%);
      font-family:'Diatype Mono', monospace; font-size:.8rem; color:var(--ink-soft); pointer-events:none; }
    .tools .suffixed .txt{ padding-right:46px; }

    .tools .note{ margin:.7rem 0 0; font-size:.84rem; line-height:1.45; color:var(--ink-soft); min-height:1.2em; }
    .tools .note.is-error{ color:var(--err); }
    .tools .note.is-ok{ color:var(--ok); }

    /* ----------------------------------------------------------- pills --- */
    .tools .pills{ display:flex; flex-wrap:wrap; gap:10px; }
    .tools .pill{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
      border-radius:999px; padding:10px 18px; font-size:.92rem; color:var(--ink); background:var(--field);
      transition:transform .14s cubic-bezier(.2,.7,.3,1), border-color .2s ease, color .2s ease, background .2s ease; }
    .tools .pill:hover{ border-color:var(--ink); }
    .tools .pill:active{ transform:scale(.96); }
    .tools .pill input{ position:absolute; opacity:0; pointer-events:none; }
    .tools .pill .pct{ font-family:'Diatype Mono', monospace; font-size:.72rem; color:var(--ink-soft);
      margin-left:.5rem; transition:color .2s ease; }
    .tools .pill.on{ border-color:var(--accent); color:var(--deep); background:var(--accent); font-weight:500; }
    .tools .pill.on .pct{ color:rgba(27,20,36,.65); }

    /* ----------------------------------------------------------- proof --- */
    /* A white plate on a dark page — the barcode shown the way it will actually
       be printed, rather than knocked out to fit the theme. */
    .tools .proof{ background:#FFFFFF; border-radius:6px; padding:30px 32px;
      display:flex; align-items:center; justify-content:center; min-height:180px;
      box-shadow:0 12px 40px rgba(0,0,0,.34); }
    .tools .proof svg{ display:block; height:auto; max-width:100%; }
    .tools .proof.mode-upc svg{ width:100%; max-width:520px; }
    .tools .proof.mode-qr svg{ width:216px; }
    .tools .proof.is-empty{ background:var(--field); box-shadow:none; color:var(--placeholder);
      font-size:.88rem; font-family:'Diatype Mono', monospace; letter-spacing:.06em; }
    .tools .meta{ margin:1rem 0 0; font-size:.74rem; line-height:1.6; letter-spacing:.04em;
      color:var(--ink-soft); min-height:2.4em; }
    .tools .meta .warn{ color:#FFC98A; }

    /* --------------------------------------------------------- actions --- */
    .tools .actions{ border-top:1px solid var(--line); margin-top:3rem; padding-top:2.4rem;
      display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
    .tools .btn{ font-family:inherit; font-size:1rem; font-weight:500; cursor:pointer;
      display:inline-flex; align-items:center; justify-content:center; gap:.6rem;
      border-radius:999px; padding:14px 28px; background:none; color:var(--ink);
      border:1px solid var(--line-strong);
      transition:background .2s ease, color .2s ease, border-color .2s ease, box-shadow .25s ease; }
    /* Icon strokes are currentColor, so they invert with the label on hover
       and dim with the button when it's disabled. */
    .tools .btn-ico{ display:block; flex:0 0 auto; }
    .tools .btn:hover:not(:disabled){ background:var(--accent); border-color:var(--accent);
      color:var(--deep); box-shadow:0 0 24px rgba(180,124,255,.34); }
    .tools .btn:active:not(:disabled){ transform:scale(.98); }
    .tools .btn:disabled{ opacity:.32; cursor:not-allowed; }
    .tools .actions-note{ margin-left:auto; font-size:.68rem; letter-spacing:.16em;
      text-transform:uppercase; color:var(--placeholder); }
    @media (max-width:600px){
      .tools .actions-note{ display:none; }
      /* Three equal pills on one row rather than wrapping 2 + 1. */
      .tools .actions{ gap:8px; flex-wrap:nowrap; }
      .tools .btn{ flex:1 1 0; padding:14px 6px; font-size:.94rem; gap:.45rem; }
    }

    /* ------------------------------------------------------------ foot --- */
    .tools .tfoot{ margin:2.6rem 0 0; max-width:70ch; font-size:.82rem; line-height:1.7; color:var(--placeholder); }
    .tools .tfoot a{ color:var(--ink-soft); text-decoration:underline; text-underline-offset:3px;
      text-decoration-thickness:1px; transition:color .2s ease; }
    @media (hover:hover){ .tools .tfoot a:hover{ color:var(--accent); } }

    /* ---------------------------------------------------------- motion --- */
    .tools .rise{ opacity:0; transform:translateY(8px); transition:opacity .6s ease, transform .6s ease; }
    .tools .rise.in{ opacity:1; transform:none; }
    .tools .panel{ transition:opacity .24s ease; }
    .tools .panel.swapping{ opacity:0; }
    @media (prefers-reduced-motion:reduce){
      .tools .rise{ opacity:1; transform:none; transition:none; }
      .tools .panel{ transition:none; }
    }

    /* ------------------------------------------------------------- nav --- */
    /* Shared inner-page nav, themed to the violet colorway — same treatment
       /brief gives it, deep + blurred so it stays legible over the card. */
    .home-bottom-bar.inner-page-nav.tools-nav{ background:rgba(18,17,22,0.62) !important;
      -webkit-backdrop-filter:blur(12px) !important; backdrop-filter:blur(12px) !important; }
    .tools-nav .home-bottom-email,
    .tools-nav .home-bottom-location,
    .tools-nav .inner-nav-links a,
    .tools-nav .pulse-dot{ color:#A9A3B8 !important; }
    .tools-nav .home-bottom-email,
    .tools-nav .inner-nav-links a{ transition:color .2s ease; }
    @media (hover:hover){
      .tools-nav .home-bottom-email:hover,
      .tools-nav .inner-nav-links a:hover{ color:#C79BFF !important; }
    }
  </style>

  <script>
    import { normalizeUpc, buildUpcA } from '../../lib/barcode/upca.js';
    import { buildQr } from '../../lib/barcode/qr.js';
    import { toSvg, toPdf, toEps } from '../../lib/barcode/emit.js';
    import { initLattice } from '../../lib/tools-background.js';

    // Tuning lives in LATTICE_DEFAULTS, so there's one place to change it.
    initLattice(document.getElementById('tools-lattice'));

    const EMITTERS = {
      svg: { emit: toSvg, mime: 'image/svg+xml' },
      pdf: { emit: toPdf, mime: 'application/pdf' },
      eps: { emit: toEps, mime: 'application/postscript' },
    };

    const $ = (id) => document.getElementById(id);
    const mmToIn = (mm) => (mm / 25.4).toFixed(3);
    const clamp = (v, lo, hi, fallback) => {
      const n = Number(v);
      return Number.isFinite(n) ? Math.min(hi, Math.max(lo, n)) : fallback;
    };

    const proof = $('proof');
    const meta = $('meta');
    const actions = $('actions');
    const buttons = [...actions.querySelectorAll('button[data-fmt]')];

    /** Current tool's output: { doc, name } — null whenever input is invalid. */
    let current = null;
    let mode = 'upc';

    function show(docObj, name, kind) {
      current = { doc: docObj, name };
      proof.innerHTML = toSvg(docObj);
      proof.classList.remove('is-empty');
      proof.classList.toggle('mode-upc', kind === 'upc');
      proof.classList.toggle('mode-qr', kind === 'qr');
      buttons.forEach((b) => { b.disabled = false; });
    }

    function clear(message) {
      current = null;
      proof.innerHTML = message;
      proof.classList.add('is-empty');
      proof.classList.remove('mode-upc', 'mode-qr');
      meta.innerHTML = '';
      buttons.forEach((b) => { b.disabled = true; });
    }

    /* -------------------------------------------------------------- UPC --- */

    function renderUpc() {
      const input = $('upc-input');
      const note = $('upc-note');
      const result = normalizeUpc(input.value);

      if (!result.ok) {
        input.classList.toggle('is-error', input.value.trim().length > 0);
        note.textContent = result.error;
        note.className = 'note is-error';
        clear('Waiting on a valid number');
        return;
      }

      input.classList.remove('is-error');
      note.textContent = result.computed
        ? `Check digit ${result.check} added — the full code is ${result.digits}.`
        : `Valid. Check digit ${result.check} confirmed.`;
      note.className = 'note is-ok';

      const mag = clamp($('upc-mag').value, 80, 200, 100) / 100;
      const bwr = clamp($('upc-bwr').value, 0, 0.05, 0);
      const doc = buildUpcA(result.digits, { magnification: mag, bwr });

      show(doc, `upc-a-${result.digits}`, 'upc');
      meta.innerHTML =
        `${doc.w} × ${doc.h} mm · ${mmToIn(doc.w)} × ${mmToIn(doc.h)} in<br>` +
        `module ${(0.33 * mag).toFixed(4)} mm · ${Math.round(mag * 100)}% magnification` +
        (mag < 0.9 ? ' <span class="warn">· below 90%, test on a scanner</span>' : '');
    }

    /* --------------------------------------------------------------- QR --- */

    function slug(text) {
      return String(text)
        .replace(/^https?:\/\//, '')
        .replace(/[^a-zA-Z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 48)
        .toLowerCase() || 'qr';
    }

    function currentEc() {
      const on = $('qr-ec').querySelector('input:checked');
      return on ? on.value : 'M';
    }

    function renderQr() {
      const input = $('qr-input');
      const note = $('qr-note');
      const text = input.value.trim();

      if (!text) {
        input.classList.remove('is-error');
        note.textContent = '';
        note.className = 'note';
        clear('Waiting on a link');
        return;
      }

      let doc;
      try {
        doc = buildQr(text, { sizeMm: clamp($('qr-size').value, 10, 300, 30), ecLevel: currentEc() });
      } catch (err) {
        input.classList.add('is-error');
        note.textContent = 'Too long to encode — shorten the link, or drop the damage tolerance a step.';
        note.className = 'note is-error';
        clear('Too much data');
        return;
      }

      input.classList.remove('is-error');
      const isLink = /^(https?:\/\/|mailto:|tel:)/i.test(text);
      note.textContent = isLink
        ? 'Encoded as a link.'
        : 'No scheme on the front — most phone cameras will read this as plain text, not a link.';
      note.className = isLink ? 'note is-ok' : 'note';

      show(doc, `qr-${slug(text)}`, 'qr');
      const m = doc.meta;
      meta.innerHTML =
        `${doc.w} × ${doc.h} mm · ${mmToIn(doc.w)} × ${mmToIn(doc.h)} in<br>` +
        `version ${m.version} · ${m.modules}×${m.modules} modules · ${m.moduleMm} mm each` +
        (m.moduleMm < 0.4 ? ' <span class="warn">· under 0.4 mm, print it bigger</span>' : '');
    }

    const render = () => (mode === 'upc' ? renderUpc() : renderQr());

    /* ------------------------------------------------------------ wiring --- */

    const debounce = (fn, ms = 120) => {
      let t;
      return () => { clearTimeout(t); t = setTimeout(fn, ms); };
    };

    ['upc-input', 'upc-mag', 'upc-bwr', 'qr-input', 'qr-size'].forEach((id) => {
      $(id).addEventListener('input', debounce(render));
    });

    // Error-correction pills behave as a radio group; the visual state lives on
    // the label so the native input can stay hidden.
    $('qr-ec').addEventListener('change', (e) => {
      if (e.target.name !== 'ec') return;
      $('qr-ec').querySelectorAll('.pill').forEach((p) => {
        p.classList.toggle('on', p.contains(e.target));
      });
      render();
    });

    const panels = { upc: $('panel-upc'), qr: $('panel-qr') };
    $('tool-select').addEventListener('change', (e) => {
      const next = e.target.value;
      if (next === mode) return;
      const from = panels[mode];
      const to = panels[next];
      mode = next;
      from.classList.add('swapping');
      window.setTimeout(() => {
        from.hidden = true;
        from.classList.remove('swapping');
        to.hidden = false;
        to.classList.add('swapping');
        // Next frame, so the browser paints the hidden state before fading in.
        requestAnimationFrame(() => requestAnimationFrame(() => to.classList.remove('swapping')));
        render();
      }, 180);
    });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!current) return;
        const { emit, mime } = EMITTERS[btn.dataset.fmt];
        const blob = new Blob([emit(current.doc)], { type: mime });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${current.name}.${btn.dataset.fmt}`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      });
    });

    render();
    requestAnimationFrame(() => $('tcard').classList.add('in'));
  </script>
</BaseLayout>
