        </div>
      </div>
    </div>
  </footer>

  <!-- Sitewide click conversion tracking -->
  <script is:inline>
    function gtag_report_conversion(sendTo, url) {
      var callback = function () { if (typeof url !== 'undefined') { window.location = url; } };
      if (typeof gtag === 'function') {
        gtag('event', 'conversion', { 'send_to': sendTo, 'event_callback': callback });
      }
      return false;
    }
    document.addEventListener('click', function (e) {
      var link = e.target.closest('a');
      if (!link) return;
      var href = link.getAttribute('href') || '';
      if (href.indexOf('mailto:hello@cognak.com') !== -1) {
        // The mailto link's own default action opens the mail client exactly once.
        // Do NOT call gtag_report_conversion here: its event_callback does
        // window.location = url, which re-opens the mail dialog — and gtag can
        // invoke that callback more than once, stacking up several dialogs.
        // Fire the GA4 event + Ads conversion without re-navigating.
        if (typeof gtag === 'function') {
          gtag('event', 'click_email', { 'event_category': 'Contact', 'event_label': 'mailto:hello@cognak.com' });
          gtag('event', 'conversion', { 'send_to': 'AW-876403750/KaY9CKLGmLwcEKa486ED' });
        }
        return;
      }
      if (href.indexOf('calendar.app.google') !== -1) {
        if (typeof gtag === 'function') {
          gtag('event', 'click_schedule_call', { 'event_category': 'Contact', 'event_label': 'Schedule a Call' });
        }
        gtag_report_conversion('AW-876403750/r1GlCKXGmLwcEKa486ED', href);
      }
    });
  </script>
  <!-- if you're reading this, you're our kind of person. pierce@cognak.com -->

  <!-- Global scripts (deferred) -->
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" defer></script>
  <script src={`/js/cognak-lenis-init.js?v=${jsV}`} defer></script>
  <script src={`/js/cognak-global.js?v=${jsV}`} defer></script>
  <script src={`/js/cognak-scrollbar.js?v=${jsV}`} defer></script>

  {/* UnicornStudio: the init script lazy-loads the WebGL library itself
      (on idle, once the hero is near the viewport) — see cognak-unicorn-init.js. */}
  {(page === 'home' || page === 'studio' || page === 'brief' || page === 'send' || page === 'receive') && (
    <script src={`/js/cognak-unicorn-init.js?v=${jsV}`} defer></script>
  )}
  {page === 'home' && <script src={`/js/cognak-home.js?v=${jsV}`} defer></script>}
  {page === 'projects' && <script src={`/js/cognak-projects.js?v=${jsV}`} defer></script>}
  {page === 'project' && <script src={`/js/cognak-single.js?v=${jsV}`} defer></script>}
  <Analytics />
  <SpeedInsights sampleRate={0.25} />
</body>
