---
/**
 * BaseLayout — the site's shared shell.
 * Renders <head> (consent mode, meta, JSON-LD, fonts, CSS), the global
 * cursor + cookie banner, the site footer, and the conditional script loads
 * per page type.
 */
const THEME = '/theme';

export interface Props {
  page?: 'home' | 'studio' | 'projects' | 'project' | 'privacy' | 'colophon' | 'brief' | 'tools' | 'send' | 'receive' | '404' | 'page';
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  ogUrl?: string;
  noindex?: boolean;
  /** Extra JSON-LD object (e.g. CreativeWork on project pages) */
  jsonLd?: Record<string, unknown> | null;
  /** Forced page background color, injected per template */
  pageBg?: string | null;
  /** Absolute/optimized URL of the LCP hero image to preload (project pages) */
  heroPreload?: string | null;
}

const {
  page = 'page',
  title = 'COGNAK | Design & Development Studio, Los Angeles',
  description = 'An award-winning design and development studio in Los Angeles, partnering with startups and global brands on identity, art direction, and web.',
  ogType = 'website',
  ogImage = 'https://cognak.com' + THEME + '/assets/images/cognak-og.jpg',
  ogUrl = 'https://cognak.com/',
  noindex = false,
  jsonLd = null,
  pageBg = null,
  heroPreload = null,
} = Astro.props;

const isHome = page === 'home';
const bodyClass = isHome ? 'non-fixed-nav' : 'fixed-nav';

/* color-scheme (and the page-background classification the scrollbar colours use).
   The site had zero scrollbar styling, so every dark page rendered the stock
   light scrollbar - the most visible browser default left on it. The native
   scrollbar is now hidden entirely and replaced by a custom overlay bar; see
   custom.css and cognak-scrollbar.js for why.

   Light/dark is DERIVED from the page's own background rather than a hardcoded
   list, so a new page can't drift out of sync with its own colour (which is how
   the studio avail-dot ended up contradicting itself in three places). Two pages
   don't pass pageBg and must be named explicitly: home paints #17151a from CSS,
   and project detail resolves to white. Assuming "no pageBg = light" would put a
   light scrollbar on the darkest page on the site, so these fallbacks are
   load-bearing, not decorative.

   color-scheme also themes native form controls (the /brief range slider, the
   /tools number spinners, autofill on /send) - intended, and the reason this is
   derived per page rather than set once globally.

   color-scheme is still worth deriving even with no native scrollbar: it drives
   the form controls above and the browser's own canvas colour. */
const PAGE_BG_FALLBACK = { home: '#17151a', project: '#ffffff' };

/* Thumb colour for the CUSTOM overlay scrollbar (#cognak-scrollbar), consumed as
   --sb-thumb. The native scrollbar is hidden entirely — see custom.css.

   ONE RULE, not a palette: the bar is the page's own ink at 15%. It reads as a
   veil over the background rather than a coloured element, so it recedes on
   every page without needing a per-page decision.

   "Ink" means the OPPOSITE of the page, which is the part worth understanding.
   Near-black at 15% over a near-black page is arithmetically no change —
   measured 1.00:1 on home, studio and tools, i.e. an invisible scrollbar. So
   dark pages take white at 15% and light pages take the Cognak near-black at
   15%. Same idea, same weight, expressed against whatever the page is:

     dark  (white @15%)  home 1.56  studio 1.56  brief 1.51  send 1.48  tools 1.56
     light (ink   @15%)  projects 1.36  privacy 1.35  project 1.37  404 1.36

   Deliberately subtle — this is a 15% veil, not an accent. Anything under ~1.35
   stops being perceptible, which is the floor to respect if a page is added. */
const SB_INK   = 'rgba(23, 21, 26, 0.15)';    // Cognak near-black, for light pages
const SB_LIGHT = 'rgba(255, 255, 255, 0.15)'; // for dark pages

/* The one page the rule can't serve at 15%: klein blue is mid-luminance AND
   saturated, so a 15% veil lands at 1.26 (white) or 1.14 (ink) — invisible
   either way.

   Pierce's call is DARKER, not lighter, so this is the same near-black ink,
   opened up until it's perceptible. Darkening klein blue is inefficient because
   the blue is already low-luminance: ink at 25% only reaches 1.23, at 50% 1.46.
   70% gets to 1.62 — matching the perceptual weight the 15% veil has everywhere
   else — and resolves to a deep navy (#141051), which reads as the page's own
   blue pushed down rather than a grey bar laid over it.
   For reference the nav's literal darker blue (#0700AC) only measures 1.23 here,
   which is why this is a veil and not that colour. */
const SCROLL_THUMB_OVERRIDE = {
  colophon: 'rgba(23, 21, 26, 0.70)',

  /* /brief is the other page the veil can't serve, for a different reason: its
     WebGL runs full-bleed behind everything and swings from luminance 0 to 46
     (measured), so a translucent thumb gets modulated by whatever frame the
     animation is on and shimmers as you scroll. OPAQUE fixes that — the bar
     stops reacting to the background entirely. #37322C is exactly what the 15%
     white veil resolves to over this page's #140E07, frozen. */
  brief: '#37322C',
};

function relLuminance(hex) {
  let h = String(hex || '').replace('#', '').trim();
  if (h.length === 3) h = h.split('').map((c) => c + c).join('');
  if (h.length !== 6) return 1; // unparseable -> treat as light, i.e. leave it alone
  const chan = (v) => {
    const s = parseInt(v, 16) / 255;
    return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
  };
  return 0.2126 * chan(h.slice(0, 2)) + 0.7152 * chan(h.slice(2, 4)) + 0.0722 * chan(h.slice(4, 6));
}

const schemeBg   = pageBg || PAGE_BG_FALLBACK[page] || '#ffffff';
const isDarkPage = relLuminance(schemeBg) < 0.25;
const scrollThumb = SCROLL_THUMB_OVERRIDE[page] || (isDarkPage ? SB_LIGHT : SB_INK);

// Cache-buster for the unhashed /js/ scripts, stable across the whole build:
// the deploy's commit SHA on Vercel, else an hour-rounded timestamp locally.
// Every deploy gets a fresh ?v=, so phones stop running day-old cached JS
// against fresh HTML/CSS (Vercel serves /js/ with max-age=86400 + SWR 30d).
const jsV = (process.env.VERCEL_GIT_COMMIT_SHA || '').slice(0, 8)
  || Math.floor(Date.now() / 3600000).toString(36);

// Inner-page top nav (home-bottom-bar inner-page-nav) renders on these pages.
const innerNavPages = ['studio', 'projects', 'project', 'privacy', 'colophon', 'brief', 'tools', 'send', 'receive', '404'];
const showInnerNav = innerNavPages.includes(page);
const innerNavVariant =
  page === 'studio' ? ' studio-nav' :
  page === 'privacy' ? ' privacy-nav' :
  page === 'colophon' ? ' colophon-nav' :
  page === 'brief' ? ' brief-nav' :
  page === 'tools' ? ' tools-nav' :
  // /send and /receive have their own teal colorway + nav treatment, distinct
  // from /tools' violet (each page defines its own `.send-nav` overrides in
  // its own <style> block, so sharing the class name between the two is safe).
  page === 'send' || page === 'receive' ? ' send-nav' :
  page === '404' ? ' fourofour-nav' : '';

// Corner cookie banner (non-home pages): dark glass on Studio (dark bg, dark nav),
// light glass on the Projects listing (light bg, light frosted nav). Individual
// project case-study pages are skipped for now — GA/Ads consent mode already
// defaults every non-essential cookie to denied sitewide, so there's no tracking
// gap, just less prompting on those pages.
const cornerVariant =
  page === 'studio' ? 'dark' :
  page === 'projects' ? 'light' : null;
const showCookieBanner = isHome || cornerVariant;
const cornerClass = cornerVariant ? `cognak-cookie--corner cognak-cookie--corner-${cornerVariant}` : '';

const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'COGNAK',
  description:
    'An award-winning design and development studio based in Los Angeles. We partner with startups, rising ventures, and global brands to lead next-gen creative work.',
  url: 'https://cognak.com',
  logo: 'https://cognak.com' + THEME + '/assets/images/cognak-logo.svg',
  email: 'hello@cognak.com',
  telephone: '+16178636802',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  founder: { '@type': 'Person', name: 'Pierce Liefeld', jobTitle: 'Founder & CEO' },
  alternateName: ['COGNAK Studio', 'COGNAK Design', 'COGNAK Agency', 'Cognak Los Angeles'],
  disambiguatingDescription:
    'COGNAK is a proper brand name (pronounced kōnˌyak), not a variant spelling of cognac. It is a design and development studio based in Los Angeles.',
  sameAs: [
    'https://www.instagram.com/cognak/',
    'https://dribbble.com/cognak',
    'https://www.awwwards.com/sites/cognak',
    'https://cognak.com',
    'https://www.wikidata.org/wiki/Q140469493',
  ],
  knowsAbout: [
    'Art Direction', 'Brand Identity', 'Web Design', 'Web Development', 'UI/UX Design',
    'Motion & Animation', 'Creative Strategy', 'Packaging Design', 'Design Systems', 'Video Production',
  ],
};

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/site.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) — consent mode default must fire before any config -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'analytics_storage': 'denied',
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#3a313b" />
  {isHome && <style is:inline set:html={`html,body{background:#17151a!important}`}></style>}
  {pageBg && <style is:inline set:html={`html,body{background-color:${pageBg}!important}`}></style>}
  <style is:inline set:html={`html{color-scheme:${isDarkPage ? 'dark' : 'light'};--sb-thumb:${scrollThumb}}`}></style>
  <title set:html={title}></title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="preconnect" href="https://assets.unicorn.studio" />
  <!-- Site icons -->
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
  <link rel="icon" href="/favicon-192x192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="msapplication-TileImage" content="/mstile-270x270.png" />
  <link rel="author" type="text/plain" href="/humans.txt" />
  <link rel="preload" href={`${THEME}/assets/images/cognak-logo.svg`} as="image" type="image/svg+xml" />
  {heroPreload && <link rel="preload" href={heroPreload} as="image" fetchpriority="high" />}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(professionalService)} />
  {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

  <meta name="description" content={description} />
  {/* Canonical: dedupes URL variants (gclid/UTM params from Ads clicks, trailing
      slash, etc.) so ranking signals collect on one URL. Skipped on noindex
      pages — a canonical on a page told not to index is contradictory. */}
  {!noindex && <link rel="canonical" href={ogUrl} />}
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {isHome && <meta name="p:domain_verify" content="ffad2dc262e467b3e80d13ee1449d794" />}

  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="COGNAK" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Diatype Variable is self-hosted (see @font-face in custom.css) -->

  {isHome && (
    <style is:inline>{`
@keyframes cognak-fade-in { from { opacity: 0; } to { opacity: 1; } }
.home-bottom-bar, #awwwards, .scroll-discover, #cognak-cookie {
    animation: cognak-fade-in 1s ease 0s both;
}
`}</style>
  )}

  <!-- Google tags — GA4 + Ads, sharing one dataLayer -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SE5WX8VYF3"></script>
  <script is:inline>
    (function () {
      try {
        if (document.cookie.indexOf('cognak_consent=accepted') !== -1) {
          gtag('consent', 'update', {
            'analytics_storage': 'granted',
            'ad_storage': 'granted',
            'ad_user_data': 'granted',
            'ad_personalization': 'granted'
          });
        }
      } catch (e) {}
      // Preserve gclid in URLs for consent-denied visitors so ad-driven
      // page views can still be recorded as conversions (consent mode).
      gtag('set', 'url_passthrough', true);
      gtag('js', new Date());
      gtag('config', 'G-SE5WX8VYF3');
      gtag('config', 'AW-876403750');
      gtag('event', 'conversion', { 'send_to': 'AW-876403750/xmGnCNTYt7scEKa486ED' });
      // Cosmetic cleanup for url_passthrough: by window load, gtag.js (async in
      // head) has already executed and read the _gl linker param, so stripping
      // it from the address bar does not affect attribution. If gtag is blocked
      // client-side, stripping loses nothing. Only _gl is removed; gclid etc. stay.
      window.addEventListener('load', function () {
        try {
          if (location.search.indexOf('_gl=') !== -1) {
            var u = new URL(location.href);
            u.searchParams.delete('_gl');
            var q = u.searchParams.toString();
            history.replaceState(history.state, '', u.pathname + (q ? '?' + q : '') + u.hash);
          }
        } catch (e) {}
      });
    })();
  </script>
  <script is:inline define:vars={{ page }}>window.COGNAK_PAGE = page; document.documentElement.classList.add('js');</script>
  {page === 'projects' && (
    <script is:inline>{`(function(){try{var v=localStorage.getItem('cognak-projects-view');document.documentElement.classList.add(v==='grid'?'pv-grid':'pv-list');}catch(e){document.documentElement.classList.add('pv-list');}})();`}</script>
  )}
  <!-- Project→project view transition: clean cross-fade instead of mismatched hero morph.
       Grid→project (and home→project) keep the shared-element thumbnail morph untouched. -->
  <script is:inline>
    (function () {
      var isProject = function (p) { return /^\/projects\/[^/]+\/?$/.test(p || ''); };
      var apply = function (vt, fromPath, toPath) {
        if (!vt || !isProject(fromPath) || !isProject(toPath)) return;
        try { vt.types.add('proj-switch'); } catch (e) {}
        var hero = document.querySelector('.img-wide--hero');
        if (hero) hero.style.viewTransitionName = 'none';
      };
      window.addEventListener('pageswap', function (e) {
        if (!e.viewTransition) return;
        var to = e.activation && e.activation.entry ? new URL(e.activation.entry.url).pathname : '';
        apply(e.viewTransition, location.pathname, to);
      });
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var nav = window.navigation;
        var from = nav && nav.activation && nav.activation.from ? new URL(nav.activation.from.url).pathname : '';
        apply(e.viewTransition, from, location.pathname);
      });
    })();
  </script>

  <!-- List row → project morph. The list is the DEFAULT view on /projects, so most
       visitors were getting a plain root fade while grid users got the signature
       thumb→hero morph. The rows are now named too; this just tags the transition
       so custom.css can drop the old (text) snapshot fast instead of stretching it.
       Gated on the saved view preference rather than a click flag, because for a
       cross-document transition the pseudo-elements live in the NEW document and
       localStorage is the only same-origin signal that survives the navigation. -->
  <script is:inline>
    (function () {
      var isProject = function (p) { return /^\/projects\/[^/]+\/?$/.test(p || ''); };
      var isArchive = function (p) { return /^\/projects\/?$/.test(p || ''); };
      var listView = function () {
        try { return localStorage.getItem('cognak-projects-view') !== 'grid'; } catch (e) { return true; }
      };
      var apply = function (vt, fromPath, toPath) {
        if (!vt || !isArchive(fromPath) || !isProject(toPath) || !listView()) return;
        try { vt.types.add('list-morph'); } catch (e) {}
      };
      window.addEventListener('pageswap', function (e) {
        if (!e.viewTransition) return;
        var to = e.activation && e.activation.entry ? new URL(e.activation.entry.url).pathname : '';
        apply(e.viewTransition, location.pathname, to);
      });
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var nav = window.navigation;
        var from = nav && nav.activation && nav.activation.from ? new URL(nav.activation.from.url).pathname : '';
        apply(e.viewTransition, from, location.pathname);
      });
    })();
  </script>

  <style is:inline>
    /* Frosted nav blur kept inline so the standard backdrop-filter survives CSS
       minification, which strips the unprefixed property from the bundle and
       leaves only -webkit- (which Chrome ignores alone). Matches the studio nav:
       a 6px frost on the pinned homepage nav and every inner-page nav. */
    .home-bottom-bar.nav-mode,
    .home-bottom-bar.inner-page-nav {
      -webkit-backdrop-filter: blur(6px) !important;
      backdrop-filter: blur(6px) !important;
    }
    /* Same reason: the studio corner cookie banner's glass blur must survive
       minification too. */
    #cognak-cookie.cognak-cookie--corner {
      -webkit-backdrop-filter: blur(6px) !important;
      backdrop-filter: blur(6px) !important;
    }
  </style>
</head>
<!-- data-page mirrors the `page` prop onto the DOM so CSS can target a single
     page without a bespoke class per page. First customer: the per-page
     ::selection colours in custom.css. window.COGNAK_PAGE is the JS equivalent. -->
<body id="cognak" class={bodyClass} data-page={page}>
  <a href="#cognak-main" class="skip-to-main">Skip to main content</a>
  <div id="cognak-cursor"><span id="cognak-cursor-label"></span><img id="cognak-cursor-img" src="" alt="" /><video id="cognak-cursor-video" src="" muted loop playsinline webkit-playsinline preload="auto" aria-hidden="true"></video></div>

  <!-- Custom overlay scrollbar. The native one is hidden (see custom.css) so it
       stops reserving a gutter — that gutter is what cut every fixed nav ~11px
       short of the right edge on any machine using classic scrollbars (macOS with
       a mouse attached, most of Windows). This floats over the content instead,
       the way macOS overlay scrollbars do, so nothing loses width.
       aria-hidden because it duplicates scrolling the page already exposes;
       keyboard scrolling is unaffected. -->
  <div id="cognak-scrollbar" aria-hidden="true"><i></i></div>

  {showCookieBanner && (
    <Fragment>
    {/* No aria-modal: the banner is non-blocking (no focus trap, page stays interactive),
        so marking it modal would wrongly tell screen readers the rest of the page is inert. */}
    <div id="cognak-cookie" class={cornerClass} role="dialog" aria-label="Cookie consent" aria-describedby="cognak-cookie-desc">
      <span class="cognak-cookie-label" id="cognak-cookie-desc">This site uses <a href="/privacy-policy" class="cognak-cookie-link">cookies</a></span>
      <button class="cognak-cookie-opt" id="cognak-decline" type="button">
        <span class="cognak-cookie-radio"></span>Decline
      </button>
      <button class="cognak-cookie-opt cognak-cookie-opt--on" id="cognak-accept" type="button">
        <span class="cognak-cookie-radio cognak-cookie-radio--on"></span>Accept
      </button>
    </div>
    <script is:inline define:vars={{ isCornerVariant: Boolean(cornerVariant) }}>
      (function () {
        var el = document.getElementById('cognak-cookie');
        if (!el) return;
        if (document.cookie.indexOf('cognak_consent=') !== -1) { el.style.display = 'none'; return; }
        // Corner variant and mobile homepage: stay put, locked to the viewport corner.
        // Desktop homepage only: reparent onto <html> so the banner rides with the hero scroll.
        var isMobileCookie = !isCornerVariant && window.innerWidth <= 720;
        if (!isCornerVariant && window.innerWidth > 720) { document.documentElement.appendChild(el); }
        function setCookie(val) {
          var d = new Date(); d.setFullYear(d.getFullYear() + 1);
          document.cookie = 'cognak_consent=' + val + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
        }
        function dismiss() {
          el.style.opacity = '0';
          el.style.pointerEvents = 'none';
          setTimeout(function () { el.style.display = 'none'; }, 400);
        }
        document.getElementById('cognak-accept').addEventListener('click', function () {
          setCookie('accepted');
          if (typeof gtag === 'function') gtag('consent', 'update', { analytics_storage: 'granted', ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' });
          dismiss();
        });
        document.getElementById('cognak-decline').addEventListener('click', function () {
          setCookie('declined');
          dismiss();
        });
        // Corner variant + mobile homepage: hidden until visitor starts scrolling,
        // then fades in once and stays. Mobile homepage uses the same reveal pattern
        // since it now lives at the bottom-right corner just like Studio/Projects.
        if (isCornerVariant || isMobileCookie) {
          var revealed = false;
          function reveal() {
            if (revealed) return;
            revealed = true;
            el.classList.add('cognak-cookie--visible');
            window.removeEventListener('scroll', reveal);
          }
          if (window.scrollY > 0) { reveal(); }
          else { window.addEventListener('scroll', reveal, { passive: true }); }
        }
      })();
    </script>
    </Fragment>
  )}

  {showInnerNav && (
    <div class={`home-bottom-bar inner-page-nav${innerNavVariant}`} style={page === 'studio' ? 'background:transparent!important;' : undefined}>
      <a href="/" class="home-bottom-logo">
        <img src="/theme/assets/images/cognak-logo.svg" alt="COGNAK" />
      </a>
      <a href="mailto:hello@cognak.com" class="home-bottom-email">hello@cognak.com</a>
      <div class="home-bottom-location">Los Angeles, CA <span class="pulse-dot" aria-hidden="true">&bull;</span> <span id="la-time" aria-hidden="true"></span></div>
      <div class="inner-nav-links">
        <a href="/projects">Projects</a>
        <a href="/studio">Studio</a>
      </div>
    </div>
  )}

  <slot />

  {/* /send + /receive used to skip the sitewide footer as "a tight utility
      flow, not an editorial page". Reversed 2026-07-28 (Pierce): now that both
      pages sit on the shared 190px header grid and carry the nav bar, dropping
      the footer was what made them feel like a different site. */}
  <footer class="main-footer">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-contact">
          {/* Three doors, ordered by commitment: a question, a project, a
             conversation. The brief was previously reachable ONLY from the
             bottom of home / projects / studio — so anyone arriving on a case
             study, the colophon, privacy or 404 had no route to it at all. The
             footer is on every page and is by definition the end of the page,
             which is where someone is ready to act. Sitewide on purpose; it does
             not clash with the big "Start a project" block on those three pages
             because this reads as contact information, not a CTA. */}
          <span class="footer-label">Get in touch</span>
          <a href="mailto:hello@cognak.com" class="footer-email-link">hello@cognak.com</a>
          <a href="/brief" class="footer-email-link">write a brief</a>
          <a href="https://calendar.app.google/U4EdR5gEVfaGkWhN8" class="footer-email-link">schedule a call</a>
        </div>
        <div class="footer-social">
          <span class="footer-label">Social</span>
          <a href="https://www.instagram.com/cognak/" target="_blank" rel="noopener noreferrer">instagram</a>
          <a href="https://dribbble.com/cognak" target="_blank" rel="noopener noreferrer">dribbble</a>
        </div>
        <div class="footer-top-right">
          <a href="#" class="footer-backtotop">Back to top</a>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy">
          {/* Desktop: one inline row (copy + all three links) via .footer-copy /
              .footer-legal flex, both baseline-aligned. Mobile: .footer-copy and
              .footer-legal switch to display:contents (see the max-width:720px
              block in custom.css) so these four items become direct grid
              children of .footer-bottom instead — Colophon/Tools stacked
              top-left, Privacy Policy bottom-left, copyright bottom-right.
              Each link's own class is what that grid targets, so don't drop
              footer-colophon-link / footer-tools-link / footer-privacy-link
              even though footer-privacy still does the shared color/hover
              styling. THIS MARKUP HAS BEEN DROPPED BY A CONCURRENT EDIT AND
              RE-APPLIED THREE TIMES (2026-07-28) — if you're editing this
              file yourself, please reload it from disk first so your save
              doesn't revert it again. */}
          <p class="footer-copy-text">© {new Date().getFullYear()} COGNAK LLC</p>
          <nav class="footer-legal">
            <a href="/privacy-policy" class="footer-privacy footer-privacy-link">Privacy Policy</a>
            <a href="/colophon" class="footer-privacy footer-colophon-link">Colophon</a>
            <a href="/tools" class="footer-privacy footer-tools-link">Tools</a>
          </nav>
        </div>
        <div class="footer-links">
