---
/**
 * /receive — client-facing file-download page.
 * Reached as cognak.com/files/<token> via a vercel.json rewrite (so the browser
 * URL stays clean); also readable directly as /receive?t=<token> for local
 * testing, since Vercel-only rewrites don't apply under `astro dev`.
 *
 * Passcode-free: posts { token } to /api/deliver-get.js, which reads the
 * share manifest from Vercel Blob and returns the file list. No passcode or
 * admin session needed — the token itself is the credential. This is the
 * link COGNAK sends a client instead of a Hightail link.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="receive"
  title="Files from COGNAK"
  description="A file delivery from COGNAK."
  ogUrl="https://cognak.com/receive/"
  noindex={true}
  pageBg="#090C0B"
>
  <div class="send-webgl" data-us-project="PWb8s0lxglpnSGUgkkIR" aria-hidden="true"></div>

  <main id="cognak-main"><section class="receive">

    <h1 class="headline receive-headline"><em>Files</em> from COGNAK.</h1>
    <p class="lede receive-lede" id="receive-lede">Loading your files…</p>

    <div class="dcard rise" id="invalid" hidden>
      <p class="note is-error" id="invalid-note" role="alert">This link isn't complete. Check the URL your recipient sent you.</p>
    </div>

    <div class="dcard rise" id="files-card" hidden>
      <div class="group">
        <div class="group-title" id="files-title">Files</div>
        <ul class="flist" id="flist"></ul>
        <p class="expiry-note" id="expiry-note" hidden></p>
      </div>
    </div>

  </section></main>

  <style is:inline>
    html, body { background-color:#090C0B !important; }
    #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }

    /* WebGL background (UnicornStudio, project PWb8s0lxglpnSGUgkkIR) — fixed
       behind #cognak-main, fades in once the canvas mounts. Same setup as
       /brief and /studio; skipped entirely on reduced-motion. Replaced the
       hand-drawn "transit" canvas (src/lib/send-background.js) on 2026-07-28. */
    .send-webgl{ position:fixed; inset:0; width:100vw; height:100vh; z-index:0;
      pointer-events:none; opacity:0; transition:opacity 1.6s ease; }
    .send-webgl.webgl-ready{ opacity:1; }
    @media (prefers-reduced-motion:reduce){ .send-webgl{ display:none; } }

    /* Same dark teal colorway as /send — see that page's comment for the
       full rationale and the WCAG AA contrast notes. */
    .receive {
      --bg:#090C0B;
      --card:#0E1413; --field:rgba(0,0,0,0.28); --field-focus:rgba(0,0,0,0.40);
      --ink:#D5E6E4; --ink-soft:#BED0CD; --accent:#BED0CD; --accent-hi:#D5E6E4;
      --accent-soft:#8FC2F2; --deep:#151B1A; --line:rgba(213,230,228,0.18);
      --line-strong:rgba(213,230,228,0.52); --placeholder:#829C98;
      --ok:#8FE7B4; --err:#FFA79A;
      --warn:#FF7A5C; /* expiry countdown — see /send */
      /* Brightest-thing-on-the-page CTA, matching /send. */
      --cta:#8FC2F2; --cta-hi:#A9D2F6;
      /* Fixed 190px, same shared-header convention as /send and every other
         inner page — see /send's comment for why the viewport centering went.
         820px matches /send's container width exactly — the headline/lede
         and the Files card share this one parent's width, same as /send's
         header text and its cards (Pierce, 2026-07-29). */
      max-width:820px; margin:0 auto; padding:190px 6vw 22vh;
      color:var(--ink); font-family:'Diatype Variable', sans-serif;
    }
    @media (max-width:720px){ .receive{ padding-top:100px; } }
    .receive .mono{ font-family:'Diatype Mono', monospace; }
    .receive label.q{ display:block !important; }
    /* Same Ninja Forms leftover, same fix as /brief: screen.css carries a
       global `label{display:none!important}`, so every <label> this page uses
       has to opt back in explicitly. The expiry pills ARE labels — without
       this they collapse to nothing and the row renders as blank space. */
    .receive label.pill{ display:inline-flex !important; align-items:center; }

    /* Site headline scale — clamp(20px,5.5vw,62px) desktop / clamp(24px,7vw,42px)
       under 720px, identical to .projects-display-headline, .colophon-headline,
       .tools .headline and .brief .headline. /send and /receive were the only
       inner pages running a smaller 52/38 ramp, so their headline read a size
       down from every other page at the same 190px top offset. */
    .receive .headline{ font-size:clamp(20px,5.5vw,62px); font-weight:500; line-height:1.1;
      letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
    .receive .headline em{ font-style:normal; font-weight:500; color:var(--accent-soft); }
    .receive .lede{ font-size:1.05rem; line-height:1.65; color:var(--ink-soft); max-width:56ch; margin:0 0 3.4rem 0; }
    @media (max-width:720px){ .receive .headline{ font-size:clamp(24px,7vw,42px); } }
    html.js .receive-headline, html.js .receive-lede{ opacity:0; }
    @media (prefers-reduced-motion:reduce){
      html.js .receive-headline, html.js .receive-lede{ opacity:1; }
    }
    .receive-lede .stagger-word{ transform:none; transition:opacity .55s ease; }

    .receive .dcard{ border-radius:10px; padding:34px 34px 30px;
      box-shadow:0 2px 18px rgba(0,0,0,.26); margin-bottom:1.4rem;
      /* Opaque, so the transit dashes can't drift under body text. That
         matters for more than taste: measured with a dash passing behind a
         card, contrast fell under the AA line — the page stopped passing AA
         for exactly as long as the animation took to cross. The animation now
         reads around the cards, not through them. (backdrop-filter was tried
         and rejected: it softens the shift without removing it, and costs a
         full-viewport blur every frame.) */
      background:var(--card);
    }
    @media (max-width:600px){ .receive .dcard{ padding:24px 20px 22px; } }

    .receive .group-title{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.2em;
      text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.6rem; }
    .receive .field{ margin-bottom:0; }
    .receive .q{ display:block; margin-bottom:.85rem; padding:0; }
    .receive .q-title{ display:block; font-size:1.02rem; font-weight:500; line-height:1.3; color:var(--ink); }

    .receive .txt{
      width:100%; box-sizing:border-box; margin:0;
      background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
      color:var(--ink); font-family:inherit; font-size:1.1rem; letter-spacing:.08em; line-height:1.5; padding:14px 16px;
      transition:border-color .2s ease, background .2s ease; outline:none; }

    /* Typed text was going illegible: WebKit paints autofilled fields with its
       own dark-on-pale treatment, and on a dark field that lands as near-black
       on near-black. -webkit-text-fill-color is the only thing that overrides
       the text colour there (plain `color` is ignored), and the giant inset
       shadow is the standard way to repaint the background, since
       background-color is likewise overridden. The absurd transition delay
       stops WebKit animating its yellow back in on re-focus. */
    .send .txt, .receive .txt{ -webkit-text-fill-color:var(--ink); caret-color:var(--accent); }
    .send .txt:-webkit-autofill,
    .send .txt:-webkit-autofill:hover,
    .send .txt:-webkit-autofill:focus,
    .send .txt:-webkit-autofill:active,
    .receive .txt:-webkit-autofill,
    .receive .txt:-webkit-autofill:hover,
    .receive .txt:-webkit-autofill:focus,
    .receive .txt:-webkit-autofill:active{
      -webkit-text-fill-color:var(--ink) !important;
      caret-color:var(--accent);
      -webkit-box-shadow:0 0 0 1000px var(--field) inset !important;
      box-shadow:0 0 0 1000px var(--field) inset !important;
      transition:background-color 9999s ease-out 0s; }

    .receive .txt:focus{ border-color:var(--accent); background:var(--field-focus); }
    .receive .txt.is-error{ border-color:var(--err); }
    .receive a:focus-visible, .receive button:focus-visible, .receive input:focus-visible{ outline-color:var(--accent) !important; }

    .receive .note{ margin:.7rem 0 0; font-size:.84rem; line-height:1.45; color:var(--ink-soft); min-height:1.2em; }
    .receive .note.is-error{ color:var(--err); }

    .receive .actions{ margin-top:1.6rem; }
    .receive .btn{ font-family:inherit; font-size:.98rem; font-weight:500; cursor:pointer;
      display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
      border-radius:999px; padding:14px 26px; background:none; color:var(--ink);
      border:1px solid var(--line-strong);
      transition:background .2s ease, color .2s ease, border-color .2s ease, box-shadow .25s ease; }
    /* Primary CTA carries the headline's blue, and glows on hover the way
       /brief's does — same 0 0 24px shadow, same .45 alpha, just this page's
       accent instead of /brief's orange. --deep on #8FC2F2 is 9.28:1, so the
       label clears AA comfortably; the hover tint lightens rather than
       darkens so contrast only ever improves. */
    .receive .btn.btn-primary{ background:var(--cta); border-color:var(--cta); color:var(--deep);
      transition:box-shadow .25s ease, background .2s ease, border-color .2s ease; }
    .receive .btn.btn-primary:hover:not(:disabled){ background:var(--cta-hi); border-color:var(--cta-hi);
      box-shadow:0 0 24px rgba(143,194,242,.45); }
    .receive .btn:active:not(:disabled){ transform:scale(.98); }
    .receive .btn:disabled{ opacity:.55; cursor:not-allowed; }

    .receive .flist{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
    /* 11px rather than 14px: the 46px preview thumbnail now sets the row
       height, so the old vertical padding made every row read as oversized. */
    .receive .frow{ display:flex; align-items:center; gap:14px; background:var(--field);
      border:1px solid var(--line); border-radius:8px; padding:11px 16px;
      transition:border-color .2s ease; }
    /* The row a preview is currently showing for. Both the row edge and the
       thumbnail take the accent so there's no doubt which file the floating
       card belongs to — it sits away from the list, next to the cursor. */
    .receive .frow.is-hot{ border-color:var(--line-strong); }

    /* ---- preview thumbnail, left edge of each row ----------------------
       A <button> for previewable files (so it's reachable by keyboard and
       tappable on touch, where there is no hover) and an inert <span> for
       everything else. Images under THUMB_MAX render for real; anything
       bigger, plus PDFs and unknown types, gets a dashed extension tile —
       pulling a 30MB TIFF down to paint 46 square pixels isn't worth it. */
    .receive .frow-thumb{ flex:0 0 auto; width:46px; height:46px; border-radius:6px; overflow:hidden;
      background:var(--deep); border:1px solid var(--line); padding:0; margin:0;
      display:flex; align-items:center; justify-content:center; position:relative;
      transition:border-color .2s ease; }
    .receive button.frow-thumb{ cursor:zoom-in; }
    .receive .frow.is-hot .frow-thumb{ border-color:var(--accent); }
    .receive .frow-thumb img,
    .receive .frow-thumb video{ width:100%; height:100%; object-fit:cover; display:block; }
    .receive .frow-thumb.is-plain{ border-style:dashed; }
    .receive .frow-thumb .tp{ font-family:'Diatype Mono', monospace; font-size:.5rem;
      letter-spacing:.06em; color:var(--placeholder); }
    /* Play glyph over the video poster frame — the still alone reads as an
       image, and "is this the reel or a frame grab" is exactly the guess
       this whole feature exists to remove. */
    .receive .frow-thumb .play{ position:absolute; inset:0; display:flex; align-items:center;
      justify-content:center; background:rgba(0,0,0,.34); }
    .receive .frow-thumb .play::after{ content:""; border-left:9px solid #fff;
      border-top:6px solid transparent; border-bottom:6px solid transparent;
      margin-left:2px; opacity:.92; }
    /* line-height matters here: reset.css sets `font:inherit` on these
       elements, and with overflow:hidden a tight line box clips descenders —
       "Dark Yak.png" lost the tail of its g. 1.5 gives the box room. */
    .receive .frow-name{ flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; line-height:1.5; font-size:.96rem; }
    .receive .frow-size{ color:var(--ink-soft); font-family:'Diatype Mono', monospace; font-size:.8rem; flex:0 0 auto; }
    .receive .frow-dl{ flex:0 0 auto; text-decoration:none; }
    /* Downloaded rows step back rather than light up — done is quieter than
       to-do, so what's left unread is what stands out in a long list. */
    .receive .frow-dl.is-done{ color:var(--ink-soft); border-color:var(--line); }
    .receive .frow-dl.is-done:hover{ color:var(--ink); border-color:var(--line-strong); }
    /* Expiry, told to the client rather than only to Pierce. Sits under the
       list as a quiet note, not a warning — until it's genuinely urgent, at
       which point it takes the error colour. */
    .receive .expiry-note{ margin:1.2rem 0 0; font-size:.8rem; line-height:1.75;
      color:var(--ink-soft); font-family:'Diatype Mono', monospace; }
    /* Download All — shown above the list (right under the title) when there
       are 3+ files. Divider sits on the bottom edge so the button reads as
       grouped with the title above it, separated from the rows below. */
    .receive .dl-all-wrap{ margin-bottom:1.4rem; padding-bottom:1.2rem; border-bottom:1px solid var(--line); }
    .receive .btn-dl-all{ width:100%; justify-content:center; }
    /* Only the deadline itself takes the warn colour — the instruction around
       it stays in normal ink, so the eye lands on the bit that runs out. */
    .receive .expiry-note .exp-warn{ color:var(--warn); }
    .receive .expiry-note[hidden]{ display:none; }

    .receive .rise{ opacity:0; transform:translateY(8px); transition:opacity .6s ease, transform .6s ease; }
    .receive .rise.in{ opacity:1; transform:none; }
    @media (prefers-reduced-motion:reduce){ .receive .rise{ opacity:1; transform:none; transition:none; } }


    /* ---- step transition: gate <-> the view behind it -------------------
       Lifted from /brief's picker->questionnaire swap so the two flows feel
       like the same site: the outgoing panel fades up and out over 260ms,
       then the incoming panel's blocks rise in staggered 60ms apart. Both
       collapse to an instant swap under prefers-reduced-motion. */
    .step-fade{ transition:opacity .26s ease, transform .26s ease; }
    .step-fade.step-hide{ opacity:0; transform:translateY(-8px); pointer-events:none; }
    @media (prefers-reduced-motion:reduce){
      .step-fade{ transition:none; }
      .step-fade.step-hide{ transform:none; }
    }

    /* ---- floating preview card ----------------------------------------
       Appended to <body>, NOT inside .receive: Lenis and the page's own
       stacking context would otherwise clip or mis-anchor a position:fixed
       child, and the card has to be able to sit over the nav bar. That means
       the page's custom properties don't reach it, so the colours are the
       literal values of --card / --line-strong / --ink-soft / --placeholder,
       same arrangement (and same keep-them-in-sync caveat) as .send-nav below.

       z-index 9999998 is above the nav bar (10000000 is the nav's, but the
       nav is a separate stacking root and paints below body's late children
       here) and one below the custom cursor (9999999): the card follows the
       pointer, so it has to be able to cross the bar, but it must never
       occlude the cursor dot itself. */
    .pvcard{ position:fixed; left:0; top:0; z-index:9999998;
      width:min(300px, calc(100vw - 24px));
      background:#0E1413; border:1px solid rgba(213,230,228,0.52); border-radius:10px;
      padding:9px; box-shadow:0 22px 50px rgba(0,0,0,.6);
      opacity:0; transform:translateY(8px) scale(.98); transform-origin:left center;
      transition:opacity .18s ease, transform .18s ease;
      /* Never eats the pointer: the row underneath keeps its hover, and the
         card can pass under the cursor without flickering itself away. */
      pointer-events:none; }
    .pvcard.is-on{ opacity:1; transform:none; }
    .pvcard .pv-media{ width:100%; height:200px; border-radius:6px; overflow:hidden;
      background:#070A09; display:flex; align-items:center; justify-content:center; }
    /* contain, not cover: the 46px thumbnail crops on purpose (it's an
       identifier), but the card is the thing that has to show the whole
       artboard — a cropped preview is barely better than no preview. */
    .pvcard .pv-media img,
    .pvcard .pv-media video{ max-width:100%; max-height:100%; width:auto; height:auto;
      object-fit:contain; display:block; }
    .pvcard .pv-media iframe{ width:100%; height:100%; border:0; background:#fff; }
    .pvcard .pv-msg{ font-family:'Diatype Mono', monospace; font-size:.66rem; letter-spacing:.04em;
      color:#829C98; text-align:center; line-height:1.9; padding:0 14px; }
    .pvcard .pv-meta{ font-family:'Diatype Mono', monospace; font-size:.66rem; letter-spacing:.04em;
      color:#829C98; padding:9px 5px 3px; display:flex; justify-content:space-between; gap:10px; }
    .pvcard .pv-name{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#BED0CD; }
    .pvcard .pv-size{ flex:0 0 auto; }
    @media (prefers-reduced-motion:reduce){ .pvcard{ transition:none; } }

    /* Literal rgba of --card (#0E1413), not var(--card) — the bar is a sibling
       of .send/.receive, so the page's custom properties don't reach it. Keep
       this in sync with --card; the bar and the cards share a surface tone.

       Frosted like every other inner-page nav: translucent tint + the 6px
       backdrop blur inherited from the base .inner-page-nav rule (and
       BaseLayout's inline fallback). The bar was opaque with blur disabled
       until 2026-07-30 as a perf guard against blurring over the
       always-animating transit canvas; the background's load has since been
       lightened, so the full frost is back to match the rest of the site. */
    .home-bottom-bar.inner-page-nav.send-nav{ background:rgba(14,20,19,0.75) !important; }
    .send-nav .home-bottom-email,
    .send-nav .home-bottom-location,
    .send-nav .inner-nav-links a,
    .send-nav .pulse-dot{ color:#BED0CD !important; }
    .send-nav .home-bottom-email,
    .send-nav .inner-nav-links a{ transition:color .2s ease; }
    /* Hover DARKENS rather than brightens — the nav text already sits near the
       top of the ramp, so there was nowhere brighter to go that read as a
       change. #93A29F is 7.01:1 on the #0E1413 bar: still WCAG AAA for body
       text, so the link stays fully legible while it's being pointed at. The
       AA floor for reference is #73807D (4.51:1) — noticeably darker, but it
       starts to read as disabled rather than hovered. */
    @media (hover:hover){
      .send-nav .home-bottom-email:hover,
      .send-nav .inner-nav-links a:hover{ color:#93A29F !important; }
    }
    /* Focus-visible keeps the bright treatment: keyboard users get a positive
       highlight rather than the pointer's dimming, and it can't be confused
       with a disabled control. */
    .send-nav .home-bottom-email:focus-visible,
    .send-nav .inner-nav-links a:focus-visible{ color:#D5E6E4 !important; }
  </style>

  <script>

    const $ = (id) => document.getElementById(id);

    /* Step transition, same shape as /brief's showForm(). `outEl` fades out,
       then `inEl` is revealed and its direct blocks rise in staggered. */
    const REDUCE = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function swapStep(outEl, inEl, done) {
      if (!outEl || !inEl) return;
      if (REDUCE()) {
        outEl.hidden = true; inEl.hidden = false;
        syncScroll();
        if (done) done();
        return;
      }
      outEl.classList.add('step-fade', 'step-hide');
      setTimeout(() => {
        outEl.hidden = true;
        outEl.classList.remove('step-hide');
        inEl.hidden = false;
        const items = inEl.matches('.acard, .dcard') ? [inEl] : inEl.querySelectorAll(':scope > .acard, :scope > .dcard, :scope > .actions');
        items.forEach((el, i) => {
          el.style.opacity = '0';
          el.style.transform = 'translateY(10px)';
          const dl = (i * 0.06).toFixed(2) + 's';
          el.style.transition = 'opacity .5s ease ' + dl + ', transform .5s ease ' + dl;
          requestAnimationFrame(() => requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'none';
          }));
          setTimeout(() => { el.style.transition = ''; el.style.transform = ''; el.style.opacity = ''; },
                     600 + i * 60);
        });
        syncScroll();
        // Card heights are still settling through the staggered rise, so sync
        // again once it's done — otherwise Lenis caches the mid-animation height.
        setTimeout(syncScroll, 700);
        if (done) done();
      }, 260);
    }

    /* Lenis caches the document height. Swapping the gate for the (much taller)
       view behind it changes that height without a resize event, so Lenis keeps
       scrolling against the OLD bounds and the page dead-ends partway down the
       card. /brief hit the same thing on its picker->form swap and solves it the
       same way — see refreshScroll() there. Deliberately does NOT jump to top:
       unlike /brief's full step change, these swaps happen in place. */
    function syncScroll() {
      requestAnimationFrame(() => {
        try {
          if (window._lenis && window._lenis.resize) window._lenis.resize();
        } catch (e) {}
        window.dispatchEvent(new Event('resize'));
      });
    }

    function humanSize(b) {
      return b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB';
    }

    /* ---- per-file preview -------------------------------------------------
       A client who's been sent nine files usually only wants one of them, and
       a filename is a poor way to tell "Boards_v4_FINAL" from "Boards_v4b".
       Every previewable row carries a 46px thumbnail; pointing at the row
       floats a 300px card beside the cursor with the file rendered properly.

       Type is decided by EXTENSION, not by asking the server: the manifest
       stores name/url/size only, and adding a MIME field would break every
       manifest written before today. An unknown extension simply falls back to
       the no-preview tile, which is the safe direction to be wrong in.

       Everything here is progressive: with JS off, or if any of it throws, the
       list is exactly the download list it was before. */
    const RE_IMG = /\.(png|jpe?g|webp|gif|avif|svg)$/i;
    const RE_VID = /\.(mp4|webm|mov|m4v)$/i;
    const RE_PDF = /\.pdf$/i;
    /* Thumbnails are painted at 46px but the browser still downloads the whole
       file — Blob has no resizing endpoint. Under 5MB that's a fair trade for a
       real picture; above it, the row shows an extension tile and the full
       image is only fetched if the client actually hovers. */
    const THUMB_MAX = 5 * 1024 * 1024;
    /* And nothing gets pulled into the hover card at all past this — a hover is
       an idle gesture, it shouldn't be able to start a 40MB transfer. */
    const PREVIEW_MAX = 25 * 1024 * 1024;
    /* Hover is a desktop-only input. On touch the same thumbnail is a tap
       target instead — see the click handler in wirePreview(). */
    const FINE_POINTER = window.matchMedia('(hover:hover) and (pointer:fine)').matches;

    function kindOf(name) {
      if (RE_IMG.test(name)) return 'image';
      if (RE_VID.test(name)) return 'video';
      if (RE_PDF.test(name)) return 'pdf';
      return 'other';
    }

    /* `thumbUrl` is a small JPEG that /send generated at upload time — page 1
       of a PDF, or a 640px copy of a large image. When one exists it's the
       best thing to show in BOTH the row tile and the card: it's a few KB, it
       needs no PDF viewer, and it works identically on every device. Shares
       created before 2026-07-31 don't have it, so every path below still has
       its original fallback. */
    function hasThumb(f) {
      return typeof f.thumbUrl === 'string' && f.thumbUrl.length > 0;
    }
    function extOf(name) {
      const parts = name.split('.');
      return parts.length > 1 ? parts.pop().toUpperCase().slice(0, 4) : 'FILE';
    }
    function tpTile(text) {
      const s = document.createElement('span');
      s.className = 'tp';
      s.textContent = text;
      return s;
    }

    let pvCard = null;
    function ensureCard() {
      if (pvCard) return pvCard;
      pvCard = document.createElement('div');
      pvCard.className = 'pvcard';
      // Decorative duplicate of what the row already says in text, so it's
      // hidden from screen readers rather than read out a second time.
      pvCard.setAttribute('aria-hidden', 'true');
      pvCard.innerHTML =
        '<div class="pv-media"></div>' +
        '<div class="pv-meta"><span class="pv-name"></span><span class="pv-size"></span></div>';
      document.body.appendChild(pvCard);
      return pvCard;
    }

    /* Media nodes are built once per file and cached, then moved in and out of
       the card. Rebuilding them per hover would re-fetch the file every time
       the pointer crossed a row — with a PDF that's megabytes a wiggle. */
    const pvMedia = new Map();
    function mediaFor(f, i) {
      if (pvMedia.has(i)) return pvMedia.get(i);
      const kind = kindOf(f.name);
      let node;
      if (hasThumb(f)) {
        /* Checked before the size cap on purpose: the cap exists to stop a
           hover pulling down a 40MB original, and a 30KB thumbnail is exactly
           the thing that makes previewing a huge file safe. */
        node = document.createElement('img');
        node.alt = '';
        node.src = f.thumbUrl;
      } else if ((f.size || 0) > PREVIEW_MAX) {
        node = document.createElement('div');
        node.className = 'pv-msg';
        node.textContent = 'Too large to preview. Download to open.';
      } else if (kind === 'image') {
        node = document.createElement('img');
        node.alt = '';
        node.src = f.url;
      } else if (kind === 'video') {
        /* Muted + loop + playsinline, started on hover and paused on leave:
           a moving preview answers "which cut is this" instantly, and muted
           autoplay is the only kind a browser will allow unprompted anyway.
           #t=0.5 seeks half a second in so the poster frame isn't the black
           first frame most exports open on. */
        node = document.createElement('video');
        node.src = f.url + '#t=0.5';
        node.muted = true;
        node.loop = true;
        node.playsInline = true;
        node.preload = 'metadata';
        node.setAttribute('muted', '');
        node.setAttribute('playsinline', '');
      } else if (kind === 'pdf' && navigator.pdfViewerEnabled !== false) {
        /* The browser's own PDF viewer in an iframe — no pdf.js, no worker, no
           extra CSP surface beyond frame-src. The hash params ask Chrome and
           Firefox to drop their toolbars so the card shows page 1 and nothing
           else; viewers that ignore them just show their chrome, which is
           still a readable preview. Needs the Blob host in frame-src — it was
           added to vercel.json alongside media-src for the video above.

           Guarded on navigator.pdfViewerEnabled because a browser without a
           built-in viewer — Chrome on Android is the big one — renders an
           iframed PDF as a blank white rectangle rather than failing visibly.
           A card that says "no preview" is honest; a blank white card looks
           like the file itself is empty. (The !== false test means browsers
           too old to expose the property still get the iframe, which is the
           behaviour they had before this line existed.) */
        node = document.createElement('iframe');
        node.title = 'Preview of ' + f.name;
        node.setAttribute('tabindex', '-1');
        node.src = f.url + '#toolbar=0&navpanes=0&scrollbar=0&view=FitH';
      } else if (kind === 'pdf') {
        node = document.createElement('div');
        node.className = 'pv-msg';
        node.textContent = 'This browser can’t preview PDFs. Download to open.';
      } else {
        node = document.createElement('div');
        node.className = 'pv-msg';
        node.textContent = 'No preview for this file type.';
      }
      pvMedia.set(i, node);
      return node;
    }

    function showPreview(f, i, x, y) {
      if (kindOf(f.name) === 'other') return;
      const card = ensureCard();
      const media = card.querySelector('.pv-media');
      const node = mediaFor(f, i);
      if (media.firstChild !== node) {
        media.textContent = '';
        media.appendChild(node);
      }
      if (node.tagName === 'VIDEO') { const p = node.play(); if (p && p.catch) p.catch(() => {}); }
      card.querySelector('.pv-name').textContent = f.name;
      card.querySelector('.pv-size').textContent = humanSize(f.size || 0);
      card.classList.add('is-on');
      movePreview(x, y);
    }

    /* Flips to the other side of the pointer near the right edge and clamps
       vertically, so the card is never half off-screen and never covers the
       row it's describing. */
    function movePreview(x, y) {
      if (!pvCard || !pvCard.classList.contains('is-on')) return;
      const w = pvCard.offsetWidth || 300;
      const h = pvCard.offsetHeight || 250;
      let left = x + 24;
      if (left + w > window.innerWidth - 12) {
        left = x - w - 24;
        pvCard.style.transformOrigin = 'right center';
      } else {
        pvCard.style.transformOrigin = 'left center';
      }
      if (left < 12) left = 12;
      const top = Math.max(12, Math.min(y - h / 2, window.innerHeight - h - 12));
      pvCard.style.left = left + 'px';
      pvCard.style.top = top + 'px';
    }

    function hidePreview() {
      if (!pvCard) return;
      pvCard.classList.remove('is-on');
      const v = pvCard.querySelector('video');
      if (v) v.pause();
      document.querySelectorAll('.receive .frow.is-hot').forEach((r) => r.classList.remove('is-hot'));
    }

    function thumbFor(f) {
      const kind = kindOf(f.name);
      const el = document.createElement(kind === 'other' ? 'span' : 'button');
      el.className = 'frow-thumb';
      if (kind !== 'other') {
        el.type = 'button';
        el.setAttribute('aria-label', 'Preview ' + f.name);
      }
      if (hasThumb(f) || (kind === 'image' && (f.size || 0) <= THUMB_MAX)) {
        const img = document.createElement('img');
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.src = hasThumb(f) ? f.thumbUrl : f.url;
        // A broken image would leave a blank tile with no hint of the type.
        img.addEventListener('error', () => {
          el.classList.add('is-plain');
          el.textContent = '';
          el.appendChild(tpTile(extOf(f.name)));
        });
        el.appendChild(img);
      } else if (kind === 'video') {
        const v = document.createElement('video');
        v.src = f.url + '#t=0.5';
        v.muted = true;
        v.playsInline = true;
        v.preload = 'metadata';
        v.setAttribute('muted', '');
        v.setAttribute('playsinline', '');
        el.appendChild(v);
        const play = document.createElement('span');
        play.className = 'play';
        el.appendChild(play);
      } else {
        el.classList.add('is-plain');
        el.appendChild(tpTile(kind === 'pdf' ? 'PDF' : extOf(f.name)));
      }
      return el;
    }

    function wirePreview(li, thumb, f, i) {
      if (kindOf(f.name) === 'other') return;
      if (FINE_POINTER) {
        /* The whole row is the hover target, not just the 46px tile — it's a
           far easier thing to hit, and the row highlight makes the pairing
           obvious.

           EXCEPT over the Download button, which is masked out: the card
           follows the pointer, so on the way to Download it ends up sitting
           right on top of the thing being reached for. Deciding to download is
           the end of looking, so the preview gets out of the way — and comes
           straight back if the pointer wanders off the button without
           clicking. Tested per-move rather than with enter/leave listeners on
           the button itself, because the pointer can enter the row already
           over it (coming in from the right edge). */
        const overDownload = (e) => !!(e.target.closest && e.target.closest('.frow-dl'));
        const openAt = (e) => {
          li.classList.add('is-hot');
          showPreview(f, i, e.clientX, e.clientY);
        };
        li.addEventListener('mouseenter', (e) => { if (!overDownload(e)) openAt(e); });
        li.addEventListener('mousemove', (e) => {
          const on = !!(pvCard && pvCard.classList.contains('is-on'));
          if (overDownload(e)) {
            if (on) hidePreview();
          } else if (!on) {
            openAt(e);
          } else {
            movePreview(e.clientX, e.clientY);
          }
        });
        li.addEventListener('mouseleave', hidePreview);
      }
      /* Touch and keyboard both go through the thumbnail itself: tap toggles,
         focus opens, blur/Escape closes. Anchored to the tile's right edge
         rather than to a pointer position, since neither input has one. */
      const anchor = () => {
        const r = thumb.getBoundingClientRect();
        li.classList.add('is-hot');
        showPreview(f, i, r.right, r.top + r.height / 2);
      };
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = pvCard && pvCard.classList.contains('is-on') && li.classList.contains('is-hot');
        hidePreview();
        if (!open) anchor();
      });
      thumb.addEventListener('focus', anchor);
      thumb.addEventListener('blur', hidePreview);
    }

    // Tapping anywhere else dismisses an open card (touch has no mouseleave).
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.frow-thumb')) hidePreview();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hidePreview();
    });

    function getToken() {
      // /files/<token> is the current shape — it matches the headline's blue
      // word, so the URL and the page agree. /r/<token> is the original and is
      // kept working forever: those links are already out with clients.
      const m = location.pathname.match(/\/(?:files|r)\/([a-zA-Z0-9]+)/);
      if (m) return m[1];
      const t = new URLSearchParams(location.search).get('t');
      return t || null;
    }

    const token = getToken();

    /* Show a card that starts hidden — removes any stale .in from the initial
       rAF pass, then triggers the rise animation once the element is visible. */
    function showCard(card) {
      card.hidden = false;
      card.classList.remove('in');
      requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('in')));
      syncScroll();
      setTimeout(syncScroll, 700);
    }

    function renderFiles(payload) {
      showCard($('files-card'));
      $('receive-lede').textContent = payload.client ? 'From COGNAK, for ' + payload.client + '.' : 'Ready to download.';
      // The project name headlines the file list when there is one — it's the
      // label the client actually recognises. Falls back to plain "Files".
      $('files-title').textContent = payload.project || 'Files';

      /* A download link with a deadline should say so on the page the client
         actually opens — otherwise the first they know of it is a dead link.
         Phrased as a date plus a countdown: the date is what they'd diarise,
         the countdown is what makes them act. */
      const expEl = $('expiry-note');
      if (payload.expiresAt) {
        const when = new Date(payload.expiresAt);
        const days = Math.ceil((when - Date.now()) / 86400000);
        const dateText = when.toLocaleDateString(undefined, {
          month: 'long', day: 'numeric', year: 'numeric',
        });
        const countdown =
          days <= 0 ? 'today' :
          days === 1 ? 'tomorrow' :
          days < 14 ? 'in ' + days + ' days' :
          days < 60 ? 'in ' + Math.round(days / 7) + ' weeks' :
          days < 365 ? 'in ' + Math.round(days / 30) + ' months' :
          'in ' + Math.round(days / 365) + ' year' + (Math.round(days / 365) === 1 ? '' : 's');
        // Built as nodes rather than innerHTML: dateText is locale-formatted
        // and the countdown is derived, but this sits next to client-supplied
        // strings and there's no reason for any of it to be parsed as markup.
        expEl.textContent = 'Download these before ' + dateText + '. ';
        const warn = document.createElement('span');
        warn.className = 'exp-warn';
        warn.textContent = 'This link expires ' + countdown + '.';
        expEl.appendChild(warn);
        expEl.hidden = false;
      } else {
        expEl.hidden = true;
      }
      document.title =
        [payload.client, payload.project].filter(Boolean).join(' — ') +
        (payload.client || payload.project ? ' — ' : '') + 'Files from COGNAK';

      const list = $('flist');
      list.innerHTML = '';
      (payload.files || []).forEach((f, i) => {
        const li = document.createElement('li');
        li.className = 'frow';
        li.innerHTML =
          '<span class="frow-name"></span>' +
          '<span class="frow-size"></span>' +
          '<a class="btn frow-dl" download></a>';
        // Preview thumbnail goes in front of the name; see the preview block
        // above for why it's a <button> on previewable rows.
        const thumb = thumbFor(f);
        li.insertBefore(thumb, li.firstChild);
        wirePreview(li, thumb, f, i);
        li.querySelector('.frow-name').textContent = f.name;
        li.querySelector('.frow-size').textContent = humanSize(f.size || 0);
        const a = li.querySelector('.frow-dl');
        /* ?download=1 is Vercel Blob's own switch — it makes the store return
           Content-Disposition: attachment. The plain `download` attribute does
           NOT work here: it's ignored for cross-origin URLs, and the files live
           on *.public.blob.vercel-storage.com, so the browser was navigating to
           them instead (opening images and PDFs in a tab rather than saving).
           The attribute stays for the filename hint on same-origin fallbacks. */
        a.href = f.url + (f.url.indexOf('?') === -1 ? '?download=1' : '&download=1');
        a.setAttribute('download', f.name);
        a.textContent = 'Download';
        // Per-row label so a screen reader hears which file, not N x "Download".
        a.setAttribute('aria-label', 'Download ' + f.name);
        /* Sticks, unlike /send's "Copied" — several files can each have been
           downloaded, and the whole point is remembering which ones you've
           already got when there are twelve in the list. The link keeps
           working, so this is a record of what you did, not a disabled state.
           Not persisted across reloads: it would need storage, and claiming a
           file was saved when the download may have failed is worse than
           forgetting. */
        a.addEventListener('click', () => {
          a.classList.add('is-done');
          a.textContent = 'Downloaded';
          a.setAttribute('aria-label', 'Download ' + f.name + ' again');
          /* Separate from the row state above, and NOT the same tradeoff:
             this is a one-way, one-bit signal ("has anything in this share
             ever been opened") that Pierce's /send dashboard shows as a
             dot per client, so it's worth persisting server-side even
             though the per-file row highlight above isn't. Fire-and-forget
             — never blocks or affects the download itself, and a failure
             here is invisible to the person downloading. keepalive so it
             still lands if this click is the last thing the tab does
             before the browser hands off to save the file. */
          try {
            fetch('/api/deliver-track-download', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token }),
              keepalive: true,
            }).catch(() => {});
          } catch (e) {}
        });
        list.appendChild(li);
      });

      // Download All — shown above the list, right under the title, once
      // there are 3+ files. (Used to also show a second copy below the list;
      // removed as redundant — one button at the top is enough.)
      const group = $('files-card').querySelector('.group');
      const existingWrap = group.querySelector('.dl-all-wrap');
      if (existingWrap) existingWrap.remove();

      if ((payload.files || []).length >= 3) {
        const files = payload.files || [];
        const wrap = document.createElement('div');
        wrap.className = 'dl-all-wrap';
        const dlBtn = document.createElement('button');
        dlBtn.type = 'button';
        dlBtn.className = 'btn btn-dl-all';
        dlBtn.textContent = 'Download all';
        dlBtn.addEventListener('click', () => {
          dlBtn.disabled = true;
          dlBtn.textContent = 'Downloading…';
          files.forEach((f, i) => {
            setTimeout(() => {
              const a = document.createElement('a');
              a.href = f.url + (f.url.indexOf('?') === -1 ? '?download=1' : '&download=1');
              a.setAttribute('download', f.name);
              a.style.display = 'none';
              document.body.appendChild(a);
              a.click();
              setTimeout(() => document.body.removeChild(a), 1000);
              if (i === files.length - 1) {
                setTimeout(() => {
                  dlBtn.disabled = false;
                  dlBtn.textContent = 'Download all';
                }, 800);
              }
            }, i * 300);
          });
        });
        wrap.appendChild(dlBtn);
        // Right after the group title, before the file list itself.
        $('files-title').insertAdjacentElement('afterend', wrap);
      }
    }

    async function loadFiles() {
      const res = await fetch('/api/deliver-get', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      let data = null;
      try { data = await res.json(); } catch (e) {}
      if (res.ok && data && data.ok) {
        renderFiles(data);
        return;
      }
      if (data && data.expired) {
        $('invalid-note').textContent = 'This link has expired. Ask COGNAK to send a new one.';
        showCard($('invalid'));
        return;
      }
      $('receive-lede').textContent = (data && data.error) || 'Could not load files. Please try again.';
    }

    if (!token) {
      showCard($('invalid'));
    } else {
      loadFiles();
    }

    requestAnimationFrame(() => {
      document.querySelectorAll('.receive .rise').forEach((el) => el.classList.add('in'));
    });
  </script>

  <script is:inline>
    /* Fade the WebGL background in once UnicornStudio mounts its canvas (with a
       timed fallback), matching /brief and the site's hero fade. */
    (function(){
      var el=document.querySelector('.send-webgl');
      if(!el) return;
      if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      function ready(){ el.classList.add('webgl-ready'); }
      if('MutationObserver' in window){
        var mo=new MutationObserver(function(){ if(el.querySelector('canvas')){ ready(); mo.disconnect(); } });
        mo.observe(el,{childList:true,subtree:true});
        setTimeout(function(){ ready(); mo.disconnect(); }, 4000);
      } else {
        setTimeout(ready, 1200);
      }
    })();
  </script>
</BaseLayout>
