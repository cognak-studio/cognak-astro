  -o-transition: all 0.7s ease;
  -webkit-transition: all 0.7s ease;
  transition: all 0.7s ease;
  color: #898193;
}
}
@media screen and (max-width: 720px) {
a[rel="prev"],
a[rel="next"] {
    position: static;
    top: 0;
    left: 0;
    right: 0;
    margin: 0;
    background: white;
    text-align: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
  }
@media (hover: hover) {
a[rel="prev"]:hover,
a[rel="next"]:hover {
    -moz-transition: all 0.7s ease;
    -o-transition: all 0.7s ease;
    -webkit-transition: all 0.7s ease;
    transition: all 0.7s ease;
    background: white;
  }
}
}
a[rel="prev"] {
  left: 0;
  margin-left: -500px;
  -moz-transition: all 0.7s ease;
  -o-transition: all 0.7s ease;
  -webkit-transition: all 0.7s ease;
  transition: all 0.7s ease;
}
a[rel="next"] {
  right: 0;
  margin-right: -500px;
  -moz-transition: all 0.7s ease;
  -o-transition: all 0.7s ease;
  -webkit-transition: all 0.7s ease;
  transition: all 0.7s ease;
}
