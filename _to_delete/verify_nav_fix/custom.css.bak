  border-style: solid;
  border-width: 2px;
  box-shadow: none;
  -moz-transition: all 0.7s ease;
  -o-transition: all 0.7s ease;
  -webkit-transition: all 0.7s ease;
  transition: all 0.7s ease;
  margin-bottom: -8px;
}
@media (hover: hover) {
input[type="text"]:active,
input[type="text"]:focus,
input[type="text"]:hover {
