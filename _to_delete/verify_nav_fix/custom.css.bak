/* ═══════════════════════════════════════════════════════════════════════════
   FOLDED IN FROM screen.css, 2026-08-02.

   screen.css was the WordPress theme's stylesheet. After the dead-code sweep
   what remained was ~430 lines of base styles that nothing distinguished from
   the rest of this file, plus one more cascade layer to reason about. It is
   prepended here VERBATIM AND IN ORDER — site.css loaded reset → screen →
   custom, so screen's rules must stay above custom's to keep losing the same
   ties they lost before. Do not sort or merge these into the sections below;
   the whole safety of the move is that nothing changed position.
   Verified by byte-comparing the bundled CSS before and after: identical.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── screen.css — what SURVIVED the inherited WordPress theme ──
   Cut from 1524 lines to this on 2026-08-01. The original was the theme
   stylesheet that came with the WordPress build: a full CSS reset, a socicon
   icon font, Ninja Forms rules, a hamburger nav, `.order-*` utilities and ~60
   vendor-prefixed `transition: all 0.7s ease` declarations. 293 of its 423
   selectors matched nothing on any page.

   HOW THE CUT WAS MADE — by evidence, not by reading. Every selector was
   comma-split so each is judged on its own, then run through
   `document.querySelectorAll` against the real DOM of 11 page templates in a
   production build. A second net kept any selector whose class token is
   added or queried by JS at runtime (`classList.add/remove/toggle`,
   `querySelector`, `closest`), so runtime-only classes were not mistaken for
   dead. Verified afterwards by diffing a 30-property computed-style
   fingerprint of every element on every page, before against after.

   WHY COMMA-SPLITTING MATTERED: `.v-center, .page, a[rel="prev"], a[rel="next"]`
   is ONE rule whose first two selectors are dead while the last two carry the
   project pagers' fixed positioning. Deleting the rule — or the file — would
   have unstyled the pagers.

   Before deleting anything else here by eye: it may be matched by markdown body
   content or a runtime class. Re-run the audit instead. */

html,
body,
div,
span,
h1,
h2,
h3,
p,
a,
code,
em,
img,
strong,
sup,
b,
i,
ul,
fieldset,
form,
label,
legend,
article,
aside,
canvas,
figure,
figcaption,
footer,
nav,
section,
video {
  margin: 0;
  padding: 0;
  border: 0;
  font: inherit;
  font-size: 100%;
  vertical-align: baseline;
}
html {
  line-height: 1;
}
ul {
  list-style: none;
}
a img {
  border: none;
}
article,
aside,
figcaption,
figure,
footer,
main,
nav,
section {
  display: block;
}
* {
  -moz-box-sizing: border-box;
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
}
a {
  text-decoration: none;
  color: inherit;
}
html {
  background-color: #fff;
}
i {
  font-family: 'Material Icons';
  font-weight: 700;
  font-style: normal;
  line-height: 1;
  text-transform: none;
  letter-spacing: normal;
  direction: ltr;
  /* Support for all WebKit browsers. */
  -webkit-font-smoothing: antialiased;
  /* Support for Safari and Chrome. */
  text-rendering: optimizeLegibility;
  /* Support for Firefox. */
  -moz-osx-font-smoothing: grayscale;
  /* Support for IE. */
  font-feature-settings: 'liga';
}
body,
html,
.main-intro {
  height: 100%;
}
body.fixed-nav {
  padding: 84px 0 0 0;
}
@media screen and (max-width: 1025px) {
body.fixed-nav {
    padding: 54px 0 0 0;
  }
}
a[rel="prev"],
a[rel="next"] {
  position: relative;
  top: 50%;
  -webkit-transform: translateY(-50%);
  transform: translateY(-50%);
}
@media screen and (max-width: 720px) {
a[rel="prev"],
a[rel="next"] {
    position: absolute;
    left: 0;
    width: 100%;
  }
}
.main-intro {
  /* The WordPress homepage photo lived here. `custom.css` has killed it with
     `background-image: none !important` since the WebGL hero landed, so the
     shorthand only ever served to reset the colour above it to transparent.
     Both are gone; the colour stays. (2026-08-02) */
  background-color: #3A313B;
  margin: 0 auto;
  position: relative;
  max-width: 1800px;
}
@media screen and (max-width: 1025px) {
.main-intro {
    background-attachment: scroll;
  }
}
.main-footer {
  padding: 52px 0;
  background: #f4f3f3;
}
@media screen and (min-width: 719px) {
.main-footer {
    padding: 73.5px 0;
  }
}
article img {
  -webkit-transition: -webkit-transform .7s;
  transition: -webkit-transform .7s;
  transition: transform .7s;
  transition: transform .7s, -webkit-transform .7s;
}
@media screen and (max-width: 720px) {
}
@media screen and (max-width: 720px) {
}
@media (hover: hover) {
}
.project-excerpt {
  margin: 20px 0;
}
.img-wide img,
.img-wide video {
  display: block;
  height: auto;
  width: 100%;
}
.container--work-single {
  margin: 0 auto;
  max-width: 1100px;
  width: 80%;
}
@media screen and (max-width: 720px) {
.container--work-single {
    width: 90%;
  }
}
.template-single-project {
  margin-top: -1px;
}
.template-single-project .information {
  margin: 55px 0;
}
.template-single-project .information .title {
  color: #3A313B;
  font-family: 'Diatype Mono', monospace;
  font-weight: 400;
  font-size: 70px;
  margin: 0 0 15px 0;
}
@media screen and (max-width: 720px) {
