a[rel="prev"],
a[rel="next"] {
  background: rgba(255, 255, 255, 0.75);
  display: block;
  padding: 25px;
  position: fixed;
  text-decoration: none;
  z-index: 500;
  display: -webkit-flex;
  display: flex;
  -webkit-align-items: center;
  align-items: center;
}
@media (hover: hover) {
a[rel="prev"]:hover,
a[rel="next"]:hover {
  -moz-transition: all 0.7s ease;
  -o-transition: all 0.7s ease;
  -webkit-transition: all 0.7s ease;
  transition: all 0.7s ease;
  background: rgba(255, 255, 255, 0.9);
}
}
.page .title,
a[rel="prev"] .title,
a[rel="next"] .title {
  color: #fff;
}
@media (hover: hover) {
a[rel="prev"]:hover,
a[rel="next"]:hover,
a[rel="prev"]:active,
a[rel="next"]:active {
  margin-right: 0px;
}
}
@media (hover: hover) {
