---
/**
 * /schedule — book a call directly onto Pierce's real Google Calendar.
 * (2026-08-25) Replaces the footer's old raw link out to Google's own
 * Appointment Schedule page (calendar.app.google/...). Google Calendar is
 * still the system of record — every slot shown here comes from a live
 * freeBusy query and every booking is a real Calendar event with a Meet
 * link — but the picker, the card, the whole surface is ours now instead of
 * handing visitors off to Google's default styling.
 *
 * Backend: api/schedule-availability.js (GET, freeBusy -> open slots) and
 * api/schedule-book.js (POST, re-validates the slot then writes the event).
 * Both go through a domain-wide-delegation service account — see
 * api/_lib/googleAuth.mjs for the three required env vars and
 * /schedule-setup.md for the one-time Google Cloud + Workspace admin steps.
 *
 * Rules baked into api/_lib/scheduleSlots.mjs (Pierce, 2026-08-25): Mon–Thu
 * only, 10am–5pm Pacific, 15 min buffer around existing events, 30 or 60
 * minute calls, 4 hours minimum lead time.
 *
 * Palette (2026-08-27, Pierce: "we should go to a dark theme like brief
 * and studio though, where hover purple is the button color and any
 * signifier color"): dark, near-black ground (#17151A, the same
 * --ink-deep every other dark page on the site shares), the site's own
 * brand purple as the one accent for buttons, borders, focus rings and
 * the busy-day heat map. Same .scard/.group/.field/.q/.pill/.btn
 * structure as /tools and /brief, just re-themed. Nav follows the
 * standard dark-blurred-bar treatment every other inner page uses (not
 * the pale-nav variant "Sky Milk" needed).
 * "Sky Milk" (2026-08-26, a light cyan-blue) was the palette before
 * this -- see project_schedule_page_2026_08.md if it's ever wanted back,
 * along with the three light alternates (Cloud Blue, Powder Blue, Denim
 * Mist) that were mocked up alongside it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  page="schedule"
  title="Schedule a Call | COGNAK"
  description="Book time directly on our real calendar. Pick a 30 or 60 minute slot, Mon–Thu, and get a Google Calendar invite with a Meet link the moment you submit."
  ogUrl="https://cognak.com/schedule/"
  pageBg="#17151A"
>
  {/* UnicornStudio (2026-08-27 round 11): retrying after round 10's pull --
     found a likely real cause first (see cognak-unicorn-init.js's dated
     comment): the shared loader was pinned to runtime v2.1.12, a full
     minor version behind this scene's own declared format v2.2.12, and
     an older parser reading newer-format scene JSON is the direction
     that's actually likely to break, not the reverse. Bumped the shared
     loader to v2.2.12 (confirmed API-compatible with the older scenes on
     /send/brief/studio/home too) before re-wiring this mount -- same
     lazy-load-on-idle mechanism via cognak-unicorn-init.js and
     [data-us-project], fixed full-bleed behind #cognak-main (z-index:1,
     see .schedule-webgl below), fades in once its canvas mounts. --bg
     stays the fallback shown until it mounts and forever under
     prefers-reduced-motion. */}
  <div class="schedule-webgl" data-us-project="Mt3f3Tq4KPcsXzo7mZGv" aria-hidden="true"></div>

  <main id="cognak-main"><section class="schedule">

    <h1 class="headline schedule-headline">
      <em>Schedule</em> a call, straight onto our calendar.
    </h1>
    <p class="lede schedule-lede">
      This checks the same calendar we actually run our week from, so if a
      time's open here, it's open. Pick a length, grab a slot, and you'll get
      a Google Calendar invite with a Meet link the moment you submit.
    </p>

    <div class="scard rise" id="scard">
      <div class="scard-body" id="scard-body">

        <div class="group">
          <div class="group-title">Call length</div>
          <div class="field">
            <div class="pills" id="duration-pills" role="radiogroup" aria-label="Call length">
              <label class="pill on">
                <input type="radio" name="duration" value="30" checked />30 min
              </label>
              <label class="pill">
                <input type="radio" name="duration" value="60" />60 min
              </label>
            </div>
          </div>
        </div>

        <div class="group">
          <div class="group-title">Pick a time</div>
          <div class="field">
            <label class="q">
              <span class="q-title">Mon–Thu, 10am–5pm Pacific</span>
              <span class="q-sub">Pulled live from the calendar. If it's not shown here, it's already booked.</span>
            </label>
            <div id="days-wrap" class="days-wrap" aria-live="polite">
              <div class="sched-loading">Loading availability…</div>
            </div>
          </div>
        </div>

        <div class="group" id="details-group" hidden>
          <div class="group-title">Your details</div>
          <p class="selected-slot-banner" id="selected-slot-banner"></p>
          <div class="field">
            <label class="q" for="name-input"><span class="q-title">Name</span></label>
            <input class="txt" id="name-input" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label class="q" for="email-input"><span class="q-title">Email</span></label>
            <input class="txt" id="email-input" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label class="q" for="notes-input">
              <span class="q-title">What's this about?</span>
              <span class="q-sub">Optional, a line or two helps us show up prepared.</span>
            </label>
            <textarea class="txt" id="notes-input" rows="3"></textarea>
          </div>
          {/* Honeypot: off-screen, unreachable by tab, invisible to a real
             visitor. A bot that fills every field blind trips it; see
             api/schedule-book.js for the server-side handling. */}
          <div class="field hp-field" aria-hidden="true">
            <label class="q" for="company-input">Company</label>
            <input class="txt" id="company-input" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>

        <div class="actions" id="actions" hidden>
          <button class="btn" id="book-btn" type="button" disabled>Book the call</button>
        </div>

        <p class="note" id="form-note" role="status"></p>

        <p class="tfoot">
          This is for a conversation, not a project start. We're generally
          booking new projects 30–60 days out, and Fridays are kept for
          studio work, not calls. If none of this works for
          you, <a href="mailto:hello@cognak.com">email us</a> and we'll find a time.
        </p>
      </div>

      <div class="confirmed-view" id="confirmed-view" hidden>
        <button class="schedule-backlink" id="back-to-cal-btn" type="button">&larr; Back to calendar</button>
        <div class="confirmed-check" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7.5 12.5L10.5 15.5L16.5 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="confirmed-title">You're on the calendar.</h2>
        <p class="confirmed-when" id="confirmed-when"></p>
        <p class="confirmed-sub">
          A calendar invite is on its way to <span id="confirmed-email"></span>.
          Accept it and you're set. Need to reschedule? Just reply to the invite.
        </p>
        <div class="confirmed-actions">
          <a class="btn" id="confirmed-meet" href="#" target="_blank" rel="noopener noreferrer">Join by Google Meet</a>
          <a class="btn btn-ghost" id="confirmed-cal" href="#" target="_blank" rel="noopener noreferrer">Open in Google Calendar</a>
        </div>
      </div>
    </div>

  </section></main>
</BaseLayout>

<style is:inline>
  html, body { background-color:#17151A !important; }

  /* UnicornStudio mount -- fixed behind the content, fades in once it mounts.
     Same pattern as .send-webgl/.brief-webgl; see cognak-unicorn-init.js.
     2026-08-27 round 11: re-added after round 10's pull, once the loader's
     version pin was bumped to match this scene's format -- see the mount
     comment above and cognak-unicorn-init.js. */
  .schedule-webgl{ position:fixed; inset:0; width:100vw; height:100vh; z-index:0;
    pointer-events:none; opacity:0; transition:opacity 1.6s var(--ease-standard); }
  .schedule-webgl.webgl-ready{ opacity:1; }
  @media (prefers-reduced-motion:reduce){ .schedule-webgl{ display:none; } }
  #cognak-main { position:relative; z-index:1; min-height:100vh; min-height:100dvh; }

  /* ============================================================
     COGNAK /schedule -- dark, purple accent (2026-08-27). Ground is
     --ink-deep, the same near-black #17151A as home/studio/tools, not a
     new one-off. --accent is the site's own brand purple
     (--cognak-purple-text elsewhere) -- Pierce asked for THE purple, the
     hue that already means "interactive" everywhere else on the site, not
     a fourth custom hue like /tools' lighter violet or /brief's orange.
     --accent-soft is a lighter step off it for body-sized purple text
     (links, banner, headline em) where 16px text needs more contrast than
     --accent clears on its own; --accent itself stays for borders, icons
     and the busy-day heat map, where the real floor is 3:1. --deep is dark
     ink FOR text laid on a solid --accent fill, same role /tools' --deep
     plays -- white-on-#9F50FF under-contrasts, dark-on-#9F50FF doesn't.
     Contrast checked, worst realistic pairing per token: ink 15.2:1,
     ink-soft 7.4:1, placeholder 5.0:1, accent-soft 7.4:1, deep-on-accent
     4.5:1, accent (decorative use only) 4.4:1 against a 3:1 floor. */
  .schedule {
    --bg:#17151A;
    --card:rgba(33,31,40,0.90); --field:rgba(0,0,0,0.30); --field-focus:rgba(0,0,0,0.42);
    --ink:#EDEAF3; --ink-soft:#A9A3B8;
    --accent:#9F50FF; --accent-hi:#B46FFF; --accent-rgb:159,80,255;
    --accent-soft:#C79BFF;
    --deep:#1B1424; --line:rgba(237,234,243,0.13); --line-strong:rgba(237,234,243,0.28);
    --placeholder:#8A8499; --ok:#7EE2A8; --err:#FF9E90;
    max-width:1040px; margin:0 auto; padding:190px 6vw 22vh;
    color:var(--ink); font-family:'Diatype Variable', sans-serif;
  }
  @media (max-width:720px){ .schedule{ padding-top:100px; } }
  @media (min-width:960px){ .schedule{ margin-left:clamp(48px,10vw,180px); margin-right:auto; } }

  /* screen.css hides every <label> globally (a Ninja Forms leftover) — same
     restore /tools and /brief both need. */
  .schedule label.q, .schedule legend.q { display:block !important; }
  .schedule label.pill { display:inline-flex !important; align-items:center; }

  /* ---------------------------------------------------------- header --- */
  .schedule .headline{ font-size:clamp(20px,5.5vw,62px); font-weight:500; line-height:1.1;
    letter-spacing:-.02em; margin:0 0 1.4rem; color:var(--ink); }
  .schedule .headline em{ font-style:normal; font-weight:500; color:var(--accent-soft); }
  .schedule .lede{ font-size:1.05rem; line-height:1.65; color:var(--ink-soft); max-width:52ch;
    margin:0 0 3.4rem 40px; }
  @media (max-width:720px){
    .schedule .headline{ font-size:clamp(24px,7vw,42px); }
    .schedule .lede{ margin-left:0; }
  }
  html.js .schedule-headline, html.js .schedule-lede{ opacity:0; }
  @media (prefers-reduced-motion:reduce){
    html.js .schedule-headline, html.js .schedule-lede{ opacity:1; }
  }
  .schedule-lede .stagger-word{ transform:none; transition:opacity var(--dur-xl) var(--ease-standard); }

  /* ------------------------------------------------------------ card --- */
  .schedule .scard{ background:var(--card); border-radius:10px; padding:34px 34px 30px;
    box-shadow:0 2px 18px rgba(0,0,0,.28); position:relative; }
  @media (max-width:600px){ .schedule .scard{ padding:24px 20px 22px; } }

  .schedule .group{ border-top:1px solid var(--line); padding-top:2.2rem; margin-top:2.6rem; }
  .schedule .group:first-of-type{ border-top:none; padding-top:0; margin-top:0; }
  .schedule .group[hidden]{ display:none; }
  .schedule .group-title{ font-family:'Diatype Mono', monospace; font-size:.72rem; letter-spacing:.2em;
    text-transform:uppercase; color:var(--ink-soft); margin-bottom:1.9rem; }

  .schedule .field{ margin-bottom:2rem; }
  .schedule .field:last-child{ margin-bottom:0; }
  .schedule .q{ display:block; margin-bottom:.85rem; padding:0; }
  .schedule .q-title{ display:block; font-size:1.08rem; font-weight:500; line-height:1.3; color:var(--ink); }
  .schedule .q-sub{ display:block; font-size:.88rem; font-weight:450; line-height:1.4; color:var(--ink-soft); margin-top:.2rem; max-width:54ch; }

  /* ---------------------------------------------------------- inputs --- */
  .schedule .txt{
    width:100%; box-sizing:border-box; margin:0; resize:vertical;
    background:var(--field); border:1px solid var(--line-strong); border-radius:8px;
    color:var(--ink); font-family:inherit; font-size:1rem; line-height:1.5; padding:14px 16px;
    transition:border-color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard); outline:none; }
  .schedule .txt::placeholder{ color:var(--placeholder); }
  .schedule .txt:focus{ border-color:var(--accent); background:var(--field-focus); color:var(--ink); }
  .schedule .txt.is-error{ border-color:var(--err); }
  .schedule a:focus-visible, .schedule button:focus-visible, .schedule input:focus-visible,
  .schedule textarea:focus-visible, .schedule [tabindex]:focus-visible{ outline-color:var(--accent) !important; }

  /* Honeypot — off-screen, not display:none (some bots skip that specifically). */
  .schedule .hp-field{ position:absolute; left:-9999px; top:-9999px; width:1px; height:1px; overflow:hidden; }

  /* ----------------------------------------------------------- pills --- */
  .schedule .pills{ display:flex; flex-wrap:wrap; gap:10px; }
  .schedule .pill{ position:relative; cursor:pointer; user-select:none; border:1px solid var(--line-strong);
    border-radius:999px; padding:10px 18px; font-size:.92rem; color:var(--ink); background:var(--field);
    transition:transform var(--dur-xs) var(--ease-press), border-color var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard); }
  .schedule .pill:hover{ border-color:var(--ink); }
  .schedule .pill:active{ transform:scale(.96); }
  .schedule .pill input{ position:absolute; opacity:0; pointer-events:none; }
  .schedule .pill.on{ border-color:var(--accent); color:var(--deep); background:var(--accent); font-weight:500; }

  /* ---------------------------------------------------- calendar picker --- */
  .schedule .days-wrap{ min-height:60px; }
  .schedule .sched-loading, .schedule .sched-empty{ font-size:.92rem; color:var(--ink-soft); padding:.4rem 0; }
  .schedule .sched-empty a{ color:var(--accent-soft); text-decoration:underline; text-underline-offset:var(--link-offset); }
  .schedule .sched-retry{ background:none; border:none; padding:0; margin-left:.4em; color:var(--accent-soft);
    text-decoration:underline; text-underline-offset:var(--link-offset); cursor:pointer; font:inherit; }

  /* A real month calendar (Pierce, 2026-08-26: "that's a crazy way to
     visualize the dates... can we have an actual calendar visualized
     instead... base it off of best practice or how google does it") —
     same two-step pattern Google's own scheduler and Calendly use: pick a
     DAY on a month grid, then a separate row of time buttons appears for
     just that day, instead of every open day and every open hour listed at
     once. Only dates present in daysCache (the server already found at
     least one open slot there) are clickable — weekends, Fridays, past
     days, fully-booked Mon–Thu days and anything past the 28-day horizon
     all render dim and inert. Month nav is clamped to the horizon: there's
     nothing bookable outside it, so there's nothing to browse to.

     Two-column layout (Pierce, 2026-08-26: "left 2/3 of card is calendar,
     right third is times stacked like the day view? just be empty if no
     date is selected") — calendar and the selected day's times sit side by
     side instead of times appearing below the grid, and the times list is
     a vertical stack (like Google Calendar's day view) instead of a
     flex-wrapped row of pills. */
  .schedule .cal-layout{ display:grid; grid-template-columns:2fr 1fr; gap:1.8rem; align-items:stretch; }
  .schedule .cal-col{ min-width:0; }

  .schedule .cal-nav{ display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; }
  .schedule .cal-month-label{ font-size:.92rem; font-weight:500; color:var(--ink); }
  .schedule .cal-nav-btn{ display:inline-flex; align-items:center; justify-content:center;
    width:32px; height:32px; border-radius:999px; border:1px solid var(--line-strong);
    background:var(--field); color:var(--ink); cursor:pointer; padding:0;
    transition:border-color var(--dur-s) var(--ease-standard), opacity var(--dur-s) var(--ease-standard); }
  .schedule .cal-nav-btn:hover:not(:disabled){ border-color:var(--accent-soft); }
  .schedule .cal-nav-btn:active:not(:disabled){ transform:scale(.94); }
  .schedule .cal-nav-btn:disabled{ opacity:.28; cursor:not-allowed; }
  .schedule .cal-nav-btn svg{ display:block; }

  .schedule .cal-weekdays{ display:grid; grid-template-columns:repeat(7,1fr); gap:4px;
    font-family:'Diatype Mono', monospace; font-size:.64rem; letter-spacing:.1em; text-transform:uppercase;
    color:var(--ink-soft); text-align:center; margin-bottom:.5rem; }

  .schedule .cal-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:4px; }
  .schedule .cal-day{ position:relative; aspect-ratio:1; display:flex; align-items:center; justify-content:center;
    font-family:inherit; font-size:.88rem; color:var(--placeholder); background:none; border:1px solid transparent;
    border-radius:8px; padding:0; cursor:default; -webkit-appearance:none; appearance:none;
    transition:border-color var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard); }
  .schedule .cal-day.is-blank{ visibility:hidden; }
  /* Trailing days from next month (Pierce, 2026-08-27: "show grayed
     out days for the next month" so the grid's last row doesn't just
     end in dead space) -- plain numbered spans, same inert look as an
     unbookable day in THIS month, faded further to read as "not this
     month" rather than "this month, just not open". Built right after
     the main day loop in renderCalendar(). */
  .schedule .cal-day.is-adjacent{ opacity:.38; }
  .schedule .cal-day.is-open{ border-color:var(--line-strong); background:var(--field); color:var(--ink); cursor:pointer; font-weight:500; }
  .schedule .cal-day.is-open:hover{ border-color:var(--accent-soft); transform:translateY(-1px) scale(1.05); }
  .schedule .cal-day.is-open:active{ transform:scale(.94); }
  .schedule .cal-day.on{ border-color:var(--accent); background:var(--accent); color:var(--deep); font-weight:500; }

  /* Busy-level gauge (Pierce, 2026-08-27: the heat-map wash was still
     hard to tell what it meant -- "let's do an uncolored line on the
     right side of each available day and have it be filled more if
     the day is busy ... and be empty/not filled in (hover purple) if
     it's wide open ... each day can just be the same inactive color
     overall"). Cells are back to the plain --field look regardless of
     tier; a thin neutral track sits inset from the right edge of each
     OPEN day, with a purple fill rising from the bottom in proportion
     to busyTier() -- see GAUGE_FILL in the script for the exact
     per-tier heights (0 / 50 / 100%). .on gets a white-on-accent
     variant since a purple fill would vanish against the day's own
     solid accent background. */
  .schedule .cal-day-gauge{ position:absolute; right:5px; top:7px; bottom:7px; width:3px;
    border-radius:2px; background:var(--line-strong); pointer-events:none; overflow:hidden; }
  .schedule .cal-day-gauge i{ position:absolute; left:0; right:0; bottom:0; border-radius:2px;
    background:var(--accent); display:block; width:100%; }
  .schedule .cal-day.on .cal-day-gauge{ background:rgba(255,255,255,.30); }
  .schedule .cal-day.on .cal-day-gauge i{ background:#fff; }

  /* Legend for the gauge above -- three mini gauges at the same fill
     steps the real ones use, so "a line that fills more" has a stated
     meaning before anyone hovers a day. Static, not tier-driven; built
     in renderCalendar() right under the grid. */
  .schedule .cal-legend{ display:flex; align-items:center; gap:7px; margin-top:.9rem;
    font-family:'Diatype Mono', monospace; font-size:.62rem; letter-spacing:.14em; text-transform:uppercase;
    color:var(--placeholder); }
  .schedule .cal-legend-gauge{ position:relative; width:3px; height:12px; border-radius:2px;
    background:var(--line-strong); flex:0 0 auto; overflow:hidden; }
  .schedule .cal-legend-gauge i{ position:absolute; left:0; right:0; bottom:0; border-radius:2px;
    background:var(--accent); display:block; width:100%; }
  .schedule .cal-legend-gauge.t1 i{ height:0%; }
  .schedule .cal-legend-gauge.t2 i{ height:50%; }
  .schedule .cal-legend-gauge.t3 i{ height:100%; }

  .schedule .times-col{ border-left:1px solid var(--line); padding-left:1.8rem; }
  @keyframes schedTimesIn{ from{ opacity:0; transform:translateY(6px); } to{ opacity:1; transform:translateY(0); } }
  .schedule .cal-day-label{ font-size:.88rem; font-weight:500; color:var(--ink); margin-bottom:.8rem;
    animation:schedTimesIn .32s var(--ease-standard) both; }
  .schedule .cal-day-note{ font-size:.76rem; color:var(--placeholder); margin:-.5rem 0 .8rem;
    animation:schedTimesIn .32s var(--ease-standard) .03s both; }
  .schedule .sched-slots{ display:flex; flex-direction:column; gap:8px; }
  .schedule .sched-slot{ font-family:inherit; font-size:.9rem; color:var(--ink); background:var(--field);
    border:1px solid var(--line-strong); border-radius:8px; padding:9px 14px; cursor:pointer; text-align:center;
    animation:schedTimesIn .3s var(--ease-standard) both;
    transition:transform var(--dur-xs) var(--ease-press), border-color var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard), background var(--dur-s) var(--ease-standard); }
  .schedule .sched-slot:hover{ border-color:var(--accent-soft); transform:translateX(3px); }
  .schedule .sched-slot:active{ transform:scale(.96); }
  .schedule .sched-slot.on{ border-color:var(--accent); color:var(--deep); background:var(--accent); font-weight:500; }

  @media (max-width:640px){
    .schedule .cal-layout{ grid-template-columns:1fr; gap:0; }
    .schedule .times-col{ border-left:none; padding-left:0; border-top:1px solid var(--line);
      padding-top:1.2rem; margin-top:1.4rem; }
    .schedule .times-col:empty{ display:none; }
  }

  .schedule .selected-slot-banner{ margin:0 0 1.6rem; font-size:.96rem; color:var(--accent-soft); }
  .schedule .selected-slot-banner:empty{ display:none; }

  .schedule .note{ margin:1.2rem 0 0; font-size:.88rem; line-height:1.45; color:var(--ink-soft); min-height:1.2em; }
  .schedule .note.is-error{ color:var(--err); }
  .schedule .note.is-ok{ color:var(--ok); }

  /* --------------------------------------------------------- actions --- */
  .schedule .actions{ border-top:1px solid var(--line); margin-top:3rem; padding-top:2.4rem; }
  .schedule .btn{ font-family:inherit; font-size:1rem; font-weight:500; cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center; gap:.6rem;
    border-radius:999px; padding:14px 28px; background:none; color:var(--ink);
    border:1px solid var(--line-strong); text-decoration:none;
    transition:background var(--dur-s) var(--ease-standard), color var(--dur-s) var(--ease-standard), border-color var(--dur-s) var(--ease-standard), box-shadow var(--dur-sm) var(--ease-standard); }
  .schedule .btn:hover:not(:disabled){ background:var(--accent); border-color:var(--accent);
    color:var(--deep); box-shadow:0 0 24px rgba(var(--accent-rgb),.34); }
  .schedule .btn:active:not(:disabled){ transform:scale(.98); }
  .schedule .btn:disabled{ opacity:.32; cursor:not-allowed; }
  .schedule .btn-ghost{ opacity:.85; }

  .schedule .tfoot{ margin:2.6rem 0 0; font-size:.82rem; line-height:1.7; color:var(--placeholder); }
  .schedule .tfoot a{ color:var(--ink-soft); text-decoration:underline; text-underline-offset:var(--link-offset);
    text-decoration-thickness:1px; transition:color var(--link-dur) var(--link-ease); }
  @media (hover:hover){ .schedule .tfoot a:hover{ color:var(--accent); } }

  /* ------------------------------------------------------- confirmed --- */
  /* Livelier confirmation (Pierce, 2026-08-27: make the page more
     interactive) — the check circle/mark draw themselves in via
     stroke-dasharray, then title/when/sub/actions fade up in sequence,
     instead of the whole block just appearing. Pure CSS; showConfirmed()
     still just flips `hidden`, unchanged. */
  .schedule .confirmed-view{ position:relative; text-align:center; padding:2.4rem 0 4.4rem; }
  /* Back-to-calendar (Pierce, 2026-08-27: "add a BACK TO CALENDAR in the
     top left of the card with an arrow similar to how brief says change
     project type"). Absolutely positioned so it never pushes the centered
     confirmation content down -- confirmed-view's own padding-top above
     is sized to clear it with room to spare. Click resets the card back
     to the calendar/duration picker and re-runs loadAvailability(), so
     the slot just booked no longer shows as open. */
  .schedule .schedule-backlink{ position:absolute; top:2px; left:0; display:flex; align-items:center;
    gap:.5rem; background:none; border:none; padding:0; margin:0; font:inherit; font-size:.85rem;
    color:var(--ink-soft); cursor:pointer; text-align:left;
    transition:color var(--dur-s) var(--ease-standard); }
  .schedule .schedule-backlink::before{ content:""; position:absolute; inset:-12px -10px; }
  @media (hover:hover){ .schedule .schedule-backlink:hover{ color:var(--accent-soft); } }
  .schedule .confirmed-check{ color:var(--accent); margin-bottom:1.2rem; }
  .schedule .confirmed-check circle{ stroke-dasharray:69; stroke-dashoffset:69; animation:schedCheckDraw .5s var(--ease-standard) forwards; }
  .schedule .confirmed-check path{ stroke-dasharray:14; stroke-dashoffset:14; animation:schedCheckDraw .35s var(--ease-standard) .45s forwards; }
  @keyframes schedCheckDraw{ to{ stroke-dashoffset:0; } }
  @keyframes schedConfirmIn{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:none; } }
  .schedule .confirmed-title{ font-size:1.6rem; font-weight:500; margin:0 0 .8rem; color:var(--ink);
    animation:schedConfirmIn var(--dur-2xl) var(--ease-standard) .55s both; }
  .schedule .confirmed-when{ font-size:1.1rem; color:var(--accent-soft); margin:0 0 1.2rem;
    animation:schedConfirmIn var(--dur-2xl) var(--ease-standard) .65s both; }
  .schedule .confirmed-sub{ font-size:.95rem; line-height:1.55; color:var(--ink-soft); max-width:46ch;
    margin:0 auto 2.2rem; animation:schedConfirmIn var(--dur-2xl) var(--ease-standard) .75s both; }
  .schedule .confirmed-actions{ display:flex; flex-wrap:wrap; gap:12px; justify-content:center;
    animation:schedConfirmIn var(--dur-2xl) var(--ease-standard) .85s both; }

  /* ---------------------------------------------------------- motion --- */
  .schedule .rise{ opacity:0; transform:translateY(8px); transition:opacity var(--dur-2xl) var(--ease-standard), transform var(--dur-2xl) var(--ease-standard); }
  .schedule .rise.in{ opacity:1; transform:none; }
  @media (prefers-reduced-motion:reduce){
    .schedule .rise{ opacity:1; transform:none; transition:none; }
    .schedule .cal-day.is-open:hover{ transform:none; }
    .schedule .sched-slot:hover{ transform:none; }
    .schedule .cal-day-label, .schedule .cal-day-note, .schedule .sched-slot,
    .schedule .confirmed-check circle, .schedule .confirmed-check path,
    .schedule .confirmed-title, .schedule .confirmed-when,
    .schedule .confirmed-sub, .schedule .confirmed-actions{
      animation:none; opacity:1; transform:none; stroke-dashoffset:0;
    }
  }

  /* ------------------------------------------------------------- nav --- */
  /* Standard dark-blurred-bar every other inner page uses (the pale nav
     was a Sky Milk-only need), themed to this page's purple -- same
     treatment /tools gives it. No logo filter override: the default
     invert(1) in custom.css already renders it white-on-dark correctly.
     2026-08-27: the actual dark-background override moved OUT of this
     block and into custom.css (next to .studio-nav) -- this page-level
     <style is:inline> tag renders near the END of body (after all the
     BaseLayout nav/main/footer markup, since schedule.astro's own <style>
     lives after </BaseLayout> in the source), so a rule that lived here
     didn't take effect until the parser reached this point, well after the
     nav had already painted once against custom.css's base pale
     .inner-page-nav background (rgba(247,241,255,0.75), the Sky-Milk-
     family default every other inner page without its own dark override
     also starts from) -- a real, visible flash of pale-then-dark on first
     paint, not a screenshot artifact. custom.css loads via a blocking
     <link> in <head>, before ANY body markup paints, so the override lives
     there now instead -- see .schedule-nav in custom.css. */
</style>

<script>
  const $ = (id) => document.getElementById(id);

  const scardBody = $('scard-body');
  const confirmedView = $('confirmed-view');
  const backToCalBtn = $('back-to-cal-btn');
  const daysWrap = $('days-wrap');
  const detailsGroup = $('details-group');
  const actions = $('actions');
  const bookBtn = $('book-btn');
  const formNote = $('form-note');
  const selectedBanner = $('selected-slot-banner');
  const nameInput = $('name-input');
  const emailInput = $('email-input');
  const notesInput = $('notes-input');
  const companyInput = $('company-input');

  const LA_TZ = 'America/Los_Angeles';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const viewerTz = (() => {
    try { return Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (e) { return LA_TZ; }
  })();
  const showBothTz = viewerTz && viewerTz !== LA_TZ;

  let duration = 30;
  let selectedSlot = null; // ISO string, or null
  let daysCache = [];

  // ---- Calendar state (2026-08-26: real month-grid picker, replacing the
  // old "every open day listed top to bottom" layout) -----------------
  const HORIZON_DAYS = 28; // mirrors api/_lib/scheduleSlots.mjs — keep in sync
  let calCursor = null;    // { y, m } — the month currently displayed
  let selectedDate = null; // 'YYYY-MM-DD', or null

  function pad2(n) { return String(n).padStart(2, '0'); }
  function laTodayKey() {
    // en-CA gives YYYY-MM-DD directly — the same format the server's
    // dateKey() produces, so string comparison below is safe.
    return new Intl.DateTimeFormat('en-CA', { timeZone: LA_TZ }).format(new Date());
  }
  function keyParts(key) {
    const [y, m, d] = key.split('-').map(Number);
    return { y, m, d };
  }
  function shiftKey(key, n) {
    const { y, m, d } = keyParts(key);
    const dt = new Date(Date.UTC(y, m - 1, d));
    dt.setUTCDate(dt.getUTCDate() + n);
    const yy = dt.getUTCFullYear(), mm = dt.getUTCMonth() + 1, dd = dt.getUTCDate();
    return { y: yy, m: mm, key: yy + '-' + pad2(mm) + '-' + pad2(dd) };
  }
  function shiftMonth({ y, m }, delta) {
    const idx = y * 12 + (m - 1) + delta;
    return { y: Math.floor(idx / 12), m: (idx % 12) + 1 };
  }
  function monthIndex({ y, m }) { return y * 12 + m; }
  function daysInMonth(y, m) { return new Date(Date.UTC(y, m, 0)).getUTCDate(); }
  function firstWeekdayOfMonth(y, m) { return new Date(Date.UTC(y, m - 1, 1)).getUTCDay(); }
  function monthLabel(y, m) {
    return new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', month: 'long', year: 'numeric' }).format(new Date(Date.UTC(y, m - 1, 1)));
  }

  // Busy-level indicator (Pierce, 2026-08-27: "show some days are busier
  // than others") — a lightweight relative read using the slot counts the
  // API already returns, not a real historical baseline. Tier 3 (fewest
  // slots) always applies at count<=1 regardless of the relative ratio, so
  // a single-slot day never misreads as "wide open" just because every
  // other day is just as thin.
  // Per-tier gauge fill height, percent -- 0 (wide open, empty track) to
  // 100 (limited availability, fully filled). Shared by the real day
  // gauges and the static legend so they can never drift apart.
  const GAUGE_FILL = { 1: 0, 2: 50, 3: 100 };
  function busyTier(count, maxCount) {
    if (count <= 1) return 3;
    const ratio = count / maxCount;
    if (ratio >= 0.66) return 1;
    if (ratio >= 0.33) return 2;
    return 3;
  }
  function busyLabel(tier) {
    return tier === 1 ? 'wide open' : tier === 2 ? 'some openings' : 'limited availability';
  }

  // Day-dependent copy (Pierce, 2026-08-27: make the page more interactive)
  // — a one-line note that shifts with how far out the picked date is.
  // Purely cosmetic; delete this function and its one call site in
  // renderTimesFor() if it doesn't land.
  function relativeNote(dateKey, todayKey) {
    const t = keyParts(todayKey);
    const d = keyParts(dateKey);
    const diffDays = Math.round((Date.UTC(d.y, d.m - 1, d.d) - Date.UTC(t.y, t.m - 1, t.d)) / 86400000);
    if (diffDays <= 0) return 'Today, if it works.';
    if (diffDays === 1) return 'Tomorrow.';
    if (diffDays <= 6) return 'This week.';
    if (diffDays <= 13) return 'Next week.';
    return 'A few weeks out.';
  }

  function setNote(msg, kind) {
    formNote.textContent = msg || '';
    formNote.classList.toggle('is-error', kind === 'error');
    formNote.classList.toggle('is-ok', kind === 'ok');
  }

  function fmtTime(iso, tz) {
    return new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).format(new Date(iso));
  }

  function fmtDayLabel(dateKey) {
    // dateKey is a 'YYYY-MM-DD' LA calendar date. Anchor at 19:00 UTC (11am
    // Pacific, safely inside the day either side of DST) purely so the
    // weekday/month/day formatting below can't roll onto the wrong date.
    const [y, m, d] = dateKey.split('-').map(Number);
    const anchor = new Date(Date.UTC(y, m - 1, d, 19));
    return new Intl.DateTimeFormat('en-US', { timeZone: LA_TZ, weekday: 'short', month: 'short', day: 'numeric' }).format(anchor);
  }

  async function loadAvailability() {
    daysWrap.innerHTML = '<div class="sched-loading">Loading availability…</div>';
    selectedSlot = null;
    detailsGroup.hidden = true;
    actions.hidden = true;
    setNote('');

    try {
      const r = await fetch('/api/schedule-availability?duration=' + duration, { cache: 'no-store' });
      const json = await r.json().catch(() => null);
      if (!r.ok || !json) throw new Error((json && json.error) || 'Could not load availability.');
      daysCache = json.days || [];
      renderCalendar();
    } catch (e) {
      daysWrap.innerHTML = '<div class="sched-empty">Couldn’t load availability right now. '
        + '<button type="button" class="sched-retry" id="retry-btn">Try again</button></div>';
      const retry = $('retry-btn');
      if (retry) retry.addEventListener('click', loadAvailability);
    }
  }

  function renderCalendar() {
    if (!daysCache.length) {
      daysWrap.innerHTML = '<div class="sched-empty">Nothing open in the next few weeks. '
        + '<a href="mailto:hello@cognak.com">Email us</a> and we\u2019ll find a time.</div>';
      return;
    }

    const availByDate = new Map(daysCache.map((d) => [d.date, d.slots]));
    const todayKey = laTodayKey();
    const minMonth = keyParts(todayKey);
    const maxMonth = shiftKey(todayKey, HORIZON_DAYS - 1);

    if (!calCursor || monthIndex(calCursor) < monthIndex(minMonth) || monthIndex(calCursor) > monthIndex(maxMonth)) {
      calCursor = { y: minMonth.y, m: minMonth.m };
    }
    if (selectedDate && !availByDate.has(selectedDate)) selectedDate = null;

    // Auto-populate the day view on load (Pierce, 2026-08-27: "have the
    // current date automatically populate the day view on load") — default
    // to today if it's bookable; otherwise fall back to the soonest day
    // that is (today's usually a Friday/weekend/fully-booked miss, not an
    // empty calendar). Only fires while nothing's explicitly selected, so
    // it re-applies after a duration switch clears the pick but never
    // fights a real choice or a month-nav browse.
    if (!selectedDate) {
      if (availByDate.has(todayKey)) {
        selectedDate = todayKey;
      } else {
        const soonest = daysCache.map((d) => d.date).sort()[0];
        if (soonest) selectedDate = soonest;
      }
      if (selectedDate) {
        const sd = keyParts(selectedDate);
        if (monthIndex({ y: sd.y, m: sd.m }) !== monthIndex(calCursor)) {
          calCursor = { y: sd.y, m: sd.m };
        }
      }
    }

    daysWrap.innerHTML = '';

    const layout = document.createElement('div');
    layout.className = 'cal-layout';

    const calCol = document.createElement('div');
    calCol.className = 'cal-col';

    // ---- month nav ----
    const nav = document.createElement('div');
    nav.className = 'cal-nav';

    const prevBtn = document.createElement('button');
    prevBtn.type = 'button';
    prevBtn.className = 'cal-nav-btn';
    prevBtn.setAttribute('aria-label', 'Previous month');
    prevBtn.innerHTML = '<svg width="7" height="12" viewBox="0 0 7 12" fill="none" aria-hidden="true"><path d="M6 1 1 6l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    prevBtn.disabled = monthIndex(calCursor) <= monthIndex(minMonth);
    prevBtn.addEventListener('click', () => { calCursor = shiftMonth(calCursor, -1); renderCalendar(); });

    const label = document.createElement('div');
    label.className = 'cal-month-label';
    label.textContent = monthLabel(calCursor.y, calCursor.m);

    const nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.className = 'cal-nav-btn';
    nextBtn.setAttribute('aria-label', 'Next month');
    nextBtn.innerHTML = '<svg width="7" height="12" viewBox="0 0 7 12" fill="none" aria-hidden="true"><path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    nextBtn.disabled = monthIndex(calCursor) >= monthIndex(maxMonth);
    nextBtn.addEventListener('click', () => { calCursor = shiftMonth(calCursor, 1); renderCalendar(); });

    nav.append(prevBtn, label, nextBtn);
    calCol.appendChild(nav);

    // ---- weekday header ----
    const weekdaysEl = document.createElement('div');
    weekdaysEl.className = 'cal-weekdays';
    ['S', 'M', 'T', 'W', 'T', 'F', 'S'].forEach((w) => {
      const s = document.createElement('span');
      s.textContent = w;
      weekdaysEl.appendChild(s);
    });
    calCol.appendChild(weekdaysEl);

    // ---- day grid ----
    const grid = document.createElement('div');
    grid.className = 'cal-grid';

    const lead = firstWeekdayOfMonth(calCursor.y, calCursor.m);
    for (let i = 0; i < lead; i++) {
      const blank = document.createElement('span');
      blank.className = 'cal-day is-blank';
      grid.appendChild(blank);
    }

    const total = daysInMonth(calCursor.y, calCursor.m);
    const maxSlotCount = Math.max(1, ...daysCache.map((d) => d.slots.length));
    for (let d = 1; d <= total; d++) {
      const dateKey = calCursor.y + '-' + pad2(calCursor.m) + '-' + pad2(d);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cal-day';
      btn.textContent = String(d);

      if (availByDate.has(dateKey)) {
        btn.classList.add('is-open');
        if (dateKey === selectedDate) btn.classList.add('on');
        const fullLabel = new Intl.DateTimeFormat('en-US', { timeZone: LA_TZ, weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(dateKey + 'T19:00:00Z'));

        const tier = busyTier(availByDate.get(dateKey).length, maxSlotCount);
        const gauge = document.createElement('span');
        gauge.className = 'cal-day-gauge';
        gauge.setAttribute('aria-hidden', 'true');
        const fill = document.createElement('i');
        fill.style.height = GAUGE_FILL[tier] + '%';
        gauge.appendChild(fill);
        btn.appendChild(gauge);
        btn.setAttribute('aria-label', fullLabel + ', ' + busyLabel(tier));
        btn.addEventListener('click', () => selectDate(dateKey, btn));
      } else {
        btn.disabled = true;
        btn.setAttribute('aria-hidden', 'true');
        btn.tabIndex = -1;
      }
      grid.appendChild(btn);
    }

    // Trailing days from next month, grayed out, to fill the grid's
    // last row instead of leaving it dead space (skipped when the
    // month's last day already lands on Saturday and the row is
    // already full -- trail comes out 0 there).
    const trail = (7 - ((lead + total) % 7)) % 7;
    for (let d = 1; d <= trail; d++) {
      const adj = document.createElement('span');
      adj.className = 'cal-day is-adjacent';
      adj.textContent = String(d);
      adj.setAttribute('aria-hidden', 'true');
      grid.appendChild(adj);
    }
    calCol.appendChild(grid);

    const legend = document.createElement('div');
    legend.className = 'cal-legend';
    legend.setAttribute('aria-hidden', 'true');
    legend.innerHTML = '<span>Open</span>'
      + '<span class="cal-legend-gauge t1"><i></i></span>'
      + '<span class="cal-legend-gauge t2"><i></i></span>'
      + '<span class="cal-legend-gauge t3"><i></i></span>'
      + '<span>Busy</span>';
    calCol.appendChild(legend);

    // ---- times column (right third \u2014 like Google's day view once a date's
    // picked; stays empty until then, per Pierce 2026-08-26) ----
    const timesCol = document.createElement('div');
    timesCol.className = 'times-col';

    layout.append(calCol, timesCol);
    daysWrap.appendChild(layout);

    if (selectedDate) renderTimesFor(selectedDate);
  }

  function selectDate(dateKey, btnEl) {
    selectedDate = dateKey;
    selectedSlot = null;
    detailsGroup.hidden = true;
    actions.hidden = true;
    daysWrap.querySelectorAll('.cal-day.on').forEach((el) => el.classList.remove('on'));
    btnEl.classList.add('on');
    renderTimesFor(dateKey);
    const timesCol = daysWrap.querySelector('.times-col');
    if (timesCol) timesCol.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function renderTimesFor(dateKey) {
    const timesCol = daysWrap.querySelector('.times-col');
    if (!timesCol) return;
    timesCol.innerHTML = '';

    const day = daysCache.find((d) => d.date === dateKey);
    if (!day) return;

    const label = document.createElement('div');
    label.className = 'cal-day-label';
    label.textContent = fmtDayLabel(dateKey);
    timesCol.appendChild(label);

    const note = document.createElement('div');
    note.className = 'cal-day-note';
    note.textContent = relativeNote(dateKey, laTodayKey());
    timesCol.appendChild(note);

    const slotsEl = document.createElement('div');
    slotsEl.className = 'sched-slots';
    day.slots.forEach((iso, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'sched-slot';
      b.dataset.iso = iso;
      b.textContent = fmtTime(iso, LA_TZ);
      b.style.animationDelay = (i * 0.045) + 's';
      if (iso === selectedSlot) b.classList.add('on');
      b.addEventListener('click', () => selectSlot(iso, b));
      slotsEl.appendChild(b);
    });
    timesCol.appendChild(slotsEl);
  }

  function selectSlot(iso, btnEl) {
    selectedSlot = iso;
    daysWrap.querySelectorAll('.sched-slot.on').forEach((el) => el.classList.remove('on'));
    btnEl.classList.add('on');

    let when = fmtTime(iso, LA_TZ) + ' Pacific';
    if (showBothTz) when += ' · ' + fmtTime(iso, viewerTz) + ' your time';
    const dayLabel = new Intl.DateTimeFormat('en-US', { timeZone: LA_TZ, weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(iso));
    selectedBanner.textContent = dayLabel + ', ' + when;

    detailsGroup.hidden = false;
    actions.hidden = false;
    updateBookEnabled();
    detailsGroup.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function updateBookEnabled() {
    const emailOk = EMAIL_RE.test(emailInput.value.trim());
    bookBtn.disabled = !(selectedSlot && nameInput.value.trim() && emailOk);
  }
  nameInput.addEventListener('input', updateBookEnabled);
  emailInput.addEventListener('input', updateBookEnabled);

  document.querySelectorAll('#duration-pills input[name="duration"]').forEach((input) => {
    input.addEventListener('change', () => {
      document.querySelectorAll('#duration-pills .pill').forEach((p) => p.classList.remove('on'));
      const pillEl = input.closest('.pill');
      if (pillEl) pillEl.classList.add('on');
      duration = parseInt(input.value, 10);
      loadAvailability();
    });
  });

  bookBtn.addEventListener('click', async () => {
    if (bookBtn.disabled || !selectedSlot) return;
    bookBtn.disabled = true;
    const original = bookBtn.textContent;
    bookBtn.textContent = 'Booking…';
    setNote('');

    try {
      const r = await fetch('/api/schedule-book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameInput.value.trim(),
          email: emailInput.value.trim(),
          notes: notesInput.value.trim(),
          durationMinutes: duration,
          start: selectedSlot,
          company: companyInput.value,
        }),
      });
      const json = await r.json().catch(() => null);

      if (!r.ok || !json || !json.ok) {
        setNote((json && json.error) || 'Something went wrong. Please try again.', 'error');
        bookBtn.disabled = false;
        bookBtn.textContent = original;
        if (r.status === 409) loadAvailability(); // someone else took it — refresh the list
        return;
      }

      showConfirmed(json);
    } catch (e) {
      setNote('Something went wrong. Please try again.', 'error');
      bookBtn.disabled = false;
      bookBtn.textContent = original;
    }
  });

  function showConfirmed(payload) {
    scardBody.hidden = true;
    confirmedView.hidden = false;

    let when = fmtTime(payload.start, LA_TZ) + ' Pacific';
    if (showBothTz) when += ' · ' + fmtTime(payload.start, viewerTz) + ' your time';
    const dayLabel = new Intl.DateTimeFormat('en-US', { timeZone: LA_TZ, weekday: 'long', month: 'long', day: 'numeric' }).format(new Date(payload.start));
    $('confirmed-when').textContent = dayLabel + ', ' + when;
    $('confirmed-email').textContent = emailInput.value.trim();

    const meetBtn = $('confirmed-meet');
    if (payload.meetLink) { meetBtn.href = payload.meetLink; } else { meetBtn.hidden = true; }
    const calBtn = $('confirmed-cal');
    if (payload.calendarLink) { calBtn.href = payload.calendarLink; } else { calBtn.hidden = true; }

    // The real Ads conversion moment — a call actually booked, not just a
    // click through to this page (BaseLayout's sitewide click handler only
    // tracks that click-through now; see the comment there for why).
    if (typeof gtag === 'function') {
      gtag('event', 'schedule_call_booked', { event_category: 'Contact', event_label: duration + ' min' });
      gtag('event', 'conversion', { send_to: 'AW-876403750/r1GlCKXGmLwcEKa486ED' });
    }
  }

  backToCalBtn.addEventListener('click', () => {
    confirmedView.hidden = true;
    scardBody.hidden = false;
    bookBtn.disabled = true;
    bookBtn.textContent = 'Book the call';
    loadAvailability();
  });

  // Card entrance — same immediate-reveal-on-next-frame pattern as /tools'
  // #tcard (there's no shared sitewide .rise revealer; each page fires its
  // own, see cognak-global.js's stagger SELECTORS for the headline/lede half
  // of this reveal instead).
  requestAnimationFrame(() => $('scard').classList.add('in'));

  loadAvailability();

  // Fade the WebGL background in once UnicornStudio mounts its canvas --
  // same pattern as /send and /brief (see cognak-unicorn-init.js for the load).
  (function(){
    var el = document.querySelector('.schedule-webgl');
    if(!el) return;
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    function ready(){ el.classList.add('webgl-ready'); }
    if('MutationObserver' in window){
      var mo = new MutationObserver(function(){
        if(el.querySelector('canvas')){ ready(); mo.disconnect(); }
      });
      mo.observe(el, {childList:true, subtree:true});
      setTimeout(function(){ ready(); mo.disconnect(); }, 4000);
    } else {
      setTimeout(ready, 1200);
    }
  })();
</script>
